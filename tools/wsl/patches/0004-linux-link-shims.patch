+++ b/osfmk/vm/vm_link_compat.c
@@ -0,0 +1,41 @@
+/*
+ * Link shims for a non-Apple toolchain.
+ *
+ * bsd/pgo/profile_runtime.c calls the InstrProfiling helpers that Apple's
+ * compiler-rt supplies at link time; there is no such runtime here, so report
+ * an empty profile. __cxa_atexit is only referenced by the C++ static
+ * destructor registration in libkern's bootstrap object; the kernel builds
+ * with -fno-c++-static-destructors and never runs it.
+ */
+#include <stdint.h>
+
+uint64_t
+__llvm_profile_get_size_for_buffer_internal(
+	const char *DataBegin, const char *DataEnd,
+	const char *CountersBegin, const char *CountersEnd,
+	const char *NamesBegin, const char *NamesEnd)
+{
+	(void)DataBegin; (void)DataEnd;
+	(void)CountersBegin; (void)CountersEnd;
+	(void)NamesBegin; (void)NamesEnd;
+	return 0;
+}
+
+int
+__llvm_profile_write_buffer_internal(
+	char *Buffer, const char *DataBegin, const char *DataEnd,
+	const char *CountersBegin, const char *CountersEnd,
+	const char *NamesBegin, const char *NamesEnd)
+{
+	(void)Buffer; (void)DataBegin; (void)DataEnd;
+	(void)CountersBegin; (void)CountersEnd;
+	(void)NamesBegin; (void)NamesEnd;
+	return 0;
+}
+
+int
+__cxa_atexit(void (*func)(void *), void *arg, void *dso)
+{
+	(void)func; (void)arg; (void)dso;
+	return 0;
+}
