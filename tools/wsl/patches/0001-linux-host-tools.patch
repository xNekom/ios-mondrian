XCRUN, PLUTIL, PAX and HOST_CODESIGN are hardcoded to /usr/bin paths with `=`,
so an environment variable cannot override them; without xcrun every
`$(shell $(XCRUN) ...)` query returns empty and CC/HOST_CC/MIG/IIG stay unset.
`?=` lets tools/wsl/env.sh point them at the shims. macOS is unaffected: the
values there are the same absolute paths.

diff --git a/makedefs/MakeInc.cmd b/makedefs/MakeInc.cmd
index bc39e19..6fa85ea 100644
--- a/makedefs/MakeInc.cmd
+++ b/makedefs/MakeInc.cmd
@@ -100,12 +100,12 @@ ifeq ($(VERBOSE),YES)
 	_v =
 	_vstdout =
 	_vstderr =
-	XCRUN = /usr/bin/xcrun -verbose
+	XCRUN ?= xcrun -verbose
 else
 	_v = @
 	_vstdout = > /dev/null
 	_vstderr = 2> /dev/null
-	XCRUN = /usr/bin/xcrun
+	XCRUN ?= xcrun
 endif
 
 VERBOSE_GENERATED_MAKE_FRAGMENTS = NO
@@ -285,7 +285,7 @@ MKDIR = /bin/mkdir -p
 CHMOD = /bin/chmod
 FIND = /usr/bin/find
 XARGS = /usr/bin/xargs
-PAX = /bin/pax
+PAX ?= pax
 BASENAME = /usr/bin/basename
 DIRNAME = /usr/bin/dirname
 TR = /usr/bin/tr
@@ -293,7 +293,7 @@ TOUCH = /usr/bin/touch
 SLEEP = /bin/sleep
 AWK = /usr/bin/awk
 SED = /usr/bin/sed
-PLUTIL = /usr/bin/plutil
+PLUTIL ?= plutil
 PATCH = /usr/bin/patch
 GREP = /usr/bin/grep
 
@@ -317,7 +317,7 @@ ifeq ($(origin HOST_GM4),undefined)
 	export HOST_GM4		:= $(shell $(XCRUN) -sdk $(HOST_SDKROOT) -find gm4)
 endif
 ifeq ($(origin HOST_CODESIGN),undefined)
-	export HOST_CODESIGN	:= /usr/bin/codesign
+	export HOST_CODESIGN	:= codesign
 endif
 ifeq ($(origin HOST_CODESIGN_ALLOCATE),undefined)
 	export HOST_CODESIGN_ALLOCATE	:= $(shell $(XCRUN) -sdk $(HOST_SDKROOT) -find codesign_allocate)
