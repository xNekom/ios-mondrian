+};
+
+/*
+ * The GPU's driver, where the kernel has a GPU to drive (the service
+ * MondrianGPU, reached through src/mondrian-drm); NULL means the caller falls
+ * back to the software rasteriser. OSMESA_SOFTWARE=1 forces that fallback.
+ */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, freedreno_options, ARRAY_SIZE(freedreno_options));
+   driParseConfigFiles(&cache, &info, 0, "msm", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   screen = fd_drm_screen_create_renderonly(fd, NULL, &config);
+   if (screen)
+      gpu_fd = fd;
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+#endif
+
+
+extern struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
+
+/*
+ * The memory of an IOSurface as a texture, to draw into and to draw with: the
+ * kernel's GPU driver (MondrianGPU, request 0x7e) makes a buffer of it. NULL:
+ * the screen is not the GPU's, or the surface cannot be a BGRA texture.
+ */
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface)
+{
+#ifdef GALLIUM_FREEDRENO
+   struct mondrian_drm_surface s = { .surface = surface };
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_B8G8R8A8_UNORM,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET,
+   };
+   struct winsys_handle handle = { .type = WINSYS_HANDLE_TYPE_FD };
+
+   if (gpu_fd < 0 || mondrian_drm_surface(gpu_fd, &s) != 0)
+      return NULL;
+   /*
+    * 'BGRA' is a plain surface. 'b3a8' is CoreAnimation's display surface:
+    * plane 0 is 32-bit BGRA and the second plane is not the picture.
+    */
+   if ((s.pixel_format != 0x42475241 /* 'BGRA' */ &&
+        s.pixel_format != 0x62336138 /* 'b3a8' */) || s.planes > 2)
+      return NULL;
+   templ.width0 = s.width;
+   templ.height0 = s.height;
+   handle.handle = surface;
+   handle.stride = s.row_bytes;
+   handle.offset = s.offset;
+   handle.size = s.size;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+#else
+   return NULL;
+#endif
+}
 
