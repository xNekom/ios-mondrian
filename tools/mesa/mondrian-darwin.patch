diff --git a/src/gallium/targets/osmesa/osmesa_target.c b/src/gallium/targets/osmesa/osmesa_target.c
index 25985dd..eef4fa2 100644
--- a/src/gallium/targets/osmesa/osmesa_target.c
+++ b/src/gallium/targets/osmesa/osmesa_target.c
@@ -26,6 +26,43 @@
 
 #include "sw/null/null_sw_winsys.h"
 
+#ifdef GALLIUM_FREEDRENO
+#include "freedreno/drm/freedreno_drm_public.h"
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include <xf86drm.h>
+
+static const driOptionDescription freedreno_options[] = {
+#include "freedreno/driinfo_freedreno.h"
+};
+
+/*
+ * The GPU's driver, where the kernel has a GPU to drive (the service
+ * MondrianGPU, reached through src/mondrian-drm); NULL means the caller falls
+ * back to the software rasteriser. OSMESA_SOFTWARE=1 forces that fallback.
+ */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, freedreno_options, ARRAY_SIZE(freedreno_options));
+   driParseConfigFiles(&cache, &info, 0, "msm", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   screen = fd_drm_screen_create_renderonly(fd, NULL, &config);
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+#endif
+
 
 struct pipe_screen *
 osmesa_create_screen(void);
@@ -37,6 +74,12 @@ osmesa_create_screen(void)
    struct sw_winsys *winsys;
    struct pipe_screen *screen;
 
+#ifdef GALLIUM_FREEDRENO
+   screen = osmesa_create_gpu_screen();
+   if (screen)
+      return screen;
+#endif
+
    /* We use a null software winsys since we always just render to ordinary
     * driver resources.
     */
