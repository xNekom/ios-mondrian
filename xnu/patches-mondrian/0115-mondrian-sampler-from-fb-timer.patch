+/*
+ * Ordinary kernel pages, not device memory: the framebuffer's default surface
+ * must not describe the panel's managed pages to IOMemoryDescriptor, which
+ * would put a device pager on them and corrupt the pmap's PV lists (the
+ * "physical with managed page" backtrace, then a pmap_remove_pv panic).
+ */
 MondrianSurface *
+mondrian_surface_create_vm(uint32_t width, uint32_t height, uint32_t bytesPerRow,
+    uint32_t pixelFormat)
+{
+	MondrianSurface *s = mondrian_surface_alloc();
+
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page((uint64_t)bytesPerRow * height);
+	s->memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	s->mapCache = kIOMapDefaultCache;
+	if (s->memory == NULL || !mondrian_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	bzero((void *)s->kernelAddress(), s->allocSize);
+	return s;
+}
+
+MondrianSurface *
 mondrian_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
     uint32_t bytesPerRow, uint32_t pixelFormat)
 {
