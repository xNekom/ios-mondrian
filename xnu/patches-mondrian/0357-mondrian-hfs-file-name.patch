 			}
+			if (err == noErr && actualNumBlocks != 0) {
+			{
+				static int mondrian_logged_alloc;
+				struct cnode *cp = FTOC(fcb);
+				char shown[44];
+				int n = 0;
+
+				if (mondrian_logged_alloc < 24) {
+					mondrian_logged_alloc++;
+					if (cp->c_desc.cd_nameptr != NULL &&
+					    cp->c_desc.cd_namelen > 0) {
+						n = cp->c_desc.cd_namelen <
+						    (int)sizeof(shown) - 1 ?
+						    cp->c_desc.cd_namelen :
+						    (int)sizeof(shown) - 1;
+						memcpy(shown, cp->c_desc.cd_nameptr, n);
+					}
+					shown[n] = '\0';
+					printf("MONDRIAN HFS: %s file %u '%.*s' fork %d %u+%u\n",
+					    "alloc", (unsigned)FTOC(fcb)->c_fileid, n, shown,
+					    FORK_IS_RSRC(fcb) ? 2 : 1,
+					    actualStartBlock, actualNumBlocks);
+				}
+			}
+			}
 		}
 		if (err == dskFulErr) {
 			if (forceContig) {
