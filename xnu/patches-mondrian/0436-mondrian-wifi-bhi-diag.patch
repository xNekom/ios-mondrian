+/*
+ * W6 diagnostic: the load leaves the ring silent when the doorbell does not
+ * start, so read the context state after the wait. A translation fault in FSR
+ * with a matching FAR means the BHI read reached the SMMU and the page table
+ * is wrong; a clean FSR with a stuck doorbell means the device never fetched.
+ */
+int
+mondrian_wifi_smmu_fault(uint32_t *sctlr, uint32_t *fsr, uint32_t *far,
+    uint32_t *fsynr, uint32_t *gfsr, uint32_t *s2cr, uint32_t *s2cr2)
+{
+    uint32_t v;
+
+    if (w2.smmu == 0 || w2.cb == 0 || sctlr == NULL || fsr == NULL ||
+        far == NULL || fsynr == NULL || gfsr == NULL || s2cr == NULL ||
+        s2cr2 == NULL) {
+        return -1;
+    }
+    if (w2_rd32(w2.cb + W2_CB_SCTLR, sctlr) ||
+        w2_rd32(w2.cb + W2_CB_FSR, fsr) ||
+        w2_rd32(w2.cb + W2_CB_FAR, far) ||
+        w2_rd32(w2.cb + W2_CB_FSYNR0, fsynr) ||
+        w2_rd32(W2_GFSR, gfsr) ||
+        w2_rd32(W2_S2CR(w2.slot), s2cr)) {
+        return -1;
+    }
+    *s2cr2 = 0;
+    if (w2.slot2_touched) {
+        if (w2_rd32(W2_S2CR(w2.slot2), &v)) {
+            return -1;
+        }
+        *s2cr2 = v;
+    }
+    return 0;
+}
