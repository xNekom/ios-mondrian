xnu 0295: the final physmap, and the console it carries

The final TTBR1 is installed before the framebuffer alias is written, and the
tables must then be reached through the physmap: the same page seen through
the bootstrap VA=PA block and through the physmap is a mismatched alias, and a
descriptor written through the bootstrap one can stay invisible to the walker
(the measured symptom is a level-2 translation fault on a mapping that reads
back correct from C). The alias is built after arm_vm_physmap_init(),
descriptors are cleaned to the point of coherency and the TLB is dropped.

16 KiB pages need one L2 block for the low globals and one for the alias, and
the panel console is off unless `mondrianfb_console=1`: the ring already
records every line, and the text used to sit over the boot logo until the UI
drew.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1851,17 +1851,21 @@
 	if ((va + (MONDRIAN_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE)) > gVirtBase) {
 		return FALSE;
 	}
-	l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	/*
+	 * This runs with the final TTBR1 already live and the bootstrap VA=PA
+	 * aperture still installed in TTBR0. The tables must be reached through
+	 * the physmap, not through their physical address: the same page
+	 * accessed through two different mappings (the VA=PA bootstrap block and
+	 * the physmap) is a mismatched alias, and a descriptor written through
+	 * the bootstrap one can stay invisible to the walker, which then takes a
+	 * translation fault on a mapping that reads back correctly from C.
+	 * cpu_tte is a bootstrap KVA and is not mapped once TTBR1 changes.
+	 */
+	l1 = ((tt_entry_t *)phystokv(cpu_ttep))[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
 		return FALSE;
 	}
-	/*
-	 * The bootstrap aperture is still the live mapping here, so the page
-	 * tables are reachable by their physical address. phystokv() is not:
-	 * it returns a physmap address, and the physmap is only mapped once
-	 * TTBR1 points at the final table.
-	 */
-	l2 = (tt_entry_t *)(l1 & ARM_TTE_TABLE_MASK);
+	l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	for (i = 0; i < MONDRIAN_EARLY_FB_BLOCKS; i++) {
 		tt_entry_t *slot = &l2[((va + (i * ARM_TT_L2_SIZE)) & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 		if (*slot != ARM_TTE_EMPTY) {
@@ -1875,7 +1879,24 @@
 		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	}
-	__asm__ volatile("dsb ishst" ::: "memory");
+	/*
+	 * A descriptor written through the physmap is not necessarily the one
+	 * the walker reads: this board maps the same page through the bootstrap
+	 * VA=PA block and through the physmap with different cache attributes,
+	 * and a store through one of them can stay invisible to the other. The
+	 * measured symptom is a translation fault (level 2) on a mapping that
+	 * reads back correct from C. Clean and invalidate the descriptor lines
+	 * to the point of coherency and drop the TLB before anything uses it.
+	 */
+	for (i = 0; i < MONDRIAN_EARLY_FB_BLOCKS; i++) {
+		tt_entry_t *slot = &l2[((va + (i * ARM_TT_L2_SIZE)) & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+
+		__asm__ volatile("dc civac, %0" :: "r"(slot) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	__asm__ volatile("tlbi vmalle1" ::: "memory");
+	__asm__ volatile("dsb ish" ::: "memory");
+	__asm__ volatile("isb" ::: "memory");
 	return TRUE;
 }
 #endif
@@ -2209,23 +2230,46 @@
 	arm_set_user_tbi();
 
 	arm_vm_physmap_init(args);
+	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
+
+	ml_enable_monitor();
+
 #if defined(MONDRIAN)
 	/*
-	 * The alias needs the final TTBR1 tables, and they only exist once
-	 * the physmap is in: the kernel image (gVirtBase) shares the L1
-	 * entry with the low globals, and that entry is created by
-	 * arm_vm_physmap_init(). The bootstrap aperture is still live here,
-	 * so the tables can be read by their physical address.
+	 * Install the alias only now: the final TTBR1 (and with it the physmap)
+	 * is live, so the tables can be written through a normal-memory mapping
+	 * that the walker is coherent with. TTBR0 still holds the bootstrap
+	 * VA=PA aperture, so the console keeps painting at 0xb8000000 until
+	 * mondrian_early_relocate() switches it.
 	 */
 	if (!mondrian_early_map_final()) {
 		mondrian_early_disable();
 	} else {
 		mondrian_early_set_fb_va(MONDRIAN_EARLY_FB_VA);
 	}
+	mondrian_early_fb_backup = phystokv(0xb8000000);
 #endif
-	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
-	ml_enable_monitor();
+#if defined(MONDRIAN)
+	if (mondrian_early_fb_va() != 0) {
+		uint64_t d_par;
+		tt_entry_t d_l1 = ((tt_entry_t *)phystokv(cpu_ttep))[(MONDRIAN_EARLY_FB_VA & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+		tt_entry_t *d_l2 = (tt_entry_t *)phystokv(d_l1 & ARM_TTE_TABLE_MASK);
+		unsigned int d_i2 = (unsigned int)((MONDRIAN_EARLY_FB_VA & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+
+		mondrian_early_reg("slotok", (d_l2[d_i2] & ~ARM_TTE_BLOCK_WIRED) ==
+		    ((0xb8000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX) & ~ARM_TTE_BLOCK_WIRED));
+		__asm__ volatile("at s1e1w, %0" :: "r"((uint64_t)MONDRIAN_EARLY_FB_VA));
+		__asm__ volatile("mrs %0, par_el1" : "=r"(d_par));
+		mondrian_early_reg("par", d_par);
+		mondrian_early_reg("l1e", d_l1);
+		mondrian_early_reg("slot", d_l2[d_i2]);
+	}
+	mondrian_early_reg("slotok2", 0x1234);
+#endif
 
 #if defined(MONDRIAN)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */

diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2553,7 +2553,12 @@
 	 * Reserve the whole alias region instead; the VM then starts
 	 * allocating at LOW_GLOBAL_BASE_ADDRESS + 32MB, past the last block.
 	 */
+#if __ARM_16K_PG__
+	/* 16 KiB pages: one L2 block for the low globals, one for the alias. */
+	low_global_vr_size = 0x4000000;
+#else
 	low_global_vr_size = 0x2000000;
+#endif
 #endif /* MONDRIAN */
 
 	if (((gVirtBase & low_global_vr_mask) != LOW_GLOBAL_BASE_ADDRESS) && (region_select == 2)) {

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -1035,8 +1035,20 @@
 		fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
 	}
 	mondrian_early_mark(18, "fbcon mapping returned");
+	/*
+	 * The panel console overwrites the bootloader's Apple logo with kernel
+	 * text from the first printf, and the UI can take a minute to draw over
+	 * it. The persistent ring already records every line, so keep the panel
+	 * clean unless a boot needs the text on the screen:
+	 * mondrianfb_console=1 restores it.
+	 */
 	if (fbcon_base != NULL) {
-		register_serial_functions(&mondrian_fbcon_serial_functions);
+		int console = 0;
+
+		if (PE_parse_boot_argn("mondrianfb_console", &console, sizeof(console)) &&
+		    console != 0) {
+			register_serial_functions(&mondrian_fbcon_serial_functions);
+		}
 	}
 }
 

