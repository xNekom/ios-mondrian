+/*
+ * "wfile PATH LEN": the LEN bytes follow as "RLW1" + little-endian u32 offset
+ * + data datagrams, and the file is written when the last byte of the range
+ * has landed. This is how a file in the root is replaced without a kernel
+ * build and without a userdata flash. Because the write truncates, the target
+ * must not be mapped: kill its process first (`kill PID`), write, and launchd
+ * brings the process back with the new copy.
+ *
+ * "wstat" reports how much has arrived, so the host can resend a file whose
+ * datagrams the gadget dropped instead of starting over blind.
+ */
+#define UD_WFILE_MAX    (1u << 20)
+
+static unsigned char *ud_wfile_buf;
+static uint32_t ud_wfile_len;
+static uint32_t ud_wfile_got;
+static char     ud_wfile_path[96];
+static int      ud_wfile_active;
+
+static void
+ud_cmd_wfile(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	char out[160];
+	const char *path = line + 5;
+	const char *p;
+	uint32_t len = 0;
+	size_t path_len;
+	int n;
+
+	while (*path == ' ' || *path == '\t') {
+		path++;
+	}
+	for (p = path; *p != 0 && *p != ' ' && *p != '\t'; p++) {
+		;
+	}
+	path_len = (size_t)(p - path);
+	if (path_len == 0 || path_len >= sizeof(ud_wfile_path)) {
+		n = snprintf(out, sizeof(out), "wfile needs a path\n");
+		ud_cmd_send(so, to, out, (size_t)n);
+		return;
+	}
+	if (ud_cmd_num(p, &len) == NULL || len == 0 || len > UD_WFILE_MAX) {
+		n = snprintf(out, sizeof(out), "wfile needs a length up to %u\n",
+		    UD_WFILE_MAX);
+		ud_cmd_send(so, to, out, (size_t)n);
+		return;
+	}
+	if (ud_wfile_buf == NULL) {
+		vm_offset_t buf = 0;
+
+		if (kmem_alloc_contig(kernel_map, &buf, UD_WFILE_MAX, PAGE_MASK,
+		    0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			n = snprintf(out, sizeof(out), "wfile has no memory\n");
+			ud_cmd_send(so, to, out, (size_t)n);
+			return;
+		}
+		ud_wfile_buf = (unsigned char *)(uintptr_t)buf;
+	}
+	memcpy(ud_wfile_path, path, path_len);
+	ud_wfile_path[path_len] = 0;
+	ud_wfile_len = len;
+	ud_wfile_got = 0;
+	ud_wfile_active = 1;
+	n = snprintf(out, sizeof(out), "wfile %s %u ready\n", ud_wfile_path,
+	    ud_wfile_len);
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("MONDR USB: wfile %s %u bytes\n", ud_wfile_path, ud_wfile_len);
+}
+
+static void
+ud_cmd_wdata(socket_t so, struct sockaddr_in *to, const char *packet, size_t n)
+{
+	uint32_t offset, data;
+
+	if (n < 8) {
+		return;
+	}
+	memcpy(&offset, packet + 4, sizeof(offset));
+	data = (uint32_t)n - 8;
+	/*
+	 * Only the contiguous prefix counts: a datagram that arrives ahead of a
+	 * hole must not make the file look complete, and the host retransmits
+	 * from the start, which the "already here" case below absorbs.
+	 */
+	if (offset > ud_wfile_got || offset >= ud_wfile_len ||
+	    data > ud_wfile_len - offset) {
+		return;
+	}
+	memcpy(ud_wfile_buf + offset, packet + 8, data);
+	if (offset + data > ud_wfile_got) {
+		ud_wfile_got = offset + data;
+	}
+	if (ud_wfile_got >= ud_wfile_len) {
+		char out[160];
+		int error, m;
+
+		ud_wfile_active = 0;
+		error = mondrian_root_write(ud_wfile_path, ud_wfile_buf,
+		    ud_wfile_len);
+		m = snprintf(out, sizeof(out), "wfile %s %u bytes -> %d\n",
+		    ud_wfile_path, ud_wfile_len, error);
+		ud_cmd_send(so, to, out, (size_t)m);
+		printf("MONDRIAN WFILE: %s %u bytes -> %d\n", ud_wfile_path,
+		    ud_wfile_len, error);
+	}
+}
+
+/*
+ * "kill PID": the signal the control channel needs to relaunch a daemon that
+ * has a replaced file mapped, and to prove what the system does when a service
+ * is absent. launchd applies its own restart throttle, which is worth seeing.
+ */
+static void
+ud_cmd_kill(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	char out[96];
+	uint32_t pid = 0;
+	proc_t p;
+	int n, error = ESRCH;
+
+	(void)ud_cmd_num(line + 4, &pid);
+	if (pid != 0) {
+		p = proc_find((int)pid);
+		if (p != PROC_NULL) {
+			psignal(p, SIGKILL);
+			proc_rele(p);
+			error = 0;
+		}
+	}
+	n = snprintf(out, sizeof(out), "kill %u -> %d\n", pid, error);
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("MONDR USB: %s", out);
+}
