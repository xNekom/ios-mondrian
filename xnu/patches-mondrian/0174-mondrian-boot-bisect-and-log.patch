+mondrian_early_set_stop(int stage)
+{
+	mondrian_early_stop_stage = stage;
+}
+
+void
 mondrian_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 20) {
+	if ((early_disabled && stage < 21) || stage > 60) {
 		return;
 	}
+	if (stage >= 21) {
+		/* The console is off by now; keep the bisection marks visible. */
+		early_forced = 1;
+	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48 && x < EARLY_WIDTH; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
 		}
 	}
@@ -120,6 +138,13 @@
 	mondrian_early_string(": ");
 	mondrian_early_string(label);
 	mondrian_early_putc('\n');
+	if (mondrian_early_stop_stage == (int)stage) {
+		mondrian_early_string("MONDRIAN EARLY HALT\n");
+		__asm__ volatile("msr daifset, #0xf" ::: "memory");
+		for (;;) {
+			__asm__ volatile("wfi");
+		}
+	}
 }
 
