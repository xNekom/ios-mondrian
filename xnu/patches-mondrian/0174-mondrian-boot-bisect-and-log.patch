 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0xb8000000;
 #define EARLY_FB early_fb
@@ -99,15 +100,32 @@
 	}
 }
 
+static int mondrian_early_stop_stage = -1;
+
+/*
+ * Set once PE_init_platform() has installed PE_state.bootArgs: parsing a
+ * boot arg before that dereferences a NULL boot_args pointer and kills the
+ * kernel before the first line is on the screen.
