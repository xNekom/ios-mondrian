+
+/* The global clock controller and the branch that clocks the UFS host. */
+static vm_offset_t gcc_base;
+static uint32_t gcc_branch;
+
+static void
+ufs_enable_clock(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	uintptr_t const *prop = NULL;
+	unsigned int size = 0;
+	uint32_t branch = 0, value = 0;
 
+	if (SecureDTLookupEntry(NULL, "/mondrian-gcc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("MONDRIAN UFS: no /mondrian-gcc node in the device tree\n");
+		return;
+	}
+	if (SecureDTGetProperty(node, "ufs-branch", (void const **)&prop, &size) == kSuccess && size == 4) {
+		branch = *(uint32_t const *)prop;
+	}
+	gcc_base = ml_io_map(reg[0], 0x1000);
+	if (gcc_base == 0) {
+		printf("MONDRIAN UFS: cannot map the clock controller\n");
+		return;
+	}
+	gcc_branch = branch;
+	/*
+	 * The bootloader had the storage only while it needed it and left the
+	 * host's clock off: every register of the host reads as zero. The
+	 * branch's command register (the first one of the branch) enables it.
+	 */
+	value = *(volatile uint32_t *)(gcc_base + (branch * 0x100));
+	printf("MONDRIAN UFS: gcc %llx branch %u cmd %x\n", (uint64_t)gcc_base, branch, value);
+	*(volatile uint32_t *)(gcc_base + (branch * 0x100)) = 1;
+	value = *(volatile uint32_t *)(gcc_base + (branch * 0x100));
+	printf("MONDRIAN UFS: gcc branch %u cmd is now %x\n", branch, value);
+}
