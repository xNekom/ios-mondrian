+#if defined(ARM64_BOARD_CONFIG_MONDRIAN)
+/*
+ * Opt-in bring-up hook for HackiOS's containermanagerd workaround and
+ * backboardd display diagnostics. Only those two images get the library; its
+ * Objective-C hooks resolve classes and selectors dynamically rather than
+ * relying on shared-cache addresses from another build.
+ */
+static bool
+mondrian_ui_hook_env(struct image_params *imgp, char *env, size_t size)
+{
+	int enabled = 0;
+	const char *name;
+	const char library[] = "DYLD_INSERT_LIBRARIES=/usr/libexec/mondrian-ui-hook.dylib";
+
+	if (!PE_parse_boot_argn("mondrian_ui_hook", &enabled, sizeof(enabled)) || !enabled ||
+	    imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	if (name == NULL || sizeof(library) > size) {
+		return false;
+	}
+	if (!((imgp->ip_ndp->ni_cnd.cn_namelen == sizeof("containermanagerd") - 1 &&
+	    strncmp(name, "containermanagerd", sizeof("containermanagerd") - 1) == 0) ||
+	    (imgp->ip_ndp->ni_cnd.cn_namelen == sizeof("backboardd") - 1 &&
+	    strncmp(name, "backboardd", sizeof("backboardd") - 1) == 0))) {
+		return false;
+	}
+	strlcpy(env, library, size);
+	return true;
+}
+#endif
