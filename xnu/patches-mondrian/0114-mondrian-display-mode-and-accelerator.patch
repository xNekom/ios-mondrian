+/*
+ * The graphics accelerator. There is no GPU driver here, but CoreAnimation
+ * waits 30 s for a service of this class before it looks for a renderer at
+ * all, once per process. Without MetalPluginName and MetalPluginClassName
+ * both Metal and OpenGL ES pass it over, which leaves CoreAnimation's own
+ * software rasterizer as the renderer.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+static void
+mondrian_publish_accelerator(IOService *provider)
+{
+	IOAcceleratorES *accelerator = OSTypeAlloc(IOAcceleratorES);
+
+	if (accelerator != NULL && accelerator->init() && accelerator->attach(provider)) {
+		accelerator->setName("sgx");
+		accelerator->registerService();
+	}
+	OSSafeReleaseNULL(accelerator);
+}
+
+static void
+mondrian_set_number(OSDictionary *dict, const char *key, uint64_t value)
+{
+	OSNumber *number = OSNumber::withNumber(value, 32);
+
+	if (number != NULL) {
+		dict->setObject(key, number);
+		number->release();
+	}
+}
+
+/*
+ * The modes of the display, as CoreAnimation reads them (properties
+ * TimingElements and ColorElements; without a mode it draws nothing): one
+ * timing at the panel's size and MONDRIAN_FB_REFRESH_HZ, one 8-bit RGB colour
+ * mode. Their IDs are what GetBlock 0x40 answers with.
+ */
+static void
+mondrian_publish_modes(IOService *fb, uint32_t width, uint32_t height)
+{
+	OSDictionary *timing = OSDictionary::withCapacity(8);
+	OSDictionary *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4);
+	OSDictionary *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1);
+	OSArray *colors = OSArray::withCapacity(1);
+	const uint32_t rate = MONDRIAN_FB_REFRESH_HZ << 16;      /* 16.16 fixed point */
+
+	if (timing == NULL || horizontal == NULL || vertical == NULL || color == NULL ||
+	    timings == NULL || colors == NULL) {
+		goto done;
+	}
+	mondrian_set_number(color, "ID", MONDRIAN_FB_COLOR_ID);
+	mondrian_set_number(color, "PixelEncoding", 0);          /* RGB 4:4:4 */
+	mondrian_set_number(color, "Depth", 8);
+	mondrian_set_number(color, "Colorimetry", 1);
+	mondrian_set_number(color, "EOTF", 1);
+	mondrian_set_number(color, "DynamicRange", 0);
+	mondrian_set_number(color, "Score", 1);
+	color->setObject("IsVirtual", kOSBooleanFalse);
+	colors->setObject(color);
+
+	mondrian_set_number(horizontal, "Active", width);
+	mondrian_set_number(horizontal, "Total", width);
+	mondrian_set_number(horizontal, "SyncRate", rate);
+	mondrian_set_number(horizontal, "PreciseSyncRate", rate);
+	mondrian_set_number(vertical, "Active", height);
+	mondrian_set_number(vertical, "Total", height);
+	mondrian_set_number(vertical, "SyncRate", rate);
+	mondrian_set_number(vertical, "PreciseSyncRate", rate);
+	mondrian_set_number(timing, "ID", MONDRIAN_FB_TIMING_ID);
+	mondrian_set_number(timing, "Score", 1);
+	timing->setObject("IsVirtual", kOSBooleanFalse);
+	timing->setObject("IsOverscanned", kOSBooleanFalse);
+	timing->setObject("HorizontalAttributes", horizontal);
+	timing->setObject("VerticalAttributes", vertical);
+	timing->setObject("ColorModes", colors);
+	timings->setObject(timing);
+
+	fb->setProperty("TimingElements", timings);
+	fb->setProperty("ColorElements", colors);
+done:
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+}
+
