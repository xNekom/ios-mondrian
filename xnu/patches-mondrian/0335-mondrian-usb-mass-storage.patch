+/*
+ * The userdata partition as a SCSI medium, for the USB mass-storage interface
+ * (bsd/dev/mondrian_usb.c). The sectors are 512 bytes while the device works
+ * in 4 KiB blocks; the range is the GPT entry the mount came from, so a host
+ * can address exactly the volume that holds the iOS root and nothing outside
+ * it. One lock for the whole transfer, the same one the block device and the
+ * console ring take: a host read cannot interleave with a file system write.
+ */
+int
+mondrian_ufs_userdata_read(uint64_t sector, void *dst, uint32_t bytes)
+{
+	uint8_t *out = dst;
+	uint64_t byte = sector << 9;
+	uint64_t limit;
+	int error = 0;
+
+	if (!su.ready) {
+		return ENXIO;
+	}
+	limit = su.nblocks * UFS_BLOCK;
+	if (byte > limit || bytes > limit - byte) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&mondrian_ufs_lock);
+	while (bytes > 0) {
+		uint64_t block = su.first_block + byte / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(byte % UFS_BLOCK);
+		uint32_t len;
+
+		if (skip == 0 && bytes >= UFS_BLOCK) {
+			uint32_t count = MIN(bytes / UFS_BLOCK,
+			    BOUNCE_SIZE / UFS_BLOCK);
+
+			error = ufs_read_blocks(block, count);
+			if (error) {
+				break;
+			}
+			len = count * UFS_BLOCK;
+			memcpy(out, (const void *)(su.dma + DMA_BOUNCE), len);
+		} else {
+			error = ufs_read_blocks(block, 1);
+			if (error) {
+				break;
+			}
+			len = MIN(UFS_BLOCK - skip, bytes);
+			memcpy(out, (const void *)(su.dma + DMA_BOUNCE + skip),
+			    len);
+		}
+		out += len;
+		byte += len;
+		bytes -= len;
+	}
+	lck_mtx_unlock(&mondrian_ufs_lock);
+	return error;
+}
+
+/* That range in 512-byte SCSI sectors, 0 while the partition is not known. */
+uint64_t
+mondrian_ufs_userdata_sectors(void)
+{
+	return su.ready ? su.nblocks * (UFS_BLOCK / 512) : 0;
+}
