+/* ---- USB mass storage: the userdata partition, read-only ---- */
+
+/*
+ * Bulk-only transport (interface class 8, subclass 6, protocol 0x50) on a
+ * third interface, so the ECM function keeps the log and control channels.
+ * The host sends a 31-byte command block (CBW) on 0x02 OUT and reads data and
+ * a 13-byte status block (CSW) on 0x83 IN; the medium is the GPT partition the
+ * root was mounted from, read through the UFS driver's own block path
+ * (mondrian_ufs_userdata_read), so "512 bytes at an LBA" has one
+ * implementation. Nothing here writes.
+ *
+ * One command is in flight at a time and every path ends in a CSW, including
+ * the failures: a host that never sees one waits out its own timeout and then
+ * resets the port, which from the outside is the same as a hang.
+ */
+#define MSC_CBW_SIG		0x43425355u	/* "USBC" */
+#define MSC_CSW_SIG		0x53425355u	/* "USBS" */
+#define MSC_ASC_READ_ERROR	0x11
+#define MSC_ASC_INVALID_CMD	0x20
+#define MSC_ASC_OUT_OF_RANGE	0x21
+#define MSC_ASC_INVALID_FIELD	0x24
+#define MSC_ASC_WRITE_PROTECT	0x27
+#define MSC_ASC_MEDIUM_ABSENT	0x3a
+
+extern int mondrian_ufs_userdata_read(uint64_t sector, void *dst, uint32_t bytes);
+extern uint64_t mondrian_ufs_userdata_sectors(void);
+
+enum { MSC_WAIT_CBW, MSC_DATA_IN, MSC_DATA_OUT, MSC_CSW, MSC_RESET };
+
+static struct {
+	uint32_t tag;			/* dCBWTag, echoed in the CSW */
+	uint32_t data_len;		/* dCBWDataTransferLength */
+	uint32_t remaining;		/* still to start in this data phase */
+	uint32_t sent;			/* started so far: residue is data_len - sent */
+	uint32_t chunk;			/* this OUT discard's length */
+	uint64_t lba;			/* in 512-byte sectors */
+	uint8_t  cdb[16];
+	uint8_t  phase;
+	uint8_t  sense_key, sense_asc;
+	bool     streaming;		/* READ: the data comes from the UFS */
+	bool     out_armed;		/* a transfer is posted on EP_MSC_OUT */
+	uint32_t out_buf;		/* ... and it points here */
+	uint32_t commands;		/* rate limit for the log */
+} msc;
+
+/* Post the command block, unless one is already posted. */
+static void
+ud_msc_arm(void)
+{
+	static unsigned arms;
+
+	if (msc.out_armed) {
+		return;
+	}
+	msc.phase = MSC_WAIT_CBW;
+	msc.streaming = false;
+	msc.out_armed = true;
+	msc.out_buf = UD_MSC_CBW;
+	ud_start_trb(EP_MSC_OUT, UD_TRB_MSC_OUT, UD_MSC_CBW, 31, TRBCTL_NORMAL);
+	if (arms < 4) {
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_MSC_OUT);
+
+		arms++;
+		printf("MONDR USB: msc arm %u depcmd 0x%08x trb %08x %08x %08x %08x\n",
+		    arms, dwc_rd(DEPCMD(EP_MSC_OUT)), t[0], t[1], t[2], t[3]);
+	}
+}
+
+/*
+ * Bulk-only reset (also what a CLEAR_FEATURE on either bulk endpoint means):
+ * drop the command in flight. A transfer stays posted -- the controller owns
+ * it and there is no way to take it back from here -- so the completion of
+ * that transfer is what re-arms the command block. MSC_RESET is that state:
+ * whatever arrives is parsed as a command block, from the buffer the posted
+ * transfer points at, and not finished as the command the host abandoned.
+ */
+static void
+ud_msc_reset(void)
+{
+	msc.tag = 0;
+	msc.data_len = msc.remaining = msc.sent = msc.chunk = 0;
+	msc.streaming = false;
+	msc.sense_key = msc.sense_asc = 0;
+	msc.phase = MSC_RESET;
+}
+
+/*
+ * A fresh configuration (SET_CONFIGURATION, after a bus reset): the endpoints
+ * were just programmed, so nothing is posted any more and the command block
+ * has to be armed again -- 0298's lesson for the ECM endpoints.
+ */
+static void
+ud_msc_restart(void)
+{
+	ud_msc_reset();
+	msc.out_armed = false;
+	ud_msc_arm();
+}
+
+static void
+ud_msc_csw(uint8_t status)
+{
+	uint8_t *c = (uint8_t *)(ud.dma + UD_MSC_CSW);
+	uint32_t residue = msc.sent < msc.data_len ? msc.data_len - msc.sent : 0;
+
+	c[0] = (uint8_t)MSC_CSW_SIG;
+	c[1] = (uint8_t)(MSC_CSW_SIG >> 8);
+	c[2] = (uint8_t)(MSC_CSW_SIG >> 16);
+	c[3] = (uint8_t)(MSC_CSW_SIG >> 24);
+	c[4] = (uint8_t)msc.tag;
+	c[5] = (uint8_t)(msc.tag >> 8);
+	c[6] = (uint8_t)(msc.tag >> 16);
+	c[7] = (uint8_t)(msc.tag >> 24);
+	c[8] = (uint8_t)residue;
+	c[9] = (uint8_t)(residue >> 8);
+	c[10] = (uint8_t)(residue >> 16);
+	c[11] = (uint8_t)(residue >> 24);
+	c[12] = status;
+	msc.phase = MSC_CSW;
+	ud_start_trb(EP_MSC_IN, UD_TRB_MSC_IN, UD_MSC_CSW, 13, TRBCTL_NORMAL);
+}
+
+/* Remember why, for the REQUEST SENSE the host sends after a failure. */
+static void
+ud_msc_fail(uint8_t key, uint8_t asc)
+{
+	msc.sense_key = key;
+	msc.sense_asc = asc;
+	ud_msc_csw(1);
+}
+
+/* Finish a command whose response is in UD_MSC_DATA, or that has none. */
+static void
+ud_msc_send(uint32_t n)
+{
+	if (n > msc.data_len) {
+		n = msc.data_len;
+	}
+	msc.sent = n;
+	msc.remaining = 0;
+	if (n == 0) {
+		ud_msc_csw(0);
+		return;
+	}
+	msc.phase = MSC_DATA_IN;
+	ud_start_trb(EP_MSC_IN, UD_TRB_MSC_IN, UD_MSC_DATA, n, TRBCTL_NORMAL);
+}
+
+/*
+ * One chunk of a READ(10): the UFS fills the data buffer, then the endpoint
+ * carries it. 64 KiB is 32 sectors and 16 device blocks, half the UFS driver's
+ * bounce buffer, so one call is one READ(10) on the wire.
+ */
+static void
+ud_msc_chunk(void)
+{
+	uint32_t len = msc.remaining < UD_MSC_CHUNK ? msc.remaining : UD_MSC_CHUNK;
+
+	len &= ~511u;			/* whole sectors only */
+	if (len == 0) {
+		ud_msc_csw(0);
+		return;
+	}
+	if (mondrian_ufs_userdata_read(msc.lba, (void *)(ud.dma + UD_MSC_DATA), len)) {
+		ud_msc_fail(3, MSC_ASC_READ_ERROR);	/* MEDIUM ERROR */
+		return;
+	}
+	msc.lba += len >> 9;
+	msc.remaining -= len;
+	msc.sent += len;
+	msc.phase = MSC_DATA_IN;
+	ud_start_trb(EP_MSC_IN, UD_TRB_MSC_IN, UD_MSC_DATA, len, TRBCTL_NORMAL);
+}
+
+/* WRITE(10): the data phase has to be consumed, or the host's OUT transfer
+ * never completes; the CSW then reports the medium write-protected. */
+static void
+ud_msc_discard(void)
+{
+	msc.chunk = msc.remaining < UD_MSC_CHUNK ? msc.remaining : UD_MSC_CHUNK;
+	if (msc.chunk == 0) {
+		ud_msc_csw(1);
+		return;
+	}
+	msc.phase = MSC_DATA_OUT;
+	msc.out_armed = true;
+	msc.out_buf = UD_MSC_DATA;
+	ud_start_trb(EP_MSC_OUT, UD_TRB_MSC_OUT, UD_MSC_DATA, msc.chunk, TRBCTL_NORMAL);
+}
+
+/*
+ * The commands answered without the medium. INQUIRY included: it reads no
+ * block, so it answers even while the UFS probe still holds the lock and a
+ * host is waiting on its first command.
+ */
+static void
+ud_msc_response(void)
+{
+	uint8_t *d = (uint8_t *)(ud.dma + UD_MSC_DATA);
+	uint8_t *cdb = msc.cdb;
+	uint32_t n = 0;
+
+	switch (cdb[0]) {
+	case 0x00:			/* TEST UNIT READY */
+		if (mondrian_ufs_userdata_sectors() == 0) {
+			ud_msc_fail(2, MSC_ASC_MEDIUM_ABSENT);	/* NOT READY */
+			return;
+		}
+		break;
+	case 0x03:			/* REQUEST SENSE: the last failure, once */
+		memset(d, 0, 18);
+		d[0] = 0x70;
+		d[2] = msc.sense_key;
+		d[7] = 10;
+		d[12] = msc.sense_asc;
+		msc.sense_key = msc.sense_asc = 0;
+		n = 18;
+		break;
+	case 0x12:			/* INQUIRY */
+		if (cdb[1] & 1) {	/* EVPD: the supported pages */
+			if (cdb[2] != 0) {
+				ud_msc_fail(5, MSC_ASC_INVALID_FIELD);
+				return;
+			}
+			memset(d, 0, 6);
+			d[3] = 1;	/* one page follows */
+			d[4] = 0x00;	/* page 0x00: the list itself */
+			n = 6;
+			break;
+		}
+		memset(d, 0, 36);
+		d[0] = 0x00;		/* direct access block device */
+		d[2] = 0x05;		/* SPC-3 */
+		d[3] = 0x02;		/* response data format */
+		d[4] = 31;		/* the rest of the 36 bytes */
+		memcpy(d + 8, "MONDRIAN", 8);			/* vendor */
+		memcpy(d + 16, "iOS userdata    ", 16);		/* product */
+		memcpy(d + 32, "1.0 ", 4);			/* revision */
+		n = 36;
+		break;
+	case 0x1a:			/* MODE SENSE(6): write protected, no pages */
+		memset(d, 0, 4);
+		d[0] = 3;
+		d[2] = 0x80;		/* WP: the host marks the disk read-only */
+		n = 4;
+		break;
+	case 0x5a:			/* MODE SENSE(10) */
+		memset(d, 0, 8);
+		d[1] = 6;
+		d[3] = 0x80;
+		n = 8;
+		break;
+	case 0x25: {			/* READ CAPACITY(10) */
+		uint64_t sectors = mondrian_ufs_userdata_sectors();
+		uint64_t last;
+
+		if (sectors == 0) {
+			ud_msc_fail(2, MSC_ASC_MEDIUM_ABSENT);
+			return;
+		}
+		last = sectors - 1;
+		if (last > 0xffffffffu) {
+			last = 0xffffffffu;	/* past READ(10)'s reach */
+		}
+		memset(d, 0, 8);
+		d[0] = (uint8_t)(last >> 24);
+		d[1] = (uint8_t)(last >> 16);
+		d[2] = (uint8_t)(last >> 8);
+		d[3] = (uint8_t)last;
+		d[6] = 2;		/* 512-byte blocks: 0x00000200 */
+		n = 8;
+		break;
+	}
+	case 0xa0:			/* REPORT LUNS: LUN 0 */
+		memset(d, 0, 16);
+		d[3] = 8;		/* one 8-byte LUN */
+		n = 16;
+		break;
+	case 0x1b:			/* START STOP UNIT */
+	case 0x1e:			/* PREVENT ALLOW MEDIUM REMOVAL */
+	case 0x2f:			/* VERIFY(10) */
+	case 0x35:			/* SYNCHRONIZE CACHE(10) */
+		break;			/* nothing to do, no data */
+	default:
+		ud_msc_fail(5, MSC_ASC_INVALID_CMD);
+		return;
+	}
+	ud_msc_send(n);
+}
+
+static void
+ud_msc_command(void)
+{
+	uint8_t *cdb = msc.cdb;
+
+	msc.streaming = false;
+	switch (cdb[0]) {
+	case 0x28: {			/* READ(10) */
+		uint64_t lba = ((uint64_t)cdb[2] << 24) | ((uint64_t)cdb[3] << 16) |
+		    ((uint64_t)cdb[4] << 8) | cdb[5];
+		uint64_t count = ((uint64_t)cdb[7] << 8) | cdb[8];
+		uint64_t bytes = count * 512;
+		uint64_t sectors = mondrian_ufs_userdata_sectors();
+
+		if (count == 0) {
+			ud_msc_csw(0);		/* no data phase */
+			return;
+		}
+		if (sectors == 0) {
+			ud_msc_fail(2, MSC_ASC_MEDIUM_ABSENT);
+			return;
+		}
+		if (lba >= sectors || count > sectors - lba) {
+			ud_msc_fail(5, MSC_ASC_OUT_OF_RANGE);
+			return;
+		}
+		/*
+		 * The data phase is the host's length, and it has to be whole
+		 * sectors no longer than the CDB asks for: a transfer that ends
+		 * on a full packet with bytes still owed would leave the host
+		 * waiting for a short packet that is not coming.
+		 */
+		if ((msc.data_len & 511) || msc.data_len > bytes) {
+			ud_msc_fail(5, MSC_ASC_INVALID_FIELD);
+			return;
+		}
+		if (msc.data_len == 0) {
+			ud_msc_csw(0);
+			return;
+		}
+		msc.lba = lba;
+		msc.remaining = msc.data_len;
+		msc.streaming = true;
+		ud_msc_chunk();
+		return;
+	}
+	case 0x2a:			/* WRITE(10), read-only medium */
+		msc.sense_key = 7;	/* DATA PROTECT */
+		msc.sense_asc = MSC_ASC_WRITE_PROTECT;
+		if (msc.data_len != 0) {
+			ud_msc_discard();
+		} else {
+			msc.remaining = 0;
+			ud_msc_csw(1);
+		}
+		return;
+	default:
+		ud_msc_response();
+		return;
+	}
+}
+
+/* The 31-byte command block, or the tail of a discarded data phase. */
+static void
+ud_msc_out_done(void)
+{
+	uint8_t *c;
+	uint32_t sig, tag, len;
+	uint8_t cblen;
+
+	msc.out_armed = false;
+	if (msc.phase == MSC_DATA_OUT) {
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_MSC_OUT);
+		uint32_t moved;
+
+		ud_sync(UD_TRB_MSC_OUT, 16);
+		moved = msc.chunk - (t[2] & 0xffffff);
+		msc.sent += moved;
+		if (moved >= msc.remaining) {
+			msc.remaining = 0;
+			ud_msc_csw(1);		/* the sense data has the reason */
+		} else {
+			msc.remaining -= moved;
+			ud_msc_discard();
+		}
+		return;
+	}
+
+	/*
+	 * A command block: normally in UD_MSC_CBW, but after a reset it is
+	 * whatever the transfer that was still posted was pointed at.
+	 */
+	ud_sync(msc.out_buf, 64);
+	c = (uint8_t *)(ud.dma + msc.out_buf);
+	sig = (uint32_t)c[0] | ((uint32_t)c[1] << 8) | ((uint32_t)c[2] << 16) |
+	    ((uint32_t)c[3] << 24);
+	if (sig != MSC_CBW_SIG) {
+		/*
+		 * Not a command block. There is no tag to answer, so drop it and
+		 * wait for the next one; the host's timeout is the recovery.
+		 */
+		printf("MONDR USB: msc bad cbw %02x %02x %02x %02x\n",
+		    c[0], c[1], c[2], c[3]);
+		ud_msc_arm();
+		return;
+	}
+	tag = (uint32_t)c[4] | ((uint32_t)c[5] << 8) | ((uint32_t)c[6] << 16) |
+	    ((uint32_t)c[7] << 24);
+	len = (uint32_t)c[8] | ((uint32_t)c[9] << 8) | ((uint32_t)c[10] << 16) |
+	    ((uint32_t)c[11] << 24);
+	cblen = c[14];
+	msc.tag = tag;
+	msc.data_len = len;
+	msc.remaining = len;
+	msc.sent = 0;
+	msc.commands++;
+	if (msc.commands <= 4 || (msc.commands & 0xff) == 0) {
+		printf("MONDR USB: msc cbw #%u tag %08x len %u flags %02x cdb %02x %02x %02x\n",
+		    msc.commands, tag, len, c[12], c[15], c[16], c[17]);
+	}
+	if (cblen < 1 || cblen > 16) {
+		ud_msc_fail(5, MSC_ASC_INVALID_FIELD);
+		return;
+	}
+	memcpy(msc.cdb, c + 15, 16);
+	ud_msc_command();
+}
+
+/* An IN transfer finished: the next chunk, the CSW, or the command block. */
+static void
+ud_msc_in_done(void)
+{
+	if (msc.phase == MSC_RESET) {
+		ud_msc_arm();		/* the reset dropped that transfer */
+		return;
+	}
+	if (msc.phase == MSC_CSW) {
+		ud_msc_arm();
+		return;
+	}
+	if (msc.phase == MSC_DATA_IN) {
+		if (msc.streaming && msc.remaining > 0) {
+			ud_msc_chunk();
+			return;
+		}
+		ud_msc_csw(0);
+	}
+}
+
+/*
+ * The two endpoints. The FIFO number is the one mainline gives an IN endpoint
+ * (physical 7 -> FIFO 3, dep->number >> 1); two IN endpoints that name the
+ * same FIFO are not a supported configuration.
+ */
+
+static bool
+ud_msc_ep_setup(void)
+{
+	int a, b, c, d;
+	uint32_t hw3 = dwc_rd(0xc14c);
+	uint32_t r1, r2, r3, r4, s2, s4, s7;
+
+	/*
+	 * A SETEPCONFIG that "succeeds" on an endpoint the core does not have
+	 * leaves DALEPENA set and the host waiting forever on its first
+	 * INQUIRY, so print what the core advertises before touching it.
+	 */
+	printf("MONDR USB: msc hwparams3 0x%08x num_eps %u num_in_eps %u\n",
+	    hw3, (hw3 >> 12) & 0x3f, (hw3 >> 18) & 0x1f);
+	/*
+	 * Every command is kept: a SETEPCONFIG that "succeeds" but leaves the
+	 * endpoint unusable is the difference between a host that sees a disk
+	 * and one that times out on its first INQUIRY.
+	 */
+	a = ud_epcmd(EP_MSC_OUT, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3),
+	    (1u << 8) | ((uint32_t)EP_MSC_OUT << 25), 0);
+	r1 = dwc_rd(DEPCMD(EP_MSC_OUT));
+	b = ud_epcmd(EP_MSC_OUT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+	r2 = dwc_rd(DEPCMD(EP_MSC_OUT));
+	c = ud_epcmd(EP_MSC_IN, DEPCMD_SETEPCONFIG,
+	    (2u << 1) | (512u << 3) | (3u << 17),
+	    (1u << 8) | ((uint32_t)EP_MSC_IN << 25), 0);
+	r3 = dwc_rd(DEPCMD(EP_MSC_IN));
+	d = ud_epcmd(EP_MSC_IN, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0);
+	r4 = dwc_rd(DEPCMD(EP_MSC_IN));
+	printf("MONDR USB: msc epcmd %d %d %d %d dalepena 0x%08x\n",
+	    a, b, c, d, dwc_rd(DALEPENA));
+	printf("MONDR USB: msc epcmd raw out 0x%08x 0x%08x in 0x%08x 0x%08x\n",
+	    r1, r2, r3, r4);
+	if (a || b || c || d) {
+		return false;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_MSC_OUT) | (1u << EP_MSC_IN));
+	printf("MONDR USB: msc dalepena now 0x%08x\n", dwc_rd(DALEPENA));
+	/*
+	 * GETEPSTATE (3) returns the endpoint state in the command status:
+	 * 0 disabled, 1 enabled, 2 stalled, 3 setup, 4 in progress. EP_RX is
+	 * the control: it carries the working network and must read enabled.
+	 */
+	dwc_wr(DEPCMD(EP_RX), 3 | DEPCMD_CMDACT);
+	s2 = dwc_rd(DEPCMD(EP_RX));
+	dwc_wr(DEPCMD(EP_MSC_OUT), 3 | DEPCMD_CMDACT);
+	s4 = dwc_rd(DEPCMD(EP_MSC_OUT));
+	dwc_wr(DEPCMD(EP_MSC_IN), 3 | DEPCMD_CMDACT);
+	s7 = dwc_rd(DEPCMD(EP_MSC_IN));
+	printf("MONDR USB: msc epstate 2/4/7 0x%08x 0x%08x 0x%08x\n", s2, s4, s7);
+	return true;
+}
+
+/*
+ * Whether the storage function can work at all, decided before the host reads
+ * the configuration descriptor. Two things can be missing there: the endpoint
+ * pair itself (the core's NUM_EPS), and the IN endpoint's TX FIFO. GTXFIFOSIZ
+ * holds what the bootloader sized for fastboot, and FIFO 3 is usually not in
+ * it; an IN endpoint without a FIFO accepts the transfer and never puts a
+ * packet on the wire, which a host experiences as its first INQUIRY never
+ * returning. Take the depth the ECM bulk IN (FIFO 1) already carries 512-byte
+ * packets with, and append it after the last allocated FIFO.
+ */
+static bool
+ud_msc_probe(void)
+{
+	uint32_t hw3 = dwc_rd(DWC3_GHWPARAMS3);
+	uint32_t hw7 = dwc_rd(DWC3_GHWPARAMS7);
+	uint32_t eps = (hw3 >> 12) & 0x3f;
+	uint32_t ram = hw7 & 0xffff;
+	uint32_t depth, last = 0;
+	int n;
+
+	for (n = 0; n < 4; n++) {
+		uint32_t r = dwc_rd(0xc380 + 4 * (uint32_t)n);
+
+		printf("MONDR USB: RXFIFO%u 0x%08x depth %u\n", n, r, r & 0x7fff);
+	}
+	/*
+	 * This controller keeps one RX FIFO per OUT endpoint and the
+	 * bootloader only sizes the ones it uses: FIFO 0 and 1 came up with
+	 * 787 entries each, FIFO 2 (the storage OUT endpoint) with none. An
+	 * OUT endpoint whose FIFO has depth 0 takes DEPCFG and then NAKs every
+	 * packet, which a host sees as a bulk-out endpoint that never accepts
+	 * the command block. The start address in the upper half is what the
+	 * bootloader reserved for it; keep it.
+	 */
+	{
+		uint32_t fifo = (uint32_t)EP_MSC_OUT >> 1;
+		uint32_t reg = 0xc380 + 4 * fifo;
+		uint32_t r = dwc_rd(reg);
+		uint32_t start = (r >> 16) & 0xffff;
+		uint32_t depth = 400;   /* 400 x 8 bytes: three 512-byte packets */
+		int f;
+
+		if (start == 0) {
+			for (f = 0; f < (int)fifo; f++) {
+				uint32_t o = dwc_rd(0xc380 + 4 * (uint32_t)f);
+				uint32_t e = ((o >> 16) & 0xffff) + (o & 0xffff);
+
+				if (e > start) {
+					start = e;
+				}
+			}
+		}
+		dwc_wr(reg, (start << 16) | depth);
+		printf("MONDR USB: RXFIFO%u was 0x%08x, now 0x%08x\n",
+		    fifo, r, dwc_rd(reg));
+	}
+	if (eps < 8) {
+		printf("MONDR USB: msc: %u endpoints, the storage pair is 6/7\n", eps);
+		return false;
+	}
+	if ((dwc_rd(DWC3_GTXFIFOSIZ(3)) & 0xffff) != 0) {
+		return true;		/* the bootloader sized it */
+	}
+	depth = dwc_rd(DWC3_GTXFIFOSIZ(1)) & 0xffff;
+	if (depth < 130) {
+		depth = 260;		/* two 512-byte packets plus margin */
+	}
+	if (ram == 0 || last > ram || depth > ram - last) {
+		printf("MONDR USB: msc: no TX FIFO room (last %u depth %u ram %u)\n",
+		    last, depth, ram);
+		return false;
+	}
+	dwc_wr(DWC3_GTXFIFOSIZ(3), (last << 16) | depth);
+	printf("MONDR USB: msc: TXFIFO3 start %u depth %u of %u\n", last, depth, ram);
+	return true;
+}
