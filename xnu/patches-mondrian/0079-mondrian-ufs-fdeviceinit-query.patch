+/* NOP OUT/IN verifies the UTP layer before the device-management queries. */
+static int
+ufs_nop_out(void)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x00;                  /* NOP OUT UPIU */
+	ucd->cmd[3] = ++su.tag;
+	utrd->dw0 = (1u << 28);             /* UFS command, no data */
+	utrd->dw2 = 0x0f;
+	utrd->task_tag = ucd->cmd[3];
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	printf("MONDRIAN UFS: NOP OUT sent\n");
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			UFS_WHY("NOP OUT timeout");
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x20) {
+		printf("MONDRIAN UFS: NOP IN failed ocs 0x%x upiu 0x%x\n", ocs, ucd->resp[0]);
+		UFS_WHY("NOP OUT: ocs %x upiu %x", ocs, ucd->resp[0]);
+		return EIO;
+	}
+	printf("MONDRIAN UFS: NOP IN received\n");
+	return 0;
+}
+
+/* UFS device-management QUERY FLAG, used for fDeviceInit before SCSI I/O. */
+static int
+ufs_query_flag(uint8_t opcode, bool *value)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	uint8_t function;
+
+	if (opcode == 0x06) {                 /* SET FLAG */
+		function = 0x81;                 /* standard write request */
+	} else if (opcode == 0x05 && value != NULL) { /* READ FLAG */
+		function = 0x01;                 /* standard read request */
+	} else {
+		return EINVAL;
+	}
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x16;                 /* QUERY REQUEST UPIU */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = function;
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = 0x01;                /* QUERY_FLAG_IDN_FDEVICEINIT */
+	utrd->dw0 = (1u << 28);             /* UFS command, no data */
+	utrd->dw2 = 0x0f;
+	utrd->task_tag = ucd->cmd[3];
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	printf("MONDRIAN UFS: query opcode 0x%x fDeviceInit sent\n", opcode);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			UFS_WHY("query fDeviceInit timeout");
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x36 || ucd->resp[6] != 0) {
+		printf("MONDRIAN UFS: query failed ocs 0x%x upiu 0x%x response 0x%x result 0x%x\n",
+		    ocs, ucd->resp[0], ucd->resp[6], ucd->resp[19]);
+		UFS_WHY("query fDeviceInit: ocs %x upiu %x response %x result %x",
+		    ocs, ucd->resp[0], ucd->resp[6], ucd->resp[19]);
 		return EIO;
 	}
+	if (value != NULL) {
+		*value = (ucd->resp[23] & 1) != 0;
+		printf("MONDRIAN UFS: fDeviceInit is %u\n", *value);
+	}
 	return 0;
 }
 
