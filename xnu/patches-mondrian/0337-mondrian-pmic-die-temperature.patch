+/*
+ * A PMIC's own thermometer lives on channel 3 of its own SID (the tree packs
+ * the SID in the high byte of reg: pm8350b_vbat_sns is <3 0x8f>). Mainline's
+ * qcom_vadc_scale_die_temp() divides the voltage by two to get kelvin, with
+ * 0.6 V at 300 K, so mC = mV * 500 - 273150.
+ *
+ * The voltage is returned instead of the temperature because one of the five
+ * PMICs answers a value that is not one: see tools/usb-ring.py temp.
+ */
+int
+mondrian_spmi_die_mv(uint32_t sid)
+{
+	return mondrian_spmi_adc_mv(sid, 0x03u, 1u);
+}
