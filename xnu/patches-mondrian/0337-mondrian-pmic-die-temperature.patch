+/*
+ * "temp" prints the die temperature of every PMIC that answers one, in
+ * degrees and with the voltage behind it so a reader can check the scale.
+ *
+ * SID 1 (pm8350), 3 (pm8350b) and 4 (pmr735a) are temperatures. SID 0, the
+ * pmk8350 that owns the ADC, moves with them (794->772 mV as the phone
+ * cooled, the same 22 mV the others lost) but sits about 155 mV high: 113 C
+ * on a phone the vendor kernel puts at 34. Channel 3 is its die_temp (a sweep
+ * of all sixteen channels has 1.2 V and 1.9 V references and ~40 mV floating
+ * pins, and 3 the only mid-scale one), so this is the ADC's own-die path
+ * reading differently, not a wrong channel. Reported raw, never as a degree.
+ */
+static void
+ud_cmd_temp(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_spmi_die_mv(uint32_t sid);
+	static const uint32_t sids[] = { 1, 3, 4, 0 };
+	char out[192];
+	size_t len = 0;
+
+	(void)line;
+	for (size_t i = 0; i < sizeof(sids) / sizeof(sids[0]); i++) {
+		int mv = mondrian_spmi_die_mv(sids[i]);
+		int mc = mv * 500 - 273150;
+		int n;
+
+		if (mv < 1) {
+			n = snprintf(out + len, sizeof(out) - len,
+			    "temp sid %u no answer\n", sids[i]);
+		} else if (sids[i] == 0) {
+			n = snprintf(out + len, sizeof(out) - len,
+			    "temp sid 0 %d mV: tracks, not a temperature\n",
+			    mv);
+		} else {
+			n = snprintf(out + len, sizeof(out) - len,
+			    "temp sid %u %d mV %d.%d C\n", sids[i], mv,
+			    mc / 1000, (mc % 1000) / 100);
+		}
+		if (n < 0 || (size_t)n >= sizeof(out) - len) {
+			break;
+		}
+		len += (size_t)n;
+	}
+	ud_cmd_send(so, to, out, len);
+	printf("%s", out);
+}
