 }
 
+/*
+ * The PMIC's own thermometer: VADC channel 6 on SID 0 (pmk8350) is the die
+ * temperature, and mainline's qcom_vadc_scale_die_temp() divides the voltage
+ * by two to get kelvin (0.6 V at 300 K, 2 mV/K). Returns millidegrees
+ * Celsius, or -1.
+ *
+ * This is the first channel of the thermal work and the cheapest one to
+ * trust: it goes through the VADC path the battery already uses, it needs no
+ * calibration table from the device tree, and it says whether the PMIC is
+ * the thing that gets hot under load. The SoC's TSENS block is a separate
+ * driver with its own calibration.
+ */
+int
+mondrian_spmi_temp_mc(void)
+{
+	int mv = mondrian_spmi_adc_mv(0, 0x06u, 1u);
+
+	if (mv < 1) {
+		return -1;
+	}
+	return mv * 500 - 273150;
+}
