diff --git a/bsd/dev/mondrian_usb.c b/bsd/dev/mondrian_usb.c
--- a/bsd/dev/mondrian_usb.c
+++ b/bsd/dev/mondrian_usb.c
@@ -1969,6 +1969,28 @@
 	ud_cmd_send(so, to, "gpustat\n", 8);
 }
 
+/*
+ * "temp" prints the PMIC die temperature in millidegrees, read on demand so a
+ * thermal measurement costs no rebuild and no second process.
+ */
+static void
+ud_cmd_temp(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_spmi_temp_mc(void);
+	int mc = mondrian_spmi_temp_mc();
+	char out[48];
+	int n;
+
+	(void)line;
+	if (mc < 0) {
+		n = snprintf(out, sizeof(out), "temp no answer\n");
+	} else {
+		n = snprintf(out, sizeof(out), "temp %d mC\n", mc);
+	}
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
