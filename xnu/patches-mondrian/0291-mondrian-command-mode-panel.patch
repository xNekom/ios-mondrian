xnu 0291: start the command-mode panel's CTL on every frame

The bootloader's own command line names the panel a command-mode one
(`mdss_dsi_m11a_42_02_0a_dsc_cmd`): the controller fetches one frame when its
CTL starts and holds it until the next start, so writing pixels is not enough
and the panel changed only when something else started a frame. The driver now
starts the active CTL per tick from MONDRIAN tick second `mondrianfb_kick`
on, and reads INTF_FRAME_COUNT to say what the interface really sent.

The same file carries the host's window into the panel: the display memory is
sampled one half-scale RGB565 row at a time for the USB control channel, so a
glitch is looked at instead of described.

diff --git a/iokit/Kernel/arm/MondrianFramebuffer.cpp b/iokit/Kernel/arm/MondrianFramebuffer.cpp
--- a/iokit/Kernel/arm/MondrianFramebuffer.cpp
+++ b/iokit/Kernel/arm/MondrianFramebuffer.cpp
@@ -48,6 +48,80 @@
 #include <kern/clock.h>
 #include <sys/proc.h>
 
+/*
+ * The panel is a command-mode panel: the bootloader's own command line names
+ * it `msm_drm.dsi_display0=qcom,mdss_dsi_m11a_42_02_0a_dsc_cmd`, and on this
+ * board `qcom,sde-ctl-off` puts CTL0 at 0x16000 and `qcom,sde-intf-off` puts
+ * INTF0 at 0x35000 in the MDP window at 0xae00000. A command-mode controller
+ * does not scan the framebuffer the way a video-mode one does: it fetches one
+ * frame when its CTL is started and holds that frame until the next start.
+ * Writing pixels is therefore not enough, and without a start per frame the
+ * panel changes only when something else starts one, which is the once-a-
+ * second refresh a hand sees. `mondrianfb_kick=N` starts the active CTL on
+ * every tick from second N on, and INTF_FRAME_COUNT (0x0AC, the register the
+ * vendor's `sde_hw_intf.c` reads) says what the interface really sent.
+ */
+#define MONDRIAN_MDP_PHYS        0xae00000ULL
+#define MONDRIAN_MDP_SIZE        0x40000
+#define MONDRIAN_DSI_PHYS        0xae94000ULL
+#define MONDRIAN_DSI_SIZE        0x4000
+#define MONDRIAN_CTL_OFF         0x16000
+#define MONDRIAN_CTL_STRIDE      0x1000
+#define MONDRIAN_CTL_N           6
+#define MONDRIAN_CTL_TOP         0x000
+#define MONDRIAN_CTL_FLUSH       0x018
+#define MONDRIAN_CTL_START       0x01C
+#define MONDRIAN_CTL_RESET       0x030
+#define MONDRIAN_CTL_INTF_ACTIVE 0x0F4
+#define MONDRIAN_INTF_OFF        0x35000
+#define MONDRIAN_INTF_STRIDE     0x1000
+#define MONDRIAN_INTF_N          4
+#define MONDRIAN_INTF_TIMING_EN  0x000
+#define MONDRIAN_INTF_CONFIG     0x004
+#define MONDRIAN_INTF_MDP_FRAME_COUNT 0x0A4
+#define MONDRIAN_INTF_FRAME_COUNT 0x0AC
+#define MONDRIAN_INTF_LINE_COUNT 0x0B0
+#define MONDRIAN_INTF_CMD_TRIGGER_EN 0x084
+#define MONDRIAN_INTF_PROG_FETCH  0x170
+#define MONDRIAN_INTF_STATUS      0x26C
+#define MONDRIAN_INTF_UNDERRUN    0x268
+#define MONDRIAN_INTF_TEAR_CHECK_EN 0x284
+#define MONDRIAN_INTF_TEAR_SYNC   0x288
+#define MONDRIAN_INTF_TEAR_RD_PTR 0x2A4
+#define MONDRIAN_INTF_TEAR_LINE   0x2B0
+#define MONDRIAN_INTF_AUTOREFRESH 0x2B4
+#define MONDRIAN_INTF_AUTOREFRESH_STATUS 0x2C0
+#define MONDRIAN_DSI1_OFF        0x2000   /* ctrl1 inside the DSI window */
+/* The pipes whose source address says what the DPU really fetches. */
+#define MONDRIAN_SSPP_N          8
+#define MONDRIAN_SSPP_SRC0       0x14
+#define MONDRIAN_SSPP_STRIDE     0x24
+#define MONDRIAN_SSPP_FORMAT     0x30
+/*
+ * `mondrianfb_test=1` paints a magenta band in the panel memory that moves
+ * one band-height down per tick. It runs in the kernel, so it separates the
+ * two halves of a slow screen: a band that glides answers that the display
+ * shows what this memory holds, and a band that jumps once a second answers
+ * that it does not.
+ */
+#define MONDRIAN_TEST_H          16
+#define MONDRIAN_TEST_COLOR      0xFFFF00FFu
+
+/* osfmk/arm/machine_routines.h, C linkage: this file is C++. */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static inline uint32_t
+mondrian_mdp_rd(volatile uint32_t *base, uint32_t off)
+{
+	return base[off / 4];
+}
+
+static inline void
+mondrian_mdp_wr(volatile uint32_t *base, uint32_t off, uint32_t value)
+{
+	base[off / 4] = value;
+}
