+/*
+ * One row of the panel at half scale in RGB565, for the host. The panel is
+ * BGRA in memory (MONDRIAN_FB_FORMAT_BGRA), so byte 0 is blue. Half scale is
+ * 720 pixels, 1440 bytes: one datagram with the header.
+ */
+extern "C" uint32_t
+mondrian_fb_capture_row(uint32_t y, uint8_t *dst, uint32_t dstLen)
+{
+	AppleCLCD *fb = gMondrianFB;
+	uint32_t half, i;
+
+	if (fb == NULL || fb->fPixels == 0 || fb->fRowBytes == 0 ||
+	    (y >= fb->fHeight) || (fb->fWidth < 2)) {
+		return 0;
+	}
+	half = fb->fWidth / 2;
+	if (dstLen < half * 2) {
+		return 0;
+	}
+	const uint32_t *src = (const uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+	uint16_t *out = (uint16_t *)dst;
+
+	for (i = 0; i < half; i++) {
+		uint32_t p = src[i * 2];
+		uint32_t b = (p >> 3) & 0x1f;
+		uint32_t g = (p >> 10) & 0x3f;
+		uint32_t r = (p >> 19) & 0x1f;
+
+		out[i] = (uint16_t)((r << 11) | (g << 5) | b);
+	}
+	return half * 2;
+}
+
+extern "C" uint32_t
+mondrian_fb_capture_rows(void)
+{
+	AppleCLCD *fb = gMondrianFB;
+
+	return (fb != NULL && fb->fPixels != 0) ? fb->fHeight : 0;
+}
+
+extern "C" uint32_t
+mondrian_fb_capture_width(void)
+{
+	AppleCLCD *fb = gMondrianFB;
+
+	return (fb != NULL && fb->fPixels != 0) ? fb->fWidth / 2 : 0;
+}
