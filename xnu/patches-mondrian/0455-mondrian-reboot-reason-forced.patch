index 46ea7a0..bbb731b 100644
--- a/bsd/dev/mondrian_usb.c
+++ b/bsd/dev/mondrian_usb.c
@@ -2899,6 +2899,11 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 
 				printf("MONDR USB: reboot requested by the host\n");
 				mondrian_reboot_to_fastboot();
+			} else if (strncmp(cmd, "bcb ", 4) == 0) {
+				extern int mondrian_ufs_bcb_set(const char *);
+
+				printf("MONDR USB: bcb \"%s\" seen\n", cmd + 4);
+				(void)mondrian_ufs_bcb_set(cmd + 4);
 			} else if (strcmp(cmd, "hardreset") == 0) {
 				extern void mondrian_hard_reset(void);
 
