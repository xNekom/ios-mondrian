xnu 0097: start the persistent console log after root mount

The first log-reader boots found no MONDLOG header even though userdata was
writable. Start the writer only after BSD has mounted and installed the root
vnode, flush immediately instead of sleeping first, and verify the initial
header by reading it back after SYNCHRONIZE CACHE. This distinguishes a thread
startup problem from a UFS write or cache-flush failure before launchd starts.

diff --git a/bsd/dev/mondrian_ufs.c b/bsd/dev/mondrian_ufs.c
--- a/bsd/dev/mondrian_ufs.c
+++ b/bsd/dev/mondrian_ufs.c
@@ -49,5 +49,5 @@
 extern void pe_mondrian_gic_dump(void);
 extern void mondrian_irq_dump(void);
 extern int hz;
-static void mondrian_log_start(void);
+void mondrian_log_start(void);
 static void mondrian_log_dump(uint32_t lines);
@@ -1088,7 +1088,6 @@
 			mondrian_log_dump(dump);        /* does not return */
 		}
 	}
-	mondrian_log_start();
 	mondrian_sample_start();
 	return 0;
 }
@@ -1163,6 +1162,7 @@
 	uint64_t base = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	bool first_flush = true, verified = false;
 
 	printf("MONDRIAN LOG: console ring in the last %u KiB of the partition (block 0x%llx)\n",
 	    MONDRIAN_LOG_BLOCKS * UFS_BLOCK >> 10, base);
@@ -1170,11 +1170,18 @@
 		uint64_t total, pos;
 		int error = 0;
 
-		(void)tsleep(&mondrian_log_chan, PZERO, "mondrianlog", MONDRIAN_LOG_TICKS * hz);
+		if (!first_flush) {
+			(void)tsleep(&mondrian_log_chan, PZERO, "mondrianlog", MONDRIAN_LOG_TICKS * hz);
+		}
+		first_flush = false;
 		total = os_atomic_load(&mondrian_log_total, relaxed);
 		if (total == flushed) {
 			continue;
 		}
+		struct mondrian_log_header h = {
+			.magic = { 'M', 'O', 'N', 'D', 'L', 'O', 'G' },
+			.version = 1, .size = MONDRIAN_LOG_SIZE, .total = total, .seq = ++seq
+		};
 		/*
 		 * Write whole device blocks, from the first block that holds
 		 * unflushed data: a partial block would lose the bytes that
@@ -1194,11 +1201,6 @@
 			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
 		}
 		if (!error) {
-			struct mondrian_log_header h = {
-				.magic = { 'M', 'O', 'N', 'D', 'L', 'O', 'G' },
-				.version = 1, .size = MONDRIAN_LOG_SIZE, .total = total, .seq = ++seq
-			};
-
 			bzero(bounce, UFS_BLOCK);
 			memcpy(bounce, &h, sizeof(h));
 			error = ufs_write_blocks(base, 1);
@@ -1206,9 +1208,21 @@
 		if (!error) {
 			error = ufs_flush();
 		}
+		if (!error && !verified) {
+			error = ufs_read_blocks(base, 1);
+			if (!error && memcmp(bounce, &h, sizeof(h)) != 0) {
+				error = EIO;
+			}
+			if (!error) {
+				verified = true;
+				printf("MONDRIAN LOG: initial header verified (total %llu, seq %llu)\n",
+				    total, h.seq);
+			}
+		}
 		lck_mtx_unlock(&mondrian_ufs_lock);
 		if (error) {
-			printf("MONDRIAN LOG: write failed (%d), stopping\n", error);
+			printf("MONDRIAN LOG: flush failed at total %llu (%d), stopping\n",
+			    total, error);
 			return;
 		}
 		flushed = total;
@@ -1360,19 +1374,24 @@
-static void
+void
 mondrian_log_start(void)
 {
 	static int started;
 	uint32_t on = 1;
 	thread_t thread;
+	kern_return_t kr;
 
 	if (started || !su.ready) {
 		return;
 	}
 	PE_parse_boot_argn("mondrianlog", &on, sizeof(on));
 	if (!on || su.nblocks < 2 * MONDRIAN_LOG_BLOCKS) {
 		return;
 	}
-	if (kernel_thread_start(mondrian_log_thread, NULL, &thread) == KERN_SUCCESS) {
+	kr = kernel_thread_start(mondrian_log_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
 		started = 1;
 		thread_deallocate(thread);
+		printf("MONDRIAN LOG: writer thread started\n");
+	} else {
+		printf("MONDRIAN LOG: writer thread start failed (%d)\n", kr);
 	}
 }
