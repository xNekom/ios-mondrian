+++ b/bsd/dev/mondrian_wifi.c
@@ -532,7 +532,7 @@ wifi_vote_rail(const struct wifi_rail *rail)
 	return 0;
 }
 
-static int
+static int __unused
 wifi_vote_arc(const char *name)
 {
 	uint32_t addr = mondrian_cmd_db_addr(name);
@@ -625,17 +625,15 @@ wifi_supplies(void)
 	}
 	/* qcom,vdd-wlan-ipa-config has enable=0 on this phone. */
 	wifi_log("ipa rail smpe3 has DT enable=0; not voted");
-	if (wifi_vote_arc("mx.lvl") != 0 || wifi_vote_arc("cx.lvl") != 0) {
-		return -1;
-	}
