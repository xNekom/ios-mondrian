+/*
+ * The slower cores of an asymmetric SoC.
+ *
+ * XNU already has a way to de-prioritise a core: a non-zero
+ * l2-access-penalty makes it the SMT sibling of a faster processor, and the
+ * scheduler then puts a thread on it only when no faster core is idle or
+ * running something of lower priority. What it does not have is room for
+ * more than one such core per primary, because its SMT model is two-way and
+ * its own code pairs every penalised core with the boot processor.
+ *
+ * This phone has four slow cores (the four A510s) and four fast ones (three
+ * A710s and the X2), so each slow core is paired with a fast core of its own.
+ * It stays a "secondary": the scheduler prefers the primaries, and a thread
+ * on a secondary goes back to the run queue at every rescheduling (see
+ * sched_slow_secondaries in osfmk/kern/sched.h), so a faster core that comes
+ * free takes it. With small_cores=0 every core is alike, as before.
+ */
+static uint32_t small_cores_apart = 2;          /* boot-arg small_cores */
+
+/* Three quarters of the fastest core's capacity: 1024 against 2386 is a
+ * small core, 2253 against 2386 is not. */
+static boolean_t
+capacity_is_slow(uint32_t capacity, uint32_t fastest)
+{
+	return capacity != 0 && fastest != 0 && capacity * 4 < fastest * 3;
+}
+
+static int ml_slow_core_partner[MAX_CPUS];      /* by cpu_id: its faster core, -1 if none */
+
+static void
+ml_choose_slow_core_partners(void)
+{
+	boolean_t taken[MAX_CPUS] = { false };
+
+	for (int i = 0; i < MAX_CPUS; i++) {
+		ml_slow_core_partner[i] = -1;
+	}
+	for (int i = 0; i < (int)topology_info.num_cpus; i++) {
+		int partner = -1;
+
+		if (topology_info.cpus[i].l2_access_penalty == 0) {
+			continue;
+		}
+		/* the last fast core not yet taken; the boot core only if there is no other */
+		for (int j = (int)topology_info.num_cpus - 1; j >= 0; j--) {
+			if (topology_info.cpus[j].l2_access_penalty != 0 || taken[j]) {
+				continue;
+			}
+			if (&topology_info.cpus[j] == topology_info.boot_cpu) {
+				if (partner < 0) {
+					partner = j;
+				}
+				continue;
+			}
+			partner = j;
+			break;
+		}
+		if (partner >= 0) {
+			taken[partner] = true;
+			ml_slow_core_partner[i] = partner;
+		}
+	}
+}
+
+/* At the registration of each processor: pairs it with its partner, if that
+ * one is registered too (whichever comes second does it). */
+static void
+ml_pair_slow_processors(int cpu_id)
+{
+	for (int i = 0; i < (int)topology_info.num_cpus; i++) {
+		int partner = ml_slow_core_partner[i];
+		processor_t slow, fast;
+
+		if (partner < 0) {
+			if (i == cpu_id) {
+				kprintf("MONDRIAN CPU: cpu %d (mpidr 0x%x) is small: "
+				    "no faster core left to pair it with\n", i,
+				    topology_info.cpus[i].phys_id);
+			}
+			continue;
+		}
+		if (i != cpu_id && partner != cpu_id) {
+			continue;
+		}
+		slow = processor_array[i];
+		fast = processor_array[partner];
+		if (slow == PROCESSOR_NULL || fast == PROCESSOR_NULL ||
+		    slow->processor_primary == fast) {
+			continue;
+		}
+		sched_slow_secondaries = small_cores_apart >= 2;
+		processor_set_primary(slow, fast);
+		kprintf("MONDRIAN CPU: cpu %d (mpidr 0x%x) is a slower core: "
+		    "the scheduler uses it after cpu %d (mpidr 0x%x)\n",
+		    i, topology_info.cpus[i].phys_id, partner,
+		    topology_info.cpus[partner].phys_id);
+	}
+}
