+/*
+ * The Bluetooth port is serial engine 5 of QUPv3 wrapper 2. The live tree has
+ * qcom,msm-geni-serial-hs at 0x894000 (the wrapper is at 0x8C0000 and its SE
+ * apertures start at 0x880000 in steps of 0x4000), GIC SPI 587 and a wakeup on
+ * GPIO 79; the console UART is the other engine, 0x99c000 on SPI 608, and
+ * bringing that one up for Bluetooth is the mistake this comment exists for.
+ *
+ * The three clocks the node names (se-clk, m-ahb, s-ahb) resolve, in mainline's
+ * gcc-sm8450, to ids 0x82, 0x8a and 0x8b = GCC_QUPV3_WRAP2_S5_CLK,
+ * GCC_QUPV3_WRAP_2_M_AHB_CLK and GCC_QUPV3_WRAP_2_S_AHB_CLK, and all three are
+ * bits of the one vote register 0x62010: SE5 bit 9, m-ahb bit 2, s-ahb bit 1,
+ * with core bit 0 and core 2x bit 3 beside them. The SE's own root is the RCG
+ * at CMD_RCGR 0x2e618 / CFG_RCGR 0x2e61c.
+ *
+ * Three stages, each one proof for the next:
+ *   btuart        the engine answers with its clocks voted (identity registers)
+ *   btuart loop   the UART is programmed and a byte comes back on its own RX
+ *   btuart hci    HCI_Reset goes out on the wire and whatever answers is printed
+ *
+ * The register set and the order are mainline's (qcom_geni_serial.c and
+ * geni-se.h): FIFO mode (SE_GENI_DMA_MODE_EN = 0), SER clock divider in
+ * GENI_SER_M/S_CLK_CFG, 8N1 in the SE_UART_* registers, RX started once with
+ * UART_START_READ and each TX framed by SE_UART_TX_TRANS_LEN + UART_START_TX.
+ *
+ * Nothing here reaches the QCA firmware: the ROM's UART is the thing being
+ * spoken to, and a firmware load only makes sense after this answers.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <pexpert/arm64/board_config.h>
+
+#if defined(MONDRIAN)
+
+#define MONDRIAN_BT_GCC_BASE		0x00100000UL
+#define MONDRIAN_BT_WRAP2_BASE		0x008c0000UL
+#define MONDRIAN_BT_SE5_BASE		0x00894000UL
+
+#define MONDRIAN_BT_VOTE_REG		0x62010
+#define MONDRIAN_BT_CORE		(1u << 0)
+#define MONDRIAN_BT_S_AHB		(1u << 1)
+#define MONDRIAN_BT_M_AHB		(1u << 2)
+#define MONDRIAN_BT_CORE_2X		(1u << 3)
+#define MONDRIAN_BT_SE5			(1u << 9)
+#define MONDRIAN_BT_WANT		(MONDRIAN_BT_CORE | \
+					 MONDRIAN_BT_S_AHB | \
+					 MONDRIAN_BT_M_AHB | \
+					 MONDRIAN_BT_CORE_2X | \
+					 MONDRIAN_BT_SE5)
+
+#define MONDRIAN_BT_HALT_SE5		0x2e610
+#define MONDRIAN_BT_HALT_M_AHB		0x2e004
+#define MONDRIAN_BT_HALT_S_AHB		0x2e008
+#define MONDRIAN_BT_SE5_CMD_RCGR	0x2e618
+#define MONDRIAN_BT_SE5_CFG_RCGR	0x2e61c
+#define MONDRIAN_BT_SE5_M_RCGR		0x2e620
+#define MONDRIAN_BT_SE5_N_RCGR		0x2e624
+#define MONDRIAN_BT_SE5_D_RCGR		0x2e628
+#define MONDRIAN_BT_CMD_UPDATE		(1u << 0)
+#define MONDRIAN_BT_CFG_PRE_DIV		0xffu
+#define MONDRIAN_BT_CFG_SRC_SEL		(0x7u << 8)
+#define MONDRIAN_BT_CFG_MODE		(0x3u << 12)
+#define MONDRIAN_BT_CFG_MODE_DUAL	(0x2u << 12)
+#define MONDRIAN_BT_SRC_GPLL0_EVEN	6u
+#define MONDRIAN_BT_RCG_M		768u
+#define MONDRIAN_BT_RCG_N		15625u
+#define MONDRIAN_BT_GPLL0_HZ		300000000u
+
+/*
+ * The pin controller, as the touch driver already uses it: the live tree
+ * declares pinctrl@f000000 with a 16 MB region, but the pin registers start one
+ * megabyte into it and a read of the hole wedges the interconnect. CFG is the
+ * function/pull/drive word, IN_OUT the level (bit 0) and the output enable.
+ */
+#define MONDRIAN_BT_TLMM_BASE		0x0f100000UL
+#define MONDRIAN_BT_TLMM_PAGE(n)	(MONDRIAN_BT_TLMM_BASE + 0x1000UL * (n))
+#define MONDRIAN_BT_TLMM_CFG		0x0
+#define MONDRIAN_BT_TLMM_INTR_CFG	0x8
+#define MONDRIAN_BT_TLMM_INTR_STATUS	0xc
+#define MONDRIAN_BT_TLMM_IN_OUT		0x4
+#define MONDRIAN_BT_TLMM_OUTPUT		(1u << 9)
+#define MONDRIAN_BT_TLMM_DRIVE_8MA	3
+#define MONDRIAN_BT_RPMH_VOLTAGE	0x0
+#define MONDRIAN_BT_RPMH_ENABLE		0x4
+
+#define MONDRIAN_BT_GPIO_UART_CTS	76
+#define MONDRIAN_BT_GPIO_UART_RTS	77
+#define MONDRIAN_BT_GPIO_UART_TX		78
+#define MONDRIAN_BT_GPIO_UART_RX		79
+#define MONDRIAN_BT_GPIO_WAKEUP		79
+#define MONDRIAN_BT_TLMM_FUNC_QUP20	(1u << 2)
+#define MONDRIAN_BT_GPIO_WL_RESET	80
+#define MONDRIAN_BT_GPIO_RESET		81
+#define MONDRIAN_BT_GPIO_SW_CTRL	82
+#define MONDRIAN_BT_GPIO_XO_CLK		204
+
+extern uint32_t mondrian_cmd_db_addr(const char *id);
+extern const void *mondrian_cmd_db_data(const char *id, uint32_t *len);
+extern int mondrian_rpmh_write_one(uint32_t addr, uint32_t data);
+#define MONDRIAN_BT_RCG_ROOT_OFF	(1u << 31)
+#define MONDRIAN_BT_RCG_ROOT_EN		(1u << 1)
+#define MONDRIAN_BT_RCG_UPDATE		(1u << 0)
+#define MONDRIAN_BT_HALTED		0x1
+
+#define MONDRIAN_BT_QUPV3_HW_VER	0x4
+#define MONDRIAN_BT_SE_INIT_CFG_REV	0x0
+#define MONDRIAN_BT_SE_CGC_CTRL		0x28
+#define MONDRIAN_BT_SE_CLK_CTRL_RO	0x60
+#define MONDRIAN_BT_SE_FW_REV		0x1000
+
+/* geni-se.h */
+#define MONDRIAN_BT_SE_GENI_STATUS	0x40
+#define MONDRIAN_BT_SER_M_CLK_CFG	0x48
+#define MONDRIAN_BT_SER_S_CLK_CFG	0x4c
+#define MONDRIAN_BT_SE_GENI_CLK_SEL	0x7c
+#define MONDRIAN_BT_GENI_OUTPUT_CTRL	0x24
+#define MONDRIAN_BT_GENI_FORCE_DEFAULT	0x20
+#define MONDRIAN_BT_SE_IRQ_EN		0xe1c
+#define MONDRIAN_BT_SE_DMA_GENERAL_CFG	0xe30
+#define MONDRIAN_BT_SE_HW_PARAM_0	0xe24
+#define MONDRIAN_BT_SE_HW_PARAM_1	0xe28
+#define MONDRIAN_BT_SE_UART_RX_STALE	0x294
+#define MONDRIAN_BT_SE_BYTE_GRAN	0x254
+#define MONDRIAN_BT_TX_WATERMARK_REG	0x80c
+#define MONDRIAN_BT_RX_WATERMARK	0x810
+#define MONDRIAN_BT_RX_RFR_WATERMARK	0x814
+#define MONDRIAN_BT_TX_PACKING_CFG0	0x260
+#define MONDRIAN_BT_TX_PACKING_CFG1	0x264
+#define MONDRIAN_BT_RX_PACKING_CFG0	0x284
+#define MONDRIAN_BT_RX_PACKING_CFG1	0x288
+#define MONDRIAN_BT_DMA_MODE_EN		0x258
+#define MONDRIAN_BT_M_CMD0		0x600
+#define MONDRIAN_BT_M_CMD_CTRL		0x604
+#define MONDRIAN_BT_M_IRQ_STATUS	0x610
+#define MONDRIAN_BT_M_IRQ_EN		0x614
+#define MONDRIAN_BT_M_IRQ_CLEAR		0x618
+#define MONDRIAN_BT_S_CMD0		0x630
+#define MONDRIAN_BT_S_CMD_CTRL		0x634
+#define MONDRIAN_BT_S_IRQ_STATUS	0x640
+#define MONDRIAN_BT_S_IRQ_EN		0x644
+#define MONDRIAN_BT_S_IRQ_CLEAR		0x648
+#define MONDRIAN_BT_S_GENI_CMD_ABORT	(1u << 1)
+#define MONDRIAN_BT_TX_FIFO		0x700
+#define MONDRIAN_BT_RX_FIFO		0x780
+#define MONDRIAN_BT_TX_FIFO_STATUS	0x800
+#define MONDRIAN_BT_RX_FIFO_STATUS	0x804
+#define MONDRIAN_BT_SER_CLK_EN		(1u << 0)
+#define MONDRIAN_BT_CLK_DIV_SHFT	4
+#define MONDRIAN_BT_M_OPCODE_SHFT	27
+#define MONDRIAN_BT_S_OPCODE_SHFT	27
+#define MONDRIAN_BT_M_CMD_DONE_EN	(1u << 0)
+#define MONDRIAN_BT_M_TX_WATERMARK_EN	(1u << 30)
+#define MONDRIAN_BT_M_CMD_ABORT_EN	(1u << 1)
+#define MONDRIAN_BT_M_GENI_CMD_ABORT	(1u << 1)
+#define MONDRIAN_BT_UART_START_TX	0x1
+#define MONDRIAN_BT_UART_START_READ	0x1
+#define MONDRIAN_BT_RX_FIFO_WC_MSK	0x01ffffffu
+#define MONDRIAN_BT_RX_LAST		(1u << 31)
+#define MONDRIAN_BT_RX_LAST_BYTE	(0x7u << 28)
+#define MONDRIAN_BT_RX_LAST		(1u << 31)
+#define MONDRIAN_BT_RX_LAST_BYTE_MSK	(0x7u << 28)
+#define MONDRIAN_BT_RX_LAST_BYTE_SHFT	28
+
+/* qcom_geni_serial.c */
+#define MONDRIAN_BT_SE_UART_LOOPBACK	0x22c
+#define MONDRIAN_BT_SE_UART_TX_CFG	0x25c
+#define MONDRIAN_BT_SE_UART_TX_WORD	0x268
+#define MONDRIAN_BT_SE_UART_TX_STOP	0x26c
+#define MONDRIAN_BT_SE_UART_TX_LEN	0x270
+#define MONDRIAN_BT_SE_UART_RX_CFG	0x280
+#define MONDRIAN_BT_SE_UART_RX_WORD	0x28c
+#define MONDRIAN_BT_SE_UART_TX_PAR	0x2a4
+#define MONDRIAN_BT_SE_UART_RX_PAR	0x2a8
+#define MONDRIAN_BT_LOOPBACK_RX_TX_SORTED (1u << 0)
+#define MONDRIAN_BT_UART_CTS_MASK	(1u << 1)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys, vm_size_t size);
+extern void delay(int us);
+extern void mondrian_log_flush_now(void);
+
+static uint32_t
+mondrian_bt_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+mondrian_bt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * One step, in both directions: to the ring first (flushed, so a stalled bus
+ * leaves this line and not silence), then to the host's answer.
+ */
+static int
+mondrian_bt_step(char *out, size_t len, int n, const char *line)
+{
+	printf("%s", line);
+	mondrian_log_flush_now();
+	if (n < 0) {
+		return 0;
+	}
+	if ((size_t)n >= len) {
+		/* Full: the ring keeps the line, the answer does not. */
+		return (int)len;
+	}
+	return n + snprintf(out + n, len - (size_t)n, "%s", line);
+}
+
+/* The same map the probe uses; 0 on any failure. */
+static int
+mondrian_bt_map(vm_offset_t *gcc, vm_offset_t *wrap, vm_offset_t *se)
+{
+	*gcc = ml_io_map(MONDRIAN_BT_GCC_BASE, 0x70000);
+	*wrap = ml_io_map(MONDRIAN_BT_WRAP2_BASE, 0x2000);
+	*se = ml_io_map(MONDRIAN_BT_SE5_BASE, 0x4000);
+	return *gcc != 0 && *wrap != 0 && *se != 0;
+}
+
+/* Vote the five bits, root the SE clock on the XO only if it was off. */
+static void
+mondrian_bt_power(vm_offset_t gcc)
+{
+	uint32_t vote, cmd, cfg;
+
+	vote = mondrian_bt_rd(gcc, MONDRIAN_BT_VOTE_REG);
+	mondrian_bt_wr(gcc, MONDRIAN_BT_VOTE_REG, vote | MONDRIAN_BT_WANT);
+	delay(1000);
+
+	cmd = mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CMD_RCGR);
+	if ((cmd & MONDRIAN_BT_RCG_ROOT_OFF) != 0) {
+		cfg = mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CFG_RCGR);
+		cfg &= ~0x1fu;
+		cfg &= ~0x700u;
+		mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_CFG_RCGR, cfg);
+		mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_CMD_RCGR, MONDRIAN_BT_RCG_UPDATE);
+		for (int i = 0; i < 1000; i++) {
+			if ((mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CMD_RCGR) &
+			    MONDRIAN_BT_RCG_UPDATE) == 0) {
+				break;
+			}
+		}
+		cmd = mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CMD_RCGR);
+		mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_CMD_RCGR,
+		    cmd | MONDRIAN_BT_RCG_ROOT_EN);
+		delay(1000);
+	} else if ((cmd & MONDRIAN_BT_RCG_ROOT_EN) == 0) {
+		/*
+		 * Rooted but not enabled: ROOT_OFF (bit 31) clear only means the
+		 * root was picked, and this one read back 0x0 with ROOT_EN clear,
+		 * which is a clock that does not run. The RX sequencer still
+		 * accepted a command, so this is not the whole story, but a
+		 * gated root has no business being left off.
+		 */
+		mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_CMD_RCGR,
+		    cmd | MONDRIAN_BT_RCG_ROOT_EN);
+		delay(1000);
+	}
+}
+
+/*
+ * Move the SE root from the XO to P_GCC_GPLL0_OUT_EVEN at M/N = 768/15625, the
+ * 14745600 Hz entry of mainline's QUP table, so that a SER divider of 8 gives
+ * 115200 exactly. The UART divider is a small integer, so the root has to be a
+ * multiple of baud * 16; the XO (19.2 MHz) is not.
+ */
+static int
+mondrian_bt_rcg_14745600(vm_offset_t gcc, char *out, size_t len, int n)
+{
+	uint32_t cfg, cmd, vote;
+	char line[192];
+
+	/*
+	 * The branch is enabled at this point and the engine is live; dropping
+	 * SE5's vote gates it for the duration of the parent and divider change,
+	 * which is what the clock framework does around set_parent().
+	 */
+	vote = mondrian_bt_rd(gcc, MONDRIAN_BT_VOTE_REG);
+	mondrian_bt_wr(gcc, MONDRIAN_BT_VOTE_REG, vote & ~MONDRIAN_BT_SE5);
+	delay(1000);
+
+	mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_M_RCGR, MONDRIAN_BT_RCG_M);
+	mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_N_RCGR,
+	    (uint16_t)~(MONDRIAN_BT_RCG_N - MONDRIAN_BT_RCG_M));
+	mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_D_RCGR,
+	    (uint16_t)~MONDRIAN_BT_RCG_N);
+
+	cfg = mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CFG_RCGR);
+	cfg &= ~(MONDRIAN_BT_CFG_PRE_DIV | MONDRIAN_BT_CFG_SRC_SEL |
+	    MONDRIAN_BT_CFG_MODE);
+	cfg |= 1u;   /* pre divider 1 */
+	cfg |= MONDRIAN_BT_SRC_GPLL0_EVEN << 8;
+	cfg |= MONDRIAN_BT_CFG_MODE_DUAL;
+	mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_CFG_RCGR, cfg);
+
+	/* Read-modify-write, the way update_config() does it: ROOT_EN stays. */
+	cmd = mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CMD_RCGR);
+	mondrian_bt_wr(gcc, MONDRIAN_BT_SE5_CMD_RCGR, cmd | MONDRIAN_BT_CMD_UPDATE);
+	for (int i = 0; i < 1000; i++) {
+		cmd = mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CMD_RCGR);
+		if ((cmd & MONDRIAN_BT_CMD_UPDATE) == 0) {
+			break;
+		}
+		delay(10);
+	}
+
+	mondrian_bt_wr(gcc, MONDRIAN_BT_VOTE_REG, vote);
+	delay(1000);
+
+	snprintf(line, sizeof(line),
+	    "btuart: rcg cmd 0x%x cfg 0x%x m 0x%x n 0x%x d 0x%x -> %u Hz\n",
+	    mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CMD_RCGR),
+	    mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_CFG_RCGR),
+	    mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_M_RCGR) & 0xffffu,
+	    mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_N_RCGR) & 0xffffu,
+	    mondrian_bt_rd(gcc, MONDRIAN_BT_SE5_D_RCGR) & 0xffffu,
+	    (uint32_t)((uint64_t)MONDRIAN_BT_GPLL0_HZ * MONDRIAN_BT_RCG_M /
+	    MONDRIAN_BT_RCG_N));
+	return mondrian_bt_step(out, len, n, line);
+}
+
+/*
+ * Program the engine for 8N1 in FIFO mode. The SE's root is the XO (19.2 MHz,
+ * divider 1), so the SER divider is what sets the baud: with the 16x
+ * oversampling the 2.5+ engines use, divider 10 gives 120000, not 115200 --
+ * the clock cannot hit 115200 exactly with an integer divider from 19.2 MHz,
+ * and the loopback stage is what says whether the programming itself is right
+ * before any of that can be blamed on the far end.
+ */
+static int
+mondrian_bt_uart_init(vm_offset_t se, uint32_t div, uint32_t root_hz,
+    int loopback, char *out, size_t len, int n)
+{
+	char line[160];
+
+	/*
+	 * qcom_geni_serial_abort_rx: cancel the secondary command before
+	 * anything else, because the previous stage leaves one ACTIVE and the
+	 * engine would hand this stage its leftovers.
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_S_CMD_CTRL, MONDRIAN_BT_S_GENI_CMD_ABORT);
+	for (int i = 0; i < 500; i++) {
+		if ((mondrian_bt_rd(se, MONDRIAN_BT_S_CMD_CTRL) &
+		    MONDRIAN_BT_S_GENI_CMD_ABORT) == 0) {
+			break;
+		}
+		delay(100);
+	}
+	mondrian_bt_wr(se, MONDRIAN_BT_M_IRQ_EN, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_S_IRQ_EN, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_M_IRQ_CLEAR, 0xffffffffu);
+	mondrian_bt_wr(se, MONDRIAN_BT_S_IRQ_CLEAR, 0xffffffffu);
+
+	/*
+	 * geni_se_io_init: clock gating on, the IO macro in its default output
+	 * state, and FORCE_DEFAULT last. That last write is what put the first
+	 * attempt's UART_START_TX command in limbo: M_CMD0 was written, the
+	 * engine stayed idle and M_IRQ_STATUS never moved.
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_CGC_CTRL,
+	    mondrian_bt_rd(se, MONDRIAN_BT_SE_CGC_CTRL) | 0x7fu);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_DMA_GENERAL_CFG,
+	    mondrian_bt_rd(se, MONDRIAN_BT_SE_DMA_GENERAL_CFG) | 0xfu);
+	mondrian_bt_wr(se, MONDRIAN_BT_GENI_OUTPUT_CTRL, 0x7fu);
+	mondrian_bt_wr(se, MONDRIAN_BT_GENI_FORCE_DEFAULT, 1);
+
+	/*
+	 * geni_se_io_set_mode leaves the four IRQ sources enabled because
+	 * mainline has a handler. Nothing here acknowledges SPI 587, so the
+	 * line stays masked; M_IRQ_STATUS latches what the polling reads.
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_IRQ_EN, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_DMA_MODE_EN, 0);
+
+	/*
+	 * geni_se_config_packing(8 bits, 4 per FIFO entry, lsb first) and the
+	 * watermarks geni_se_init sets (rx 2, rfr 62 of the 64-entry FIFO).
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_TX_PACKING_CFG0, 0x4380eu);
+	mondrian_bt_wr(se, MONDRIAN_BT_TX_PACKING_CFG1, 0xc3e0eu);
+	mondrian_bt_wr(se, MONDRIAN_BT_RX_PACKING_CFG0, 0x4380eu);
+	mondrian_bt_wr(se, MONDRIAN_BT_RX_PACKING_CFG1, 0xc3e0eu);
+	/*
+	 * setup_fifos(): the depth is the engine's, not a guess -- HW_PARAM_1
+	 * bits 21:16 peeking through a mask that widens on 3.10+ hardware, and
+	 * a watermark past the depth would hold the RFR line for ever.
+	 */
+	{
+		uint32_t hw0 = mondrian_bt_rd(se, MONDRIAN_BT_SE_HW_PARAM_0);
+		uint32_t hw1 = mondrian_bt_rd(se, MONDRIAN_BT_SE_HW_PARAM_1);
+		uint32_t tx_depth = (hw0 >> 16) & 0x3fu;
+		uint32_t rx_depth = (hw1 >> 16) & 0x3fu;
+		uint32_t tx_width = (hw0 >> 24) & 0x3fu;
+
+		mondrian_bt_wr(se, MONDRIAN_BT_SE_BYTE_GRAN, 0);
+		mondrian_bt_wr(se, MONDRIAN_BT_RX_WATERMARK, 2);
+		mondrian_bt_wr(se, MONDRIAN_BT_RX_RFR_WATERMARK,
+		    rx_depth > 2 ? rx_depth - 2 : rx_depth);
+		mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_RX_STALE, 160);
+		snprintf(line, sizeof(line),
+		    "btuart: fifo tx %u words x %u bits, rx %u words\n", tx_depth,
+		    tx_width, rx_depth);
+		n = mondrian_bt_step(out, len, n, line);
+	}
+
+	/*
+	 * The primary sequencer is the one that would not move. Abort whatever
+	 * it is holding (M_CMD_ABORT on M_CMD_CTRL, done = M_CMD_ABORT in
+	 * M_IRQ_STATUS) and latch-clear both sides, so the next TX starts from
+	 * a known state rather than from the bootloader's.
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_M_CMD_CTRL, MONDRIAN_BT_M_GENI_CMD_ABORT);
+	for (int i = 0; i < 500; i++) {
+		if ((mondrian_bt_rd(se, MONDRIAN_BT_M_IRQ_STATUS) &
+		    MONDRIAN_BT_M_CMD_ABORT_EN) != 0) {
+			break;
+		}
+		delay(100);
+	}
+	mondrian_bt_wr(se, MONDRIAN_BT_M_IRQ_CLEAR, 0xffffffffu);
+	mondrian_bt_wr(se, MONDRIAN_BT_S_IRQ_CLEAR, 0xffffffffu);
+
+	mondrian_bt_wr(se, MONDRIAN_BT_SER_M_CLK_CFG,
+	    MONDRIAN_BT_SER_CLK_EN | (div << MONDRIAN_BT_CLK_DIV_SHFT));
+	mondrian_bt_wr(se, MONDRIAN_BT_SER_S_CLK_CFG,
+	    MONDRIAN_BT_SER_CLK_EN | (div << MONDRIAN_BT_CLK_DIV_SHFT));
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_GENI_CLK_SEL, 0);
+
+	/*
+	 * UART_CTS_MASK: without hardware flow control the engine must ignore
+	 * the CTS pin. With this zero the TX command latched, went ACTIVE and
+	 * never completed, which is the whole of the first two attempts.
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_TX_CFG, MONDRIAN_BT_UART_CTS_MASK);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_TX_PAR, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_RX_CFG, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_RX_PAR, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_TX_WORD, 8);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_RX_WORD, 8);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_TX_STOP, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_LOOPBACK,
+	    loopback ? MONDRIAN_BT_LOOPBACK_RX_TX_SORTED : 0);
+
+	/* One RX command per session: it keeps receiving into the FIFO. */
+	mondrian_bt_wr(se, MONDRIAN_BT_S_CMD0,
+	    MONDRIAN_BT_UART_START_READ << MONDRIAN_BT_S_OPCODE_SHFT);
+	delay(2000);
+
+	snprintf(line, sizeof(line),
+	    "btuart: uart 8n1 div %u (root %u -> %u baud) loopback %d "
+	    "status 0x%x\n", div, root_hz, root_hz / (div * 16),
+	    loopback ? 1 : 0,
+	    mondrian_bt_rd(se, MONDRIAN_BT_SE_GENI_STATUS));
+	return mondrian_bt_step(out, len, n, line);
+}
+
+/* Send len bytes and wait for the TX command to complete. */
+static int
+mondrian_bt_send(vm_offset_t se, const uint8_t *buf, uint32_t len, char *out,
+    size_t len_out, int n)
+{
+	uint32_t status = 0;
+	char line[128];
+	int done = 0;
+
+	/*
+	 * mainline's order: qcom_geni_serial_setup_tx starts the command and
+	 * send_chunk_fifo fills the FIFO afterwards, four bytes per 32-bit
+	 * entry with the first byte in the low bits (the packing is programmed
+	 * msb_to_lsb = false). The first attempt filled the FIFO first.
+	 */
+	/*
+	 * M_IRQ_STATUS latches the completion whether or not M_IRQ_EN lets it
+	 * reach the GIC, and this kernel has no handler for SPI 587: enabling it
+	 * would assert a level-high line that nothing clears.
+	 */
+	mondrian_bt_wr(se, MONDRIAN_BT_M_IRQ_EN, 0);
+	mondrian_bt_wr(se, MONDRIAN_BT_TX_WATERMARK_REG, 2);
+	mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_TX_LEN, len);
+	{
+		uint32_t before = mondrian_bt_rd(se, MONDRIAN_BT_SE_GENI_STATUS);
+
+		mondrian_bt_wr(se, MONDRIAN_BT_M_CMD0,
+		    MONDRIAN_BT_UART_START_TX << MONDRIAN_BT_M_OPCODE_SHFT);
+		delay(1000);
+		snprintf(line, sizeof(line),
+		    "btuart: m_cmd0 0x%x status 0x%x -> 0x%x\n",
+		    mondrian_bt_rd(se, MONDRIAN_BT_M_CMD0), before,
+		    mondrian_bt_rd(se, MONDRIAN_BT_SE_GENI_STATUS));
+		n = mondrian_bt_step(out, len_out, n, line);
+	}
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t word = 0;
+
+		for (uint32_t j = 0; j < 4 && i + j < len; j++) {
+			word |= (uint32_t)buf[i + j] << (8 * j);
+		}
+		mondrian_bt_wr(se, MONDRIAN_BT_TX_FIFO, word);
+	}
+	snprintf(line, sizeof(line), "btuart: tx fifo filled 0x%x\n",
+	    mondrian_bt_rd(se, MONDRIAN_BT_TX_FIFO_STATUS));
+	n = mondrian_bt_step(out, len_out, n, line);
+	for (int i = 0; i < 2000; i++) {
+		status = mondrian_bt_rd(se, MONDRIAN_BT_M_IRQ_STATUS);
+		if ((status & MONDRIAN_BT_M_CMD_DONE_EN) != 0) {
+			done = 1;
+			break;
+		}
+		delay(100);
+	}
+	if (!done) {
+		mondrian_bt_wr(se, MONDRIAN_BT_M_CMD_CTRL,
+		    MONDRIAN_BT_M_GENI_CMD_ABORT);
+	}
+	mondrian_bt_wr(se, MONDRIAN_BT_M_IRQ_CLEAR, 0xffffffffu);
+	snprintf(line, sizeof(line),
+	    "btuart: tx %u bytes done %d irq 0x%x tx_fifo left 0x%x\n", len,
+	    done, status, mondrian_bt_rd(se, MONDRIAN_BT_TX_FIFO_STATUS));
+	return mondrian_bt_step(out, len_out, n, line);
+}
+
+/* How many bytes the engine has received, and take them out of the FIFO. */
+static int
+mondrian_bt_recv(vm_offset_t se, uint8_t *buf, uint32_t cap, uint32_t wait_ms,
+    char *out, size_t len_out, int n)
+{
+	uint32_t status = 0;
+	char line[192];
+	uint32_t got = 0, quiet = 0;
+
+	/*
+	 * One FIFO word holds four bytes (the packing above says so), so the
+	 * drain splits the word instead of taking one byte per read, and it
+	 * keeps going until 40 ms pass with nothing new: a Command Complete is
+	 * two or three bytes behind the first one, and stopping at the first
+	 * byte reported the reset as a lone 0x04.
+	 */
+	for (uint32_t t = 0; t < wait_ms; t++) {
+		uint32_t words, drained = 0;
+
+		status = mondrian_bt_rd(se, MONDRIAN_BT_RX_FIFO_STATUS);
+		words = status & MONDRIAN_BT_RX_FIFO_WC_MSK;
+		if (words != 0) {
+			uint32_t last = (status & MONDRIAN_BT_RX_LAST_BYTE) >> 28;
+			uint32_t bytes = 4 * (words - 1);
+
+			/*
+			 * The status counts words of four bytes, and the last one may
+			 * be short: RX_LAST says it is partial and RX_LAST_BYTE_VALID
+			 * how many bytes it carries, zero meaning all four.
+			 */
+			if ((status & MONDRIAN_BT_RX_LAST) == 0 || last == 0) {
+				bytes += 4;
+			} else {
+				bytes += last;
+			}
+			while (drained < bytes) {
+				uint32_t word = mondrian_bt_rd(se,
+				    MONDRIAN_BT_RX_FIFO);
+				uint32_t take = (bytes - drained) > 4 ? 4 :
+				    bytes - drained;
+
+				for (uint32_t i = 0; i < take; i++) {
+					if (got < cap) {
+						buf[got] = (uint8_t)(word >>
+						    (8 * i));
+					}
+					got++;
+				}
+				drained += take;
+			}
+		}
+		if (drained != 0) {
+			quiet = 0;
+		} else if (++quiet > 40 && got != 0) {
+			break;
+		}
+		delay(1000);
+	}
+	snprintf(line, sizeof(line), "btuart: rx fifo status 0x%x, %u bytes\n",
+	    status, got);
+	n = mondrian_bt_step(out, len_out, n, line);
+	{
+		int m = snprintf(line, sizeof(line), "btuart: rx data:");
+
+		for (uint32_t i = 0; i < got && m < (int)sizeof(line) - 4; i++) {
+			m += snprintf(line + m, sizeof(line) - (size_t)m, " %02x",
+			    buf[i]);
+		}
+		if (got == 0) {
+			m += snprintf(line + m, sizeof(line) - (size_t)m,
+			    " (nothing)");
+		}
+		line[m++] = '\n';
+		line[m] = '\0';
+		n = mondrian_bt_step(out, len_out, n, line);
+	}
+	return n;
+}
+
+/*
+ * btpower: the rails by cmd-db name and the five pins, read only.
+ *
+ * The voltage each rail needs is the minimum of the node's own
+ * qcom,bt-vdd-*-config (966 aon/dig/rfa-0p8/rfacmn share smpb11); they are
+ * printed beside the resource so a vote can be written against the numbers
+ * that came from the tree, not from memory.
+ */
+static int
+mondrian_bt_power_probe(vm_offset_t gcc, char *out, size_t len, int n)
+{
+	static const struct {
+		const char *name;
+		uint32_t mv;
+		const char *who;
+	} rails[] = {
+		{ "smpb11", 966, "aon, dig, rfa-0p8, rfacmn" },
+		{ "smpb10", 1800, "io" },
+		{ "smpc1", 1900, "rfa1" },
+		{ "smpb12", 1350, "rfa2" },
+		{ "ldoe7", 2800, "asd" },
+		{ "smpe3", 2200, "ipa" },
+	};
+	static const uint32_t gpios[] = {
+		MONDRIAN_BT_GPIO_UART_CTS, MONDRIAN_BT_GPIO_UART_RTS,
+		MONDRIAN_BT_GPIO_UART_TX, MONDRIAN_BT_GPIO_UART_RX,
+		MONDRIAN_BT_GPIO_WL_RESET, MONDRIAN_BT_GPIO_RESET,
+		MONDRIAN_BT_GPIO_SW_CTRL, MONDRIAN_BT_GPIO_XO_CLK,
+	};
+	char line[192];
+
+	n = mondrian_bt_step(out, len, n, "btpower: rails\n");
+	for (size_t i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		uint32_t aux_len = 0;
+		const uint16_t *aux =
+		    mondrian_cmd_db_data(rails[i].name, &aux_len);
+		uint32_t addr = mondrian_cmd_db_addr(rails[i].name);
+
+		snprintf(line, sizeof(line),
+		    "btpower: %s addr 0x%x want %u mV aux %u bytes%s\n",
+		    rails[i].name, addr, rails[i].mv, aux_len,
+		    aux == NULL ? " (no aux data)" : "");
+		n = mondrian_bt_step(out, len, n, line);
+		if (aux != NULL && aux_len >= 6) {
+			/* linear range: min uV, step uV, count */
+			snprintf(line, sizeof(line),
+			    "btpower: %s range %u..%u uV step %u (%s)\n",
+			    rails[i].name, aux[0],
+			    (uint32_t)aux[0] + (uint32_t)aux[1] * (aux[2] - 1),
+			    aux[1], rails[i].who);
+			n = mondrian_bt_step(out, len, n, line);
+		}
+	}
+
+	n = mondrian_bt_step(out, len, n, "btpower: pins\n");
+	for (size_t i = 0; i < sizeof(gpios) / sizeof(gpios[0]); i++) {
+		vm_offset_t page = ml_io_map(MONDRIAN_BT_TLMM_PAGE(gpios[i]), 0x1000);
+
+		if (page == 0) {
+			snprintf(line, sizeof(line),
+			    "btpower: gpio %u cannot map\n", gpios[i]);
+		} else {
+			snprintf(line, sizeof(line),
+			    "btpower: gpio %u cfg 0x%x io 0x%x\n",
+			    gpios[i], mondrian_bt_rd(page, MONDRIAN_BT_TLMM_CFG),
+			    mondrian_bt_rd(page, MONDRIAN_BT_TLMM_IN_OUT));
+		}
+		n = mondrian_bt_step(out, len, n, line);
+	}
+	(void)gcc;
+	return n;
+}
+
+/* One pad as a push-pull output at 8 mA: level first, then the config. */
+static void
+mondrian_bt_gpio_out(vm_offset_t page, int level)
+{
+	mondrian_bt_wr(page, MONDRIAN_BT_TLMM_IN_OUT, level ? 2 : 0);
+	mondrian_bt_wr(page, MONDRIAN_BT_TLMM_CFG,
+	    (MONDRIAN_BT_TLMM_DRIVE_8MA << 6) | MONDRIAN_BT_TLMM_OUTPUT);
+}
+
+/*
+ * The rails and the two lines that bring the QCA6490 out of reset. Addresses
+ * are the cmd-db's (measured with `btpower`), and the voltage each rail wants
+ * is the minimum of the node's own qcom,bt-vdd-*-config.
+ */
+static int
+mondrian_bt_power_on(int vote, char *out, size_t len, int n)
+{
+	static const struct {
+		const char *name;
+		uint32_t addr;
+		uint32_t mv;
+	} rails[] = {
+		{ "smpb11", 0x40000, 966 },
+		{ "smpb10", 0x40700, 1800 },
+		{ "smpc1", 0x40200, 1900 },
+		{ "smpb12", 0x40100, 1350 },
+		{ "ldoe7", 0x41600, 2800 },
+		{ "smpe3", 0x43400, 2200 },
+	};
+	char line[160];
+	vm_offset_t bt_en, xo, sw_ctrl;
+	uint32_t got;
+
+	for (size_t i = 0; vote && i < sizeof(rails) / sizeof(rails[0]); i++) {
+		uint32_t addr = mondrian_cmd_db_addr(rails[i].name);
+
+		if (addr == 0) {
+			addr = rails[i].addr;
+		}
+		(void)mondrian_rpmh_write_one(addr + MONDRIAN_BT_RPMH_VOLTAGE,
+		    rails[i].mv);
+		(void)mondrian_rpmh_write_one(addr + MONDRIAN_BT_RPMH_ENABLE, 1);
+		snprintf(line, sizeof(line), "btpower: %s 0x%x <- %u mV on\n",
+		    rails[i].name, addr, rails[i].mv);
+		n = mondrian_bt_step(out, len, n, line);
+	}
+	if (vote) {
+		delay(20000);
+	}
+
+	bt_en = ml_io_map(MONDRIAN_BT_TLMM_PAGE(MONDRIAN_BT_GPIO_RESET), 0x1000);
+	xo = ml_io_map(MONDRIAN_BT_TLMM_PAGE(MONDRIAN_BT_GPIO_XO_CLK), 0x1000);
+	sw_ctrl = ml_io_map(MONDRIAN_BT_TLMM_PAGE(MONDRIAN_BT_GPIO_SW_CTRL),
+	    0x1000);
+	if (bt_en == 0 || xo == 0 || sw_ctrl == 0) {
+		return mondrian_bt_step(out, len, n,
+		    "btpower: cannot map the pins\n");
+	}
+
+	/* BT_EN low, the part off and the rails settling. */
+	mondrian_bt_gpio_out(bt_en, 0);
+	n = mondrian_bt_step(out, len, n, "btpower: bt_en low, 50 ms\n");
+	delay(50000);
+
+	/* XO first: the part latches its clock before it comes out of reset. */
+	mondrian_bt_gpio_out(xo, 1);
+	delay(200);
+	mondrian_bt_gpio_out(bt_en, 1);
+	n = mondrian_bt_step(out, len, n, "btpower: bt_en high, xo on\n");
+	delay(5000);
+	mondrian_bt_gpio_out(xo, 0);
+	delay(50000);
+
+	/*
+	 * The tree's active state: qup20 on the four UART pads. Without it the
+	 * TX byte the SE pushes stops at a pad still configured as a GPIO.
+	 */
+	for (uint32_t i = 0; i < 4; i++) {
+		static const uint32_t uart_pins[] = {
+			MONDRIAN_BT_GPIO_UART_CTS, MONDRIAN_BT_GPIO_UART_RTS,
+			MONDRIAN_BT_GPIO_UART_TX, MONDRIAN_BT_GPIO_UART_RX,
+		};
+		vm_offset_t page = ml_io_map(MONDRIAN_BT_TLMM_PAGE(uart_pins[i]),
+		    0x1000);
+
+		if (page == 0) {
+			continue;
+		}
+		/*
+		 * RX (79) is also the node's wakeup line and the loader leaves
+		 * its interrupt enabled: mask it and clear the latch before the
+		 * chip starts driving the pad, or its traffic is an interrupt
+		 * nobody acknowledges.
+		 */
+		{
+			uint32_t intr = mondrian_bt_rd(page,
+			    MONDRIAN_BT_TLMM_INTR_CFG);
+
+			mondrian_bt_wr(page, MONDRIAN_BT_TLMM_INTR_CFG, 0);
+			mondrian_bt_wr(page, MONDRIAN_BT_TLMM_INTR_STATUS,
+			    0xffffffffu);
+			mondrian_bt_wr(page, MONDRIAN_BT_TLMM_CFG,
+			    MONDRIAN_BT_TLMM_FUNC_QUP20);
+			snprintf(line, sizeof(line),
+			    "btpower: gpio %u qup20 cfg 0x%x (intr was 0x%x)\n",
+			    uart_pins[i],
+			    mondrian_bt_rd(page, MONDRIAN_BT_TLMM_CFG), intr);
+			n = mondrian_bt_step(out, len, n, line);
+		}
+	}
+
+	/* SW_CTRL is an input: the part drives it high once it is running. */
+	mondrian_bt_wr(sw_ctrl, MONDRIAN_BT_TLMM_CFG, 0);
+	got = mondrian_bt_rd(sw_ctrl, MONDRIAN_BT_TLMM_IN_OUT) & 1u;
+	snprintf(line, sizeof(line),
+	    "btpower: sw_ctrl %u %s\n", got,
+	    got ? "(the part says it is up)" : "(still low)");
+	return mondrian_bt_step(out, len, n, line);
+}
+
+int
+mondrian_btuart_run(const char *mode, char *out, size_t len)
+{
+	vm_offset_t gcc, wrap, se;
+	uint8_t buf[32];
+	char line[192];
+	int n = 0;
+
+	if (!mondrian_bt_map(&gcc, &wrap, &se)) {
+		return snprintf(out, len, "btuart: cannot map the engine\n");
+	}
+	mondrian_bt_power(gcc);
+
+	if (mode != NULL && strcmp(mode, "loop") == 0) {
+		uint8_t one = 0x5a;
+
+		n = mondrian_bt_uart_init(se, 10, 19200000u, 1, out, len, n);
+		n = mondrian_bt_send(se, &one, 1, out, len, n);
+		n = mondrian_bt_recv(se, buf, sizeof(buf), 20, out, len, n);
+		mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_LOOPBACK, 0);
+		return n;
+	}
+	if (mode != NULL && strcmp(mode, "power") == 0) {
+		return mondrian_bt_power_probe(gcc, out, len, n);
+	}
+	if (mode != NULL && strcmp(mode, "on") == 0) {
+		return mondrian_bt_power_on(0, out, len, n);
+	}
+	if (mode != NULL && strcmp(mode, "vote") == 0) {
+		return mondrian_bt_power_on(1, out, len, n);
+	}
+	if (mode != NULL && strcmp(mode, "baud") == 0) {
+		uint8_t one = 0x5a;
+
+		n = mondrian_bt_rcg_14745600(gcc, out, len, n);
+		n = mondrian_bt_uart_init(se, 8, 14745600u, 1, out, len, n);
+		n = mondrian_bt_send(se, &one, 1, out, len, n);
+		n = mondrian_bt_recv(se, buf, sizeof(buf), 20, out, len, n);
+		mondrian_bt_wr(se, MONDRIAN_BT_SE_UART_LOOPBACK, 0);
+		return n;
+	}
+	if (mode != NULL && strcmp(mode, "tx115") == 0) {
+		static const uint8_t reset[4] = { 0x01, 0x03, 0x0c, 0x00 };
+		char line[160];
+		uint32_t fifo, sirq;
+
+		n = mondrian_bt_rcg_14745600(gcc, out, len, n);
+		n = mondrian_bt_uart_init(se, 8, 14745600u, 0, out, len, n);
+		n = mondrian_bt_send(se, reset, sizeof(reset), out, len, n);
+		fifo = mondrian_bt_rd(se, MONDRIAN_BT_RX_FIFO_STATUS);
+		sirq = mondrian_bt_rd(se, MONDRIAN_BT_S_IRQ_STATUS);
+		snprintf(line, sizeof(line),
+		    "btuart: right after tx rx fifo 0x%x s_irq 0x%x\n", fifo,
+		    sirq);
+		return mondrian_bt_step(out, len, n, line);
+	}
+	if (mode != NULL && strcmp(mode, "edl115") == 0) {
+		static const uint8_t ver[5] = { 0x01, 0x00, 0xfc, 0x01, 0x19 };
+
+		n = mondrian_bt_rcg_14745600(gcc, out, len, n);
+		n = mondrian_bt_uart_init(se, 8, 14745600u, 0, out, len, n);
+		n = mondrian_bt_send(se, ver, sizeof(ver), out, len, n);
+		n = mondrian_bt_recv(se, buf, sizeof(buf), 600, out, len, n);
+		return n;
+	}
+	if (mode != NULL && strcmp(mode, "hci115") == 0) {
+		static const uint8_t reset[4] = { 0x01, 0x03, 0x0c, 0x00 };
+
+		n = mondrian_bt_rcg_14745600(gcc, out, len, n);
+		n = mondrian_bt_uart_init(se, 8, 14745600u, 0, out, len, n);
+		n = mondrian_bt_send(se, reset, sizeof(reset), out, len, n);
+		n = mondrian_bt_recv(se, buf, sizeof(buf), 400, out, len, n);
+
+		/*
+		 * HCI_Read_Local_Version_Information: the reset event only says the
+		 * ROM is awake. This command names it, and hci_qca asks the same one
+		 * to decide which firmware applies.
+		 */
+		{
+			static const uint8_t ver[4] = { 0x01, 0x01, 0x10, 0x00 };
+
+			n = mondrian_bt_send(se, ver, sizeof(ver), out, len, n);
+			n = mondrian_bt_recv(se, buf, sizeof(buf), 400, out, len, n);
+		}
+		return n;
+	}
+	if (mode != NULL && strcmp(mode, "hci") == 0) {
+		static const uint8_t reset[4] = { 0x01, 0x03, 0x0c, 0x00 };
+
+		n = mondrian_bt_uart_init(se, 10, 19200000u, 0, out, len, n);
+		n = mondrian_bt_send(se, reset, sizeof(reset), out, len, n);
+		n = mondrian_bt_recv(se, buf, sizeof(buf), 150, out, len, n);
+		return n;
+	}
+
+	/* No mode: the identity probe, unchanged. */
+	{
+		uint32_t vote, halt5, init, cgc, clk, fw, hw;
+
+		vote = mondrian_bt_rd(gcc, MONDRIAN_BT_VOTE_REG);
+		snprintf(line, sizeof(line), "btuart: vote 0x%x (want 0x%x) %s\n",
+		    vote, MONDRIAN_BT_WANT,
+		    (vote & MONDRIAN_BT_WANT) == MONDRIAN_BT_WANT ? "granted" :
+		    "NOT granted");
+		n = mondrian_bt_step(out, len, n, line);
+
+		halt5 = mondrian_bt_rd(gcc, MONDRIAN_BT_HALT_SE5);
+		snprintf(line, sizeof(line),
+		    "btuart: halt se5 0x%x%s\n", halt5,
+		    (halt5 & MONDRIAN_BT_HALTED) ? " se5 STILL HALTED" : "");
+		n = mondrian_bt_step(out, len, n, line);
+
+		hw = mondrian_bt_rd(wrap, MONDRIAN_BT_QUPV3_HW_VER);
+		snprintf(line, sizeof(line), "btuart: wrapper2 hw ver 0x%x\n", hw);
+		n = mondrian_bt_step(out, len, n, line);
+
+		init = mondrian_bt_rd(se, MONDRIAN_BT_SE_INIT_CFG_REV);
+		snprintf(line, sizeof(line), "btuart: se init 0x%x\n", init);
+		n = mondrian_bt_step(out, len, n, line);
+		cgc = mondrian_bt_rd(se, MONDRIAN_BT_SE_CGC_CTRL);
+		snprintf(line, sizeof(line), "btuart: se cgc 0x%x\n", cgc);
+		n = mondrian_bt_step(out, len, n, line);
+		clk = mondrian_bt_rd(se, MONDRIAN_BT_SE_CLK_CTRL_RO);
+		snprintf(line, sizeof(line), "btuart: se clk 0x%x\n", clk);
+		n = mondrian_bt_step(out, len, n, line);
+		fw = mondrian_bt_rd(se, MONDRIAN_BT_SE_FW_REV);
+		snprintf(line, sizeof(line), "btuart: se fw 0x%x\n", fw);
+		n = mondrian_bt_step(out, len, n, line);
+	}
+	return n;
+}
+
+#endif /* MONDRIAN */
