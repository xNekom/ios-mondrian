+/*
+ * "btuart [loop|hci]" runs the Bluetooth engine: no argument reads the identity
+ * registers with the clocks voted, "loop" programs the UART and waits for the
+ * byte on its own RX, "hci" sends HCI_Reset 01 03 0c 00 and prints whatever
+ * comes back. The stages exist because they fail differently: an engine that
+ * does not answer, an engine that answers but cannot frame a byte, and a byte
+ * that reaches the wrong far end.
+ */
+static void
+ud_cmd_btuart(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_btuart_run(const char *mode, char *out, size_t len);
+	char out[1152];
+	const char *p = line + 6;
+	int n;
+
+	while (*p == ' ') {
+		p++;
+	}
+	n = mondrian_btuart_run(*p != '\0' ? p : NULL, out, sizeof(out));
+	ud_cmd_send(so, to, out, (size_t)n);
+}
