--- a/bsd/dev/mondrian_usb.c
+++ b/bsd/dev/mondrian_usb.c
@@ -2138,6 +2138,24 @@ ud_cmd_hap(socket_t so, struct sockaddr_in *to, const char *line)
 	printf("%s", out);
 }
 
+/*
+ * "btuart" maps the Bluetooth engine (QUPv3 wrapper 2, SE5 at 0x894000) with
+ * its clocks voted and prints what it answers. It transfers nothing: the first
+ * question is whether the register window is alive, and a driver that loads
+ * firmware into a dead engine only hides that.
+ */
+static void
+ud_cmd_btuart(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_btuart_probe(char *out, size_t len);
+	char out[384];
+	int n;
+
+	(void)line;
+	n = mondrian_btuart_probe(out, sizeof(out));
+	ud_cmd_send(so, to, out, (size_t)n);
+}
+
 static void
 ud_cmd_hapreg(socket_t so, struct sockaddr_in *to, const char *line)
 {
@@ -2591,6 +2609,8 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 			    strcmp(cmd, "vib") == 0 ||
