+		words[n++] = 0x408e0601u;	/* RB_UNKNOWN_8E06 */
+		words[n++] = 0x02080000u;	/* a730 magic_regs value */
+		words[n++] = 0x40800701u;	/* GRAS_UNKNOWN_8007 */
+		words[n++] = 0x00000000u;
+		words[n++] = 0x40811001u;	/* GRAS_UNKNOWN_8110 */
+		words[n++] = 0x00000002u;
+		words[n++] = 0x408e0901u;	/* RB_UNKNOWN_8E09 */
+		words[n++] = 0x00000004u;
+		words[n++] = 0x70650001u;	/* CP_SET_MARKER */
