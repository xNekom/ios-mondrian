xnu 0248: put the a7xx sysmem registers in front of the 2D blit

fd6_emit_sysmem_prep() writes five a7xx registers and a direct-render
marker before a sysmem pass; RB_UNKNOWN_8812 = 0x3ff is the one that says
the render targets are in system memory. The replay now emits that block
ahead of the blit, off by default: with it the blit never fences and the CP
stops answering its register port, so the 2D engine needs the render-target
setup that comes with the registers, not the registers alone.

The same line reads back RB_UNKNOWN_8812, RB_UNKNOWN_8E06, RB_UNKNOWN_8E09
and RBBM_INT_0_STATUS: whether the block took, and whether the UCHE or the
trusted-size check latched an error the masked interrupt hid.
--- a/iokit/Kernel/arm/MondrianGPU.cpp
+++ b/iokit/Kernel/arm/MondrianGPU.cpp
@@ -793,6 +793,29 @@
 }
 
 /*
+ * gpu2dsysmem=1: put the a7xx direct-render registers in front of the
+ * blit, the set fd6_emit_sysmem_prep() writes (RB_UNKNOWN_8812 = 0x3ff marks
+ * every render target as living in system memory). Measured: the blit then
+ * never fences and the CP stops answering its register port, so the 2D engine
+ * needs the render-target setup that comes with those registers, not just the
+ * registers; off by default. Mesa emits the same block on every frame and
+ * frames fence, so the switch is in effect on the UI path either way.
+ */
+static int
+mondrian_uc_2dfill_sysmem(void)
+{
+	static int parsed, on = 0;
+
+	if (!parsed) {
+		parsed = 1;
+		if (!PE_parse_boot_argn("gpu2dsysmem", &on, sizeof(on))) {
+			on = 0;
+		}
+	}
+	return on != 0;
+}
+
