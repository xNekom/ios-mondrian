--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10978,10 +10978,23 @@ pmap_insert_commpage_internal(
 
 #elif (ARM_PGSHIFT == 12)
 /**
- * Ensure that 64-bit devices using 4K pages can nest the commpage completely
- * above the maximum userspace VA.
+ * The commpage is nested in a 1 GiB region that is reserved in every user
+ * address space (vm_reserved_regions[] in
+ * osfmk/arm64/machine_routines.c), so the L1 entry of that region holds
+ * nothing but the commpage tables and the commpage can live inside the user
+ * VA range.
+ *
+ * The original check (the commpage completely above the maximum userspace
+ * VA) does not hold on this board: with 4 KiB pages an L1 entry covers
+ * 1 GiB, and the MacOSX platform gives the user a 140 TiB VA, so the
+ * commpage would have to move out of the userspace address space, where
+ * the iOS userland cannot map it.
+ *
+ * What has to hold instead is that the commpage and its nesting region
+ * share an L1 entry, and that this entry is the reserved one.
  */
-static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) ==
+    (_COMM_PAGE64_NESTING_START & ~ARM_TT_L1_OFFMASK));
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
