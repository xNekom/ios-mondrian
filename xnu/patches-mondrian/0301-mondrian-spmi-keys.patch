xnu 0301: power and volume keys over SPMI

The boot menu already reads the same two PMIC pages in the shim; the kernel
now has the other half. A thread polls the PMK8350 PON's real-time status
(power bit 7, volume down bit 6, active high) and the PM8350 GPIO6 page
(volume up, active low) and publishes both edges through MondrianHIDButtons,
so SpringBoard's power and volume keys work. The arbiter is v7 and the APIDs
are scanned from its map, not hardcoded; mondriankeys=0 disables the thread.

The bus is read-only: the only store is the arbiter's one-byte EXT_READL
command. Addresses and page numbers are the live tree's
(soc/qcom,spmi@c42d000, pmk8350@0 pon_hlos@1300, pm8350@1 pinctrl@8800 pin 6).

--- /dev/null
+++ b/bsd/dev/mondrian_spmi.c
@@ -0,0 +1,224 @@
+/*
+ * MONDRIAN: the side and volume keys, read over SPMI.
+ *
+ * The boot menu in the shim already reads the same two PMIC pages
+ * (shim/spmi.c), and this is the kernel half: a thread polls the PON's
+ * real-time status and the PM8350 GPIO and publishes edges through the
+ * MondrianHIDButtons service, so SpringBoard gets the power and volume keys
+ * it expects. Nothing writes the PMIC: the only bus store is the arbiter's
+ * one-byte EXT_READL command.
+ *
+ * Live device tree (2026-11-09):
+ *   soc/qcom,spmi@c42d000, compatible qcom,spmi-pmic-arb, arbiter v7
+ *     reg-names "cnfg" 0x0c42d000/0x4000, "core" 0x0c400000/0x3000,
+ *               "chnls" 0x0c500000/0x400000, "obsrvr" 0x0c440000/0x80000,
+ *               "intr" 0x0c4c0000/0x10000
+ *   soc/.../qcom,pmk8350@0/pon_hlos@1300   sid 0, peripheral 0x13
+ *     power in bit 7 of RT_STATUS (0x10), volume down in bit 6, active high
+ *   soc/.../qcom,pm8350@1/pinctrl@8800     sid 1, peripheral 0x88
+ *     /soc/gpio_keys/vol_up is pin 6, so its own page is 0x18d; the level
+ *     is bit 0 of RT_STATUS and the pin is pulled up, so it reads 0 held.
+ *
+ * The arbiter's APID for each peripheral is assigned at boot; scan the map
+ * instead of hardcoding an observer channel. mondriankeys=0 disables the
+ * thread for a boot that needs to rule it out.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int hz;
+extern void mondrian_hid_key(int key, int down);
+
+#define MONDRIAN_SPMI_CORE	0x0c400000u
+#define MONDRIAN_SPMI_CORE_SIZE	0x3000u
+#define MONDRIAN_SPMI_CNFG	0x0c42d000u
+#define MONDRIAN_SPMI_CNFG_SIZE	0x4000u
+#define MONDRIAN_SPMI_OBS	0x0c440000u
+#define MONDRIAN_SPMI_OBS_SIZE	0x8000u
+
+#define MONDRIAN_SPMI_COUNT_MAX	1024
+#define MONDRIAN_SPMI_REG_STATUS	0x10u
+#define MONDRIAN_SPMI_PON_PPID	0x0013u	/* pmk8350@0 pon_hlos@1300 */
+#define MONDRIAN_SPMI_GPIO_PPID	0x018du	/* pm8350@1 pinctrl@8800 pin 6 */
+
+#define MONDRIAN_SPMI_HZ	20	/* polls a second */
+#define MONDRIAN_SPMI_RETRIES	2000
+
+#define MONDRIAN_SPMI_KEY_POWER	0
+#define MONDRIAN_SPMI_KEY_VOLUP	1
+#define MONDRIAN_SPMI_KEY_VOLDOWN 2
+
+static volatile uint32_t *sp_core, *sp_cnfg, *sp_obs;
+static uint32_t sp_count;
+static uint32_t sp_obs_stride = 0x20, sp_map_off = 0x2000, sp_owner_off = 0;
+static uint16_t sp_pon = 0xffffu, sp_gpio = 0xffffu;
+static int sp_disabled;
+
+static uint32_t
+sp_rd(volatile uint32_t *base, uint32_t off)
+{
+	uint32_t v = base[off / 4];
+
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static int
+sp_read(uint16_t apid, uint32_t off, uint8_t *out)
+{
+	uintptr_t q = (uintptr_t)sp_obs + (uintptr_t)apid * sp_obs_stride;
+	uint32_t cmd = (1u << 27) | ((off & 0xffu) << 4);
+
+	*(volatile uint32_t *)q = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < MONDRIAN_SPMI_RETRIES; i++) {
+		uint32_t st = sp_rd((volatile uint32_t *)q, 0x08u);
+
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return 0;
+			}
+			*out = (uint8_t)sp_rd((volatile uint32_t *)q, 0x18u);
+			return 1;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+static uint16_t
+sp_find_apid(uint16_t ppid)
+{
+	uint16_t found = 0xffffu;
+
+	for (uint32_t i = 0; i < sp_count; i++) {
+		uint32_t map = sp_rd(sp_core, sp_map_off + 4u * i);
+
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = sp_rd(sp_cnfg, sp_owner_off + 4u * i) & 7u;
+
+		if (found == 0xffffu || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static void
+sp_key(int key, const char *name, bool now, bool was)
+{
+	if (now == was) {
+		return;
+	}
+	printf("MONDRIAN SPMI: %s %s\n", name, now ? "down" : "up");
+	mondrian_hid_key(key, now);
+}
+
+static void
+mondrian_spmi_thread(__unused void *arg, __unused wait_result_t wait)
+{
+	static int chan;
+	int ticks = MAX(hz / MONDRIAN_SPMI_HZ, 1);
+	uint8_t pon = 0, gpio = 0;
+	bool have = false;
+
+	for (;;) {
+		uint8_t p = 0, g = 0;
+
+		(void)tsleep(&chan, PZERO, "mspmi", ticks);
+		if (sp_disabled) {
+			continue;
+		}
+		if (!sp_read(sp_pon, MONDRIAN_SPMI_REG_STATUS, &p) ||
+		    !sp_read(sp_gpio, MONDRIAN_SPMI_REG_STATUS, &g)) {
+			/*
+			 * One failed transaction is a broken arbiter, not a
+			 * key. Stop polling instead of spending a timeout
+			 * every tick; a reboot is the recovery.
+			 */
+			printf("MONDRIAN SPMI: key read failed, polling stopped\n");
+			sp_disabled = 1;
+			continue;
+		}
+		if (!have) {
+			pon = p;
+			gpio = g;
+			have = true;
+		}
+		sp_key(MONDRIAN_SPMI_KEY_POWER, "power", (p & 0x80u) != 0,
+		    (pon & 0x80u) != 0);
+		sp_key(MONDRIAN_SPMI_KEY_VOLDOWN, "vol-down", (p & 0x40u) != 0,
+		    (pon & 0x40u) != 0);
+		sp_key(MONDRIAN_SPMI_KEY_VOLUP, "vol-up", (g & 1u) == 0,
+		    (gpio & 1u) == 0);
+		pon = p;
+		gpio = g;
+	}
+}
+
+void
+mondrian_spmi_probe(void)
+{
+	uint32_t version;
+	uint8_t p = 0, g = 0;
+	int enable = 1;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("mondriankeys", &enable, sizeof(enable)) && enable == 0) {
+		printf("MONDRIAN SPMI: keys disabled by mondriankeys=0\n");
+		return;
+	}
+	sp_core = (volatile uint32_t *)ml_io_map(MONDRIAN_SPMI_CORE, MONDRIAN_SPMI_CORE_SIZE);
+	sp_cnfg = (volatile uint32_t *)ml_io_map(MONDRIAN_SPMI_CNFG, MONDRIAN_SPMI_CNFG_SIZE);
+	sp_obs = (volatile uint32_t *)ml_io_map(MONDRIAN_SPMI_OBS, MONDRIAN_SPMI_OBS_SIZE);
+	if (sp_core == NULL || sp_cnfg == NULL || sp_obs == NULL) {
+		printf("MONDRIAN SPMI: mapping failed\n");
+		return;
+	}
+	version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (version >= 0x70000000u) {
+		sp_obs_stride = 0x20;
+		sp_map_off = 0x2000;
+		sp_owner_off = 0;
+	} else if (version >= 0x50000000u) {
+		sp_obs_stride = 0x80;
+		sp_map_off = 0x900;
+		sp_owner_off = 0x700;
+	} else {
+		printf("MONDRIAN SPMI: unsupported arbiter 0x%x\n", version);
+		return;
+	}
+	if (sp_count == 0 || sp_count > MONDRIAN_SPMI_COUNT_MAX) {
+		printf("MONDRIAN SPMI: bad APID count %u\n", sp_count);
+		return;
+	}
+	sp_pon = sp_find_apid(MONDRIAN_SPMI_PON_PPID);
+	sp_gpio = sp_find_apid(MONDRIAN_SPMI_GPIO_PPID);
+	if (sp_pon == 0xffffu || sp_gpio == 0xffffu) {
+		printf("MONDRIAN SPMI: no key APIDs (pon %s, gpio %s)\n",
+		    sp_pon == 0xffffu ? "missing" : "ok",
+		    sp_gpio == 0xffffu ? "missing" : "ok");
+		return;
+	}
+	if (!sp_read(sp_pon, MONDRIAN_SPMI_REG_STATUS, &p) ||
+	    !sp_read(sp_gpio, MONDRIAN_SPMI_REG_STATUS, &g)) {
+		printf("MONDRIAN SPMI: key page did not answer\n");
+		return;
+	}
+	if (kernel_thread_start(mondrian_spmi_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("MONDRIAN SPMI: no key thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+	printf("MONDRIAN SPMI: keys arb 0x%x APIDs %u pon %u gpio %u status 0x%02x/0x%02x\n",
+	    version, sp_count, sp_pon, sp_gpio, p, g);
+}
diff --git a/bsd/conf/files b/bsd/conf/files
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -110,6 +110,7 @@
 bsd/dev/mondrian_touch.c		standard
 bsd/dev/mondrian_usb.c			standard
 bsd/dev/mondrian_cpufreq.c		standard
+bsd/dev/mondrian_spmi.c		standard
 bsd/dev/mondrian_gpu.c			standard
 bsd/dev/mem.c				standard
 bsd/dev/munge.c 			optional config_requires_u32_munging
diff --git a/bsd/dev/mondrian_ufs.c b/bsd/dev/mondrian_ufs.c
--- a/bsd/dev/mondrian_ufs.c
+++ b/bsd/dev/mondrian_ufs.c
@@ -1964,10 +1964,12 @@
 		extern int mondrian_gpu_probe(void);
 		extern void mondrian_touch_probe(void);
 		extern void mondrian_usb_probe(void);
+		extern void mondrian_spmi_probe(void);
 
 		(void)mondrian_gpu_probe();
 		mondrian_touch_probe();
 		mondrian_usb_probe();
+		mondrian_spmi_probe();
 	}
 }
 
