 			forkp->cf_new_size = 0;
 			forkp->cf_blocks = recp->hfsPlusFile.dataFork.totalBlocks;
+			/*
+			 * MONDRIAN: the record on disk claims data and no
+			 * blocks. Every later lookup of it marks the volume.
+			 */
+			{
+				static int mondrian_noblocks_read;
+
+				if (forkp->cf_blocks == 0 && forkp->cf_size != 0 &&
+				    mondrian_noblocks_read++ < 8) {
