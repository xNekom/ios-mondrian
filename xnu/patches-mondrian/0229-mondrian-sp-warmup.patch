+/*
+ * The command-buffer-start quirk of the 725/730: the shader and the registers
+ * around it, laid out exactly as Turnip's `tu_init_cmdbuf_start_a725_quirk`
+ * (a7xx field offsets from adreno_pm4.xml). The shader is a multiply over the
+ * whole array -- `NGROUPS_X` 12, the SP's waves -- and stops; no state the
+ * callers keep is left modified that CoreAnimation does not re-emit at its
+ * own start.
+ */
+static void
+mondrian_uc_quirk_build(void)
+{
+	uint32_t *p = (uint32_t *)(mondrian_uc_quirk.va + 64);
+	static const uint32_t shader[10] = {
+		0x00040000, 0x40600000,		/* mul.f hr0.x, hr0.x, hr1.x */
+		0x00050001, 0x40600001,		/* mul.f hr0.y, hr0.y, hr1.y */
+		0x00060002, 0x40600002,		/* mul.f hr0.z, hr0.z, hr1.z */
+		0x00070003, 0x40600003,		/* mul.f hr0.w, hr0.w, hr1.w */
+		0x00000000, 0x03000000,		/* end */
+	};
+	const uint64_t shader_iova = mondrian_uc_quirk.iova;
+	const uint32_t one = 1;
+
+	memcpy((void *)mondrian_uc_quirk.va, shader, sizeof(shader));
+
+	*p++ = mondrian_pm4_type4(0xab1fu, 1);		/* HLSQ_INVALIDATE_CMD */
+	*p++ = 0x01ffff9fu;				/* all shader stages, both bindless */
+	*p++ = mondrian_pm4_type4(0xa9cfu, 1);		/* HLSQ_CS_CNTL */
+	*p++ = 0x101u;					/* constlen 4 dwords, enabled */
+	*p++ = mondrian_pm4_type4(0xa9bbu, 1);		/* SP_CS_CONFIG */
+	*p++ = 1;					/* enabled */
+	*p++ = mondrian_pm4_type4(0xa9b0u, 1);		/* SP_CS_CTRL_REG0 */
+	*p++ = 0x80100001u;				/* MULTI, THREAD128, MERGEDREGS */
+	*p++ = mondrian_pm4_type4(0xa9b1u, 1);		/* SP_CS_CTRL_REG1 */
+	*p++ = 1;					/* 2k of shared */
+	*p++ = mondrian_pm4_type4(0xa9dcu, 3);		/* HLSQ_CS_KERNEL_GROUP */
+	*p++ = one; *p++ = one; *p++ = one;
+	*p++ = mondrian_pm4_type4(0xa9bau, 1);		/* SP_CS_TEX_COUNT */
+	*p++ = 0;
+	*p++ = mondrian_pm4_type4(0xa9bcu, 1);		/* SP_CS_INSTRLEN */
+	*p++ = 1;
+	*p++ = mondrian_pm4_type4(0xaa00u, 1);		/* SP_CS_IBO_COUNT */
+	*p++ = 0;
+	*p++ = mondrian_pm4_type4(0xa9dbu, 1);		/* HLSQ_CS_CNTL_1 */
+	*p++ = 0x44400a3fu;				/* LINEARLOCAL 63, THREAD128, ZFIRSTEN, tile 4x17 */
+	*p++ = mondrian_pm4_type4(0xa9c2u, 2);		/* SP_CS_CNTL_0 + _1 */
+	*p++ = 0xfcfcc0cfu;				/* wg/wgsize/wgoffset/local */
+	*p++ = 0x813fu;					/* linear local 63, THREAD128, TILED */
+	*p++ = mondrian_pm4_type4(0xa9beu, 1);		/* SP_CS_UNKNOWN_A9BE */
+	*p++ = 0;
+	*p++ = mondrian_pm4_type4(0xa9d4u, 7);		/* HLSQ_CS_NDRANGE_0..6 */
+	*p++ = 0x3fbu;					/* kerneldim 3, local 255x0x0 */
+	*p++ = 3072;
+	*p++ = 0;
+	*p++ = 1;
+	*p++ = 0;
+	*p++ = 1;
+	*p++ = 0;
+	*p++ = mondrian_pm4_type4(0xa9dfu, 1);		/* HLSQ_CS_LAST_LOCAL_SIZE */
+	*p++ = 0x3f8u;
+	*p++ = mondrian_pm4_type4(0xa9b3u, 3);		/* SP_CS_OBJ_FIRST_EXEC_OFFSET + START */
+	*p++ = 0;
+	*p++ = (uint32_t)shader_iova;
+	*p++ = (uint32_t)(shader_iova >> 32);
+	*p++ = mondrian_pm4_type7(0x03u, 4);		/* CP_EXEC_CS */
+	*p++ = 0;
+	*p++ = 12;					/* NGROUPS_X: 12 * 255 waves */
+	*p++ = 1;
+	*p++ = 1;
+	mondrian_uc_quirk_words =
+	    (uint32_t)((uint8_t *)p - (mondrian_uc_quirk.va + 64)) / 4;
+}
