@@ -1470,7 +1487,7 @@
 	uint64_t total = os_atomic_load(&mondrian_log_total, relaxed);
 
 	if (total - os_atomic_load(&mondrian_log_flushed, relaxed) >= MONDRIAN_LOG_KICK_BYTES) {
-		mondrian_log_store(total);
+		mondrian_log_store(total, 0);
 	}
 	/*
 	 * No sampler tick here: this runs inside the UFS strategy path, and the
@@ -1489,17 +1506,17 @@
 
 		total = os_atomic_load(&mondrian_log_total, relaxed);
 		before = os_atomic_load(&mondrian_log_flushed, relaxed);
-		mondrian_log_store(total);
+		mondrian_log_store(total, 0);
 		/*
-		 * Paint until the panel is within a line or two of the newest
