+		assert_wait((event_t)&mondrian_log_chan, THREAD_UNINT);
+		thread_block(THREAD_CONTINUE_NULL);
 	}
 }
 
@@ -1418,6 +1442,8 @@ mondrian_log_start(void)
 		return;
 	}
 	mondrian_log_base = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS;
+	os_atomic_store(&mondrian_log_next_wake,
+	    os_atomic_load(&mondrian_log_total, relaxed) + MONDRIAN_LOG_KICK_BYTES, relaxed);
 	os_atomic_store(&mondrian_log_ready, 1, relaxed);
 	kr = kernel_thread_start(mondrian_log_thread, NULL, &thread);
