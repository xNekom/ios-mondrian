+/*
+ * What the topology parse saw and did, for the console (arm_init is too early
+ * to print, so the numbers are kept and reported from the CPU start).
+ */
+void
+ml_small_cores_report(void)
+{
+	char line[256];
+	int used = 0;
+
+	used += snprintf(line + used, sizeof(line) - used, "MONDRIAN CPU: small_cores=%u fastest=%u cap",
