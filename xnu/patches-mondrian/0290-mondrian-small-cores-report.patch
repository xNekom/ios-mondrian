+	used += snprintf(line + used, sizeof(line) - used, " partner");
+	for (int i = 0; i < (int)topology_info.num_cpus && used < (int)sizeof(line) - 8; i++) {
+		used += snprintf(line + used, sizeof(line) - used, " %d", ml_slow_core_partner[i]);
+	}
+	kprintf("%s\n", line);
+}
