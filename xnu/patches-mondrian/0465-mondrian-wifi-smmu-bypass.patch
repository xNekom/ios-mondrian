diff --git a/bsd/dev/mondrian_wifi_smmu.c b/bsd/dev/mondrian_wifi_smmu.c
index dbfbb9c..add6761 100644
--- a/bsd/dev/mondrian_wifi_smmu.c
+++ b/bsd/dev/mondrian_wifi_smmu.c
@@ -81,6 +81,7 @@ extern void mondrian_log_flush_now(void);
 #define W2_MAIR0_VALUE      0x0000ff44u
 #define W2_SCTLR_VALUE      0x00000027u
 #define W2_S2CR_FAULT       0x00020000u
+#define W2_S2CR_BYPASS      0x00010000u
 
 struct w2_mem {
     vm_offset_t raw;
@@ -814,6 +815,36 @@ mondrian_wifi_smmu_map_va(vm_offset_t va, vm_size_t bytes, uint64_t *iova_out)
  * with a matching FAR means the BHI read reached the SMMU and the page table
  * is wrong; a clean FSR with a stuck doorbell means the device never fetched.
  */
+/*
+ * W15: route this stream around the tables for one experiment. With bypass the
+ * device reads host physical memory directly, so a transfer that completes
+ * with bypass and stalls with translation names the table as the fault.
+ */
+int
+mondrian_wifi_smmu_bypass(int on)
+{
+    if (w2.smmu == 0 || !w2.sid_attached) {
+        return -1;
+    }
+    if (on) {
+        if (w2_put32(W2_S2CR(w2.slot), W2_S2CR_BYPASS | w2.valid_s2cr)) {
+            return -1;
+        }
+        if (w2.slot2_touched &&
+            w2_put32(W2_S2CR(w2.slot2), W2_S2CR_BYPASS | w2.valid_s2cr)) {
+            return -1;
+        }
+        return 0;
+    }
+    if (w2_put32(W2_S2CR(w2.slot), w2.route_s2cr)) {
+        return -1;
+    }
+    if (w2.slot2_touched && w2_put32(W2_S2CR(w2.slot2), w2.route_s2cr2)) {
+        return -1;
+    }
+    return 0;
+}
+
 int
 mondrian_wifi_smmu_fault(uint32_t *sctlr, uint32_t *fsr, uint32_t *far,
     uint32_t *fsynr, uint32_t *gfsr, uint32_t *s2cr, uint32_t *s2cr2)
