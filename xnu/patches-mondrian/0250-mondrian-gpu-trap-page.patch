+/*
+ * Read after a 2D blit has fenced. Two questions, one page and one table:
+ *
+ * - UCHE_TRAP_BASE and UCHE_WRITE_THRU_BASE both name this page when
+ *   gputrap=1, so a non-zero word in it is a write the UCHE could not
+ *   translate. The whole 4 KiB is scanned: the hardware aligns the trap
+ *   address down to a page, and an earlier probe that read offset 0xf00 of
+ *   a shared page saw nothing even when the blit had gone somewhere.
+ * - A write that is not trapped is one the SMMU refused, and the port masks
+ *   every interrupt, so the only trace is a latched FSR/FAR. Bank 0 is the
+ *   CP's; the next banks and the global registers say whether the GPU's
+ *   non-CP traffic is matched by the stream table at all.
+ */
+void
+mondrian_gpu_uc_trap_report(void)
+{
+	volatile uint32_t *t;
+	uint32_t k, nz = 0, first = 0, at = 0;
+
+	if (mondrian_cp_trap_watch == 0 || mondrian_cp_trap_view == 0) {
+		return;
+	}
+	t = (volatile uint32_t *)mondrian_cp_trap_view;
+	for (k = 0; k < 0x1000u / 4u; k++) {
+		uint32_t v = t[k];
+
+		if (v != 0) {
+			if (nz == 0) {
+				first = v;
+				at = k * 4u;
+			}
+			nz++;
+		}
+	}
+	printf("MondrianGPU: 2d trap page nz %u/1024 first 0x%08x at 0x%x"
+	    " base 0x%llx\n", nz, first, at,
+	    (unsigned long long)mondrian_cp_trap.iova);
+	mondrian_log_flush_now();
+	if (mondrian_uc_smmu == 0 || mondrian_uc_tlb_ctx == 0) {
+		return;
+	}
+	mondrian_uc_keepalive(1);
+	printf("MONDRIAN GPU: smmu gfsr 0x%x gfsynr0 0x%x gfsynr1 0x%x"
+	    " ctx 0x%x\n",
+	    mondrian_gpu_read(mondrian_uc_smmu, SMMU_GFSR),
+	    mondrian_gpu_read(mondrian_uc_smmu, SMMU_GFSYNR0),
+	    mondrian_gpu_read(mondrian_uc_smmu, SMMU_GFSYNR1),
+	    mondrian_uc_tlb_ctx);
+	for (k = 0; k < 4; k++) {
+		uint32_t c = mondrian_uc_tlb_ctx + k * 0x1000u;
+
+		printf("MONDRIAN GPU: smmu ctx%u sctlr 0x%x fsr 0x%x far 0x%x"
+		    " ttbr0 0x%llx\n", k,
+		    mondrian_gpu_read(mondrian_uc_smmu, c + SMMU_SCTLR),
+		    mondrian_gpu_read(mondrian_uc_smmu, c + SMMU_FSR),
+		    mondrian_gpu_read(mondrian_uc_smmu, c + SMMU_FAR),
+		    (unsigned long long)mondrian_smmu_read64(mondrian_uc_smmu,
+		    c + SMMU_TTBR0));
+	}
+	for (k = 0; k < 8; k++) {
+		printf("MONDRIAN GPU: smmu s%u smr 0x%x s2cr 0x%x\n", k,
+		    mondrian_gpu_read(mondrian_uc_smmu, SMMU_SMR(k)),
+		    mondrian_gpu_read(mondrian_uc_smmu, SMMU_S2CR(k)));
+	}
+	mondrian_uc_keepalive(0);
+	mondrian_log_flush_now();
+}
