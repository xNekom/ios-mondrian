+/*
+ * "rf PATH [OFFSET [LEN]]": read LEN bytes (1000 by default) of a file at
+ * OFFSET and answer with them raw. The ring had a writer (`wfile`) and no
+ * reader, which is why a daemon's stderr was unreadable: a launchd job can be
+ * pointed at a file, but nothing could bring the file back. Reading is done
+ * through the same root the writer uses.
+ */
+#define UD_RF_MAX       1000
+
+static void
+ud_cmd_rf(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_root_read(const char *path, void *data,
+	    unsigned len, off_t off);
+	char path[128];
+	char buf[UD_RF_MAX];
+	const char *p = line + 2;
+	const char *q;
+	uint32_t off = 0;
+	uint32_t len = UD_RF_MAX;
+	size_t path_len;
+	char out[160];
+	int n;
+
+	while (*p == ' ' || *p == '\t') {
+		p++;
+	}
+	for (q = p; *q != 0 && *q != ' ' && *q != '\t'; q++) {
+		;
+	}
+	path_len = (size_t)(q - p);
+	if (path_len == 0 || path_len >= sizeof(path)) {
+		n = snprintf(out, sizeof(out), "rf needs a path\n");
+		ud_cmd_send(so, to, out, (size_t)n);
+		return;
+	}
+	memcpy(path, p, path_len);
+	path[path_len] = 0;
+	p = q;
+	if ((p = ud_cmd_num(p, &off)) == NULL) {
+		off = 0;
+		p = q;
+	}
+	if (ud_cmd_num(p, &len) == NULL) {
+		len = UD_RF_MAX;
+	}
+	if (len == 0 || len > UD_RF_MAX) {
+		len = UD_RF_MAX;
+	}
+	n = mondrian_root_read(path, buf, len, (off_t)off);
+	if (n <= 0) {
+		n = snprintf(out, sizeof(out), "rf %s at %u: %d\n", path, off,
+		    n);
+		ud_cmd_send(so, to, out, (size_t)n);
+		return;
+	}
+	ud_cmd_send(so, to, buf, (size_t)n);
+}
