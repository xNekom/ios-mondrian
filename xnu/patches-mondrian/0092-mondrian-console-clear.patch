xnu 0092: wrap the console without clearing the screen

When the cursor reached the last row the console cleared the whole text
area before starting again at the top. The row it is about to write is
cleared anyway, so the full clear was 18 MB of framebuffer writes for
nothing: once the screen was full every line paid it, the console spent
all its time clearing, console_write()'s ring buffer backed up and the log
arrived in bursts instead of line by line.

Wrap the row index instead (the text stays where it is, a ring) and mark
the cursor cell, so a photo still says where the newest line is: it is the
one above the mark, and the reading order continues at the top.

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -722,6 +722,7 @@
 #define FBCON_SCALE     2
 #define FBCON_FG        0xffffffffu
 #define FBCON_BG        0xff000000u
+#define FBCON_CURSOR    0xff303060u
 
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
@@ -746,26 +747,49 @@
 	return fbcon_phys_end;
 }
 
+/*
+ * Fill whole scanlines with the background. A row is 5760 bytes and the
+ * console wraps by clearing the whole text area (18 MB) once the screen is
+ * full, so this is the busiest loop in a verbose boot: 64-bit stores halve
+ * the count and keep the write pipeline fed.
+ */
 static void
-fbcon_clear_row(uint32_t row)
+fbcon_fill_rows(uint32_t y0, uint32_t y1)
 {
-	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
-		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
-		for (uint32_t x = 0; x < fbcon_width; x++) {
-			line[x] = FBCON_BG;
+	uint64_t const bg = ((uint64_t)FBCON_BG << 32) | FBCON_BG;
+	uint32_t const words = fbcon_stride / sizeof(uint64_t);
+
+	for (uint32_t y = y0; y < y1; y++) {
+		volatile uint64_t *line =
+		    (volatile uint64_t *)(fbcon_base + y * (fbcon_stride / 4));
+		for (uint32_t i = 0; i < words; i++) {
+			line[i] = bg;
 		}
 	}
 }
 
-/* Blank the whole text area; the next glyph goes to the top row. */
 static void
-fbcon_clear_screen(void)
+fbcon_clear_row(uint32_t row)
 {
-	uint32_t rows = fbcon_rows * 16 * FBCON_SCALE;
-	for (uint32_t y = 0; y < rows; y++) {
-		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
-		for (uint32_t x = 0; x < fbcon_width; x++) {
-			line[x] = FBCON_BG;
+	fbcon_fill_rows(row * 16 * FBCON_SCALE, (row + 1) * 16 * FBCON_SCALE);
+}
+
+/* Blank the whole text area; the next glyph goes to the top row. */
+/*
+ * The cursor is a block in the cell the next character goes to. The console
+ * wraps without moving the text (a ring), so the newest line is the one above
+ * the marker and the reading order runs down from it, then continues at the
+ * top; without the marker there is no way to tell where "now" is on a photo.
+ */
+static void
+fbcon_mark_cursor(void)
+{
+	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+
+	for (uint32_t y = y0; y < y0 + 16 * FBCON_SCALE; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4) + x0;
+		for (uint32_t x = 0; x < 8 * FBCON_SCALE; x++) {
+			line[x] = FBCON_CURSOR;
 		}
 	}
 }
@@ -774,13 +798,24 @@
 fbcon_newline(void)
 {
 	fbcon_col = 0;
-	if (fbcon_row + 1 >= fbcon_rows) {
-		fbcon_clear_screen();
+	/*
+	 * Wrap by reusing the top row instead of clearing the whole text area.
+	 * The row about to be written is cleared below anyway, so a full clear
+	 * was 18 MB of framebuffer writes per line once the screen was full:
+	 * the console spent all its time clearing, console_write()'s ring
+	 * buffer backed up, and the log arrived in bursts.
+	 */
+	if (++fbcon_row >= fbcon_rows) {
 		fbcon_row = 0;
-	} else {
-		fbcon_row++;
 	}
 	fbcon_clear_row(fbcon_row);
+	fbcon_mark_cursor();
+	/*
+	 * The framebuffer alias is write-combining: push the row out before
+	 * the next line starts, so the panel shows whole lines instead of
+	 * whatever the store buffer happened to have drained.
+	 */
+	__builtin_arm_dsb(0xf);
 }
 
 /*
@@ -865,6 +900,7 @@
 		}
 	}
 	fbcon_col++;
+	fbcon_mark_cursor();
 }
 
 static unsigned int
