xnu 0156: load the touch firmware in a thread, not in the boot path

The Goodix part runs from RAM and every cold boot loads about 220 KB of
firmware over the bit-banged SPI. That takes about two minutes on this
board, and it ran before launchd: the first frame waited for the touch.
Start the whole bring-up (power, GENI, SPI, firmware, IC info, the
coordinate mode) in a kernel thread and let the report loop follow in the
same thread. The UI boots while the part is being loaded; the first touch
works when the load finishes.

--- a/bsd/dev/mondrian_touch.c
+++ b/bsd/dev/mondrian_touch.c
@@ -1450,27 +1450,19 @@
 	printf("MONDRIAN TOUCH: post-firmware confirm %s\n", same ? "ok" : "bad");
 }
 
-void
-mondrian_touch_probe(void)
+/*
+ * The firmware load is a bit-banged SPI transfer of about 220 KB and takes
+ * about two minutes, and it used to run in the boot path: launchd did not
+ * start until it finished. Run the whole bring-up (power, GENI, SPI, the
+ * firmware, the IC info and the coordinate mode) in a kernel thread instead,
+ * so the UI boots while the part is being loaded; the report loop follows in
+ * the same thread, which then never returns.
+ */
+static void __attribute__((noreturn))
+mondrian_touch_bringup(void *arg, wait_result_t wait)
 {
-	thread_t touch_thread;
-	int touch_on = 1;
-
-	/*
-	 * mondriantouch=0 skips the whole driver. Useful while the UI is being
-	 * brought up: without the firmware the part has no reports and a stale
-	 * report address only feeds backboardd noise.
-	 */
-	PE_parse_boot_argn("mondriantouch", &touch_on, sizeof(touch_on));
-	PE_parse_boot_argn("mondriantouchpoll", &mondrian_touch_poll,
-	    sizeof(mondrian_touch_poll));
-	if (!touch_on) {
-		printf("MONDRIAN TOUCH: disabled by boot arg\n");
-		return;
-	}
-	if (mondrian_touch_poll) {
-		printf("MONDRIAN TOUCH: polling the report block\n");
-	}
+	(void)arg;
+	(void)wait;
 	printf("MONDRIAN TOUCH: TLMM at 0x%lx, reset/irq/avdd pins\n",
 	    (unsigned long)MONDRIAN_TLMM_BASE);
 	mondrian_log_flush_now();
@@ -1506,14 +1498,50 @@
 			printf("MONDRIAN TOUCH: no report address, reports off\n");
 		} else if (mondrian_touch_coor_mode() != 0) {
 			printf("MONDRIAN TOUCH: no coordinate mode, reports off\n");
-		} else if (kernel_thread_start(mondrian_touch_thread, NULL, &touch_thread) == KERN_SUCCESS) {
-			thread_deallocate(touch_thread);
-			printf("MONDRIAN TOUCH: report thread started\n");
 		} else {
-			printf("MONDRIAN TOUCH: report thread failed to start\n");
+			printf("MONDRIAN TOUCH: report thread started\n");
+			mondrian_touch_thread(NULL, THREAD_UNINT);
 		}
 	} else {
 		printf("MONDRIAN TOUCH: no firmware, no reports\n");
 	}
 	mondrian_log_flush_now();
+	/* No reports: park the thread for good; the driver stays out of the way. */
+	for (;;) {
+		(void)tsleep((caddr_t)&mondrian_touch_poll, PZERO - 1,
+		    "mtouchidle", 0);
+	}
 }
+
+void
+mondrian_touch_probe(void)
+{
+	thread_t touch_thread;
+	int touch_on = 1;
+
+	/*
+	 * mondriantouch=0 skips the whole driver. Useful while the UI is being
+	 * brought up: without the firmware the part has no reports and a stale
+	 * report address only feeds backboardd noise.
+	 */
+	PE_parse_boot_argn("mondriantouch", &touch_on, sizeof(touch_on));
+	if (!touch_on) {
+		printf("MONDRIAN TOUCH: disabled by boot arg\n");
+		return;
+	}
+	PE_parse_boot_argn("mondriantouchpoll", &mondrian_touch_poll,
+	    sizeof(mondrian_touch_poll));
+	if (mondrian_touch_poll) {
+		printf("MONDRIAN TOUCH: polling the report block\n");
+	}
+	/*
+	 * Start the bring-up without waiting for it: the boot continues to
+	 * launchd and the panel while the part gets its firmware.
+	 */
+	if (kernel_thread_start(mondrian_touch_bringup, NULL, &touch_thread) == KERN_SUCCESS) {
+		thread_deallocate(touch_thread);
+		printf("MONDRIAN TOUCH: bring-up thread started\n");
+	} else {
+		printf("MONDRIAN TOUCH: bring-up thread failed to start\n");
+	}
+}
