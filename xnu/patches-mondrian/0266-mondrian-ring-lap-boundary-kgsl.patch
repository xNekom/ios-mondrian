+/*
+ * Publish the write cursor, and do not believe it until the GMU says the write
+ * was not dropped. Returns the number of tries it took, 0 when the fence
+ * status was not readable (no GMU in this boot), and 0 after every retry was
+ * dropped -- the caller cannot tell those apart, and the log does.
  */
+static uint32_t
+mondrian_uc_wptr(uint32_t value)
+{
+	uint32_t tries;
+
+	for (tries = 1; tries <= MONDRIAN_WPTR_RETRIES; tries++) {
+		uint32_t status;
+
+		mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u,
+		    value);
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (mondrian_uc_gmu == 0) {
+			return 0;
+		}
+		status = mondrian_gpu_read(mondrian_uc_gmu,
+		    GMU_OFF(MONDRIAN_GMU_AHB_FENCE_STATUS));
+		if (mondrian_uc_wptr_first == 0) {
+			mondrian_uc_wptr_first = 1;
+			printf("MONDRIAN GPU: ahb fence status 0x%x with"
+			    " wptr 0x%x\n", status, value);
+			mondrian_log_flush_now();
+		}
+		if ((status & MONDRIAN_FENCE_WRITEDROPPED) != 0) {
+			mondrian_uc_wptr_drops++;
+			delay(MONDRIAN_WPTR_DELAY_US);
+			continue;
+		}
+		if (tries > 1) {
+			mondrian_uc_wptr_retried++;
+			if (tries > mondrian_uc_wptr_worst) {
+				mondrian_uc_wptr_worst = tries;
+			}
+			if (mondrian_uc_wptr_retried <= 8) {
+				printf("MONDRIAN GPU: uc doorbell 0x%x landed"
+				    " on try %u (worst %u)\n", value, tries,
+				    mondrian_uc_wptr_worst);
+				mondrian_log_flush_now();
+			}
+		}
+		return tries;
+	}
+	if (mondrian_uc_wptr_fails++ < 8) {
+		printf("MONDRIAN GPU: uc doorbell 0x%x never landed, %u"
+		    " writes dropped\n", value, mondrian_uc_wptr_drops);
+		mondrian_log_flush_now();
+	}
+	return 0;
