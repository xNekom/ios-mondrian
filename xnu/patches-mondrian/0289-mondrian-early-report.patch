+/*
+ * Secondary bring-up marker, for a photograph: fills a 32x16 white block at
+ * the bottom-left of the panel, at x = stage * 128 bytes. The MMU is off in
+ * every place it is used, so the framebuffer is written at its physical
+ * address; the console and the panic rows never reach that row, so what is
+ * on the panel is the last stage the core reached before it stopped.
+ * Only the A510 cluster (MPIDR Aff1 0) paints, so the blocks cannot come
+ * from a core that is known to work.
+ *   1 entry          2 EL1 path       3 EL2 path
+ *   4 bad EL         5 cpu_data found 6 no cpu_data entry
+ */
+.macro	MONDRIAN_MARK stage
+	mrs	x16, MPIDR_EL1
+	and	x16, x16, #0xff00
+	cbnz	x16, 7f
+	movz	x9, #0xb800, lsl #16			/* framebuffer, physical */
+	mov	x10, #3168
+	mov	x11, #5760
+	mul	x10, x10, x11
+	add	x9, x9, x10
+	add	x9, x9, #((\stage) * 128)
+	mov	w12, #0xffffffff
+	mov	w13, #16
+9:	mov	w14, #8
+	mov	x15, x9
+8:	str	w12, [x15], #4
+	subs	w14, w14, #1
+	b.ne	8b
+	add	x9, x9, x11
+	subs	w13, w13, #1
+	b.ne	9b
+	dsb	sy
+7:
+.endm
+
 
 
