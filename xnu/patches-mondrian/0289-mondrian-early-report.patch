+/*
+ * Diagnostic stop for the panic path: the format string, the caller and the
+ * first four raw argument words, all built without _doprnt so a bad %s in the
+ * message cannot fault, and the machine stops here so no nested panic scrolls
+ * it away. The two lines sit just above the fixed rows at the bottom.
+ */
+static void
+hud_string_row(unsigned int row, const char *prefix, const char *s,
+    unsigned int max)
+{
+	char line[EARLY_COLS];
+	unsigned int n = 0;
+	unsigned int i;
+	unsigned int len = 0;
+	unsigned int room;
+
+	for (i = 0; prefix[i] != 0 && n < sizeof(line) - 1; i++) {
+		line[n++] = prefix[i];
+	}
+	room = (unsigned int)sizeof(line) - 1 - n;
+	if (max > room) {
+		max = room;
+	}
+	if (s != NULL) {
+		unsigned int has_slash = 0;
+
+		while (s[len] != 0) {
+			if (s[len] == '/') {
+				has_slash = 1;
+			}
+			len++;
+		}
+		/*
+		 * A long path keeps its tail (the name), a long message keeps its
+		 * head (the subject); the build prefix of the first is noise and
+		 * the end of the second is the detail.
+		 */
+		if (len > max && has_slash) {
+			s += len - max;
+		}
+	}
+	for (i = 0; s != NULL && s[i] != 0 && i < max; i++) {
+		char c = s[i];
+
+		line[n++] = (c >= 0x20 && c <= 0x7e) ? c : '.';
+	}
+	line[n] = 0;
+	hud_row_text(row, line);
+}
