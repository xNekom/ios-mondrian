+/*
+ * "thermal" prints the decision and the p-states behind it: the SoC estimate,
+ * the level, and each EPSS domain's row against its ceiling. A domain that was
+ * never mapped is left out and "cap" only appears when there is one.
+ */
+static void
+ud_cmd_thermal(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_thermal_mc(void);
+	extern int mondrian_thermal_level(void);
+	extern unsigned int mondrian_cpufreq_state(unsigned int d,
+	    uint32_t *rows, uint32_t *ceiling, uint32_t *khz);
+	char out[192];
+	size_t len = 0;
+	int mc = mondrian_thermal_mc();
+	unsigned int d;
+	int n;
+
+	(void)line;
+	n = snprintf(out, sizeof(out), "thermal %d.%d C level %d", mc / 1000,
+	    (mc % 1000) / 100, mondrian_thermal_level());
+	if (n > 0) {
+		len = (size_t)n;
+	}
+	for (d = 0; d < 3 && len + 40 < sizeof(out); d++) {
+		uint32_t rows = 0, ceiling = 0, khz = 0;
+		unsigned int row = mondrian_cpufreq_state(d, &rows, &ceiling,
+		    &khz);
+
+		if (row == 0) {
+			continue;
+		}
+		if (ceiling == 0xffffffffu) {
+			n = snprintf(out + len, sizeof(out) - len,
+			    " d%u %u/%u %u MHz", d, row - 1, rows, khz / 1000);
+		} else {
+			n = snprintf(out + len, sizeof(out) - len,
+			    " d%u %u/%u %u MHz cap %u", d, row - 1, rows,
+			    khz / 1000, ceiling);
+		}
+		if (n < 0 || (size_t)n >= sizeof(out) - len) {
+			break;
+		}
+		len += (size_t)n;
+	}
+	if (len < sizeof(out) - 2) {
+		out[len++] = '\n';
+		out[len] = '\0';
+	}
+	ud_cmd_send(so, to, out, len);
+	printf("%s", out);
+}
+
+/* "burn <seconds>" keeps one core busy so the thermal loop has heat to see. */
+static void
+ud_cmd_burn(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_thermal_burn(unsigned int seconds);
+	char out[48];
+	uint32_t secs = 0;
+	int n;
+
+	if (ud_cmd_num(line + 4, &secs) == NULL ||
+	    mondrian_thermal_burn(secs) != 0) {
+		n = snprintf(out, sizeof(out), "burn 0..300 s\n");
+	} else {
+		n = snprintf(out, sizeof(out), "burn %u s\n", secs);
+	}
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
