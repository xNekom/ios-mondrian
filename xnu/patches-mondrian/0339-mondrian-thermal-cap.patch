diff --git a/bsd/dev/mondrian_thermal.c b/bsd/dev/mondrian_thermal.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/mondrian_thermal.c
@@ -0,0 +1,175 @@
+/*
+ * Thermal pressure, from the SoC's own sensors to the CPU's p-states.
+ *
+ * The port's thermal input used to be the PMIC's die temperature, and the
+ * SoC's TSENS blocks were only read by hand over USB. This turns the estimate
+ * `tsens` prints into a decision: the hottest sensor of block 0 (the clusters
+ * and the GPU) is sampled twice a second, and two thresholds cap the frequency
+ * through the EPSS governor, which already knows the per-domain row to write.
+ *
+ * The estimate is a fit, not a calibration (0.1 C per code and 1.6 C of offset,
+ * residual 2 C -- see mondrian_tsens.c), so the thresholds are conservative and
+ * the hysteresis is wide: cap at 62 C, cap hard at 72 C, release below 55 C.
+ *
+ * mondriantherm=0 turns the loop off and thermalthr=N moves the first threshold
+ * to N C (the second follows 10 C above, the release 7 C below), which is how
+ * the decision can be exercised on a phone that sits at 40 C.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+
+#if defined(MONDRIAN)
+
+extern int mondrian_tsens_hottest_mc(void);
+extern void mondrian_cpufreq_level(unsigned int level);
+extern void mondrian_log_flush_now(void);
+extern int hz;
+extern void delay(int us);
+
+#define MONDRIAN_THERM_HZ	2	/* samples a second */
+#define MONDRIAN_THERM_L1	62000	/* mC: three fifths of the rows */
+#define MONDRIAN_THERM_L2	72000	/* mC: the lowest row */
+#define MONDRIAN_THERM_HYST	7000	/* mC below L1 that releases */
+#define MONDRIAN_THERM_BURN_MAX	300	/* seconds */
+
+static int mt_level;
+static int mt_l1 = MONDRIAN_THERM_L1;
+static int mt_l2 = MONDRIAN_THERM_L2;
+static int mt_release = MONDRIAN_THERM_L1 - MONDRIAN_THERM_HYST;
+
+int
+mondrian_thermal_level(void)
+{
+	return mt_level;
+}
+
+int
+mondrian_thermal_mc(void)
+{
+	return mondrian_tsens_hottest_mc();
+}
+
+/*
+ * Two levels and nothing else. A hotter reading raises the level at once; a
+ * cooler one only releases it once the reading is MONDRIAN_THERM_HYST below
+ * the threshold, which is what keeps a phone sitting at the threshold from
+ * capping and releasing on every sample.
+ */
+static void
+mt_decide(int mc)
+{
+	int level = mt_level;
+
+	if (mc < 0) {
+		return;				/* no sensor, no decision */
+	}
+	if (mc >= mt_l2) {
+		level = 2;
+	} else if (mc >= mt_l1) {
+		if (level < 1) {
+			level = 1;
+		}
+	} else if (mc <= mt_release) {
+		level = 0;
+	} else if (level == 0) {
+		return;				/* inside the band: hold */
+	}
+	if (level == mt_level) {
+		return;
+	}
+	mt_level = level;
+	mondrian_cpufreq_level((unsigned int)level);
+	printf("MONDRIAN THERM: %d.%d C level %d %s\n", mc / 1000,
+	    (mc % 1000) / 100, level, level != 0 ? "capped" : "released");
+	mondrian_log_flush_now();
+}
+
+static void
+mondrian_thermal_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	int ticks = MAX(hz / MONDRIAN_THERM_HZ, 1);
+
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "mondthrm", ticks);
+		mt_decide(mondrian_tsens_hottest_mc());
+	}
+}
+
+void
+mondrian_thermal_start(void)
+{
+	thread_t thread;
+	uint32_t on = 1;
+	int thr = 0;
+
+	if (PE_parse_boot_argn("mondriantherm", &on, sizeof(on)) && on == 0) {
+		printf("MONDRIAN THERM: disabled from the command line\n");
+		return;
+	}
+	if (PE_parse_boot_argn("thermalthr", &thr, sizeof(thr)) && thr > 0 &&
+	    thr < 100) {
+		mt_l1 = thr * 1000;
+		mt_l2 = mt_l1 + 10000;
+		mt_release = mt_l1 - MONDRIAN_THERM_HYST;
+		printf("MONDRIAN THERM: %d C caps, %d C caps hard, %d C releases\n",
+		    mt_l1 / 1000, mt_l2 / 1000, mt_release / 1000);
+	}
+	if (kernel_thread_start(mondrian_thermal_thread, NULL, &thread) !=
+	    KERN_SUCCESS) {
+		printf("MONDRIAN THERM: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+/*
+ * "burn" is the load the decision needs to see. The phone cannot run a spinner
+ * from userland yet, so a kernel thread keeps one core busy for the requested
+ * seconds with delay(), which is a busy wait, and the thermal loop watches it.
+ */
+static volatile int mb_running;
+static volatile uint64_t mb_until;
+
+static void
+mondrian_burn_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int mc;
+
+	do {
+		delay(1000);
+	} while (mach_absolute_time() < mb_until);
+	mc = mondrian_tsens_hottest_mc();
+	mb_running = 0;
+	printf("MONDRIAN THERM: burn done at %d.%d C\n", mc / 1000,
+	    (mc % 1000) / 100);
+	mondrian_log_flush_now();
+}
+
+int
+mondrian_thermal_burn(unsigned int seconds)
+{
+	thread_t thread;
+	uint64_t delta;
+
+	if (mb_running || seconds == 0 || seconds > MONDRIAN_THERM_BURN_MAX) {
+		return -1;
+	}
+	nanoseconds_to_absolutetime((uint64_t)seconds * 1000000000ull, &delta);
+	mb_until = mach_absolute_time() + delta;
+	mb_running = 1;
+	if (kernel_thread_start(mondrian_burn_thread, NULL, &thread) !=
+	    KERN_SUCCESS) {
+		mb_running = 0;
+		return -1;
+	}
+	thread_deallocate(thread);
+
+	return 0;
+}
+#endif /* MONDRIAN */
