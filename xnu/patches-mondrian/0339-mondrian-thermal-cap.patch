+/*
+ * The thermal ceiling. Level 0 releases it, 1 allows three fifths of each
+ * domain's rows and 2 only the lowest row. The governor keeps running
+ * underneath, so releasing gives the frequency back to whatever the load asks
+ * for instead of to a value picked here.
+ */
+void
+mondrian_cpufreq_level(unsigned int level)
+{
+	uint64_t now = mach_absolute_time();
+	unsigned int d;
+
+	for (d = 0; d < MONDRIAN_EPSS_DOMAINS; d++) {
+		int32_t cap = -1;
+
+		if (md[d].base == 0 || md[d].rows < 2) {
+			md_ceiling[d] = -1;
+			continue;
+		}
+		if (level >= 2) {
+			cap = 0;
+		} else if (level == 1) {
+			cap = (int32_t)((md[d].rows * 3u) / 5u);
+			if (cap >= (int32_t)md[d].rows) {
+				cap = (int32_t)md[d].rows - 1;
+			}
+		}
+		md_ceiling[d] = cap;
+		if (cap >= 0 && (int32_t)md[d].row > cap) {
+			md_log_at[d] = 0;
+			md_apply(d, (uint32_t)cap, now);
+		}
+	}
+}
+
+/*
+ * What a domain is doing, for the USB side: returns the row plus one (0 when
+ * the domain was never mapped) and fills in the row count, the ceiling in
+ * force (0xffffffff when there is none) and the frequency of that row.
+ */
+unsigned int
+mondrian_cpufreq_state(unsigned int d, uint32_t *rows, uint32_t *ceiling,
+    uint32_t *khz)
+{
+	if (d >= MONDRIAN_EPSS_DOMAINS || md[d].base == 0) {
+		return 0;
+	}
+	*rows = md[d].rows;
+	*ceiling = md_ceiling[d] < 0 ? 0xffffffffu : (uint32_t)md_ceiling[d];
+	*khz = md[d].khz[md[d].row];
+
+	return md[d].row + 1;
+}
diff --git a/bsd/dev/mondrian_tsens.c b/bsd/dev/mondrian_tsens.c
--- a/bsd/dev/mondrian_tsens.c
+++ b/bsd/dev/mondrian_tsens.c
@@ -102,4 +102,42 @@
 		}
 	}
 }
+/*
+ * The hottest sensor of block 0 as millidegrees, or -1. Block 0 is the one
+ * that carries the clusters (cpuss-0..3, cpu-1-0..8) and the GPU, so it is the
+ * number a frequency cap should follow; block 1 is DDR, modem and camera.
+ * A sensor whose VALID bit is clear is skipped: unclocked or disabled, it
+ * reads whatever the last conversion left behind.
+ */
+int
+mondrian_tsens_hottest_mc(void)
+{
+	volatile uint32_t *tm;
+	int n, best = -1;
+
+	mondrian_tsens_map();
+	tm = mondrian_tsens_tm[0];
+	if (tm == NULL) {
+		return -1;
+	}
+	for (n = 0; n < MONDRIAN_TSENS_SENSORS; n++) {
+		uint32_t v = tm[(MONDRIAN_TSENS_SN + 4 * (uint32_t)n) / 4];
+		int32_t code = (int32_t)(v & 0xfffu);
+		int32_t mc;
+
+		if (((v >> 21) & 1u) == 0) {
+			continue;
+		}
+		if ((code & 0x800) != 0) {
+			code -= 0x1000;
+		}
+		mc = code * 100 - 1600;
+		if (mc > best) {
+			best = mc;
+		}
+	}
+
+	return best;
+}
+
 #endif /* MONDRIAN */
