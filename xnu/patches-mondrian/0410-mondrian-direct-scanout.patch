+/*
+ * Direct scanout (`mfs` in the boot arguments: 1 gives the bank its stage-1
+ * tables and keeps the copy, 2 also points SRC0 at the compositor's surface).
+ *
+ * The display fetches through apps_smmu (0x15000000), SID 0x2800, whose stream
+ * table entry selects context bank 3; the bootloader left that bank with
+ * stage-1 translation off (SCTLR.M=0), so SRC0 carries a physical address and
+ * the port copies every frame into the low carve-out. SRC0 is 32 bits wide and
+ * CoreAnimation's surfaces live at 0x840000000, so a flip needs that bank to
+ * translate: a 4 GiB input space with the low region identity-mapped and the
+ * surfaces placed in a 32-bit IOVA window. The copy stays the default path.
+ */
+#define MONDRIAN_SCAN_SLOTS      2
+#define MONDRIAN_SCAN_IOVA       0x90000000ULL
+#define MONDRIAN_SCAN_STRIDE     0x02000000ULL     /* 32 MiB per surface */
+#define MONDRIAN_SCAN_TABLES     0x22000ULL        /* L1, L2, 32 L3: 4 KiB each */
+#define MONDRIAN_SCAN_WATCHDOG_S 900               /* mfs test boots return to fastboot */
+#define MONDRIAN_SCAN_SMMU       0x15000000ULL
+#define MONDRIAN_SCAN_SMMU_LEN   0x100000ULL
+
+static int mondrian_fb_scan;                    /* 1 tables, 2 config, 3 translate, 4 flip */
+static volatile uint8_t *mondrian_scan_regs;
+static uint32_t mondrian_scan_cb = 0xffffffffu; /* context bank that serves SID 0x2800 */
+static uint32_t mondrian_scan_cb_off;           /* that bank's register base */
+static IOBufferMemoryDescriptor *mondrian_scan_mem;
+static void *mondrian_scan_tables;
+static uint32_t mondrian_scan_slots[MONDRIAN_SCAN_SLOTS];
+static bool mondrian_scan_slot_logged;
+
+static inline uint32_t
+mondrian_scan_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(mondrian_scan_regs + off);
+}
+
+static inline void
+mondrian_scan_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(mondrian_scan_regs + off) = value;
+}
+
+/*
+ * The physical address of the 4 KiB table at an offset inside the table
+ * memory. The tables do not need to be contiguous with each other, only each
+ * table with itself (4 KiB inside one 16 KiB kernel page), so an ordinary
+ * buffer descriptor is enough and IOMallocContiguous - whose physical-mask
+ * path returns nothing on this board - is not needed.
+ */
+static addr64_t
+mondrian_scan_table_pa(uint32_t off)
+{
+	IOByteCount len = 0;
+	addr64_t pa;
+
+	if (mondrian_scan_mem == NULL) {
+		return 0;
+	}
+	pa = mondrian_scan_mem->getPhysicalSegment(off, &len);
+	return len != 0 ? pa : 0;
+}
+
+/* Invalidate the non-secure stage-1 TLBs and wait for the hardware. */
+static void
+mondrian_scan_tlb(void)
+{
+	if (mondrian_scan_regs == NULL) {
+		return;
+	}
+	mondrian_scan_wr(0x68, 1);              /* GR0_sTLBIALLNSNH */
+	mondrian_scan_wr(0x70, 1);              /* GR0_sTLBGSYNC */
+	for (uint32_t i = 0; i < 1000000; i++) {
+		if ((mondrian_scan_rd(0x74) & 1) == 0) {
+			break;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Give the display's context bank a stage-1 table: identity for the low 4 GiB
+ * (the panel carve-out is at 0xb8000000) and 4 KiB leaves over the 64 MiB the
+ * two surface slots occupy. The walk is Non-Cacheable, Outer Shareable, and
+ * every descriptor is cleaned to the point of coherency before the bank is
+ * enabled.
+ */
+static void
+mondrian_scan_enable(void)
+{
+	uint32_t id0, id1, id2, smrg, ncb, pgshift, npage, n;
+	uint32_t ias, oas, ps;
+
+	mondrian_scan_regs = (volatile uint8_t *)ml_io_map(MONDRIAN_SCAN_SMMU,
+	    MONDRIAN_SCAN_SMMU_LEN);
+	if (mondrian_scan_regs == NULL) {
+		IOLog("MONDRIAN SCAN: apps_smmu not mapped\n");
+		return;
+	}
+	id0 = mondrian_scan_rd(0x20);
+	id1 = mondrian_scan_rd(0x24);
+	id2 = mondrian_scan_rd(0x28);
+	smrg = id0 & 0xffu;
+	ncb = id1 & 0xffu;
+	pgshift = (id1 & (1u << 31)) ? 16 : 12;
+	npage = 1u << (((id1 >> 28) & 7u) + 1u);
+	/*
+	 * ID2 carries both address sizes as io-pgtable codes: 0 32, 1 36,
+	 * 2 40, 3 42, 4 44, 5 48, 6 52. PASIZE (TCR2[3:0]) takes the OAS
+	 * code, not the bit count; a value larger than the OAS the SMMU
+	 * supports is a programming error and every walk can fault.
+	 */
+	ias = id2 & 0xfu;
+	oas = (id2 >> 4) & 0xfu;
+	ps = oas <= 6u ? oas : 2u;
+	for (n = 0; n < smrg && n < 256; n++) {
+		uint32_t smr = mondrian_scan_rd(0x800 + n * 4);
+		uint32_t mask = (smr >> 16) & 0xffffu;
+		uint32_t sid = smr & 0xffffu;
+
+		if ((smr & (1u << 31)) == 0) {
+			continue;
+		}
+		if ((0x2800u & ~mask) == (sid & ~mask)) {
+			uint32_t s2cr = mondrian_scan_rd(0xc00 + n * 4);
+
+			IOLog("MONDRIAN SCAN: sid 0x2800 smr%u 0x%x s2cr 0x%x bank %u type %u\n",
+			    n, smr, s2cr, s2cr & 0xffu, (s2cr >> 16) & 3u);
+			IOLog("MONDRIAN SCAN: id2 0x%x ias %u oas %u pasize %u\n",
+			    id2, ias, oas, ps);
+			if (((s2cr >> 16) & 3u) == 0) {
+				mondrian_scan_cb = s2cr & 0xffu;
+			}
+			break;
+		}
+	}
+	if (mondrian_scan_cb >= ncb) {
+		IOLog("MONDRIAN SCAN: no translation bank for sid 0x2800\n");
+		mondrian_scan_cb = 0xffffffffu;
+		return;
+	}
+	mondrian_scan_cb_off = (npage << pgshift) + (mondrian_scan_cb << pgshift);
+	mondrian_scan_mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared,
+	    (vm_size_t)MONDRIAN_SCAN_TABLES, page_size);
+	if (mondrian_scan_mem == NULL ||
+	    (mondrian_scan_tables = mondrian_scan_mem->getBytesNoCopy()) == NULL) {
+		IOLog("MONDRIAN SCAN: no table memory\n");
+		OSSafeReleaseNULL(mondrian_scan_mem);
+		mondrian_scan_tables = NULL;
+		mondrian_scan_cb = 0xffffffffu;
+		return;
+	}
+	bzero(mondrian_scan_tables, (size_t)MONDRIAN_SCAN_TABLES);
+	{
+		uint64_t *l1 = (uint64_t *)mondrian_scan_tables;
+		uint64_t *l2 = (uint64_t *)((uint8_t *)mondrian_scan_tables + 0x1000);
+		addr64_t l1_pa = mondrian_scan_table_pa(0);
+		addr64_t l2_pa = mondrian_scan_table_pa(0x1000);
+		uint32_t i;
+
+		if (l1_pa == 0 || l2_pa == 0) {
+			IOLog("MONDRIAN SCAN: tables have no physical address\n");
+			OSSafeReleaseNULL(mondrian_scan_mem);
+			mondrian_scan_tables = NULL;
+			mondrian_scan_cb = 0xffffffffu;
+			return;
+		}
+		/*
+		 * 0x440 is AP[1] (EL0 read/write): the display's scanout fetch is
+		 * privileged, but the DSI command DMA that reads the low DCS page
+		 * (0xbaaf0000) is not, and AP=00 made that read a permission
+		 * fault - the panel then stayed at 60 Hz because the command that
+		 * switches it to 120 never left the DMA.
+		 */
+		l1[0] = 0x00000000ULL | 0x441ULL;
+		l1[1] = 0x40000000ULL | 0x441ULL;
+		l1[2] = l2_pa | 0x3ULL;
+		l1[3] = 0xC0000000ULL | 0x441ULL;
+		for (i = 0; i < 512; i++) {
+			l2[i] = (0x80000000ULL + (uint64_t)i * 0x200000ULL) | 0x441ULL;
+		}
+		for (i = 0; i < 32; i++) {
+			addr64_t l3_pa = mondrian_scan_table_pa(0x2000 + i * 0x1000);
+
+			if (l3_pa == 0) {
+				IOLog("MONDRIAN SCAN: l3 %u has no physical address\n", i);
+				OSSafeReleaseNULL(mondrian_scan_mem);
+				mondrian_scan_tables = NULL;
+				mondrian_scan_cb = 0xffffffffu;
+				return;
+			}
+			l2[128 + i] = l3_pa | 0x3ULL;
+		}
+	}
+	flush_dcache64((addr64_t)(uintptr_t)mondrian_scan_tables,
+	    (unsigned)MONDRIAN_SCAN_TABLES, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	IOLog("MONDRIAN SCAN: tables %p l1 0x%llx l2 0x%llx l3 0x%llx\n",
+	    mondrian_scan_tables, (unsigned long long)mondrian_scan_table_pa(0),
+	    (unsigned long long)mondrian_scan_table_pa(0x1000),
+	    (unsigned long long)mondrian_scan_table_pa(0x2000));
+	/*
+	 * mfs=1 stops here: the tables are built and cleaned but the bank keeps
+	 * bypassing, so a mistake in them cannot take the phone down. mfs=2
+	 * programs the context bank but still leaves SCTLR.M=0, so the display
+	 * keeps fetching physical addresses; mfs=3 turns translation on (the
+	 * identity map covers the physical SRC0 the panel already uses); mfs=4
+	 * also points SRC0 at a compositor surface.
+	 */
+	if (mondrian_fb_scan < 2) {
+		IOLog("MONDRIAN SCAN: bank %u left off (mfs %d)\n",
+		    mondrian_scan_cb, mondrian_fb_scan);
+		return;
+	}
+	/*
+	 * The order is the one Linux writes a context bank in and every access
+	 * is 32 bits: TTBR0 is split in its two halves, because a single
+	 * 64-bit store is the one access this register file has not been
+	 * proven with yet. CONTEXTIDR is not written at all - Linux only uses
+	 * it for the AArch32 format.
+	 */
+	IOLog("MONDRIAN SCAN: write cbar\n");
+	mondrian_scan_wr(0x1000 + mondrian_scan_cb * 4, 0x1f000);       /* CBAR: measured value */
+	/*
+	 * CBA2R lives in GR1 at 0x800 + n*4, so 0x1800 + n*4 from the base. The
+	 * absolute 0x800 + n*4 of the first version is GR0 SMR[n] - the
+	 * display's own stream entry, whose loss makes SID 0x2800 unmatched
+	 * while sCR0.USFCFG is set.
+	 */
+	mondrian_scan_wr(0x1800 + mondrian_scan_cb * 4, 1);             /* CBA2R: VA64 */
+	IOLog("MONDRIAN SCAN: write tcr\n");
+	mondrian_scan_wr(mondrian_scan_cb_off + 0x10,
+	    0x38010u | ps);                                           /* TCR2: PASIZE, SEP, 16-bit ASID */
+	mondrian_scan_wr(mondrian_scan_cb_off + 0x30, 0x80802020);      /* TCR: EAE (AArch64), T0SZ 32, SH0 OS */
+	IOLog("MONDRIAN SCAN: write ttbr0\n");
+	{
+		addr64_t l1 = mondrian_scan_table_pa(0);
+
+		mondrian_scan_wr(mondrian_scan_cb_off + 0x24,
+		    (uint32_t)(0x10000ULL | (l1 >> 32)));                  /* ASID 1, high half */
+		mondrian_scan_wr(mondrian_scan_cb_off + 0x20, (uint32_t)l1);
+	}
+	IOLog("MONDRIAN SCAN: write mair\n");
+	mondrian_scan_wr(mondrian_scan_cb_off + 0x38, 0x44);           /* MAIR0: Normal Non-Cacheable */
+	mondrian_scan_wr(mondrian_scan_cb_off + 0x3c, 0);              /* MAIR1 */
+	__asm__ volatile("dsb sy" ::: "memory");
+	/*
+	 * mfs=2 leaves SCTLR.M=0 on purpose: the bank now holds the whole
+	 * configuration but keeps bypassing, so a wrong descriptor or a bad
+	 * attribute cannot reach the display yet. mfs=3 turns translation on.
+	 */
+	if (mondrian_fb_scan < 3) {
+		IOLog("MONDRIAN SCAN: bank %u configured, M=0 (mfs %d)\n",
+		    mondrian_scan_cb, mondrian_fb_scan);
+		return;
+	}
+	/* Drop the bootloader's stale status so a later read is a new fault. */
+	mondrian_scan_wr(mondrian_scan_cb_off + 0x58, 0xffffffff);
+	IOLog("MONDRIAN SCAN: write sctlr\n");
+	mondrian_scan_wr(mondrian_scan_cb_off + 0x00, 0x127);          /* SCTLR: M, TRE, AFE, CFRE */
+	__asm__ volatile("dsb sy" ::: "memory");
+	mondrian_scan_tlb();
+	IOLog("MONDRIAN SCAN: bank %u cbar 0x%x sctlr 0x%x ttbr0 0x%llx tcr 0x%x tcr2 0x%x fsr 0x%x\n",
+	    mondrian_scan_cb, mondrian_scan_rd(0x1000 + mondrian_scan_cb * 4),
+	    mondrian_scan_rd(mondrian_scan_cb_off),
+	    (unsigned long long)*(volatile uint64_t *)(mondrian_scan_regs +
+	    mondrian_scan_cb_off + 0x20),
+	    mondrian_scan_rd(mondrian_scan_cb_off + 0x30),
+	    mondrian_scan_rd(mondrian_scan_cb_off + 0x10),
+	    mondrian_scan_rd(mondrian_scan_cb_off + 0x58));
+}
+
+/* Point the slot's leaves at the surface's pages; the slot is empty first. */
+static bool
+mondrian_scan_fill(MondrianSurface *s, uint32_t slot)
+{
+	uint8_t *tables = (uint8_t *)mondrian_scan_tables + 0x2000 +
+	    (uint64_t)slot * 16 * 0x1000;
+	uint64_t len, off = 0;
+
+	if (s->memory == NULL) {
+		return false;
+	}
+	len = s->memory->getLength();
+	if (len == 0 || len > MONDRIAN_SCAN_STRIDE) {
+		return false;
+	}
+	bzero(tables, 16 * 0x1000);
+	while (off < len) {
+		IOByteCount seglen = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &seglen);
+
+		if (pa == 0 || seglen == 0) {
+			return false;
+		}
+		if (off + seglen > len) {
+			seglen = (IOByteCount)(len - off);
+		}
+		for (uint64_t o = 0; o < seglen; o += 0x1000) {
+			uint64_t page = (off + o) >> 12;
+			uint64_t *l3 = (uint64_t *)(tables + (page >> 9) * 0x1000);
+
+			l3[page & 0x1ff] = (pa + o) | 0x443ULL;
+		}
+		off += seglen;
+	}
+	flush_dcache64((addr64_t)(uintptr_t)tables, 16 * 0x1000, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return true;
+}
+
+/* The IOVA of the surface, mapping it into a free slot on first use. */
+static bool
+mondrian_scan_map(MondrianSurface *s, uint64_t *iova)
+{
+	uint32_t slot = MONDRIAN_SCAN_SLOTS;
+
+	if (mondrian_scan_tables == NULL || mondrian_scan_cb == 0xffffffffu) {
+		return false;
+	}
+	for (uint32_t i = 0; i < MONDRIAN_SCAN_SLOTS; i++) {
+		if (mondrian_scan_slots[i] == s->id) {
+			*iova = MONDRIAN_SCAN_IOVA + (uint64_t)i * MONDRIAN_SCAN_STRIDE;
+			return true;
+		}
+	}
+	for (uint32_t i = 0; i < MONDRIAN_SCAN_SLOTS; i++) {
+		if (mondrian_scan_slots[i] == 0) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == MONDRIAN_SCAN_SLOTS) {
+		if (!mondrian_scan_slot_logged) {
+			mondrian_scan_slot_logged = true;
+			IOLog("MONDRIAN SCAN: no slot for surface %u, keeping the copy\n",
+			    s->id);
+		}
+		return false;
+	}
+	if (!mondrian_scan_fill(s, slot)) {
+		IOLog("MONDRIAN SCAN: surface %u cannot be mapped\n", s->id);
+		return false;
+	}
+	mondrian_scan_slots[slot] = s->id;
+	mondrian_scan_tlb();
+	*iova = MONDRIAN_SCAN_IOVA + (uint64_t)slot * MONDRIAN_SCAN_STRIDE;
+	IOLog("MONDRIAN SCAN: surface %u -> iova 0x%llx off %u bpr %u %ux%u\n",
+	    s->id, (unsigned long long)*iova, s->offset, s->bytesPerRow,
+	    s->width, s->height);
+	return true;
+}
+
+/* Both fetch paths the bootloader left point at the panel; keep them together. */
+static void
+mondrian_scan_src0(volatile uint32_t *mdp, uint32_t addr)
+{
+	if (mdp == NULL) {
+		return;
+	}
+	mondrian_mdp_wr(mdp, 0x5000 + MONDRIAN_SSPP_SRC0, addr);
+	mondrian_mdp_wr(mdp, 0x7000 + MONDRIAN_SSPP_SRC0, addr);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
