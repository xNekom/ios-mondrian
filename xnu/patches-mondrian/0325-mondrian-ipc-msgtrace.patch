+static void
+mondrian_msg_drain(void)
+{
+	static const char *kinds[] = { "try", "sent", "recv", "armed", "fail" };
+	unsigned int total = mondrian_msg_samples_total;
+	unsigned int limit = sizeof(mondrian_msg_samples) /
+	    sizeof(mondrian_msg_samples[0]);
+
+	while (mondrian_msg_drained != total) {
+		struct mondrian_msg_sample *sample;
+
+		if (total - mondrian_msg_drained > limit) {
+			mondrian_msg_drained = total - limit;
+		}
+		sample = &mondrian_msg_samples[
+		    mondrian_msg_drained % limit];
+		if (sample->kind >= 0 && sample->kind <= 4) {
+			printf("MONDRIAN MSG: %s pid %d id %d owner %d size %d\n",
+			    kinds[sample->kind], sample->pid, sample->msg_id,
+			    sample->owner, sample->size);
+		}
+		mondrian_msg_drained++;
+	}
+}
