 static bool
 mondrian_ui_hook_env(struct image_params *imgp, char *env, size_t size)
 {
@@ -5866,6 +5897,10 @@ mondrian_ui_hook_env(struct image_params *imgp, char *env, size_t size)
 	} else if (imgp->ip_ndp->ni_cnd.cn_namelen == sizeof("xpcproxy") - 1 &&
 	    strncmp(name, "xpcproxy", sizeof("xpcproxy") - 1) == 0) {
