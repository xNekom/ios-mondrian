 		wanted = MONDRIAN_HOOK_CONTAINERMANAGERD;
@@ -5719,7 +5781,9 @@ mondrian_ui_hook_env(struct image_params *imgp, char *env, size_t size)
 	    strncmp(name, "xpcproxy", sizeof("xpcproxy") - 1) == 0) {
 		wanted = MONDRIAN_HOOK_XPCPROXY;
