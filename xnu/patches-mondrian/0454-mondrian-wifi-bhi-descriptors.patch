+/*
+ * W9: the BHI descriptor registers say whether the boot ROM ever ran. The
+ * anti-rollback version and the segment count are written by the PBL, so a
+ * zero there separates "the PBL ignores the doorbell" from "the PBL never
+ * started". The doorbell itself is read back: a consumed session id does not
+ * stay in BHI_IMGTXDB.
+ */
+static void
+wifi_bhi_dump(const char *tag, uint32_t bhioff)
+{
+    uint32_t major = 0, minor = 0, exec = 0, status = 0, err = 0;
+    uint32_t arl = 0, numseg = 0, txdb = 0, addr = 0, size = 0;
+
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x00, &minor);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x04, &major);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x08, &addr);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x10, &size);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x18, &txdb);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x28, &exec);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x2c, &status);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x30, &err);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x44, &arl);
+    (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x48, &numseg);
+    wifi_log("W9 %s ver=%u.%u arl=%x numseg=%x exec=%x status=%x err=%x"
+        " txdb=%x addr=%x size=%x", tag, major, minor, arl, numseg, exec,
+        status, err, txdb, addr, size);
+}
