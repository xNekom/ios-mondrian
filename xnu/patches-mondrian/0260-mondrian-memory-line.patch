xnu 0260: print what the VM has left with every sample

The lock screen stops drawing a minute into a boot and the whole system loses
its display links at once. One of the two candidates is memory: this port hands
iOS 768 MiB, the largest window that ends at the first firmware carve-out, and
iOS 16 expects a phone with three times that, so jetsam kills thirty processes a
minute. Free, speculative, wired, active and inactive pages every five seconds
settle it without guessing, and cost one line per sample.
--- a/bsd/dev/mondrian_sample.c
+++ b/bsd/dev/mondrian_sample.c
@@ -228,6 +228,23 @@
 	}
 	proc_iterate(PROC_ALLPROCLIST, mondrian_sample_list, NULL, NULL, NULL);
 
+	{
+		/*
+		 * The UI starves before anything else when the VM runs out: the
+		 * root is served from a 1.65 GiB window and iOS 16 asks for more.
+		 * One line per sample says whether the freeze is memory.
+		 */
+		extern unsigned int vm_page_free_count, vm_page_speculative_count;
+		extern unsigned int vm_page_wire_count, vm_page_active_count;
+		extern unsigned int vm_page_inactive_count;
+		/* 16 KiB pages: count * 16 is KiB, >> 10 is MiB. */
+		printf("MONDRIAN MEM: free %uMiB spec %uMiB wire %uMiB active %uMiB inactive %uMiB\n",
+		    (vm_page_free_count * 16) >> 10,
+		    (vm_page_speculative_count * 16) >> 10,
+		    (vm_page_wire_count * 16) >> 10,
+		    (vm_page_active_count * 16) >> 10,
+		    (vm_page_inactive_count * 16) >> 10);
+	}
 	printf("SMP t=%llus %d procs", (unsigned long long)(now / 1000000000ULL),
 	    mondrian_proc_count);
 	for (int k = 0; k < mondrian_names_count; k++) {
