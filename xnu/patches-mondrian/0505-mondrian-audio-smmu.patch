new file mode 100644
index 0000000..775222c
--- /dev/null
+++ b/bsd/dev/mondrian_audio_smmu.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * MONDRIAN AUDIO SMMU: the ADSP's audio stream (SID 0x1801) seen through the
+ * apps-SMMU. The live DT's qcom,msm-audio-ion node names <&apps_smmu 0x1801>
+ * and gives the vendor's 0x10000000 IOVA pool; the DSP never sees the DDR
+ * physical address. One buffer is mapped per boot.
+ */
+#ifndef _MONDRIAN_AUDIO_SMMU_H_
+#define _MONDRIAN_AUDIO_SMMU_H_
+
+#include <mach/vm_types.h>
+
+/* Map a wired kernel range into the DSP's 32-bit space and return the IOVA
+ * (the caller adds the 0x1_00000000 DDR tag). The range must be page aligned
+ * and at most 2 MiB; the port maps one 16 KiB PCM buffer. */
+int mondrian_audio_smmu_map(vm_offset_t va, vm_size_t bytes,
+    uint64_t *iova_out);
+
+/* Log the context and global fault state after the DSP has used the buffer. */
+void mondrian_audio_smmu_report(const char *where);
+
+#endif /* _MONDRIAN_AUDIO_SMMU_H_ */
