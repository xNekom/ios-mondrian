@@ -1247,6 +1249,41 @@ mondrian_wifi_load_amss(void)
     return (status >> 30) == 2 ? 0 : -1;
 }
 
+int
+mondrian_wifi_set_sbl(uint32_t size)
+{
+    if (size < 0x1000 || size > 0x600000) {
+        wifi_log("W7 bad sbl size 0x%x", size);
+        return -1;
+    }
+    wifi_sbl_size = size;
+    wifi_log("W7 sbl size set to 0x%x", size);
+    return mondrian_wifi_load_amss();
+}
+
+int
+mondrian_wifi_stat(void)
+{
+    uint32_t bhioff = 0, status = 0, execenv = 0, mhistatus = 0;
+    uint32_t mhictrl = 0;
+
+    if (wifi_bar == 0) {
+        wifi_log("W7 stat BAR not mapped");
+        return -1;
+    }
+    (void)mondrian_mmio_try_rd32(wifi_bar + 0x28, &bhioff);
+    (void)mondrian_mmio_try_rd32(wifi_bar + 0x38, &mhictrl);
+    (void)mondrian_mmio_try_rd32(wifi_bar + 0x48, &mhistatus);
+    if (bhioff != 0) {
+        (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x2c, &status);
+        (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x28, &execenv);
+    }
+    wifi_log("W7 stat sbl=0x%x mhictrl=0x%x mhistatus=0x%x "
+        "bhi_status=0x%x execenv=0x%x", wifi_sbl_size, mhictrl,
+        mhistatus, status, execenv);
+    return 0;
+}
