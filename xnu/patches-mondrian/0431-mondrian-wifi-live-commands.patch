xnu 0431: add live wifibhi and wifistat commands

The WiFi load path is now a register experiment, and a kernel rebuild per size
is the wrong unit. `wifibhi <hex>` sets the BHI image size (default 512 KiB)
and runs the load through the same SMMU/BHI path; `wifistat` reads MHICTRL,
MHISTATUS, BHI_STATUS and BHI_EXECENV. Both answer on the existing USB control
channel and log to the ring, so a size or state question costs one command, not
one boot.

The SBL size is checked between 4 KiB and 6 MiB, the mapped buffer size.

diff --git a/bsd/dev/mondrian_usb.c b/bsd/dev/mondrian_usb.c
index 3d372e3..6793172 100644
--- a/bsd/dev/mondrian_usb.c
+++ b/bsd/dev/mondrian_usb.c
@@ -2819,6 +2819,50 @@ ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
 				    mondrian_wifi_load_amss() == 0 ? "ok" : "failed");
 
 				ud_cmd_send(so, peer, out, (size_t)n);
+			} else if (strcmp(cmd, "wifistat") == 0) {
+				extern int mondrian_wifi_stat(void);
+				char out[32];
+				int n = snprintf(out, sizeof(out), "wifistat %s\n",
+				    mondrian_wifi_stat() == 0 ? "ok" : "failed");
+
+				ud_cmd_send(so, peer, out, (size_t)n);
+			} else if (strncmp(cmd, "wifibhi ", 8) == 0) {
+				extern int mondrian_wifi_set_sbl(uint32_t);
+				const char *p = cmd + 8;
+				uint32_t size = 0;
+				char out[48];
+				int bad = 0, n;
+
+				while (*p == ' ') {
+					p++;
+				}
+				while (*p != '\0') {
+					int d;
+
+					if (*p >= '0' && *p <= '9') {
+						d = *p - '0';
+					} else if (*p >= 'a' && *p <= 'f') {
+						d = *p - 'a' + 10;
+					} else if (*p >= 'A' && *p <= 'F') {
+						d = *p - 'A' + 10;
+					} else if (*p == 'x' || *p == 'X') {
+						p++;
+						continue;
+					} else {
+						bad = 1;
+						break;
+					}
+					size = (size << 4) | (uint32_t)d;
+					p++;
+				}
+				if (bad || size == 0) {
+					bad = 1;
+				} else {
+					bad = mondrian_wifi_set_sbl(size) != 0;
+				}
+				n = snprintf(out, sizeof(out), "wifibhi 0x%x %s\n",
+				    size, bad ? "failed" : "ok");
+				ud_cmd_send(so, peer, out, (size_t)n);
 			} else if (strcmp(cmd, "btuart") == 0 ||
 			    strncmp(cmd, "btuart ", 7) == 0) {
 				ud_cmd_btuart(so, peer, cmd);
