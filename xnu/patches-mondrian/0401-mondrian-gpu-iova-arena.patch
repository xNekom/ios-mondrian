+/* What the arena has left, for a refusal that has to name its reason. */
+void
+mondrian_gpu_uc_iova_state(uint64_t *bump, uint32_t *holes, uint64_t *largest,
+    uint64_t *dropped)
+{
+	uint32_t i;
+
+	if (bump != NULL) {
+		*bump = mondrian_uc_iova;
+	}
+	if (holes != NULL) {
+		*holes = mondrian_uc_hole_count;
+	}
+	if (largest != NULL) {
+		uint64_t best = 0;
+
+		for (i = 0; i < mondrian_uc_hole_count; i++) {
+			if (mondrian_uc_holes[i].bytes > best) {
+				best = mondrian_uc_holes[i].bytes;
+			}
+		}
+		*largest = best;
+	}
+	if (dropped != NULL) {
+		*dropped = mondrian_uc_iova_dropped;
+	}
+}
