+/*
+ * The shared cache slide of a task, for the stack instruments in other files
+ * that cannot see `struct vm_shared_region` (it is private to osfmk).
+ */
+uint64_t
+mondrian_task_slide(task_t task)
+{
+	uint64_t slide = 0;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	return slide;
+}
