+/*
+ * The stack that creates and fills a picture surface.
+ *
+ * Measured 2026-11-19: the window server creates the 640 x 480 surface the
+ * Library tile is drawn from, write-locks it once and leaves it all zero. That
+ * runs inside backboardd's CoreAnimation, and the process name is all the
+ * previous instrument could say. The stack says which function: six frames of
+ * the frame-pointer chain, with the shared cache slide on the same line so
+ * `tools/dsc-va.py CACHE --slide 0x...` names the frame in QuartzCore. Kept to
+ * the first three events (create, lock, unlock of the first picture surface) so
+ * it costs one screen of the ring.
+ */
+static void
+mondrian_surf_fill_stack(MondrianSurface *s, const char *what)
+{
+	static unsigned told;
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss;
+	uint64_t slide, fp;
+	unsigned i;
+
+	if (told >= 3 || s == NULL || s->pixelFormat != 0 || s->width < 320 ||
+	    s->height < 240 || (uint64_t)s->width * (uint64_t)s->height > 2000000) {
+		return;
+	}
+	told++;
+	slide = mondrian_task_slide(task);
+	ss = find_user_regs(thread);
+	if (ss == NULL || !is_saved_state64(ss)) {
+		IOLog("MONDRIAN SURF: %s id %u: no user state (slide %#llx)\n", what,
+		    s->id, slide);
+		return;
+	}
+	IOLog("MONDRIAN SURF: %s id %u pc %#llx lr %#llx slide %#llx\n", what, s->id,
+	    get_saved_state_pc(ss), get_saved_state_lr(ss), slide);
+	fp = get_saved_state_fp(ss);
+	for (i = 0; i < 6 && fp != 0 && (fp & 7) == 0; i++) {
+		uint64_t frame[2];
+
+		if (vm_map_read_user(get_task_map(task), fp, frame, sizeof(frame)) !=
+		    KERN_SUCCESS) {
+			break;
+		}
+		IOLog("MONDRIAN SURF:   %s frame %u %#llx\n", what, i, frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
