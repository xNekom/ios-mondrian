+	 * no need to cycle the rail between mappings. 15 ms low and the part's
+	 * ~120 ms boot time are brl_power_on's numbers. */
 	mondrian_tlmm_output(mondrian_touch_reset_page, 0, MONDRIAN_TLMM_DRIVE_8MA, 0);
 	delay(15000);
 	mondrian_tlmm_output(mondrian_touch_reset_page, 0, MONDRIAN_TLMM_DRIVE_8MA, 1);
 	delay(120000);
 }
 
+static int
+mondrian_touch_berlin(const uint8_t *id)
+{
+	static const char text[6] = { 'B', 'E', 'R', 'L', 'I', 'N' };
+	int i;
+
+	for (i = 0; i < 6; i++) {
+		if (id[8 + i] != (uint8_t)text[i]) {
+			return 0;
+		}
+	}
+	return 1;
+}
