+
+#if defined(MONDRIAN)
+/* The INTIDs that actually arrive, so that a late print can say whether
+ * the timer ever interrupted. */
+static uint32_t mondrian_intids[8];
+static unsigned int mondrian_intid_n;
+#endif
+
+/*
+ * The INTIDs that arrived, printed late (the UFS probe calls this): with
+ * the timer in there, the timer interrupt works; without it, the timer is
+ * not reaching the CPU at all.
+ */
+void
+mondrian_irq_dump(void)
+{
+#if defined(MONDRIAN)
+	for (unsigned int i = 0; i < 8; i++) {
+		kprintf("MONDRIAN IRQ: %u intid %u\n", i, mondrian_intids[(mondrian_intid_n + i) % 8]);
+	}
+#endif
 }
 
