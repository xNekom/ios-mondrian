 /*
+ * The console of the previous boot, copied out of the last 4 MiB of userdata
+ * between the moment the partition is known and this boot's first flush -- the
+ * last moment it still exists -- and printed later, on request, when the USB
+ * control channel can carry the lines to the host.
+ *
+ * `mondriandump` prints the same lines, but it runs before the gadget exists,
+ * so its output can only be read off the panel. This one is read with
+ * `tools/usb-ring.py prev`.
+ *
+ * Boot-arg mondrianprevlog=0 turns the copy off; mondrianprevlines=N prints
+ * fewer of the newest lines (default 120).
+ */
+#define MONDRIAN_PREV_LINES     120
+static char mondrian_prev_stream[UFS_BLOCK + MONDRIAN_LOG_SIZE];
+static uint32_t mondrian_prev_bytes;
+
+static void
+mondrian_prev_read(void)
+{
+	uint64_t base = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS;
+	uint32_t done = 0;
+
+	if (ufs_read_blocks(base, 1) != 0) {
+		return;
+	}
+	memcpy(mondrian_prev_stream, (void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+	while (done < MONDRIAN_LOG_SIZE) {
+		uint32_t blocks = MIN(BOUNCE_SIZE / UFS_BLOCK,
+		    (MONDRIAN_LOG_SIZE - done) / UFS_BLOCK);
+
+		if (ufs_read_blocks(base + 1 + done / UFS_BLOCK, blocks) != 0) {
+			break;
+		}
+		memcpy(mondrian_prev_stream + UFS_BLOCK + done,
+		    (void *)(su.dma + DMA_BOUNCE), (size_t)blocks * UFS_BLOCK);
+		done += blocks * UFS_BLOCK;
+	}
+	mondrian_prev_bytes = UFS_BLOCK + done;
+}
+
+void
+mondrian_prev_print(void)
+{
+	char *h = mondrian_prev_stream;
+	char *ring = mondrian_prev_stream + UFS_BLOCK;
+	char line[192];
+	uint32_t ring_size, have, nl = 0, n = 0;
+	uint32_t lines = MONDRIAN_PREV_LINES;
+	uint64_t total, start;
+
+	if (mondrian_prev_bytes < 2 * UFS_BLOCK) {
+		printf("MONDRIAN PREVLOG: no previous console (the copy failed)\n");
+		return;
+	}
+	if (memcmp(h, "MONDLOG", 7) != 0) {
+		printf("MONDRIAN PREVLOG: no MONDLOG header (nothing was flushed)\n");
+		return;
+	}
+	ring_size = *(uint32_t *)(void *)(h + 12);
+	total = *(uint64_t *)(void *)(h + 16);
+	if (ring_size != MONDRIAN_LOG_SIZE || total == 0) {
+		printf("MONDRIAN PREVLOG: bad header ring %u total %llu\n",
+		    ring_size, (unsigned long long)total);
+		return;
+	}
+	(void)PE_parse_boot_argn("mondrianprevlines", &lines, sizeof(lines));
+	have = total < ring_size ? (uint32_t)total : ring_size;
+	start = (total % ring_size + ring_size - have) % ring_size;
+	printf("MONDRIAN PREVLOG: %llu bytes, %u in the ring, flush seq %llu\n",
+	    (unsigned long long)total, have,
+	    (unsigned long long)*(uint64_t *)(void *)(h + 24));
+	for (uint32_t i = 0; i < have; i++) {
+		if (ring[(start + i) % ring_size] == '\n') {
+			nl++;
+		}
+	}
+	{
+		uint32_t const line0 = (nl > lines) ? (nl - lines) : 0;
+		uint32_t at = 0;
+
+		if (line0 != 0) {
+			uint32_t seen = 0;
+
+			for (uint32_t i = 0; i < have; i++) {
+				if (ring[(start + i) % ring_size] != '\n') {
+					continue;
+				}
+				if (seen == line0) {
+					at = i + 1;
+					break;
+				}
+				seen++;
+			}
+		}
+		for (uint32_t i = at; i < have; i++) {
+			char const c = ring[(start + i) % ring_size];
+
+			if (c != '\n' && n < sizeof(line) - 1) {
+				line[n++] = (c >= 0x20 && c < 0x7f) ? c : '.';
+				continue;
+			}
+			line[n] = 0;
+			printf("PREV | %s\n", line);
+			n = 0;
+		}
+		if (n != 0) {
+			line[n] = 0;
+			printf("PREV | %s\n", line);
+		}
+	}
+	printf("MONDRIAN PREVLOG: end\n");
+}
