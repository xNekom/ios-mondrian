+/*
+ * The live device tree's tert_tdm_pinctrl (status ok) is sck GPIO121,
+ * ws GPIO123 and dout GPIO124 (function mi2s2_data1); the tert_mi2s
+ * group with GPIO122/mi2s2_data0 is disabled. The speaker pair sits on
+ * the TDM dout line, so data1 is the pad to mux, drive and sample.
+ */
+static void
+audio_mi2s2_pins(struct audio_pins *pins)
+{
+	mondrian_tlmm_write(pins->sck, AUDIO_TLMM_IN_OUT, 2);
+	mondrian_tlmm_write(pins->sck, AUDIO_TLMM_CFG,
+	    mondrian_tlmm_cfg(AUDIO_MI2S2_FUNC, AUDIO_TLMM_PULL_NONE,
+	    AUDIO_TLMM_DRIVE_8MA, 1));
+	mondrian_tlmm_write(pins->ws, AUDIO_TLMM_IN_OUT, 2);
+	mondrian_tlmm_write(pins->ws, AUDIO_TLMM_CFG,
+	    mondrian_tlmm_cfg(AUDIO_MI2S2_FUNC, AUDIO_TLMM_PULL_NONE,
+	    AUDIO_TLMM_DRIVE_8MA, 1));
+	/*
+	 * The data line must carry the pad's output enable too: with OE clear
+	 * the peripheral function still selects the I2S input, but the pad is
+	 * tri-stated and the amplifier sees no data at all (measured
+	 * 2026-11-27: SYSST stayed 0x0011 for 80 ms of periods).
+	 */
+	mondrian_tlmm_write(pins->data1, AUDIO_TLMM_IN_OUT, 0);
+	mondrian_tlmm_write(pins->data1, AUDIO_TLMM_CFG,
+	    mondrian_tlmm_cfg(AUDIO_MI2S2_FUNC, AUDIO_TLMM_PULL_DOWN,
+	    AUDIO_TLMM_DRIVE_8MA, 1));
+	audio_log("muxed GPIO%u/%u/%u to mi2s2 (function %u), 8 mA, no pull",
+	    AUDIO_MI2S2_SCK_GPIO, AUDIO_MI2S2_WS_GPIO,
+	    AUDIO_MI2S2_DATA1_GPIO, AUDIO_MI2S2_FUNC);
+}
