+static int
+audio_amp_read(struct audio_pins *pins, struct audio_amp *a, uint8_t reg,
+    uint16_t *value, const char **why)
+{
+	int error = audio_read_reg(pins, a->addr, reg, value, why);
+
+	if (error != 0) {
+		audio_log("%s: register 0x%02x read failed: %s", a->where,
+		    reg, *why);
+	}
+	return error;
+}
+
+/* Write one register and insist it reads back; false stops the preparation. */
+static int
+audio_amp_write(struct audio_pins *pins, struct audio_amp *a, uint8_t reg,
+    uint16_t value, const char **why)
+{
+	uint16_t after = 0;
+	int error;
+
+	error = audio_write_reg(pins, a->addr, reg, value, why);
+	if (error != 0) {
+		audio_log("%s: 0x%02x <- 0x%04x not acknowledged: %s",
+		    a->where, reg, value, *why);
+		return error;
+	}
+	error = audio_read_reg(pins, a->addr, reg, &after, why);
+	if (error != 0) {
+		audio_log("%s: 0x%02x <- 0x%04x, readback failed: %s",
+		    a->where, reg, value, *why);
+		return error;
+	}
+	if (after != value) {
+		audio_log("%s: 0x%02x <- 0x%04x, reads 0x%04x", a->where, reg,
+		    value, after);
+		return EIO;
+	}
+	return 0;
+}
