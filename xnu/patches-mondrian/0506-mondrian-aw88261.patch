+/*
+ * Android's driver sequence: read the fuses, soft reset, write the Music
+ * profile, calibrate 0x50 from the fuses and park the part muted at the
+ * lowest volume. The power and mute bits in 0x04 stay as the reset left them.
+ */
+static int
+audio_amp_prepare(struct audio_pins *pins, struct audio_amp *a)
+{
+	const char *why = "";
+	uint16_t id = 0, now = 0, status = 0;
+	uint16_t h4 = 0, h3 = 0, l4 = 0, l3 = 0;
+	uint16_t icalk_bits, vcalk_bits, value;
+	uint32_t icalk, vcalk, ms;
+	uint64_t started = mach_absolute_time();
+	unsigned i, written = 0;
+
+	if (audio_amp_read(pins, a, AUDIO_AW88261_ID_REG, &id, &why) != 0 ||
+	    id != AUDIO_AW88261_ID) {
+		audio_log("%s: id 0x%04x is not an AW88261", a->where, id);
+		return EIO;
+	}
+
+	/* The fuses are read before the soft reset, as Android's driver does. */
+	if (audio_amp_read(pins, a, AUDIO_AW88261_EFRH4, &h4, &why) != 0 ||
+	    audio_amp_read(pins, a, AUDIO_AW88261_EFRH3, &h3, &why) != 0 ||
+	    audio_amp_read(pins, a, AUDIO_AW88261_EFRL4, &l4, &why) != 0 ||
+	    audio_amp_read(pins, a, AUDIO_AW88261_EFRL3, &l3, &why) != 0) {
+		return EIO;
+	}
+	value = 0;
+	for (i = 0; i < a->profile_count; i++) {
+		if (a->profile[i].reg == AUDIO_AW88261_DBGCTRL) {
+			value = a->profile[i].value & AUDIO_AW_EF_OR;
+		}
+	}
+	icalk_bits = value ? ((h4 & 0x3ff) | (l4 & 0x3ff)) :
+	    ((h4 & 0x3ff) & (l4 & 0x3ff));
+	vcalk_bits = value ? ((h3 & 0x3ff) | (l3 & 0x3ff)) :
+	    ((h3 & 0x3ff) & (l3 & 0x3ff));
+	icalk = 1000 + ((icalk_bits & 0x200) ? (int)icalk_bits - 0x400 :
+	    (int)icalk_bits);
+	vcalk = 1000 + ((vcalk_bits & 0x200) ? (int)vcalk_bits - 0x400 :
+	    (int)vcalk_bits);
+	if (icalk == 0 || vcalk == 0) {
+		audio_log("%s: fuses 0x%04x 0x%04x 0x%04x 0x%04x make no sense",
+		    a->where, h4, h3, l4, l3);
+		return EIO;
+	}
+	a->vcalb = (uint16_t)(8192 * icalk / vcalk);
+	audio_log("%s: fuses 0x%04x 0x%04x 0x%04x 0x%04x: icalk %u, "
+	    "vcalk %u, 0x%02x <- 0x%04x", a->where, h4, h3, l4, l3, icalk,
+	    vcalk, AUDIO_AW88261_VSNTM1, a->vcalb);
+
+	if (audio_write_reg(pins, a->addr, AUDIO_AW88261_ID_REG,
+	    AUDIO_AW88261_SOFT_RESET, &why) != 0) {
+		audio_log("%s: soft reset not acknowledged: %s", a->where, why);
+		return EIO;
+	}
+	delay(2000);
+
+	for (i = 0; i < a->profile_count; i++) {
+		uint8_t reg = a->profile[i].reg;
+
+		value = a->profile[i].value;
+		switch (reg) {
+		case AUDIO_AW88261_SYSINTM:
+			value = 0xffff;
+			break;
+		case AUDIO_AW88261_SYSCTRL:
+			if (audio_amp_read(pins, a, reg, &now, &why) != 0) {
+				return EIO;
+			}
+			value = (uint16_t)((value & ~(AUDIO_AW_PWDN |
+			    AUDIO_AW_AMPPD | AUDIO_AW_HMUTE)) |
+			    (now & (AUDIO_AW_PWDN | AUDIO_AW_AMPPD |
+			    AUDIO_AW_HMUTE)) | AUDIO_AW_ULS_HMUTE);
+			a->sysctrl = value;
+			break;
+		case AUDIO_AW88261_SYSCTRL2:
+			a->volume_high = a->profile[i].value & 0xfc00;
+			a->volume_at = (uint16_t)(((a->profile[i].value &
+			    0x3ff) >> 6) * AUDIO_AW_VOLUME_STEP +
+			    (a->profile[i].value & 0x3f));
+			break;
+		case AUDIO_AW88261_I2SCTRL3:
+			a->i2sctrl3 = a->profile[i].value;
+			value &= (uint16_t)~AUDIO_AW_TXEN;
+			break;
+		case AUDIO_AW88261_VSNTM1:
+			continue;
+		}
+		if (audio_amp_write(pins, a, reg, value, &why) != 0) {
+			return EIO;
+		}
+		written++;
+	}
+
+	if (audio_amp_write(pins, a, AUDIO_AW88261_VSNTM1, a->vcalb,
+	    &why) != 0) {
+		return EIO;
+	}
+	value = (uint16_t)(a->volume_high |
+	    (AUDIO_AW_VOLUME_MUTE / AUDIO_AW_VOLUME_STEP) << 6 |
+	    AUDIO_AW_VOLUME_MUTE % AUDIO_AW_VOLUME_STEP);
+	if (audio_amp_write(pins, a, AUDIO_AW88261_SYSCTRL2, value,
+	    &why) != 0) {
+		return EIO;
+	}
+
+	/* Park it explicitly, as mainline's dev_init does, whatever reset left. */
+	if (audio_amp_read(pins, a, AUDIO_AW88261_SYSCTRL, &now, &why) != 0) {
+		return EIO;
+	}
+	now |= AUDIO_AW_PWDN | AUDIO_AW_AMPPD | AUDIO_AW_HMUTE;
+	if (audio_amp_write(pins, a, AUDIO_AW88261_SYSCTRL, now, &why) != 0) {
+		return EIO;
+	}
+	a->sysctrl = now;
+	if (audio_amp_read(pins, a, AUDIO_AW88261_SYSST, &status,
+	    &why) != 0) {
+		return EIO;
+	}
+	ms = (uint32_t)((mach_absolute_time() - started) * 1000 /
+	    audio_timebase_hz);
+	audio_log("%s: prepared in %u ms, %u registers read back, muted at "
+	    "0x%04x (0x04=0x%04x 0x08=0x%04x), status 0x%04x", a->where, ms,
+	    written, value, a->sysctrl, a->i2sctrl3, status);
+	return 0;
+}
+
+static int
+audio_amp_sysctrl(struct audio_amp *a, uint16_t bits, int set,
+    const char **why)
+{
+	uint16_t value = 0;
+
+	if (audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSCTRL, &value,
+	    why) != 0) {
+		return EIO;
+	}
+	value = set ? (uint16_t)(value | bits) : (uint16_t)(value & ~bits);
+	return audio_amp_write(&audio_bus, a, AUDIO_AW88261_SYSCTRL, value,
+	    why);
+}
+
+/* The donor's start: PLL first, then the power stage, then the unmute. */
+static int
+audio_amp_start_one(struct audio_amp *a)
+{
+	const char *why = "";
+	uint16_t status = 0, value, vbat = 0, pvdd = 0;
+	unsigned tries;
+
+	audio_log("%s: power-down off", a->where);
+	if (audio_amp_sysctrl(a, AUDIO_AW_PWDN, 0, &why) != 0) {
+		return EIO;
+	}
+	delay(2000);
+	for (tries = 0; tries < AUDIO_AW_PLL_TRIES; tries++) {
+		if (audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSST,
+		    &status, &why) != 0) {
+			return EIO;
+		}
+		if ((status & AUDIO_AW_SYSST_PLL_CHECK) ==
+		    AUDIO_AW_SYSST_PLL_CHECK) {
+			break;
+		}
+		delay(2000);
+	}
+	audio_log("%s: status 0x%04x, PLL %s", a->where, status,
+	    tries < AUDIO_AW_PLL_TRIES ? "locked to the bit clock" :
+	    "did not lock: no bit clock?");
+	if (tries == AUDIO_AW_PLL_TRIES) {
+		return ETIMEDOUT;
+	}
+
+	audio_log("%s: amplifier power-down off", a->where);
+	if (audio_amp_sysctrl(a, AUDIO_AW_AMPPD, 0, &why) != 0) {
+		return EIO;
+	}
+	delay(1000);
+	/*
+	 * SWS and BSTS cannot set while the part is still muted: this is the
+	 * upstream aw88261 "check sysst fail, reg_val=0x0011" fix (2026-07),
+	 * and the vendor driver checks only PLL and clocks here. The switching
+	 * bits are looked at after the mute release below.
+	 */
+	for (tries = 0; tries < AUDIO_AW_STATUS_TRIES; tries++) {
+		if (audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSST,
+		    &status, &why) != 0) {
+			return EIO;
+		}
+		if ((status & AUDIO_AW_SYSST_FAULTS) != 0) {
+			break;
+		}
+		if ((status & AUDIO_AW_SYSST_PLL_CHECK) ==
+		    AUDIO_AW_SYSST_PLL_CHECK) {
+			break;
+		}
+		delay(2000);
+	}
+	audio_log("%s: status 0x%04x after amplifier on", a->where, status);
+	if ((status & AUDIO_AW_SYSST_FAULTS) != 0 ||
+	    (status & AUDIO_AW_SYSST_PLL_CHECK) !=
+	    AUDIO_AW_SYSST_PLL_CHECK) {
+		audio_log("%s: %s", a->where,
+		    (status & AUDIO_AW_SYSST_FAULTS) != 0 ? "reports a fault" :
+		    "has no stable clock");
+		return EIO;
+	}
+
+	if (audio_amp_write(&audio_bus, a, AUDIO_AW88261_I2SCTRL3,
+	    a->i2sctrl3, &why) != 0 ||
+	    audio_amp_sysctrl(a, AUDIO_AW_ULS_HMUTE, 0, &why) != 0 ||
+	    audio_amp_sysctrl(a, AUDIO_AW_HMUTE, 0, &why) != 0) {
+		return EIO;
+	}
+	/* Read the interrupt once to clear it, then mask it as Android does. */
+	(void)audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSINT, &status,
+	    &why);
+	(void)audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSINT, &status,
+	    &why);
+	if (audio_amp_write(&audio_bus, a, AUDIO_AW88261_SYSINTM, 0xffff,
+	    &why) != 0) {
+		return EIO;
+	}
+
+	value = (uint16_t)(a->volume_high |
+	    (a->volume_at / AUDIO_AW_VOLUME_STEP) << 6 |
+	    a->volume_at % AUDIO_AW_VOLUME_STEP);
+	if (audio_amp_write(&audio_bus, a, AUDIO_AW88261_SYSCTRL2, value,
+	    &why) != 0) {
+		return EIO;
+	}
+	for (tries = 0; tries < AUDIO_AW_STATUS_TRIES; tries++) {
+		if (audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSST,
+		    &status, &why) != 0) {
+			return EIO;
+		}
+		if ((status & AUDIO_AW_SYSST_FAULTS) != 0) {
+			break;
+		}
+		if ((status & AUDIO_AW_SYSST_SWITCHING) ==
+		    AUDIO_AW_SYSST_SWITCHING) {
+			break;
+		}
+		delay(2000);
+	}
+	if ((status & AUDIO_AW_SYSST_FAULTS) != 0) {
+		audio_log("%s: reports a fault after unmute: 0x%04x", a->where,
+		    status);
+		return EIO;
+	}
+	(void)audio_read_reg(&audio_bus, a->addr, AUDIO_AW88261_VBAT, &vbat,
+	    &why);
+	(void)audio_read_reg(&audio_bus, a->addr, AUDIO_AW88261_PVDD, &pvdd,
+	    &why);
+	audio_log("%s: unmuted at the profile volume 0x%04x (-%u.%03u dB), "
+	    "status 0x%04x (%s), vbat 0x%03x (%u mV), pvdd 0x%03x", a->where,
+	    value, a->volume_at / 8, a->volume_at % 8 * 125, status,
+	    (status & AUDIO_AW_SYSST_SWITCHING) == AUDIO_AW_SYSST_SWITCHING ?
+	    "amplifier switching" : "switching bits not set", vbat,
+	    vbat * 6025 / 1023, pvdd);
+	return 0;
+}
+
+static void
+audio_amp_power_down(struct audio_amp *a)
+{
+	const char *why = "";
+	uint16_t value = a->sysctrl;
+
+	if (audio_amp_read(&audio_bus, a, AUDIO_AW88261_SYSCTRL, &value,
+	    &why) != 0) {
+		value = a->sysctrl;
+	}
+	value |= AUDIO_AW_PWDN | AUDIO_AW_AMPPD | AUDIO_AW_HMUTE;
+	if (audio_amp_write(&audio_bus, a, AUDIO_AW88261_SYSCTRL, value,
+	    &why) != 0) {
+		audio_log("%s: power-down write failed: %s", a->where, why);
+		return;
+	}
+	audio_log("%s: powered down (0x04=0x%04x)", a->where, value);
+}
+
+/*
+ * Called by the ADSP worker once both graphs have started, so the MI2S2 bit
+ * clock the PLL locks to is already running. Returns EAGAIN when the probe is
+ * still preparing or failed: the graph then runs into muted parts.
+ */
+int
+mondrian_audio_amp_start(void)
+{
+	unsigned i, started = 0;
+	int wait;
+
+	if (audio_probe_mode < AUDIO_MODE_PREPARE) {
+		return ENOENT;
+	}
+	/*
+	 * The bit-banged register path takes seconds, and the graph is already
+	 * started (the I2S clock keeps running), so wait for the probe thread
+	 * to finish rather than giving up on the first 2 s.
+	 */
+	for (wait = 0; wait < 30000; wait += 10) {
+		if (__atomic_load_n(&audio_amps_done, __ATOMIC_ACQUIRE)) {
+			break;
+		}
+		delay(10000);
+	}
+	if (!__atomic_load_n(&audio_amps_prepared, __ATOMIC_ACQUIRE)) {
+		audio_log("start: the amplifiers are %s; leaving them muted",
+		    __atomic_load_n(&audio_amps_done, __ATOMIC_ACQUIRE) ?
+		    "not prepared" : "still preparing after 30 s");
+		return EAGAIN;
+	}
+	if (__atomic_exchange_n(&audio_amps_running, 1, __ATOMIC_ACQ_REL) !=
+	    0) {
+		return 0;
+	}
+
+	audio_log("start: the graph has started mi2s2; spksw GPIO%u on",
+	    AUDIO_SPKSW_GPIO);
+	audio_spksw(&audio_bus, 1);
+	delay(1000);
+	for (i = 0; i < AUDIO_ARRAY_SIZE(audio_amps); i++) {
+		if (audio_amp_start_one(&audio_amps[i]) == 0) {
+			started++;
+		}
+	}
+	if (started != AUDIO_ARRAY_SIZE(audio_amps)) {
+		audio_log("start: %u/2 amplifiers running; powering both down",
+		    started);
+		for (i = 0; i < AUDIO_ARRAY_SIZE(audio_amps); i++) {
+			audio_amp_power_down(&audio_amps[i]);
+		}
+		audio_spksw(&audio_bus, 0);
+		__atomic_store_n(&audio_amps_running, 0, __ATOMIC_RELEASE);
+		mondrian_log_flush_now();
+		return EIO;
+	}
+	mondrian_log_flush_now();
+	return 0;
+}
+
+void
+mondrian_audio_amp_stop(void)
+{
+	unsigned i;
+
+	if (!__atomic_load_n(&audio_amps_running, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	for (i = 0; i < AUDIO_ARRAY_SIZE(audio_amps); i++) {
+		audio_amp_power_down(&audio_amps[i]);
+	}
+	audio_spksw(&audio_bus, 0);
+	__atomic_store_n(&audio_amps_running, 0, __ATOMIC_RELEASE);
+	audio_log("stop: both amplifiers powered down, spksw GPIO%u low",
+	    AUDIO_SPKSW_GPIO);
+	mondrian_log_flush_now();
+}
+
+/*
+ * Called while the PCM period is being played: SWS/BSTS only follow real
+ * audio through the power stage, so this is the point where they mean
+ * something. Reads the supply rails too; 0x21 is VBAT in 6025/1023 mV.
+ */
+void
+mondrian_audio_amp_report(const char *when)
+{
+	const char *why = "";
+	uint16_t status = 0, vbat = 0, pvdd = 0;
+	unsigned i, tries;
+	int switching;
+
+	if (!__atomic_load_n(&audio_amps_running, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	for (i = 0; i < AUDIO_ARRAY_SIZE(audio_amps); i++) {
+		struct audio_amp *a = &audio_amps[i];
+
+		switching = 0;
+		for (tries = 0; tries < 20; tries++) {
+			if (audio_read_reg(&audio_bus, a->addr,
+			    AUDIO_AW88261_SYSST, &status, &why) != 0) {
+				break;
+			}
+			if ((status & AUDIO_AW_SYSST_SWITCHING) ==
+			    AUDIO_AW_SYSST_SWITCHING) {
+				switching = 1;
+				break;
+			}
+			delay(1000);
+		}
+		(void)audio_read_reg(&audio_bus, a->addr,
+		    AUDIO_AW88261_VBAT, &vbat, &why);
+		(void)audio_read_reg(&audio_bus, a->addr,
+		    AUDIO_AW88261_PVDD, &pvdd, &why);
+		audio_log("%s: %s status 0x%04x (%s), vbat 0x%03x (%u mV), "
+		    "pvdd 0x%03x", when, a->where, status,
+		    switching ? "amplifier switching" :
+		    "switching bits not set", vbat, vbat * 6025 / 1023, pvdd);
+	}
+	mondrian_log_flush_now();
+}
+
+/*
+ * The pads answer for themselves: a pin muxed to a peripheral function still
+ * reports its level in the TLMM input bit, so this reads SCK, WS and DATA0
+ * while the DSP renders a period. Data that never leaves the SoC shows up as
+ * a constant DATA0 with no edges even though SCK and WS run.
+ */
+void
+mondrian_audio_sample_pads(const char *when)
+{
+	uint32_t sck_high = 0, ws_high = 0, data_high = 0, edges = 0;
+	uint32_t spksw_high = 0;
+	uint32_t reads = 0;
+	uint64_t ticks, start;
+	int last = -1;
+
+	if (!__atomic_load_n(&audio_amps_running, __ATOMIC_ACQUIRE) ||
+	    audio_timebase_hz == 0) {
+		return;
+	}
+	ticks = (audio_timebase_hz / 1000) * 8;
+	start = mach_absolute_time();
+	while (mach_absolute_time() - start < ticks && reads < 2000000) {
+		int sck = audio_pin_level(audio_bus.sck);
+		int ws = audio_pin_level(audio_bus.ws);
+		int data = audio_pin_level(audio_bus.data1);
+
+		sck_high += (uint32_t)sck;
+		ws_high += (uint32_t)ws;
+		data_high += (uint32_t)data;
+		spksw_high += (uint32_t)audio_pin_level(audio_bus.spksw);
+		if (last >= 0 && data != last) {
+			edges++;
+		}
+		last = data;
+		reads++;
+	}
+	audio_log("%s: pads over %u reads: sck high %u, ws high %u, "
+	    "data1 high %u, data1 edges %u, spksw high %u", when, reads,
+	    sck_high, ws_high, data_high, edges, spksw_high);
+	mondrian_log_flush_now();
+}
