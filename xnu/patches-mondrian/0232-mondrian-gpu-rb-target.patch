xnu 0232: is the RB drawing where the panel reads?

The RB can write memory (0231: RB_DONE_TS lands on the first poll), the CP
runs every stream to its fence, and the surface the window server hands the
GPU is still all zero with glcopy=0, in gmem and with FD_MESA_DEBUG=sysmem
alike. So either the RB draws into an address that is not the surface, or no
fragment is ever produced.

This reads RB_MRT_0_BASE (0x8825/0x8826), BUF_INFO, PITCH and RB_RENDER_CNTL
back from the idle GPU after a real stream's fence is answered, and prints
them next to the iova MondrianGPUUserClient::surfaceBuffer() gave the last
adopted IOSurface. Equal addresses put the fault in the draw itself; different
addresses put it in the handoff. Nothing is written to the GPU.

Boot argument gpurbt=1.
--- a/bsd/dev/mondrian_gpu.c
+++ b/bsd/dev/mondrian_gpu.c
@@ -74,6 +74,13 @@
 static int mondrian_uc_noblit;
 /* gprbdone=1: ask the RB for its own timestamp (0231). */
 static int mondrian_cp_test_rbdone;
+/* gpurbt=1: read the RB's render target back and compare it with the iova the
+ * user client gave the surface the window server handed to the GPU (0232).
+ * Read only: nothing here writes a register or submits a packet. */
+static int mondrian_uc_rbtarget;
+static uint32_t mondrian_uc_rbt_printed;
+static uint32_t mondrian_uc_surface_id;
+static uint64_t mondrian_uc_surface_iova;
 static uint32_t mondrian_uc_nop_opcode;
 static uint32_t mondrian_uc_set_mode = 0xffffffffu;
 static uint32_t mondrian_uc_draw_state;
@@ -3619,6 +3626,18 @@
 	return mondrian_uc_noblit;
 }
 
+/*
+ * MondrianGPUUserClient::surfaceBuffer() adopts an IOSurface's memory as a GPU
+ * buffer and hands its iova to the GL client; this records which address that
+ * was, so a later submission can say whether the RB drew there.
+ */
+void
+mondrian_gpu_uc_note_surface(uint32_t id, uint64_t iova)
+{
+	mondrian_uc_surface_id = id;
+	mondrian_uc_surface_iova = iova;
+}
+
 uint32_t
 mondrian_gpu_uc_nop_opcode(void)
 {
@@ -4689,6 +4708,35 @@
 		printf("MONDRIAN GPU: uc big %u dwords fence %u done %u in %u ms\n",
 		    dwords, seq, (int32_t)(value - seq) >= 0, spent_us / 1000);
 		mondrian_log_flush_now();
+		/*
+		 * The fence is answered, so the GPU is idle and its registers
+		 * can be read. RB_MRT_0_BASE is where the RB is told to put
+		 * colour; the surface entry is where the memory the panel scans
+		 * actually lives in the GPU's address space. A draw that runs
+		 * and leaves the surface zero is either drawing elsewhere (the
+		 * two differ) or not rasterizing at all (they agree).
+		 */
+		if (mondrian_uc_rbtarget != 0 && dwords > 16 &&
+		    mondrian_uc_rbt_printed < 20) {
+			uint32_t lo = mondrian_gpu_read(mondrian_uc_gpu,
+			    0x8825u * 4u);
+			uint32_t hi = mondrian_gpu_read(mondrian_uc_gpu,
+			    0x8826u * 4u);
+			uint32_t info = mondrian_gpu_read(mondrian_uc_gpu,
+			    0x8822u * 4u);
+			uint32_t pitch = mondrian_gpu_read(mondrian_uc_gpu,
+			    0x8823u * 4u);
+			uint32_t rcntl = mondrian_gpu_read(mondrian_uc_gpu,
+			    0x8801u * 4u);
+
+			mondrian_uc_rbt_printed++;
+			printf("MONDRIAN GPU: rb target 0x%08x%08x info 0x%x pitch %u rcntl 0x%x | surface %u iova 0x%08x%08x\n",
+			    hi, lo, info, pitch * 64u, rcntl,
+			    mondrian_uc_surface_id,
+			    (uint32_t)(mondrian_uc_surface_iova >> 32),
+			    (uint32_t)mondrian_uc_surface_iova);
+			mondrian_log_flush_now();
+		}
 		if ((int32_t)(value - seq) < 0) {
 			/*
 			 * The fence was not answered: the GPU has stopped
@@ -5003,6 +5051,8 @@
 	    sizeof(mondrian_uc_noblit));
 	(void)PE_parse_boot_argn("gprbdone", &mondrian_cp_test_rbdone,
 	    sizeof(mondrian_cp_test_rbdone));
+	(void)PE_parse_boot_argn("gpurbt", &mondrian_uc_rbtarget,
+	    sizeof(mondrian_uc_rbtarget));
 	(void)PE_parse_boot_argn("gpunop", &mondrian_uc_nop_opcode,
 	    sizeof(mondrian_uc_nop_opcode));
 	(void)PE_parse_boot_argn("gpumode", &mondrian_uc_set_mode,

