+	/*
+	 * kgsl brackets every submission with these: the two CP threads are
+	 * synchronised, IFPC (inter-frame power collapse) is disabled for the
+	 * duration, the work runs on the BR thread, and the indirect buffer is
+	 * declared inside an IB1LIST. Without the IFPC markers the SQE is free
+	 * to collapse the GPU in the middle of the submission.
+	 */
+	if (mondrian_uc_nomark == 0) {
+		ring[at++] = mondrian_pm4_type7(0x17u, 1);	/* THREAD_CONTROL */
+		ring[at++] = 3;			/* both threads */
+		ring[at++] = mondrian_pm4_type7(0x65u, 1);	/* SET_MARKER */
+		ring[at++] = 0x101;		/* IFPC mode: IFPC disabled */
+		ring[at++] = mondrian_pm4_type7(0x17u, 1);	/* THREAD_CONTROL */
+		ring[at++] = 1;			/* BR thread */
+	}
 	ring[at++] = mondrian_pm4_type7(0x5fu, 1);	/* SET_PROTECTED_MODE */
 	ring[at++] = 0;
+	if (mondrian_uc_nomark == 0) {
+		ring[at++] = mondrian_pm4_type7(0x65u, 1);	/* SET_MARKER */
+		ring[at++] = 0x00du;		/* IB1LIST start */
+	}
 	ring[at++] = mondrian_pm4_type7(0x3fu, 3);	/* INDIRECT_BUFFER */
 	ring[at++] = (uint32_t)ib;
 	ring[at++] = (uint32_t)(ib >> 32);
 	ring[at++] = dwords;
+	if (mondrian_uc_nomark == 0) {
+		ring[at++] = mondrian_pm4_type7(0x65u, 1);	/* SET_MARKER */
+		ring[at++] = 0x00eu;		/* IB1LIST end */
+	}
 	ring[at++] = mondrian_pm4_type7(0x46u, 4);	/* EVENT_WRITE */
 	ring[at++] = 0x31u | (1u << 27);		/* cache clean */
 	ring[at++] = (uint32_t)slot;
