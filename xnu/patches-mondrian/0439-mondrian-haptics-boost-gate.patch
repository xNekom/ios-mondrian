-	uint8_t th = 0, tl = 0, cal = 0, vreg = 0;
+	uint8_t th = 0, tl = 0, cal = 0;
 	uint32_t t;
 	int ok = 1;
 
@@ -244,9 +250,8 @@ mondrian_haptics_buzz(unsigned int ms, unsigned int amp, unsigned int force)
 	}
 	ok &= hap_w(0, HAP_CFG_VMAX, vmax);
 	ok &= hap_w(0, HAP_CFG_EN_CTL, HAP_EN_BIT);
-	(void)hap_r(2, HAP_HBST_VREG, &vreg);
 	ok &= hap_w(0, HAP_CFG_VSET_CFG,
-	    (vreg & HAP_EN_BIT) != 0 ? HAP_FORCE_VREG_RDY : 0);
+	    hap_hbst_on ? HAP_FORCE_VREG_RDY : 0);
