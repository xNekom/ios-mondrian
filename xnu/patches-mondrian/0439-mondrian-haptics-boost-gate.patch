 	    " ppid 0x09d %s\n", on ? "on" : "off", got_arg, got_trig,
 	    ok ? "sent" : "failed");
+	if (ok) {
+		hap_hbst_on = on ? 1 : 0;
+	}
 	return ok;
 }
 
@@ -150,7 +156,7 @@ hap_boost_ready(void)
 		    HAP_HBST_VREG, &vreg) &&
 		    mondrian_spmi_reg_read_raw(MONDRIAN_HAP_HBST,
