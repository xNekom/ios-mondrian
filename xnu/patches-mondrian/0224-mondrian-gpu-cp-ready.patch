+ * The generated profile carries the registers the vendor's own tables name;
+ * these two are only in kgsl's headers, so they live here. Both are dword
+ * offsets into the CP window, like the rest of the gen7 set.
+ */
+#ifndef GEN7_CP_LPAC_PROTECT_CNTL
+#define GEN7_CP_LPAC_PROTECT_CNTL 0xb09	/* kgsl gen7_reg.h */
+#endif
+#ifndef GEN7_CP_SECURE_MODE
+#define GEN7_CP_SECURE_MODE 0x075	/* mainline a6xx CP_SECURE_MODE */
+#endif
+#endif /* MONDRIAN_CP_PROFILE */
 #if __has_include("mondrian_zap_fw.h")
 #include "mondrian_zap_fw.h"
 #define MONDRIAN_ZAP_FW 1
@@ -55,6 +68,8 @@
 
 static int mondrian_uc_up;
 static int mondrian_uc_logged;
+/* The frame shape the submit path used, printed on its first submission. */
+static int mondrian_uc_frame_logged;
 static uint32_t mondrian_uc_pm4;
 static int mondrian_uc_noblit;
 static uint32_t mondrian_uc_nop_opcode;
@@ -70,6 +85,13 @@
 static int mondrian_uc_dump;
 static int mondrian_uc_rback;
 /*
+ * The first three submissions print a line before they touch a register,
+ * whatever gpudump says: without it a boot that hangs in this path says
+ * nothing at all, and a hang on the GMU keepalive write cannot be told from
+ * one on the CP_RB_RPTR read from one in the room loop.
+ */
+static uint32_t mondrian_uc_sub_first;
+/*
  * 1 (the default): the keepalive is raised at cp start and held.
  * Measured, that is the boot that survives; with the toggle (0) a boot died
  * right after backboardd loaded the GL driver and before it submitted
@@ -78,6 +100,14 @@
 static int mondrian_uc_keep = 1;
 static int mondrian_cp_init_hw;
