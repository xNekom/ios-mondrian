+ * The 2000-submission stress in the CP bring-up: a diagnostic, on by default
+ * because it is what proves the ring, the fence slots and the order. cpstress=0
+ * skips it, for a boot where the point is to get past the bring-up: with
+ * anything wrong in the ring one submission costs its 2 s room timeout, and
+ * 2000 of those keep userland from ever starting.
+ */
+static int mondrian_cp_stress = 1;
+/*
  * Measured: with the door thread on, the 71-dword stream never fences and the
  * UI freezes at 0 fps; written inline, it completes in 14 ms. Keep the thread
  * for measuring with gpuasync=1, default to the write that works.
@@ -97,6 +127,16 @@
 static uint32_t mondrian_uc_rptr;
 static int mondrian_uc_rptr_valid;
 /*
+ * CP_RB_CNTL selects the rptr shadow page, so the pointer that matters may
+ * be the word the CP writes into memory rather than the register. These are
+ * the last register/shadow pair the room loop saw, and whether the shadow
+ * moving while the register does not has already been reported.
+ */
+static uint32_t mondrian_uc_sh_reg;
+static uint32_t mondrian_uc_sh_shadow;
+static int mondrian_uc_sh_seen;
+static int mondrian_uc_sh_said;
+/*
  * gpuringslow=1 cleans the whole 32 KiB ring before every doorbell, which is
  * what this path did before 0222: the valve for a boot where the CP reads a
  * ring dword the CPU never flushed.
@@ -1730,6 +1770,73 @@
 /* gpustart: start the SQE. On by default now that the whole path works
  * (the parity fix and the four streams); gpustart=0 leaves it stopped. */
 static int mondrian_cp_run = 1;
+/* cpnoretry=1: report a SQE that stopped on the secure-mode switch instead of
+ * re-issuing it once. The retry is the only way back from the measured race
+ * (the same kernel drains the switch in one boot and halts on it in the next),
+ * and it is one SQE restart, not a GPU reset. */
+static int mondrian_cp_noretry;
+/* cporder=1: publish the secure-mode switch only once the CP has been seen to
+ * retire the ME_INIT the rearm re-issued (CP_RB_RPTR >= 10). The measured
+ * difference between the boot that works and every boot since ring72 is this
+ * one ordering: the good one retired ME_INIT before the switch went in, the
+ * bad one got the switch published on top of it and halted on the switch's own
+ * header with rptr 11 of 12. */
+static int mondrian_cp_order;
+/* gpureset=1: after the ZAP, cycle the GPU core through the GMU's HFI power
+ * vote before the CP registers are re-armed, so the CP starts from a core the
+ * GMU has just powered off and on rather than from whatever state the previous
+ * boot left in it. */
+static int mondrian_cp_reset;
+/* cpnosecmode=1: leave CP_SET_SECURE_MODE out entirely -- no write, no publish.
+ * The ZAP switches the CP by packet already, so this asks whether a second,
+ * explicit switch is needed at all. `at` stays 10, nothing is published for the
+ * switch, and the memory packet below goes in first: the existing `if (rptr >=
+ * at)` path and the ready check then judge the CP by that packet. */
+static int mondrian_cp_nosecmode;
+/* cpprot=1: bracket the bring-up's memory packet and its IB probe with
+ * CP_SET_PROTECTED_MODE(0) ... (1). Measured with the switch skipped, the CP
+ * retires the memory write and then parks on the EVENT_WRITE behind it; a
+ * packet issued from a context the CP still believes is protected is the
+ * candidate this tests. Off, both emit nothing and the bring-up is
+ * byte-identical. cpapriv=1 (the default) writes neither half, for the reason
+ * the bracket below gives: no 0x5f belongs in a frame in that mode, so cpprot
+ * only reaches a cpapriv=0 boot. */
+static int mondrian_cp_protmode;
+/* cpfence=mem: write the fence with CP_MEM_WRITE to the same dword instead of
+ * CP_EVENT_WRITE. The measured CP retires the memory write and parks on the
+ * event write, and the CPU already polls that dword, so this asks whether the
+ * event write is itself the packet the SQE cannot dispatch. What it gives up
+ * is CACHE_CLEAN: the GPU's own writes are no longer flushed before the CPU
+ * reads them. */
+static int mondrian_cp_fence_mem;
+/* cpevent=4: put CACHE_FLUSH_TS (4) in the fence's event dword instead of
+ * CACHE_CLEAN (0x31). Measured with cpapriv in place: the CP retires the
+ * CP_MEM_WRITE in front of the fence and refuses the event write itself
+ * (`cp int 0x80`, CP_ILLEGAL_INSTR_ERROR, nothing in CP_HW_FAULT). Mainline's
+ * a6xx/a7xx ring fence and Mesa's a7xx fence are CP_EVENT_WRITE with
+ * WRITE_ENABLED|EV_WRITE_USER_32B|EV_DST_RAM and event 4, so the payload
+ * 0x08000004 asks whether it is the event code and not the opcode that is
+ * refused: same count, same 64-bit destination, same value dword.
+ * cpevent=31, or no argument, keeps 0x31 | (1u << 27) byte for byte. */
+static int mondrian_cp_event4;
+/* cpapriv=1 (the default): program CP_APRIV_CNTL before ME_INIT runs, and
+ * republish ME_INIT on its own before the secure-mode switch.
+ *
+ * Cause, measured against kgsl's gen7_start and the a730 SQE microcode: the
+ * microcode masks its per-pipe privileged opcodes from CP_APRIV_CNTL, and
