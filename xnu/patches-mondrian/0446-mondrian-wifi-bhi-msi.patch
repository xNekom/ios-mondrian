     uint32_t *, uint32_t *, uint32_t *, uint32_t *);
 
+#define W6_MSI_OFF	0x5fe000u
+
+/*
+ * W6 MSI: the endpoint raises its MHI interrupt through the standard MSI
+ * capability, and this driver has no GIC/ITS path. Point it at a page inside
+ * the wired image buffer, mapped by the same W2 context, so the interrupt is
+ * an ordinary DMA write this kernel can poll and log. The donor retains the
+ * same kind of landing page for the QCA6490 (Iova+0x40 there).
+ */
+static int
+wifi_msi_enable(uint64_t page_iova)
+{
+    uint8_t cap;
+    uint16_t mc;
+    uint32_t lo = (uint32_t)page_iova;
+    uint32_t hi = (uint32_t)(page_iova >> 32);
+    int i, is64;
+
+    cap = (uint8_t)(wifi_read8(wifi_cfg, 0x34) & ~3u);
+    for (i = 0; i < 16; i++) {
+        uint8_t id;
+
+        if (cap < 0x40 || cap > 0xfc) {
+            break;
+        }
+        id = wifi_read8(wifi_cfg, cap);
+        if (id == 0x05) {
+            break;
+        }
+        cap = (uint8_t)(wifi_read8(wifi_cfg, cap + 1) & ~3u);
+    }
+    if (i >= 16 || cap < 0x40 || cap > 0xfc) {
+        wifi_log("W6 MSI capability not found");
+        return -1;
+    }
+    mc = wifi_read16(wifi_cfg, cap + 2);
+    is64 = (mc & 0x80) != 0;
+    wifi_log("W6 MSI cap=0x%x ctrl=0x%x addr=0x%x%08x data=0x%x",
+        cap, mc, hi, lo,
+        wifi_read16(wifi_cfg, cap + (is64 ? 0x0c : 0x08)));
+    mondrian_tlmm_write(wifi_cfg, cap + 4, lo);
+    if (is64) {
+        mondrian_tlmm_write(wifi_cfg, cap + 8, hi);
+    }
+    wifi_write16(wifi_cfg, cap + (is64 ? 0x0c : 0x08), 0);
+    if ((mc & 0x100u) != 0) {
+        /* Per-vector masking capable: an all-ones mask blocks the write. */
+        mondrian_tlmm_write(wifi_cfg, cap + (is64 ? 0x10 : 0x0c), 0);
+    }
+    wifi_write16(wifi_cfg, cap + 2, (uint16_t)((mc & ~0x100u) | 0x1u));
+    /* PCI 3.0: INTx must be disabled before MSI is enabled. */
+    mc = wifi_read16(wifi_cfg, 4);
+    wifi_write16(wifi_cfg, 4, (uint16_t)(mc | 0x400u));
+    return 0;
+}
