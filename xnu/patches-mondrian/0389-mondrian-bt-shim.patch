xnu 0389: bluetoothd's transport arrives in a dylib, not a literal

0388 hands the daemon BT_HCI_TRANSPORT as a string compiled into the kernel,
which makes every change of transport - and every attempt to see what the
daemon says about the next failure - cost a build. It also has nowhere to
report: launchd gives the job /dev/null, /dev/console does not reach the ring
with mondrianfb_noconsole=1, and the job table cannot be edited (writing it
stopped the boot at two processes).

So the exec carries DYLD_INSERT_LIBRARIES=/private/var/vm/mondrian-bt.dylib
instead. tools/mondrian-bt.c sets the variable in its constructor, before
main, and claims descriptors 1 and 2 for /private/var/tmp/bt-inject.log, so
the daemon's own stderr is a file `rf` reads. The dylib is 65 KB and lives in
the root: replacing it is a `wfile`, not a kernel build. When the file is
absent the injection is skipped and bluetoothd runs as it does today.
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 9287311..9551d87 100755
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5828,11 +5828,18 @@ mondrian_name_is(const char *name, size_t len, const char *want)
  * stderr stops after the local address, no transport line, exit status
  * 0x100). The value is TRANSPORT:DRIVER[:PARAM]: /usr/sbin/bluetoothd parses
  * it at 0x1001561a0 with strtok(":"), matches the first token against the
- * transport table at 0x1007fd3e0 (USB, H4DS, H4BC, H4, H5, APPLEBT, VIRT,
- * PCIE, PCIESW) and the second against the driver table at 0x1007fd430 (USB,
- * POSIX, APPLEBT, VIRT, PCIE, PCIESW). POSIX is the driver that opens a
- * device path, and it is also the only one the daemon checks for by hand: it
- * access()es /dev/cu.bluetooth before it looks at the IORegistry.
+ * transport table at 0x1007fd3e0 and the second against the driver table at
+ * 0x1007fd430. POSIX is the driver that opens a device path, and it is also
+ * the one the daemon checks for by hand: it access()es /dev/cu.bluetooth
+ * before it looks at the IORegistry.
+ *
+ * The string arrives through a dylib rather than directly, because the
+ * daemon's own explanation of the next failure has nowhere to go: launchd
+ * hands the job /dev/null, /dev/console does not reach the ring, and the job
+ * table cannot be edited (writing it stopped the boot at two processes,
+ * launchd never printing its UUID). tools/mondrian-bt.c claims descriptors 1
+ * and 2 for a file `rf` reads, sets the variable, and is small enough to
+ * replace with one `wfile`.
  *
  * It arrives at exec because the launchd job table is not an option: writing
  * /System/Library/xpc/launchd.plist with the same variables left the boot at
@@ -5844,21 +5851,30 @@ mondrian_bt_env(struct image_params *imgp, char *env, size_t size)
 {
 	int enabled = 0;
 	const char *name;
-	const char transport[] = "BT_HCI_TRANSPORT=H4:POSIX";
+	const char inject[] = "DYLD_INSERT_LIBRARIES=/private/var/vm/mondrian-bt.dylib";
+	const char inject_path[] = "/private/var/vm/mondrian-bt.dylib";
 
 	if (!PE_parse_boot_argn("mondrianbt", &enabled, sizeof(enabled)) ||
 	    !enabled || imgp->ip_ndp == NULL) {
 		return false;
 	}
 	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
-	if (name == NULL || sizeof(transport) > size) {
+	if (name == NULL || sizeof(inject) > size) {
 		return false;
 	}
 	if (!mondrian_name_is(name, (size_t)imgp->ip_ndp->ni_cnd.cn_namelen,
 	    "bluetoothd")) {
 		return false;
 	}
-	strlcpy(env, transport, size);
+	/*
+	 * The shim sets BT_HCI_TRANSPORT itself and takes descriptors 1 and 2
+	 * for a file `rf` can read. Keeping it a file means the next transport
+	 * or the next observation costs one `wfile` and one boot.
+	 */
+	if (!mondrian_dylib_in_vm(inject_path)) {
+		return false;
+	}
+	strlcpy(env, inject, size);
 	return true;
 }
 
