diff --git a/iokit/Kernel/arm/MondrianPlatformExpert.cpp b/iokit/Kernel/arm/MondrianPlatformExpert.cpp
--- a/iokit/Kernel/arm/MondrianPlatformExpert.cpp
+++ b/iokit/Kernel/arm/MondrianPlatformExpert.cpp
@@ -9,6 +9,7 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
 
 class MondrianPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(MondrianPlatformExpert);
@@ -70,6 +71,23 @@ MondrianPlatformExpert::processTopLevel(IORegistryEntry *root)
 	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
 	if (armio != NULL) {
 		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
 		armio->release();
 	}
+
+	/*
+	 * IODeviceTree:/options. watchdogd reads its boot arguments from that node
+	 * and calls __os_crash when the lookup fails (0x600000001 at
+	 * watchdogd+0xb620, every ten seconds, measured), so a missing NVRAM node
+	 * is a crash loop and not a missing feature. This port has no NVRAM
+	 * controller and nothing here writes it back: the property is the kernel's
+	 * own command line, published for every client that asks that way.
+	 */
+	IORegistryEntry *options = new IORegistryEntry;
+	if (options != NULL && options->init()) {
+		options->setName("options");
+		if (options->attachToParent(root, gIODTPlane)) {
+			options->setProperty("boot-args", PE_boot_args());
+		}
+		options->release();
+	}
 }
 
