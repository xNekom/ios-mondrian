diff --git a/bsd/dev/mondrian_wifi_smmu.c b/bsd/dev/mondrian_wifi_smmu.c
index add6761..ff9f9ec 100644
--- a/bsd/dev/mondrian_wifi_smmu.c
+++ b/bsd/dev/mondrian_wifi_smmu.c
@@ -815,6 +815,40 @@ mondrian_wifi_smmu_map_va(vm_offset_t va, vm_size_t bytes, uint64_t *iova_out)
  * with a matching FAR means the BHI read reached the SMMU and the page table
  * is wrong; a clean FSR with a stuck doorbell means the device never fetched.
  */
+/*
+ * W15: a physically contiguous buffer the endpoint can read with the SID in
+ * bypass. ml_io_map() of a guessed physical address wedged the worker and, in
+ * the same boot, the reset path with it (measured 2026-11-26), so the bypass
+ * image comes from memory the kernel owns and has already mapped.
+ */
+vm_offset_t
+mondrian_wifi_smmu_contig(vm_size_t bytes, uint64_t *pa)
+{
+    vm_offset_t va = 0;
+    ppnum_t pn;
+    uint64_t phys;
+
+    if (kmem_alloc_contig(kernel_map, &va, bytes, 0x3fff, 0, 3,
+        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) !=
+        KERN_SUCCESS) {
+        return 0;
+    }
+    pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+    if (pn == 0) {
+        kmem_free(kernel_map, va, bytes);
+        return 0;
+    }
+    phys = ptoa_64(pn);
+    if (phys >= W2_PHYS_LIMIT || bytes > W2_PHYS_LIMIT - phys) {
+        kmem_free(kernel_map, va, bytes);
+        return 0;
+    }
+    if (pa != 0) {
+        *pa = phys;
+    }
+    return va;
+}
+
