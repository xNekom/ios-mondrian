+/*
+ * "gpukeep" prints the GPU keepalive mode and "gpukeep 0|1|2" sets it, so the
+ * collapse can be tried on a running system instead of at boot (where the
+ * first client access arrives before anything has drawn).
+ */
+static void
+ud_cmd_gpukeep(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_gpu_keep_mode(void);
+	extern void mondrian_gpu_keep_set(int mode);
+	uint32_t mode = 0;
+	char out[64];
+	int n;
+
+	if (line[7] == ' ' && ud_cmd_num(line + 8, &mode) != NULL) {
+		mondrian_gpu_keep_set((int)mode);
+	}
+	n = snprintf(out, sizeof(out), "gpukeep %d\n",
+	    mondrian_gpu_keep_mode());
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
