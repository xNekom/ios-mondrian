+static uint64_t mondrian_gpu_hist_bytes[6];
+static uint32_t mondrian_gpu_hist_count[6];
+
+static int
+mondrian_gpu_hist_slot(uint64_t size)
+{
+	if (size < (64ull << 10)) {
+		return 0;
+	}
+	if (size < (1ull << 20)) {
+		return 1;
+	}
+	if (size < (4ull << 20)) {
+		return 2;
+	}
+	if (size < (8ull << 20)) {
+		return 3;
+	}
+	if (size < (16ull << 20)) {
+		return 4;
+	}
+	return 5;
+}
