diff --git a/osfmk/vm/vm_pageout.c b/osfmk/vm/vm_pageout.c
--- a/osfmk/vm/vm_pageout.c
+++ b/osfmk/vm/vm_pageout.c
@@ -5009,6 +5009,31 @@
  * Set up vm_config based on the vm_compressor_mode.
  * Must run BEFORE the pageout thread starts up.
  */
+/*
+ * MONDRIAN: the swap picture on demand. The MEM line says how much is lost
+ * when the UI freezes; these numbers say whether the compressor is holding
+ * it or whether the swapfile is taking it, which need opposite fixes.
+ */
+void
+mondrian_vm_stats(void)
+{
+	extern uint32_t c_segment_count, c_swappedout_count;
+	extern uint32_t c_segment_pages_compressed;
+	extern uint64_t vm_swap_get_total_space(void);
+	extern uint64_t vm_swap_get_used_space(void);
+	extern uint64_t vm_swap_get_failures;
+
+	printf("MONDRIAN VMSTAT: mode %d segs %u swapped %u src %u pages"
+	    " swap %llu/%llu used compressions %llu grabbed %llu failures %llu\n",
+	    vm_compressor_mode, c_segment_count, c_swappedout_count,
+	    c_segment_pages_compressed,
+	    (unsigned long long)vm_swap_get_used_space(),
+	    (unsigned long long)vm_swap_get_total_space(),
+	    (unsigned long long)vm_pageout_vminfo.vm_pageout_compressions,
+	    (unsigned long long)vm_pageout_vminfo.vm_compressor_pages_grabbed,
+	    (unsigned long long)vm_swap_get_failures);
+}
+
