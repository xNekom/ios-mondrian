+/*
+ * Publish the newest position once for the display tick that is current now.
+ * It is called as soon as the first report of a wake has been read, not after
+ * the whole drain: the UI commits once per touch event, and measured on the
+ * phone an event published after the four-read drain ran the compositor at 45
+ * fps where the same events published in the first millisecond of the period
+ * ran it at 60. The later reports of that drain belong to the next tick.
+ */
+static bool
+mondrian_touch_publish(uint32_t *emitted_tick, const uint8_t *now, uint8_t *was,
+    const int16_t *last_x, const int16_t *last_y, int16_t *sent_x, int16_t *sent_y,
+    uint32_t reports)
+{
+	uint32_t tick = mondrian_touch_ticks;
+
+	if (tick == *emitted_tick) {
+		return false;
+	}
+	*emitted_tick = tick;
+	for (int finger = 0; finger < MONDRIAN_TOUCH_FINGERS; finger++) {
+		if (now[finger]) {
+			mondrian_touch_event_gap();
+			mondrian_touch_events++;
+			mondrian_hid_touch(finger, 1, last_x[finger], last_y[finger]);
+			if (sent_x[finger] == last_x[finger] &&
+			    sent_y[finger] == last_y[finger]) {
+				mondrian_touch_repeats++;
+			}
+			sent_x[finger] = last_x[finger];
+			sent_y[finger] = last_y[finger];
+			if (reports < 30) {
+				printf("MONDRIAN TOUCH: report %u finger %d %d,%d\n",
+				    reports, finger, last_x[finger], last_y[finger]);
+			}
+		} else if (was[finger]) {
+			mondrian_touch_event_gap();
+			mondrian_touch_events++;
+			mondrian_hid_touch(finger, 0, last_x[finger], last_y[finger]);
+			if (reports < 30) {
+				printf("MONDRIAN TOUCH: report %u finger %d up\n",
+				    reports, finger);
+			}
+		}
+		was[finger] = now[finger];
+	}
+	return true;
 }
 
