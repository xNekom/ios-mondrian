+/*
+ * iOS locks the device when it sees the power key, but the panel is this
+ * driver's. Blank it on the press itself; the tick paints the black frame on
+ * the next refresh. A press while the panel is already black is the wake, so
+ * cancel the hold (the two presses may have come close together) and let the
+ * first frame through instead of waiting for the burst.
+ */
+extern "C" void
+mondrian_fb_power_key(void)
+{
+	AppleCLCD *fb = gMondrianFB;
+	uint64_t arm;
+
+	if (fb == NULL) {
+		return;
+	}
+	nanoseconds_to_absolutetime(MONDRIAN_FB_INPUT_WAKE_NS, &arm);
+	if (fb->fBlanked) {
+		fb->fHoldBlank = false;
+		fb->fWakeArmedTicks = mach_absolute_time() + arm;
+	} else {
+		fb->fBlankRequest = true;
+	}
+}
+
+/*
+ * A finger on the panel is the other input signal: while the panel is black
+ * the next frame counts as the wake, and while it is lit the idle clock
+ * restarts so the screen never goes black under the finger.
+ */
+extern "C" void
+mondrian_fb_touch_activity(void)
+{
+	AppleCLCD *fb = gMondrianFB;
+	uint64_t now;
+
+	if (fb == NULL) {
+		return;
+	}
+	now = mach_absolute_time();
+	if (fb->fBlanked) {
+		/* The hold only exists to hide the lock animation. */
+		if (fb->fHoldBlank && now >= fb->fHoldBlankUntil) {
+			fb->fHoldBlank = false;
+		}
+		if (!fb->fHoldBlank) {
+			uint64_t arm;
+
+			nanoseconds_to_absolutetime(MONDRIAN_FB_INPUT_WAKE_NS, &arm);
+			fb->fWakeArmedTicks = now + arm;
+		}
+	} else {
+		uint64_t grace;
+
+		nanoseconds_to_absolutetime(MONDRIAN_FB_INPUT_GRACE_NS, &grace);
+		fb->fActivityTicks = now + grace;
+	}
+}
+
 #endif /* MONDRIAN */
