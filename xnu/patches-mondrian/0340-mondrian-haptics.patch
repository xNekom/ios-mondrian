+/*
+ * "haps" prints the PMIC's HV haptics block, "vib [ms [amp [force]]]" plays a
+ * constant tone on it, and "hapr BLOCK REG" / "hapw BLOCK REG VAL" read and
+ * write one byte by page number (0 CFG, 1 PTN, 2 HBST, read only). Both pairs
+ * are here because the first question is whether the block answers and the
+ * second is whether the actuator moves; one transaction at a time is what
+ * makes a wedge attributable to a register.
+ */
+static void
+ud_cmd_hap(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_haptics_dump(char *out, size_t len);
+	extern int mondrian_haptics_buzz(unsigned int ms, unsigned int amp,
+	    unsigned int force);
+	char out[256];
+	int n;
+
+	if (line[3] == 's') {			/* "haps" */
+		n = mondrian_haptics_dump(out, sizeof(out));
+	} else {				/* "vib [ms [amp [force]]]" */
+		uint32_t ms = 0, amp = 0, force = 0;
+		const char *p = ud_cmd_num(line + 3, &ms);
+
+		if (p != NULL) {
+			p = ud_cmd_num(p, &amp);
+		}
+		if (p != NULL) {
+			(void)ud_cmd_num(p, &force);
+		}
+		n = snprintf(out, sizeof(out), "vib %s\n",
+		    mondrian_haptics_buzz(ms, amp, force) == 0 ? "sent" : "failed");
+	}
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
+
+static void
+ud_cmd_hapreg(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_haptics_peek(unsigned int block, unsigned int reg,
+	    uint8_t *out);
+	extern int mondrian_haptics_poke(unsigned int block, unsigned int reg,
+	    unsigned int val);
+	char out[96];
+	uint32_t block = 0, reg = 0, val = 0;
+	const char *p = ud_cmd_num(line + 4, &block);
+	uint8_t v = 0;
+	int n;
+
+	p = p != NULL ? ud_cmd_num(p, &reg) : NULL;
+	if (line[3] == 'w' && p != NULL) {
+		p = ud_cmd_num(p, &val);
+	}
+	if (p == NULL) {
+		n = snprintf(out, sizeof(out), "usage: hapr|hapw BLOCK REG [VAL]\n");
+	} else if (line[3] == 'w') {
+		n = snprintf(out, sizeof(out), "hapw %s\n",
+		    mondrian_haptics_poke(block, reg, val) ? "ok" : "failed");
+	} else if (mondrian_haptics_peek(block, reg, &v)) {
+		n = snprintf(out, sizeof(out), "hapr blk %u 0x%02x = 0x%02x\n",
+		    block, reg, v);
+	} else {
+		n = snprintf(out, sizeof(out), "hapr blk %u 0x%02x no answer\n",
+		    block, reg);
+	}
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
