@@ -217,6 +217,92 @@
 }
 
 /*
+ * A byte of any peripheral the AP owns, addressed by PPID. The haptics block
+ * has no channel window like the VADC's, so reads go through the arbiter
+ * (sp_read) and writes through the command window at CHNLS + apid * 0x1000,
+ * the transaction the restart reason already uses. 1 = done.
+ *
+ * The owner check is not decoration: writing a peripheral another processor
+ * owns is refused by the arbiter, and treating that as a transport failure has
+ * cost a boot before. mondrian_spmi_reg_read_raw() is the one exception, for
+ * HBST: reads of that page are what the vendor driver does on every play.
+ */
+static uint32_t sp_apid_owner(uint16_t apid);	/* defined below */
+
+static int
+sp_apid_for(uint16_t ppid, uint16_t *apid)
+{
+	uint16_t a = sp_find_apid(ppid);
+
+	if (a == 0xffffu) {
+		return 0;
+	}
+	if (sp_apid_owner(a) != 0) {
+		printf("MONDRIAN SPMI: ppid 0x%x is not AP-owned (owner %u)\n",
+		    ppid, sp_apid_owner(a));
+		return 0;
+	}
+	*apid = a;
+	return 1;
+}
+
+int
+mondrian_spmi_reg_read(uint16_t ppid, uint8_t reg, uint8_t *out)
+{
+	uint16_t apid;
+
+	if (!sp_apid_for(ppid, &apid)) {
+		return 0;
+	}
+	return sp_read(apid, reg, out);
+}
+
+int
+mondrian_spmi_reg_read_raw(uint16_t ppid, uint8_t reg, uint8_t *out)
+{
+	uint16_t apid = sp_find_apid(ppid);
+
+	if (apid == 0xffffu) {
+		return 0;
+	}
+	return sp_read(apid, reg, out);
+}
+
+int
+mondrian_spmi_reg_write(uint16_t ppid, uint8_t reg, uint8_t val)
+{
+	static uint16_t cached_ppid;
+	static volatile uint32_t *win;
+	uint16_t apid;
+
+	if (ppid != cached_ppid || win == NULL) {
+		if (!sp_apid_for(ppid, &apid)) {
+			return 0;
+		}
+		win = (volatile uint32_t *)ml_io_map(
+		    MONDRIAN_SPMI_CHNLS + ((uint32_t)apid << 12),
+		    MONDRIAN_SPMI_CHNLS_SIZE);
+		if (win == NULL) {
+			return 0;
+		}
+		cached_ppid = ppid;
+	}
+	win[0x10 / 4] = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+	win[0] = (uint32_t)reg << 4;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (uint32_t i = 0; i < MONDRIAN_SPMI_RETRIES; i++) {
+		uint32_t st = win[0x08 / 4];
+
+		if (st & 1u) {
+			return (st & 0x0eu) ? 0 : 1;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
