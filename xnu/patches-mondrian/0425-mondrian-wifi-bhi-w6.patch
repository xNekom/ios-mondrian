diff --git a/bsd/dev/mondrian_wifi_smmu.c b/bsd/dev/mondrian_wifi_smmu.c
index 3166415..a643545 100644
--- a/bsd/dev/mondrian_wifi_smmu.c
+++ b/bsd/dev/mondrian_wifi_smmu.c
@@ -634,6 +634,75 @@ w2_teardown(void)
         "UNCERTAIN" : "complete");
 }
 
+/*
+ * W6: map a wired kernel range at 0xa1000000 and enable the context. The
+ * firmware buffer need not be physically contiguous: each page is resolved
+ * with pmap_find_phys. The W2 proof tore the context and SID route down, so
+ * both are installed again; the tables are fresh and the old canary tables
+ * stay retained.
+ */
+int
+mondrian_wifi_smmu_map_va(vm_offset_t va, vm_size_t bytes, uint64_t *iova_out)
+{
+    struct w2_mem tables;
+    uint64_t iova = W2_IOVA_BASE + 0x01000000ULL;
+    uint64_t *root, *l2, *l3;
+    vm_size_t off, chunk;
+    uint32_t i1, i2, i3, l3i = 0;
+    ppnum_t pn;
+
+    if (w2.smmu == 0 || w2.cb == 0 || w2.bank == 0 || va == 0 ||
+        bytes == 0 || iova_out == 0) {
+        return -1;
+    }
+    bytes = (bytes + 0xfff) & ~(vm_size_t)0xfff;
+    if (bytes > 0x600000) {
+        bytes = 0x600000;
+    }
+    if (w2_alloc_mem(&tables, 0x6000)) {
+        return -1;
+    }
+    root = (uint64_t *)tables.va;
+    l2 = root + 512;
+    l3 = l2 + 512;
+    bzero((void *)tables.va, tables.bytes);
+    i1 = (uint32_t)((iova >> 30) & 3u);
+    root[i1] = (tables.pa + 0x1000) | 3u;
+    for (off = 0; off < bytes; off += 0x200000) {
+        uint64_t base = iova + off;
+
+        i2 = (uint32_t)((base >> 21) & 0x1ffu);
+        l2[i2] = (tables.pa + 0x2000 + (uint64_t)l3i * 0x1000) | 3u;
+        for (chunk = 0; chunk < 0x200000 && off + chunk < bytes;
+            chunk += 0x1000) {
+            pn = pmap_find_phys(kernel_pmap,
+                (addr64_t)(va + off + chunk));
+            if (pn == 0) {
+                w2_log("W6 no page va=0x%lx",
+                    (unsigned long)(va + off + chunk));
+                return -1;
+            }
+            i3 = (uint32_t)(((base + chunk) >> 12) & 0x1ffu);
+            l3[(uint64_t)l3i * 512 + i3] = ptoa_64(pn) | W2_PTE_ATTR;
+        }
+        l3i++;
+        if (l3i >= 3) {
+            break;
+        }
+    }
+    w2_flush_pa(tables.pa, tables.bytes);
+    w2.tables = tables;
+    w2.context_programmed = 0;
+    if (w2_program_context() || w2_attach_sid()) {
+        return -1;
+    }
+    *iova_out = iova;
+    w2_log("W6 mapped va=0x%lx bytes=0x%lx iova=0x%llx",
+        (unsigned long)va, (unsigned long)bytes,
+        (unsigned long long)iova);
+    return 0;
+}
+
 int
 mondrian_wifi_smmu_prove(uint16_t pci_command)
 {
