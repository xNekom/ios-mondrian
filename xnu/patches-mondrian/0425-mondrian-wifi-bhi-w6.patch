 }
 
+/*
+ * W6: read the AMSS image from the iOS root, map it through the W2 SMMU
+ * context and hand it to BHI. The host uploads the blob after boot, so this
+ * runs from the "wififw" command, not from the boot worker.
+ */
+extern int mondrian_root_read(const char *, void *, unsigned, off_t);
+extern int mondrian_wifi_smmu_map_va(vm_offset_t, vm_size_t, uint64_t *);
+
+int
+mondrian_wifi_load_amss(void)
+{
+    vm_offset_t buf;
+    kern_return_t kr;
+    uint64_t iova = 0;
+    uint32_t bhioff = 0, status = 0, errcode = 0, image_size, ready = 0;
+    uint16_t command;
+    unsigned i;
+    int got, rc;
+
+    /*
+     * The worker maps the config in W1 and the BAR in W4; a command can arrive
+     * before it finishes, so wait for both instead of failing on the first
+     * read. The 60 s ceiling is longer than the slow rail votes measured on a
+     * cold boot.
+     */
+    for (i = 0; i < 60000 && (wifi_bar == 0 || wifi_cfg == 0); i++) {
+        delay(1000);
+    }
+    if (wifi_bar == 0 || wifi_cfg == 0) {
+        wifi_log("W6 BAR or config not mapped after 60 s");
+        return -1;
+    }
+    if (mondrian_mmio_try_rd32(wifi_bar + 0x28, &bhioff) != 0 ||
+        bhioff == 0) {
+        wifi_log("W6 BHIOFF unreadable");
+        return -1;
+    }
+    kr = kmem_alloc(kernel_map, &buf, 0x600000, KMA_DATA,
+        VM_KERN_MEMORY_IOKIT);
+    if (kr != KERN_SUCCESS) {
+        wifi_log("W6 firmware buffer allocation failed kr=0x%x", kr);
+        return -1;
+    }
+    /* The auto load can run before the root is mounted; retry for a minute. */
+    for (i = 0; i < 60000; i++) {
+        got = mondrian_root_read("/private/var/vm/amss.bin", (void *)buf,
+            0x600000, 0);
+        if (got > 0) {
+            break;
+        }
+        delay(1000);
+    }
+    wifi_log("W6 amss read=%d magic=%02x%02x%02x%02x", got,
+        ((const uint8_t *)buf)[0], ((const uint8_t *)buf)[1],
+        ((const uint8_t *)buf)[2], ((const uint8_t *)buf)[3]);
+    if (got <= 0) {
+        return -1;
+    }
+    flush_dcache64((addr64_t)buf, (unsigned)got, 0);
+    if (mondrian_wifi_smmu_map_va(buf, (vm_size_t)got, &iova)) {
+        wifi_log("W6 SMMU map failed");
+        return -1;
+    }
+    /*
+     * W3 leaves bus mastering off on purpose. BHI reads the image from host
+     * memory, so memory space and bus master must both be on for the load and
+     * stay on while the SBL fetches the rest of the image.
+     */
+    command = wifi_read16(wifi_cfg, 4);
+    wifi_write16(wifi_cfg, 4,
+        command | WIFI_PCI_MEMORY | WIFI_PCI_BUS_MASTER);
+    command = wifi_read16(wifi_cfg, 4);
+    wifi_log("W6 bus master command=0x%x", command);
+    if ((command & WIFI_PCI_BUS_MASTER) == 0) {
+        return -1;
+    }
+    /*
+     * ath11k loads only the first 512 KiB (sbl_size) through BHI; the SBL
+     * fetches the AMSS remainder through BHIE. A larger size never started.
+     */
+    image_size = got > 0x80000 ? 0x80000 : (uint32_t)got;
+    rc = mondrian_mmio_try_wr32(wifi_bar + bhioff + 0x20, 0);
+    rc |= mondrian_mmio_try_wr32(wifi_bar + bhioff + 0x2c, 0);
+    rc |= mondrian_mmio_try_wr32(wifi_bar + bhioff + 0x0c,
+        (uint32_t)(iova >> 32));
+    rc |= mondrian_mmio_try_wr32(wifi_bar + bhioff + 0x08, (uint32_t)iova);
+    rc |= mondrian_mmio_try_wr32(wifi_bar + bhioff + 0x10, image_size);
+    rc |= mondrian_mmio_try_wr32(wifi_bar + bhioff + 0x18, 1);
+    wifi_log("W6 BHI trigger iova=0x%llx sbl=0x%x image=0x%x rc=0x%x",
+        iova, image_size, got, rc);
+    if (rc != 0) {
+        return -1;
+    }
+    for (i = 0; i < 10000; i++) {
+        delay(1000);
+        if (mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x2c,
+            &status) != 0) {
+            continue;
+        }
+        if ((status >> 30) == 2 || (status >> 30) == 3) {
+            break;
+        }
+    }
+    if (mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x30, &errcode) != 0) {
+        errcode = 0;
+    }
+    wifi_log("W6 BHI status=0x%x errcode=0x%x polls=%u", status, errcode,
+        i);
+    if ((status >> 30) == 2) {
+        uint32_t execenv = 0, mhistatus = 0;
+
+        for (ready = 0; ready < 5000; ready++) {
+            if (mondrian_mmio_try_rd32(wifi_bar + 0x48, &mhistatus) == 0 &&
+                (mhistatus & 1u) != 0) {
+                break;
+            }
+            delay(1000);
+        }
+        (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x28, &execenv);
+        wifi_log("W6 post execenv=0x%x mhistatus=0x%x ready_polls=%u",
+            execenv, mhistatus, ready);
+    }
+    return (status >> 30) == 2 ? 0 : -1;
+}
