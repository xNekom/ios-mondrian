diff --git a/bsd/dev/mondrian_wifi_smmu.c b/bsd/dev/mondrian_wifi_smmu.c
--- a/bsd/dev/mondrian_wifi_smmu.c
+++ b/bsd/dev/mondrian_wifi_smmu.c
@@ -24,6 +24,7 @@
 #include <vm/vm_kern.h>
 #include <arm/caches_internal.h>
 #include "mondrian_mmio.h"
+#include "mondrian_gpu_api.h"
 
 #if defined(MONDRIAN)
 
@@ -269,8 +270,31 @@
 static void
 w2_flush_pa(uint64_t pa, vm_size_t bytes)
 {
-    flush_dcache64((addr64_t)pa, (unsigned)bytes, TRUE);
-    __asm__ volatile("dsb sy" ::: "memory");
+    /*
+     * __ARM_COHERENT_IO__ turns flush_dcache64() into a bare dsb, so the
+     * tables stayed dirty while the SMMU walked stale DRAM (0459's FSR=0x402
+     * is that walk). Clean the physical range for real.
+     */
+    mondrian_dcache_flush_pa(pa, bytes);
+}
+
+/*
+ * Clear the sticky context fault bits before the BHI doorbell, so a fault
+ * reported afterwards belongs to the fetch the doorbell started.
+ */
+int
+mondrian_wifi_smmu_clear_fault(void)
+{
+    uint32_t got = 0;
+
+    if (w2.smmu == 0 || w2.cb == 0) {
+        return -1;
+    }
+    if (w2_wr32(w2.cb + W2_CB_FSR, W2_FSR_FAULT) ||
+        w2_rd32(w2.cb + W2_CB_FSR, &got)) {
+        return -1;
+    }
+    return (got & W2_FSR_FAULT) != 0 ? -1 : 0;
 }
 
 static int
