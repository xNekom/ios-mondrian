 /*
+ * flush_dcache64() is a bare dsb in this kernel (__ARM_COHERENT_IO__), so a
+ * device-visible range written through the cache is not in DRAM when the
+ * endpoint reads it. The image is virtually contiguous and physically
+ * scattered, so clean it page by page.
+ */
+static void
+wifi_flush_va(vm_offset_t va, vm_size_t bytes)
+{
+	vm_offset_t end = va + bytes;
+	vm_offset_t page;
+
+	for (page = va & ~(vm_offset_t)0xfff; page < end; page += 0x1000) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)page);
+
+		if (pn != 0) {
+			mondrian_dcache_flush_pa(ptoa_64(pn), 0x1000);
+		}
+	}
+}
