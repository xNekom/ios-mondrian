+/*
+ * The exec's path, and its length.
+ *
+ * `ni_cnd.cn_nameptr` has been advanced past every directory by namei, so it
+ * holds the last component ("Preferences") and `cn_namelen` its length -- which
+ * is exactly what every mask check above compares, and why those work. A test
+ * for a directory prefix needs the whole path: `cn_pnbuf` is the caller's
+ * NUL-terminated copy of it, `cn_pnlen` bytes long (PATHBUFLEN inline, else
+ * MAXPATHLEN). Measured 2026-11-21: `/Applications/Preferences.app/Preferences`
+ * reaches this function as `name` == "Preferences", so 0402's
+ * `strncmp(name, "/Applications/")` could never match and no app received the
+ * picture bridge.
+ */
+static const char *
+mondrian_exec_path(struct image_params *imgp, size_t *length)
+{
+	const char *path;
+	size_t size, at;
+
+	*length = 0;
+	if (imgp->ip_ndp == NULL || imgp->ip_ndp->ni_cnd.cn_pnbuf == NULL ||
+	    imgp->ip_ndp->ni_cnd.cn_pnlen <= 0) {
+		return NULL;
+	}
+	path = imgp->ip_ndp->ni_cnd.cn_pnbuf;
+	size = (size_t)imgp->ip_ndp->ni_cnd.cn_pnlen;
+	at = 0;
+	while (at < size && path[at] != '\0') {
+		at++;
+	}
+	*length = at;
+	return path;
+}
+
+/*
+ * Does this exec draw pictures? (the whole path, see mondrian_exec_path)
+ *
+ * Matching /Applications/ reached the system apps and nothing else. An App
+ * Store app runs from /private/var/containers/Bundle/Application/<uuid>/
+ * Name.app/Name and its extensions from .../Name.app/PlugIns/X.appex/X, so
+ * neither ever received the bridge: every picture such an app set as a layer's
+ * contents took the broken CGImage road and stayed behind. The WebKit services
+ * are the same gap from the other side -- a page's pictures arrive as layer
+ * contents in com.apple.WebKit.Networking, whose path is inside
+ * WebKit.framework and is not an .app bundle.
+ */
+static bool
+mondrian_path_has(const char *path, size_t length, const char *needle)
+{
+	size_t nlen = strlen(needle);
+	size_t at;
+
+	if (nlen == 0 || length < nlen) {
+		return false;
+	}
+	for (at = 0; at + nlen <= length; at++) {
+		if (path[at] == needle[0] &&
+		    memcmp(path + at, needle, nlen) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+mondrian_exec_draws_pictures(struct image_params *imgp)
+{
+	const char *path;
+	size_t length;
+
+	path = mondrian_exec_path(imgp, &length);
+	return path != NULL &&
+	    (mondrian_path_has(path, length, ".app/") ||
+	    mondrian_path_has(path, length, "/WebKit.framework/"));
+}
