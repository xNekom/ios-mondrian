+/*
+ * The GMU firmware is a list of {addr, len, type, value} blocks. Blocks below
+ * 0x4000 are ITCM and blocks at 0x10004000 are DTCM; the 57 KiB block at
+ * 0x4000 is external GMU memory and needs the GPU SMMU, so it is skipped
+ * here. Loading and reading back the TCM blocks proves the GMU AHB write
+ * path before the SMMU work.
+ */
+static void
+mondrian_gpu_load_tcm(vm_offset_t gmu)
+{
+#ifdef MONDRIAN_GMU_FW
+	uint32_t i, j;
+
+	for (i = 0; i < mondrian_gmu_block_count; i++) {
+		const struct mondrian_gmu_block *b = &mondrian_gmu_blocks[i];
+		uint32_t base;
+
+		if (b->addr < 0x4000u) {
+			base = GMU_OFF(0x1b400u) + b->addr;
+		} else if (b->addr >= 0x10004000u && b->addr < 0x10008000u) {
+			base = GMU_OFF(0x1c400u) + (b->addr - 0x10004000u);
+		} else {
+			printf("MONDRIAN GPU: fw block 0x%x len 0x%x needs smmu\n",
+			    b->addr, b->len);
+			continue;
+		}
+		for (j = 0; j < b->len; j += 4) {
+			uint32_t w = (uint32_t)b->data[j] |
+			    ((uint32_t)b->data[j + 1] << 8) |
+			    ((uint32_t)b->data[j + 2] << 16) |
+			    ((uint32_t)b->data[j + 3] << 24);
+
+			mondrian_gpu_write(gmu, base + j, w);
+		}
+		printf("MONDRIAN GPU: fw tcm 0x%x len 0x%x -> 0x%x\n",
+		    b->addr, b->len, base);
+	}
+	printf("MONDRIAN GPU: itcm0 0x%x want 0x%x dtcm 0x%x want 0x%x\n",
+	    mondrian_gpu_read(gmu, GMU_OFF(0x1b400u)),
+	    (uint32_t)mondrian_gmu_b0[0] | ((uint32_t)mondrian_gmu_b0[1] << 8) |
+	    ((uint32_t)mondrian_gmu_b0[2] << 16) | ((uint32_t)mondrian_gmu_b0[3] << 24),
+	    mondrian_gpu_read(gmu, GMU_OFF(0x1c400u) + 0x3f98u),
+	    (uint32_t)mondrian_gmu_b2[0] | ((uint32_t)mondrian_gmu_b2[1] << 8) |
+	    ((uint32_t)mondrian_gmu_b2[2] << 16) | ((uint32_t)mondrian_gmu_b2[3] << 24));
+	mondrian_log_flush_now();
+#else
+	printf("MONDRIAN GPU: no gmu firmware built in\n");
+#endif
+}
