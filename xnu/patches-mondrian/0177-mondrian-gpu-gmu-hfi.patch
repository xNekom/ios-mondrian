+/*
+ * Program the GMU context bank and stream, load the full GMU firmware
+ * (TCM plus the 57 KiB external block at IOVA 0x4000) and start the CM3.
+ * Memory map from UniXNU/Adreno740 NativeAdrenoGmuMemory.h: icache at
+ * 0x4000, dummy at 0x60000000, log at 0x60004000, HFI at 0x60008000 and
+ * debug at 0x60400000; GMU SIDs 5/0x405 with TTBR0.
+ */
+static void
+mondrian_gpu_gmu_bringup(vm_offset_t gpucc, vm_offset_t gpu, vm_offset_t gmu,
+    vm_offset_t smmu)
+{
+	struct mondrian_gpu_mem icache = {}, dummy = {}, logm = {}, hfi = {}, debug = {}, tables = {};
+	uint32_t id0, id1, id2, scr0, next = 1, bank, stride, pages, ctx, gr1;
+	uint32_t exids, nslots, slot, slot2, i, v;
+	uint64_t *tab;
+	uint64_t ttbr0;
+	uint32_t tcr, tcr2, sctlr;
+	int b;
+
+	if (mondrian_gpu_mem_alloc(&icache, 0xffc000, 0x4000) != 0) {
+		printf("MONDRIAN GPU: 16M icache failed, trying 128K\n");
+		if (mondrian_gpu_mem_alloc(&icache, 0x20000, 0x4000) != 0) {
+			printf("MONDRIAN GPU: no icache memory\n");
+			return;
+		}
+	}
+	if (mondrian_gpu_mem_alloc(&dummy, 0x4000, 0x60000000) != 0 ||
+	    mondrian_gpu_mem_alloc(&logm, 0x4000, 0x60004000) != 0 ||
+	    mondrian_gpu_mem_alloc(&hfi, 0x4000, 0x60008000) != 0 ||
+	    mondrian_gpu_mem_alloc(&debug, 0x7000, 0x60400000) != 0 ||
+	    mondrian_gpu_mem_alloc(&tables, 0x20000, 0) != 0) {
+		printf("MONDRIAN GPU: gmu memory allocation failed\n");
+		return;
+	}
+	printf("MONDRIAN GPU: gmu mem icache 0x%llx/0x%x dummy 0x%llx hfi 0x%llx tables 0x%llx\n",
+	    icache.pa, icache.bytes, dummy.pa, hfi.pa, tables.pa);
+
+	tab = (uint64_t *)tables.va;
+	mondrian_gpu_smmu_map(tab, tables.pa, 32, icache.iova, icache.pa,
+	    icache.bytes, 15, &next);
+	mondrian_gpu_smmu_map(tab, tables.pa, 32, dummy.iova, dummy.pa,
+	    dummy.bytes, 3, &next);
+	mondrian_gpu_smmu_map(tab, tables.pa, 32, logm.iova, logm.pa,
+	    logm.bytes, 3, &next);
+	mondrian_gpu_smmu_map(tab, tables.pa, 32, hfi.iova, hfi.pa,
+	    hfi.bytes, 3, &next);
+	mondrian_gpu_smmu_map(tab, tables.pa, 32, debug.iova, debug.pa,
+	    debug.bytes, 3, &next);
+	flush_dcache64((addr64_t)tables.pa, tables.bytes, TRUE);
+	printf("MONDRIAN GPU: smmu tables %u pages\n", next);
+
+	scr0 = mondrian_gpu_read(smmu, 0x0);
+	id0 = mondrian_gpu_read(smmu, SMMU_SID0);
+	id1 = mondrian_gpu_read(smmu, SMMU_SID1);
+	id2 = mondrian_gpu_read(smmu, SMMU_SID2);
+	printf("MONDRIAN GPU: smmu scr0 0x%x id0 0x%x id1 0x%x id2 0x%x\n",
+	    scr0, id0, id1, id2);
+
+	stride = (id1 & 0x80000000u) ? 0x10000u : 0x1000u;
+	pages = 1u << (((id1 >> 28) & 7) + 1);
+	gr1 = stride;
+	bank = 1;
+	ctx = (pages + bank) * stride;
+	if (ctx + 0x800 > MONDRIAN_SMMU_SIZE) {
+		printf("MONDRIAN GPU: smmu context out of range 0x%x\n", ctx);
+		return;
+	}
+	if (mondrian_gpu_read(smmu, ctx) != 0) {
+		for (b = 1; b < (int)(id1 & 0xffu); b++) {
+			uint32_t c = (pages + (uint32_t)b) * stride;
+
+			if (c + 0x800 > MONDRIAN_SMMU_SIZE) {
+				break;
+			}
+			if (mondrian_gpu_read(smmu, c) == 0) {
+				bank = (uint32_t)b;
+				ctx = c;
+				break;
+			}
+		}
+	}
+	exids = (id0 >> 8) & 1u;
+	nslots = id0 & 0xffu;
+	slot = 0xffffffffu;
+	slot2 = 0xffffffffu;
+	for (i = 0; i < nslots; i++) {
+		uint32_t smr = mondrian_gpu_read(smmu, SMMU_SMR(i));
+		uint32_t s2cr = mondrian_gpu_read(smmu, SMMU_S2CR(i));
+
+		if (exids ? !(s2cr & (1u << 10)) : !(smr & (1u << 31))) {
+			if (slot == 0xffffffffu) {
+				slot = i;
+			} else if (slot2 == 0xffffffffu) {
+				slot2 = i;
+				break;
+			}
+		}
+	}
+	if (slot == 0xffffffffu || slot2 == 0xffffffffu) {
+		printf("MONDRIAN GPU: smmu needs two free stream slots (got %u/%u)\n",
+		    slot, slot2);
+		return;
+	}
