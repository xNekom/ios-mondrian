+/*
+ * Pong's source(): force the root on, wait for the root-off status to clear,
+ * program SRC/DIV/MODE/HW in one masked write, pulse UPDATE and wait it out.
+ * The force bit stays set until every active branch below has been enabled.
+ */
+static void
+mondrian_gpu_source(vm_offset_t gpucc, uint32_t cmd, uint32_t cfg)
+{
+	uint32_t v = mondrian_gpu_read(gpucc, cmd);
+
+	if (v & 1u) {
+		printf("MONDRIAN GPU: rcg 0x%x update stuck 0x%x\n", cmd, v);
+	}
+	mondrian_gpu_write(gpucc, cmd, v | 2u);
+	(void)mondrian_gpu_wait(gpucc, cmd, 0x80000000u, 0, 500);
+	mondrian_gpu_write(gpucc, cmd + 4,
+	    (mondrian_gpu_read(gpucc, cmd + 4) & ~RCG_CFG_MASK) | cfg);
+	mondrian_gpu_write(gpucc, cmd, mondrian_gpu_read(gpucc, cmd) | 1u);
+	(void)mondrian_gpu_wait(gpucc, cmd, 1u, 0, 500);
+}
