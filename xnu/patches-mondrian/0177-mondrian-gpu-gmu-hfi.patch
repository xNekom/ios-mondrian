+/*
+ * The vendor gen7_gmu_first_boot sends the GPU ACD state to the AOP over the
+ * AOSS QMP before it touches the CX GDSC. The ABL leaves the QMP link open
+ * (MCORE link 0xffff) but the channel down; open it, then send
+ * {class: gpu, res: acd, val: 1}. The doorbell is IPCC client 0, signal 0
+ * (IPCC_REG_SEND_ID, 0x0c); the QMP IRQ is not wired here, so poll the state.
+ */
+static int
+mondrian_qmp_acd(void)
+{
+	vm_offset_t qmp = ml_io_map(MONDRIAN_QMP_BASE, MONDRIAN_QMP_SIZE);
+	vm_offset_t ipcc = ml_io_map(MONDRIAN_IPCC_BASE, MONDRIAN_IPCC_SIZE);
+	uint32_t off, i, j, n;
+	char msg[] = "{class: gpu, res: acd, val: 1}";
+
+	if (qmp == 0 || ipcc == 0) {
+		printf("MONDRIAN GPU: qmp/ipcc map failed\n");
+		return -1;
+	}
+	if (mondrian_gpu_read(qmp, 0x0) != 0x4d41494c ||
+	    mondrian_gpu_read(qmp, 0x4) != 1) {
+		printf("MONDRIAN GPU: qmp no magic (0x%x/0x%x)\n",
+		    mondrian_gpu_read(qmp, 0x0), mondrian_gpu_read(qmp, 0x4));
+		return -1;
+	}
+	off = mondrian_gpu_read(qmp, 0x38);
+	printf("MONDRIAN GPU: qmp link uc 0x%x/0x%x mc 0x%x/0x%x ch 0x%x/0x%x off 0x%x\n",
+	    mondrian_gpu_read(qmp, 0xc), mondrian_gpu_read(qmp, 0x10),
+	    mondrian_gpu_read(qmp, 0x24), mondrian_gpu_read(qmp, 0x28),
+	    mondrian_gpu_read(qmp, 0x2c), mondrian_gpu_read(qmp, 0x30), off);
+	mondrian_log_flush_now();
+	mondrian_gpu_write(qmp, 0x10, mondrian_gpu_read(qmp, 0xc));
+	mondrian_gpu_write(qmp, 0x2c, 0xffff);
+	mondrian_gpu_write(ipcc, 0xc, 0);
+	for (i = 0; i < 1000; i++) {
+		if (mondrian_gpu_read(qmp, 0x14) == 0xffff) {
+			break;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN GPU: qmp ch uc 0x%x after %u ms\n",
+	    mondrian_gpu_read(qmp, 0x14), i);
+	mondrian_log_flush_now();
+	mondrian_gpu_write(qmp, 0x18, 0xffff);
+	mondrian_gpu_write(ipcc, 0xc, 0);
+	for (i = 0; i < 1000; i++) {
+		if (mondrian_gpu_read(qmp, 0x30) == 0xffff) {
+			break;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN GPU: qmp ch ack 0x%x after %u ms\n",
+	    mondrian_gpu_read(qmp, 0x30), i);
+	mondrian_log_flush_now();
+	n = (sizeof(msg) + 3u) & ~3u;
+	for (i = 0; i < n; i += 4) {
+		uint32_t w = 0;
+
+		for (j = 0; j < 4 && i + j < sizeof(msg); j++) {
+			((uint8_t *)&w)[j] = (uint8_t)msg[i + j];
+		}
+		mondrian_gpu_write(qmp, off + 4 + i, w);
+	}
+	mondrian_gpu_write(qmp, off, n);
+	mondrian_gpu_write(ipcc, 0xc, 0);
+	for (i = 0; i < 1000; i++) {
+		if (mondrian_gpu_read(qmp, off) == 0) {
+			break;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN GPU: qmp acd len 0x%x after %u ms\n",
+	    mondrian_gpu_read(qmp, off), i);
+	mondrian_log_flush_now();
+	return 0;
+}
