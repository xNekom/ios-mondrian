+	mondrian_gpu_write(smmu, SMMU_SMR(slot), (exids ? 0u : 0x80000000u) | 5u);
+	mondrian_gpu_write(smmu, SMMU_S2CR(slot), 0x20000u | (exids ? 0x400u : 0u));
+	mondrian_gpu_write(smmu, SMMU_S2CR(slot2), 0x20000u);
+	mondrian_gpu_write(smmu, SMMU_SMR(slot2), (exids ? 0u : 0x80000000u) | 0x405u);
+	mondrian_gpu_write(smmu, SMMU_S2CR(slot2), 0x20000u | (exids ? 0x400u : 0u));
+	mondrian_gpu_write(smmu, ctx, 0);
+	mondrian_gpu_write(smmu, gr1 + 0x800u + bank * 4u, 1u);
+	mondrian_gpu_write(smmu, gr1 + bank * 4u, 0x1f300u);
+	mondrian_gpu_write(smmu, ctx + SMMU_TCR2, tcr2);
+	mondrian_gpu_write(smmu, ctx + SMMU_TCR, tcr);
+	mondrian_smmu_write64(smmu, ctx + SMMU_TTBR0, ttbr0);
+	mondrian_smmu_write64(smmu, ctx + SMMU_TTBR1, 0);
+	mondrian_gpu_write(smmu, ctx + SMMU_MAIR0, 0xff44u);
+	mondrian_gpu_write(smmu, ctx + SMMU_MAIR1, 0);
+	mondrian_gpu_write(smmu, ctx + SMMU_FSR, 0xffffffffu);
+	mondrian_gpu_write(smmu, ctx + SMMU_TLBIASID, 1u);
+	mondrian_gpu_write(smmu, ctx + SMMU_TLBSYNC, 0xffffffffu);
+	for (i = 0; i < 1000; i++) {
+		if ((mondrian_gpu_read(smmu, ctx + SMMU_TLBSTATUS) & 1u) == 0) {
+			break;
+		}
