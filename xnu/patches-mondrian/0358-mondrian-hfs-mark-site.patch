diff --git a/bsd/mondrian_hfs/core/VolumeAllocation.c b/bsd/mondrian_hfs/core/VolumeAllocation.c
--- a/bsd/mondrian_hfs/core/VolumeAllocation.c
+++ b/bsd/mondrian_hfs/core/VolumeAllocation.c
@@ -175,6 +175,79 @@
 #include "hfs_endian.h"
 #include "FileMgrInternal.h"
 
+/*
+ * MONDRIAN: the extents handed out in this boot, indexed by block so a lookup
+ * is a scan of 4096 entries and no allocation prints anything. 12 bytes each is
+ * 48 KiB of BSS; it is written once per extension and read only when a free has
+ * already found the bit clear, which is the case worth explaining.
+ */
+#define MONDRIAN_NOTE_MAX	4096
+
+struct mondrian_alloc_note {
+	u_int32_t	start;
+	u_int32_t	count;
+	u_int32_t	fileid;
+};
+
+static struct mondrian_alloc_note mondrian_notes[MONDRIAN_NOTE_MAX];
+
+void
+mondrian_note_extent(u_int32_t start, u_int32_t count, u_int32_t fileid)
+{
+	struct mondrian_alloc_note *note;
+
+	note = &mondrian_notes[start & (MONDRIAN_NOTE_MAX - 1)];
+	note->start = start;
+	note->count = count;
+	note->fileid = fileid;
+}
+
+void
+mondrian_forget_extent(u_int32_t start, u_int32_t count)
+{
+	const u_int64_t end = (u_int64_t)start + count;
+	int i;
+
+	for (i = 0; i < MONDRIAN_NOTE_MAX; i++) {
+		struct mondrian_alloc_note *note = &mondrian_notes[i];
+		u_int64_t nend;
+
+		if (note->count == 0)
+			continue;
+		nend = (u_int64_t)note->start + note->count;
+		if (nend <= (u_int64_t)start || end <= (u_int64_t)note->start)
+			continue;
+		if (note->start >= start && nend <= end)
+			note->count = 0;
+	}
+}
+
+static void
+mondrian_explain_free(u_int32_t start, u_int32_t count)
+{
+	const u_int64_t end = (u_int64_t)start + count;
+	int i, shown = 0;
+
+	for (i = 0; i < MONDRIAN_NOTE_MAX; i++) {
+		struct mondrian_alloc_note *note = &mondrian_notes[i];
+		u_int64_t nend;
+
+		if (note->count == 0)
+			continue;
+		nend = (u_int64_t)note->start + note->count;
+		if (nend <= (u_int64_t)start || end <= (u_int64_t)note->start)
+			continue;
+		printf("MONDRIAN HFS:   %u+%u was handed to file %u as %u+%u\n",
+		    start, count, note->fileid, note->start, note->count);
+		if (++shown >= 3)
+			return;
+	}
+	if (shown == 0) {
+		printf("MONDRIAN HFS:   %u+%u was not handed out in this boot\n",
+		    start, count);
+	}
+}
+
 #endif // !HFS_ALLOC_TEST
 
 #include <sys/sysctl.h>
