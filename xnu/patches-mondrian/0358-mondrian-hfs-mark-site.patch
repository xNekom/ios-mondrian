+/*
+ * MONDRIAN: which site marked the volume. One entry per function and line, the
+ * first call printed, then every 100th: the ring is 4 MiB and 370 marks of one
+ * site would fill it with nothing new.
+ */
+#define MONDRIAN_MARK_SITES	32
+
+struct mondrian_mark_site {
+	const char	*func;
+	int		line;
+	int		count;
+};
+
+static struct mondrian_mark_site mondrian_sites[MONDRIAN_MARK_SITES];
+static int mondrian_site_used;
+
+void
+mondrian_mark_site(const char *where, int line)
+{
+	int i;
+
+	for (i = 0; i < mondrian_site_used; i++) {
+		if (mondrian_sites[i].line == line &&
+		    mondrian_sites[i].func == where) {
+			mondrian_sites[i].count++;
+			if (mondrian_sites[i].count == 10 ||
+			    mondrian_sites[i].count == 100 ||
+			    mondrian_sites[i].count == 1000) {
+				printf("MONDRIAN HFS: mark from %s:%d (x%d)\n",
+				    where, line, mondrian_sites[i].count);
+			}
+			return;
+		}
+	}
+	if (mondrian_site_used < MONDRIAN_MARK_SITES) {
+		mondrian_sites[mondrian_site_used].func = where;
+		mondrian_sites[mondrian_site_used].line = line;
+		mondrian_sites[mondrian_site_used].count = 1;
+		mondrian_site_used++;
+		printf("MONDRIAN HFS: mark from %s:%d (first)\n", where, line);
+	} else {
+		printf("MONDRIAN HFS: mark from %s:%d (no room left)\n",
+		    where, line);
+	}
+}
+
