+#if defined(ARM64_BOARD_CONFIG_MONDRIAN)
+/*
+ * Processes whose exec fails with EACCES, set once at boot from
+ * `mondriankill=<names>` (the value `quiet` selects the built-in list) and
+ * replaceable at run time from the USB channel (`kill <names>`, `kill off`).
+ * Names are '\0'-separated in place. The counters next to it are printed by
+ * the battery thread, so one boot says how much churn a change removed.
+ */
+char mondrian_exec_kill_list[224];
+
+#define MONDRIAN_EXEC_QUIET \
+	"calaccessd,SiriTTSSynthesizerAU,MacinTalkAUSP,KonaSynthesizer," \
+	"watchdogd,bluetoothd,fairplayd.H2,aggregated"
+
+static int
+mondrian_exec_kill_armed(const char *name)
+{
+	char *e;
+
+	for (e = mondrian_exec_kill_list; *e != '\0'; e += strlen(e) + 1) {
+		if (name != NULL && strcmp(e, name) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+void
+mondrian_exec_kill_set(const char *list)
+{
+	char *e;
+
+	strlcpy(mondrian_exec_kill_list, list != NULL ? list : "",
+	    sizeof(mondrian_exec_kill_list));
+	for (e = mondrian_exec_kill_list; *e != '\0'; e++) {
+		if (*e == ',') {
+			*e = '\0';
+		}
+	}
+}
+#endif
