 		mondrian_gpu_write(mondrian_uc_gmu, GMU_OFF(0x1f8c3u), 1);
 	}
+	if (dwords > 16 && mondrian_uc_dump != 0) {
+		printf("MONDRIAN GPU: uc keepalive written\n");
+		mondrian_log_flush_now();
+	}
 	mondrian_gpu_mem_flush(&mondrian_cp_ring, mondrian_cp_ring.bytes);
 	__asm__ volatile("dsb sy" ::: "memory");
 	mondrian_uc_fence = seq;
@@ -3339,7 +3347,15 @@
 		 * Start every logged submission with a clean fault record, or the
 		 * dump below reports whatever the bring-up latched long ago.
 		 */
-		mondrian_gpu_uc_fault_clear();
+		if (dwords > 16) {
+			mondrian_gpu_uc_fault_clear();
+			printf("MONDRIAN GPU: uc fsr cleared\n");
+			mondrian_log_flush_now();
+		}
+	}
+	if (dwords > 16 && mondrian_uc_dump != 0) {
+		printf("MONDRIAN GPU: uc ring door 0x%x\n", at);
+		mondrian_log_flush_now();
 	}
 	if (mondrian_uc_async != 0 && mondrian_uc_door_started != 0) {
