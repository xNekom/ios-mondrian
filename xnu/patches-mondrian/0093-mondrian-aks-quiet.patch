xnu 0093: the key-store calls the userland actually makes

Two things came out of the first boot that reached the daemons:

- securityd retries kAKSWrapKey, which the emulation does not implement, in
  a tight loop; a line per call buried every other message on a console
  that can show one screenful. Print the first three calls of each
  selector.
- SpringBoard and its helpers ask for selector 35
  (aks_get_extended_device_state) and 101 (aks_assert_consume). They were
  answered kIOReturnUnsupported; 35 answers like 17 (the same DER device
  state, which is what the caller decodes) and 101 has no output.

diff --git a/iokit/Kernel/arm/MondrianKeyStore.cpp b/iokit/Kernel/arm/MondrianKeyStore.cpp
--- a/iokit/Kernel/arm/MondrianKeyStore.cpp
+++ b/iokit/Kernel/arm/MondrianKeyStore.cpp
@@ -41,6 +41,8 @@
 	kAKSLockBag          = 13,
 	kAKSGetSystem        = 14,
 	kAKSGetDeviceState   = 17,
+	kAKSGetExtDeviceState = 35,     /* aks_get_extended_device_state */
+	kAKSAssertConsume    = 101,     /* aks_assert_consume */
 	kAKSAssertHold       = 26,
 	kAKSAssertDrop       = 27,
 	kAKSUnloadSessionBags = 55,
@@ -190,6 +192,7 @@
 	case kAKSLockBag:
 	case kAKSAssertHold:
 	case kAKSAssertDrop:
+	case kAKSAssertConsume:
 	case kAKSUnloadSessionBags:
 	case kAKSNotifyStateSet:
 		args->scalarOutputCount = 0;
@@ -220,6 +223,7 @@
 		args->scalarOutputCount = 1;
 		break;
 	case kAKSGetDeviceState:
+	case kAKSGetExtDeviceState:
 		args->scalarOutputCount = 0;
 		ret = mondrian_aks_device_state(args);
 		break;
@@ -228,10 +232,20 @@
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("MONDRIAN AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	/*
+	 * securityd retries the selectors this emulation does not implement
+	 * (kAKSWrapKey) in a tight loop, and a line per call buries every
+	 * other message the boot has to say. Three lines per selector are
+	 * enough to see which methods the userland actually uses.
+	 */
+	static uint16_t aks_logged[128];
+	if (selector < 128 && aks_logged[selector]++ < 3) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("MONDRIAN AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n",
+		    name, selector, arg0, in_scalars, in_struct, out_scalars,
+		    out_struct, ret);
+	}
 	return ret;
 }
 #endif /* MONDRIAN */
