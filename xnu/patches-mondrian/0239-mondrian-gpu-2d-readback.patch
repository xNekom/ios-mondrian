+/*
+ * The SMMU's latched syndrome, for a caller that cleared it first: FSR is the
+ * context bank's, GFSR the global one. Read-only.
+ */
+uint32_t
+mondrian_gpu_uc_fault_state(uint32_t *gfsr)
+{
+	uint32_t fsr = 0;
+
+	if (gfsr != NULL) {
+		*gfsr = 0;
+	}
+	if (mondrian_uc_smmu == 0 || mondrian_uc_tlb_ctx == 0) {
+		return 0;
+	}
+	mondrian_uc_keepalive(1);
+	fsr = mondrian_gpu_read(mondrian_uc_smmu, mondrian_uc_tlb_ctx + SMMU_FSR);
+	if (gfsr != NULL) {
+		*gfsr = mondrian_gpu_read(mondrian_uc_smmu, 0x48u);
+	}
+	mondrian_uc_keepalive(0);
+	return fsr;
+}
+
+/*
+ * The 2D engine's own view of the blit it was given, and whether the CP took
+ * the register writes at all: a type-4 write that `CP_PROTECT` covers is
+ * dropped without an error, without a fault and without a stall, so a blit
+ * that ran with its state refused writes exactly as much as one that ran
+ * with it. Eight words: RB_2D_DST_INFO, RB_2D_DST (two), RB_2D_DST_PITCH,
+ * RB_2D_BLIT_CNTL, RB_2D_UNKNOWN_8C01, CP_PROTECT_STATUS, CP_HW_FAULT.
+ *
+ * Only safe once the fence answered: a wedged CP stops answering its
+ * register port and the read never returns.
+ */
+void
+mondrian_gpu_uc_2d_state(uint32_t *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	if (mondrian_uc_up == 0 || mondrian_uc_gpu == 0) {
+		bzero(out, 8 * sizeof(uint32_t));
+		return;
+	}
+	out[0] = mondrian_gpu_read(mondrian_uc_gpu, 0x8c17u * 4u);
+	out[1] = mondrian_gpu_read(mondrian_uc_gpu, 0x8c18u * 4u);
+	out[2] = mondrian_gpu_read(mondrian_uc_gpu, 0x8c19u * 4u);
+	out[3] = mondrian_gpu_read(mondrian_uc_gpu, 0x8c1au * 4u);
+	out[4] = mondrian_gpu_read(mondrian_uc_gpu, 0x8c00u * 4u);
+	out[5] = mondrian_gpu_read(mondrian_uc_gpu, 0x8c01u * 4u);
+	out[6] = mondrian_gpu_read(mondrian_uc_gpu,
+	    GEN7_CP_PROTECT_STATUS * 4u);
+	out[7] = mondrian_gpu_read(mondrian_uc_gpu, GEN7_CP_HW_FAULT * 4u);
+}
+
+/*
+ * A CP_MEM_WRITE of one dword, emitted into `buf`. The CP's own writes are
+ * the only ones this port has ever seen land, and they have all landed in a
+ * page the driver allocated: this one lands in a client buffer, through the
+ * same IOVA the blit is given, so "the address is fine and the engine is
+ * not" and "the client's memory is not reachable" stop looking alike.
+ */
+uint32_t
+mondrian_gpu_uc_mem_write(uint32_t *buf, uint64_t dst, uint32_t value)
+{
+	buf[0] = mondrian_pm4_type7(0x3du, 3);	/* CP_MEM_WRITE */
+	buf[1] = (uint32_t)dst;
+	buf[2] = (uint32_t)(dst >> 32);
+	buf[3] = value;
+	return 4;
+}
