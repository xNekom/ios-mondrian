+/*
+ * ccucntl=0 drops the two dwords; the default keeps them.
+ */
+static int
+mondrian_uc_2dfill_ccu(void)
+{
+	static int parsed, on = 1;
+
+	if (!parsed) {
+		parsed = 1;
+		if (!PE_parse_boot_argn("ccucntl", &on, sizeof(on))) {
+			on = 1;
+		}
+	}
+	return on != 0;
+}
