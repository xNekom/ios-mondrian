diff --git a/bsd/dev/mondrian_touch.c b/bsd/dev/mondrian_touch.c
--- a/bsd/dev/mondrian_touch.c
+++ b/bsd/dev/mondrian_touch.c
@@ -1083,6 +1083,75 @@
  */
 static uint32_t mondrian_touch_events;
 
+/*
+ * The interval between the events handed to the HID side, bucketed the way the
+ * framebuffer buckets frames. A drag moves when an event lands, so events that
+ * arrive three at a time and then stop for 30 ms step the content even when
+ * the count per second looks healthy.
+ */
+static uint64_t mondrian_touch_last_event;
+static uint64_t mondrian_touch_event_gap_ticks;
+static uint64_t mondrian_touch_event_gap_max;
+static uint32_t mondrian_touch_event_gap_count;
+static uint32_t mondrian_touch_event_gaps[6];
+
+static void
+mondrian_touch_event_gap(void)
+{
+	uint64_t now = mach_absolute_time();
+	uint64_t ns = 0;
+
+	if (mondrian_touch_last_event != 0 && now > mondrian_touch_last_event) {
+		uint64_t gap = now - mondrian_touch_last_event;
+
+		absolutetime_to_nanoseconds(gap, &ns);
+		mondrian_touch_event_gap_ticks += gap;
+		mondrian_touch_event_gap_count++;
+		if (gap > mondrian_touch_event_gap_max) {
+			mondrian_touch_event_gap_max = gap;
+		}
+		if (ns < 10000000ULL) {
+			mondrian_touch_event_gaps[0]++;
+		} else if (ns < 14000000ULL) {
+			mondrian_touch_event_gaps[1]++;
+		} else if (ns < 19000000ULL) {
+			mondrian_touch_event_gaps[2]++;
+		} else if (ns < 25000000ULL) {
+			mondrian_touch_event_gaps[3]++;
+		} else if (ns < 34000000ULL) {
+			mondrian_touch_event_gaps[4]++;
+		} else {
+			mondrian_touch_event_gaps[5]++;
+		}
+	}
+	mondrian_touch_last_event = now;
+}
+
+void
+mondrian_touch_event_gap_report(void)
+{
+	uint64_t avg = 0, max = 0;
+	int i;
+
+	if (mondrian_touch_event_gap_count == 0) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mondrian_touch_event_gap_ticks /
+		mondrian_touch_event_gap_count, &avg);
+	absolutetime_to_nanoseconds(mondrian_touch_event_gap_max, &max);
+	printf("MONDRIAN TOUCH: ev gap avg %llu us max %llu us lt10 %u 10-14 %u 14-19 %u 19-25 %u 25-34 %u gt34 %u\n",
+		(unsigned long long)(avg / 1000), (unsigned long long)(max / 1000),
+		mondrian_touch_event_gaps[0], mondrian_touch_event_gaps[1],
+		mondrian_touch_event_gaps[2], mondrian_touch_event_gaps[3],
+		mondrian_touch_event_gaps[4], mondrian_touch_event_gaps[5]);
+	mondrian_touch_event_gap_ticks = 0;
+	mondrian_touch_event_gap_max = 0;
+	mondrian_touch_event_gap_count = 0;
+	for (i = 0; i < 6; i++) {
+		mondrian_touch_event_gaps[i] = 0;
+	}
+}
+
