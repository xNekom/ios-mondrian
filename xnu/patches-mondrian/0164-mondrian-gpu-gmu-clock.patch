 mondrian_gpu_probe(void)
 {
-	int on = 0, power = 0;
+	int on = 0, power = 0, gmuread = 0, zapread = 0;
 	vm_offset_t gpucc, gpu, gmu, smmu;
 	uint32_t cx, gx, ahb, cxo;
 
@@ -123,6 +157,8 @@
 		return 0;
 	}
 	(void)PE_parse_boot_argn("gpupower", &power, sizeof(power));
+	(void)PE_parse_boot_argn("gmuread", &gmuread, sizeof(gmuread));
+	(void)PE_parse_boot_argn("zapread", &zapread, sizeof(zapread));
 	gpucc = ml_io_map(MONDRIAN_GPUCC_BASE, MONDRIAN_GPUCC_SIZE);
 	gmu = ml_io_map(MONDRIAN_GMU_BASE, MONDRIAN_GMU_SIZE);
 	smmu = ml_io_map(MONDRIAN_SMMU_BASE, MONDRIAN_SMMU_SIZE);
@@ -152,13 +188,15 @@
