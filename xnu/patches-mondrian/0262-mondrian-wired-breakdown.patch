 	/*
 	 * Surface-sized only: a pattern test on a texture would say nothing
 	 * about the surface and would cost a flush of every buffer.
@@ -676,6 +694,8 @@
 	if (buffer->memory != NULL) {
 		buffer->memory->release();
 	}
+	mondrian_gpu_buffer_bytes -= buffer->size;
+	mondrian_gpu_buffer_count--;
 	for (i = 0; i < fBufferCount; i++) {
 		if (fBuffers[i] == buffer) {
 			fBuffers[i] = fBuffers[--fBufferCount];
