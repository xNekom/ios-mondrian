xnu 0262: split the wired total into what this port allocates

A boot runs with 14 MiB free and 502 MiB wired out of a 768 MiB window, and
jetsam kills a process every few seconds. The two owners this port can name are
the IOSurface buffers and the GEM buffers the GPU client adopts; print both, with
their live object counts, beside the VM totals, so a boot says whether the next
hundred megabytes are a leak of ours or the userland's own demand.
--- a/iokit/Kernel/arm/MondrianSurface.cpp
+++ b/iokit/Kernel/arm/MondrianSurface.cpp
@@ -75,6 +75,31 @@
 static uint64_t      mondrian_surface_wired;       /* bytes of buffer surfaces */
 #define MONDRIAN_SURFACE_WIRED_MAX         (1536ull << 20)
 
+/* What the sampler prints: how much of the wired total is surfaces. */
+extern "C" uint64_t
+mondrian_surface_wired_bytes(void)
+{
+	return (uint64_t)mondrian_surface_wired;
+}
+
+extern "C" uint32_t
+mondrian_surface_live_count(void)
+{
+	uint32_t live = 0;
+
+	if (mondrian_surface_lock == NULL) {
+		return 0;
+	}
+	IOLockLock(mondrian_surface_lock);
+	for (uint32_t id = 1; id < MONDRIAN_SURFACE_MAX_ID; id++) {
+		if (mondrian_surface_table[id] != NULL) {
+			live++;
+		}
+	}
+	IOLockUnlock(mondrian_surface_lock);
+	return live;
+}
+
 OSDefineMetaClassAndStructors(MondrianSurface, OSObject);
 
 void
