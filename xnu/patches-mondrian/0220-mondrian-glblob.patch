@@ -1837,6 +1867,37 @@
 	return error;
 }
 
+/*
+ * Boot argument glblob=1: write the CoreAnimation dylibs that this build of the
+ * kernel carries into /private/var/vm, which is the writable copy the injector
+ * prefers over /usr/libexec (the root is mounted read-only). A userland change
+ * then costs one `fastboot boot` instead of a 16 GiB userdata flash; the blobs
+ * come from tools/gen-glblob.py and are generated into bsd/dev at build time,
+ * so a kernel built without them simply does not take this path.
+ */
+static int
+mondrian_glblob_one(const char *path, const unsigned char *data, unsigned len)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int error;
+
+	if (len == 0) {
+		return EINVAL;
+	}
+	error = vnode_open(path, (O_CREAT | FWRITE | O_TRUNC), 0755, 0, &vp, ctx);
+	if (error == 0) {
+		/* The blob is const data in the kernel image: vn_rdwr reads it. */
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)len, 0,
+		    UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+		    vfs_context_ucred(ctx), NULL, vfs_context_proc(ctx));
+		(void)VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		vnode_close(vp, FWRITE, ctx);
+	}
+	printf("MONDRIAN GLBLOB: %s %u bytes -> %d\n", path, len, error);
+	return error;
+}
+
 void
 mondrian_root_fixups(void)
 {
@@ -1848,10 +1909,26 @@
 	if (error == 0) {
 		vnode_put(vp);
 		printf("MONDRIAN ROOT: /private/var/vm present\n");
-		return;
+	} else {
+		printf("MONDRIAN ROOT: /private/var/vm lookup %d, creating it\n", error);
+		error = mondrian_root_mkdir("/private/var/vm", 0755);
+		printf("MONDRIAN ROOT: mkdir /private/var/vm -> %d\n", error);
+	}
+#if __has_include("mondrian_glblob.h")
+	{
+		int blob = 0;
+
+		/*
+		 * Not written here: at this point the root is still mounted read-only
+		 * (the first attempt from this function returned EROFS, 30) and iOS
+		 * remounts it writable a few seconds later. The log thread, which
+		 * starts just after this, retries every wake until both files are in
+		 * place.
+		 */
+		if (PE_parse_boot_argn("glblob", &blob, sizeof(blob)) && blob != 0) {
+			mondrian_glblob_pending = 1;
+		}
 	}
-	printf("MONDRIAN ROOT: /private/var/vm lookup %d, creating it\n", error);
-	error = mondrian_root_mkdir("/private/var/vm", 0755);
-	printf("MONDRIAN ROOT: mkdir /private/var/vm -> %d\n", error);
+#endif
 }
 #endif /* ARM64_BOARD_CONFIG_MONDRIAN */
