+#if __has_include("mondrian_glblob.h")
+static int mondrian_glblob_one(const char *path, const unsigned char *data, unsigned len);
+#endif
+
+/*
+ * glblob=1: the two files, once the root is writable. EROFS means "not yet",
+ * any other error means the write itself failed and is worth saying.
+ */
+static void
+mondrian_glblob_try(void)
+{
+#if __has_include("mondrian_glblob.h")
+	if (!mondrian_glblob_pending) {
+		return;
+	}
+	if (mondrian_glblob_one("/private/var/vm/mondrian-gl.dylib",
+	    mondrian_gl_dylib, mondrian_gl_dylib_len) == 0 &&
+	    mondrian_glblob_one("/private/var/vm/mondrian-inject.dylib",
+	    mondrian_inject_dylib, mondrian_inject_dylib_len) == 0) {
+		mondrian_glblob_pending = 0;
+	}
+#endif
+}
