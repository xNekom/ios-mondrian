 static void
 mondrian_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1507,6 +1536,7 @@
 		total = os_atomic_load(&mondrian_log_total, relaxed);
 		before = os_atomic_load(&mondrian_log_flushed, relaxed);
 		mondrian_log_store(total, 0);
+		mondrian_glblob_try();
 		/*
 		 * Paint everything that is new, not just the tail: the cost is
