+
+/*
+ * One byte into an AP-owned peripheral's channel window, the same transaction
+ * mondrian_spmi_set_restart_reason() uses for the SDAM: data at +0x10, the
+ * register in the command at +0x00, completion and fault in the status at
+ * +0x08. 1 = done.
+ */
+static int
+sp_chan_write(volatile uint32_t *q, uint32_t off, uint32_t val)
+{
+	uint32_t st = 0;
+
+	q[0x10 / 4] = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+	q[0] = (off & 0xffu) << 4;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (uint32_t i = 0; i < MONDRIAN_SPMI_RETRIES; i++) {
+		st = q[0x08 / 4];
+		if (st & 1u) {
+			return (st & 0x0eu) == 0;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+/*
+ * The RTC's seconds: four bytes at 0x48, LSB first, read one at a time
+ * through the observer window (the same path as the keys). The LSB is read
+ * again to catch a carry between the four transactions, which is what
+ * rtc-pm8xxx does.
+ */
+int
+mondrian_spmi_rtc_read(uint32_t *secs)
+{
+	uint16_t apid;
+	uint8_t b[4], lsb;
+	uint32_t v;
+
+	if (secs == NULL || !sp_ensure()) {
+		return 0;
+	}
+	apid = sp_find_apid(MONDRIAN_SPMI_RTC_PPID);
+	if (apid == 0xffffu) {
+		if (!sp_rtc_reported) {
+			sp_rtc_reported = true;
+			printf("MONDRIAN RTC: no APID for peripheral 0x61\n");
+		}
+		return 0;
+	}
+	for (uint32_t i = 0; i < 4; i++) {
+		if (!sp_read(apid, MONDRIAN_SPMI_RTC_READ + i, &b[i])) {
+			return 0;
+		}
+	}
+	if (!sp_read(apid, MONDRIAN_SPMI_RTC_READ, &lsb)) {
+		return 0;
+	}
+	if (lsb < b[0]) {
+		for (uint32_t i = 0; i < 4; i++) {
+			if (!sp_read(apid, MONDRIAN_SPMI_RTC_READ + i, &b[i])) {
+				return 0;
+			}
+		}
+	}
+	v = (uint32_t)b[0] | ((uint32_t)b[1] << 8) |
+	    ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+	if (!sp_rtc_reported) {
+		sp_rtc_reported = true;
+		printf("MONDRIAN RTC: apid %u raw %u owner %u\n", apid, v,
+		    sp_apid_owner(apid));
+	}
+	*secs = v;
+	return 1;
+}
+
+/*
+ * Setting the RTC, in Linux rtc-pm8xxx's order: alarm out of the way, RTC
+ * disabled, LSB 0, bytes 1..3, LSB, RTC enabled. The alarm is only checked,
+ * not cleared: if it is armed, the time is left alone and the reason is
+ * printed. The write goes through the channel window of the APID the map
+ * says is the AP's; any other owner is refused before a byte is sent.
+ */
+int
+mondrian_spmi_rtc_write(uint32_t secs)
+{
+	uint16_t apid, alarm_apid;
+	volatile uint32_t *q;
+	uint8_t ctrl = 0, alarm = 0;
+
+	if (!sp_ensure()) {
+		return 0;
+	}
+	apid = sp_find_apid(MONDRIAN_SPMI_RTC_PPID);
+	if (apid == 0xffffu) {
+		printf("MONDRIAN RTC: no APID to write\n");
+		return 0;
+	}
+	if (sp_apid_owner(apid) != 0) {
+		printf("MONDRIAN RTC: peripheral 0x61 is owned by %u, not the AP\n",
+		    sp_apid_owner(apid));
+		return 0;
+	}
+	alarm_apid = sp_find_apid(MONDRIAN_SPMI_RTC_ALARM_PPID);
+	if (alarm_apid != 0xffffu && sp_apid_owner(alarm_apid) == 0 &&
+	    sp_read(alarm_apid, MONDRIAN_SPMI_RTC_ALARM_CTRL, &alarm) &&
+	    (alarm & MONDRIAN_SPMI_RTC_ENABLE) != 0) {
+		printf("MONDRIAN RTC: alarm enabled (0x%02x), time not touched\n",
+		    alarm);
+		return 0;
+	}
+	if (!sp_read(apid, MONDRIAN_SPMI_RTC_CTRL, &ctrl)) {
+		printf("MONDRIAN RTC: control read failed\n");
+		return 0;
+	}
+	q = (volatile uint32_t *)ml_io_map(
+	    MONDRIAN_SPMI_CHNLS + ((uint32_t)apid << 12),
+	    MONDRIAN_SPMI_CHNLS_SIZE);
+	if (q == NULL) {
+		printf("MONDRIAN RTC: no window for apid %u\n", apid);
+		return 0;
+	}
+	if (!sp_chan_write(q, MONDRIAN_SPMI_RTC_CTRL,
+	    ctrl & ~MONDRIAN_SPMI_RTC_ENABLE) ||
+	    !sp_chan_write(q, MONDRIAN_SPMI_RTC_WRITE, 0)) {
+		printf("MONDRIAN RTC: disable failed\n");
+		return 0;
+	}
+	for (uint32_t i = 1; i < 4; i++) {
+		if (!sp_chan_write(q, MONDRIAN_SPMI_RTC_WRITE + i,
+		    (secs >> (8 * i)) & 0xffu)) {
+			printf("MONDRIAN RTC: byte %u failed\n", i);
+			return 0;
+		}
+	}
+	if (!sp_chan_write(q, MONDRIAN_SPMI_RTC_WRITE, secs & 0xffu) ||
+	    !sp_chan_write(q, MONDRIAN_SPMI_RTC_CTRL,
+	    ctrl | MONDRIAN_SPMI_RTC_ENABLE)) {
+		printf("MONDRIAN RTC: enable failed\n");
+		return 0;
+	}
+	printf("MONDRIAN RTC: wrote %u (ctrl 0x%02x -> 0x%02x)\n", secs,
+	    ctrl, ctrl | MONDRIAN_SPMI_RTC_ENABLE);
+	return 1;
+}
