+/*
+ * "rtc" reads the PMK8350 RTC and "rtc set SECONDS" writes it, then moves the
+ * running clock to the same value so the status bar and every later
+ * gettimeofday follow without a reboot. The host knows the real time; the
+ * phone's RTC was left at 1975, and no network exists yet to supply one.
+ */
+static void
+ud_cmd_rtc(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_spmi_rtc_read(uint32_t *secs);
+	extern int mondrian_spmi_rtc_write(uint32_t secs);
+	uint32_t secs = 0;
+	char out[128];
+	int n;
+
+	if (strncmp(line, "rtc set ", 8) == 0) {
+		if (ud_cmd_num(line + 8, &secs) == NULL) {
+			n = snprintf(out, sizeof(out), "rtc set needs seconds\n");
+		} else if (mondrian_spmi_rtc_write(secs)) {
+			clock_set_calendar_microtime((clock_sec_t)secs, 0);
+			n = snprintf(out, sizeof(out), "rtc set %u\n", secs);
+		} else {
+			/*
+			 * The PMK8350 keeps time for the secure world, which does
+			 * not hand the AP the time peripheral (measured: the
+			 * owner is 4), so the write is refused. The running clock
+			 * still moves, which is what the status bar shows:
+			 * clock_set_calendar_microtime() ends in
+			 * PESetUTCTimeOfDay() -> mondrian_pe_set_utc().
+			 */
+			clock_set_calendar_microtime((clock_sec_t)secs, 0);
+			n = snprintf(out, sizeof(out),
+			    "rtc set %u not ours; clock set\n", secs);
+		}
+	} else if (!mondrian_spmi_rtc_read(&secs)) {
+		n = snprintf(out, sizeof(out), "rtc read failed\n");
+	} else {
+		n = snprintf(out, sizeof(out), "rtc %u\n", secs);
+	}
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
