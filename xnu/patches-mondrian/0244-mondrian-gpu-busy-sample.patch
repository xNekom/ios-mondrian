xnu 0244: the LLCC slice, and RBBM's busy bits during an IB

UCHE_CMDQ_CONFIG and RBBM_GBIF_CLIENT_QOS_CNTL are programmed now (0243)
and the answer to whether the render blocks ever start is in RBBM_STATUS:
bits 17/9/8/7 say UCHE, A2D, CCU and RB busy. The fence poll of a
submission reads it as well as the GMU's GX status, so the line covers the
time the IB was in flight, and a blit that produces no fragment either
never sets one of those bits or sets them and loses the write.

gpuscache=1 additionally writes the a730 LLCC slice the way mainline's
a7xx_llc_activate does on sm8450, where LLCC_GPU is slice 9:
GBIF_SCACHE_CNTL1 holds the id in all of its id fields and
GBIF_SCACHE_CNTL0 is id<<10 | BIT(8). Neither register is written anywhere
in this port, and the GPU's traffic is tagged by them.

Both are gated (gpuif=0, gpuscache=0) so one kernel can measure either
side.
--- a/bsd/dev/mondrian_gpu.c
+++ b/bsd/dev/mondrian_gpu.c
@@ -117,6 +117,12 @@
  */
 static int mondrian_cp_if_init = 1;
 /*
+ * 1: write the a730 GBIF system-cache config the LLCC slice needs
+ * (sm8450's LLCC_GPU slice is 9): SCACHE_CNTL1 with the scid in all five
+ * client fields, SCACHE_CNTL0 as scid<<10 | BIT(8).
+ */
+static int mondrian_cp_scache = 1;
+/*
  * The 2000-submission stress in the CP bring-up: a diagnostic, on by default
  * because it is what proves the ring, the fence slots and the order. cpstress=0
  * skips it, for a boot where the point is to get past the bring-up: with
@@ -2698,6 +2704,19 @@
 		CPW(GEN7_UCHE_CMDQ_CONFIG, (6u << 16) | (6u << 12) |
 		    (9u << 8) | (1u << 3) | (1u << 2) | 2u);
 	}
+	/*
+	 * gpuscache=1: the a730 LLCC slice. Mainline takes the id from the
+	 * LLCC driver (`llcc_get_slice_id(LLCC_GPU)`, 9 on sm8450) and writes
+	 * it into every id field of GBIF_SCACHE_CNTL1, with
+	 * GBIF_SCACHE_CNTL0 as scid<<10 | BIT(8). Nothing in this port
+	 * programs either, so if the bootloader's values did not survive the
+	 * reset the GPU's traffic is tagged for a slice that is not there.
+	 */
+	if (mondrian_cp_scache != 0) {
+		CPW(GEN7_GBIF_SCACHE_CNTL1, (9u << 0) | (9u << 5) |
+		    (9u << 10) | (9u << 15) | (9u << 20) | (9u << 25));
+		CPW(GEN7_GBIF_SCACHE_CNTL0, (9u << 10) | (1u << 8));
+	}
 
 	CPW(GEN7_CP_AHB_CNTL, 1);
 	CPW(GEN7_RBBM_PERFCTR_CNTL, 1);
@@ -4825,6 +4844,7 @@
