xnu 0083: keep the panel's memory out of the page allocator

The ABL leaves the continuous-splash buffer mapped and the display
hardware keeps scanning it out of RAM: the kernel console draws into it,
and the userland framebuffer driver will do the same. The boot arguments
describe the whole window as free RAM, so the page allocator would
eventually hand those pages out and the screen would turn into whatever
the kernel stored there. The PE records the region from the ADT while it
maps the console; pmap_startup() initialises those page frames like any
other and does not release them, so they never join the free list.

The first version skipped the window inside pmap_next_page(), and that
panicked at vm_resident.c:2627 (`Assertion failed: ppnum ==
VM_PAGE_GET_PHYS_PAGE(m)`) right after "kprintf startup complete": on
arm64 a page's physical address comes from its index in vm_pages, so a
hole in the walk shifts every page after it. Keeping the walk intact and
withholding the pages from the free queues costs nothing and makes the
reservation permanent.

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -726,6 +726,25 @@
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+/*
+ * The physical extent of the panel's memory, as the ADT states it. The MDP
+ * scans that region out of RAM by itself, so it is not free memory: the
+ * page allocator must not release it (see pmap_startup()). Zero until
+ * fbcon_probe() has read the node.
+ */
+static uint64_t fbcon_phys_base, fbcon_phys_end;
+
+uint64_t
+mondrian_fb_reserved_start(void)
+{
+	return fbcon_phys_base;
+}
+
+uint64_t
+mondrian_fb_reserved_end(void)
+{
+	return fbcon_phys_end;
+}
 
 static void
 fbcon_clear_row(uint32_t row)
@@ -930,6 +949,15 @@
 	}
 	mondrian_early_mark(17, "fbcon config read; mapping");
 	/*
+	 * The panel memory is reserved from here on: arm_init() has already
+	 * read this node when the page allocator starts counting pages
+	 * (vm_page_bootstrap), so the whole region is skipped there instead of
+	 * being handed to the VM as free RAM.
+	 */
+	fbcon_phys_base = reg[0];
+	fbcon_phys_end = reg[0] + reg[1];
+	mondrian_early_mark(19, "panel memory is not RAM");
+	/*
 	 * The reserved kernel alias of the framebuffer, not a page-table
 	 * mapping: the alias lives in the low globals the VM never reuses, so
 	 * it cannot be torn down under the console while the kernel runs. The
diff --git a/pexpert/pexpert/arm/protos.h b/pexpert/pexpert/arm/protos.h
--- a/pexpert/pexpert/arm/protos.h
+++ b/pexpert/pexpert/arm/protos.h
@@ -56,6 +56,9 @@
 
 kern_return_t serial_irq_enable(serial_device_t device);
 void mondrian_fbcon_beacon(uint64_t pc, uint64_t count);
+/* The panel's memory, which the page allocator must not hand out. */
+uint64_t mondrian_fb_reserved_start(void);
+uint64_t mondrian_fb_reserved_end(void);
 kern_return_t serial_irq_action(serial_device_t device);
 bool serial_irq_filter(serial_device_t device);
 
diff --git a/osfmk/vm/vm_resident.c b/osfmk/vm/vm_resident.c
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -1394,6 +1394,31 @@
 #endif
 
 void vm_page_release_startup(vm_page_t mem);
+
+#if defined(MONDRIAN)
+/*
+ * The panel's memory is described as RAM but the display hardware keeps
+ * scanning it, so it must never reach the free list. "Never free" is not the
+ * same as "skip": on arm64 a page's physical address is derived from its
+ * index in vm_pages, so pmap_next_page() has to keep handing the region out
+ * in order. The pages are initialised like any other and simply not released
+ * to the free queues; they stay wired, which is what the display needs, and
+ * the rest of the array keeps its index/address arithmetic.
+ */
+extern uint64_t mondrian_fb_reserved_start(void);
+extern uint64_t mondrian_fb_reserved_end(void);
+
+static boolean_t
+mondrian_page_is_screen(vm_page_t mem)
+{
+	uint64_t start = mondrian_fb_reserved_start();
+	uint64_t end = mondrian_fb_reserved_end();
+	uint64_t phys = (uint64_t)VM_PAGE_GET_PHYS_PAGE(mem) << PAGE_SHIFT;
+
+	return (start < end) && (phys >= start) && (phys < end);
+}
+#endif /* MONDRIAN */
+
 void
 pmap_startup(
 	vm_offset_t     *startp,
@@ -1569,6 +1594,9 @@
 		vm_page_init(&vm_pages[i], phys_page, FALSE);
 		if (fill) {
 			fillPage(phys_page, fillval);
+		}
+		if (mondrian_page_is_screen(&vm_pages[i])) {
+			continue;
 		}
 		if (vm_himemory_mode) {
 			vm_page_release_startup(&vm_pages[i]);
@@ -1579,11 +1607,17 @@
 	if (!vm_himemory_mode) {
 		do {
 			if (!VMP_ERROR_GET(&vm_pages[--i])) {               /* skip retired pages */
+				if (mondrian_page_is_screen(&vm_pages[i])) {
+					continue;
+				}
 				vm_page_release_startup(&vm_pages[i]);
 			}
 		} while (i != 0);
 	}
 
+	printf("MONDRIAN VM: %llu panel pages kept off the free list\n",
+	    (unsigned long long)((mondrian_fb_reserved_end() -
+	    mondrian_fb_reserved_start()) >> PAGE_SHIFT));
 	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
 	printf("pmap_startup() init/release time: %lld microsec\n", (now_ns - start_ns) / NSEC_PER_USEC);
 	printf("pmap_startup() delayed init/release of %d pages\n", vm_delayed_count);
