+/*
+ * Wakeups the report thread served, and the events it handed to the HID
+ * side. The three numbers together say where a drag stalls: a low poll rate
+ * means the thread is not being woken, a high poll rate with few reports
+ * means the part is barely producing them, and few events with both high
+ * means the thread is stuck in the drain loop.
+ */
+static uint32_t mondrian_touch_events;
+
+uint32_t
+mondrian_touch_poll_count(void)
+{
+	return mondrian_touch_polls;
+}
+
+uint32_t
+mondrian_touch_event_count(void)
+{
+	return mondrian_touch_events;
+}
