xnu 0450: program the PARF requester-to-SID table

Measured 2026-11-26 with 0449: MHICFG reads 0x800080, CHDBOFF 0x300,
ERDBOFF 0x700, BHIEOFF 0x224, and the programmed context base reads back,
so the host side of MHI is complete. The doorbell still leaves BHI_STATUS
0x0 and the MSI landing page 0x0, and the SMMU records no architectural
fault.

The donor's coldLink clears the PARF requester table (0x2000, 256
entries), writes this endpoint's entry (bus 1, device 0, function 0, at
the CRC8 index of those bytes) as 0x01000100, and clears 0x2c00 bit 0.
This port took over the bootloader's SMRs for SID 0x1c00/0x1c01 but never
mapped the BDF to them: sCR0.USFCFG=1 forwards an unmatched stream
untranslated, so the PBL's fetch would read physical memory at the IOVA
instead of the wired image.

Program the table as the donor does, in the DBI setup after the PHY is
ready, and log the index, entry and control register.

diff --git a/bsd/dev/mondrian_wifi.c b/bsd/dev/mondrian_wifi.c
index 44741fb..2e7b824 100644
--- a/bsd/dev/mondrian_wifi.c
+++ b/bsd/dev/mondrian_wifi.c
@@ -792,12 +792,47 @@ wifi_phy_load_table(void)
 	return 0;
 }
 
+/*
+ * The PARF requester table maps a PCIe BDF to an SMMU stream ID. The donor
+ * clears all 256 entries, writes this phone's endpoint (bus 1, device 0,
+ * function 0, at the CRC8 index of those bytes) and clears 0x2c00 bit 0.
+ * Without it the endpoint's DMA can reach the SMMU as an unmatched stream,
+ * which sCR0.USFCFG=1 forwards untranslated: the BHI fetch reads whatever
+ * is at the IOVA as a physical address.
+ */
+static void
+wifi_parf_sid_table(void)
+{
+	uint32_t crc = 0;
+	unsigned i, b;
+
+	for (i = 0; i < 256; i++) {
+		mondrian_tlmm_write(wifi_parf, 0x2000 + 4 * i, 0);
+	}
+	for (i = 0; i < 2; i++) {
+		uint32_t byte = (i == 0) ? 1u : 0u;
+
+		crc ^= byte;
+		for (b = 0; b < 8; b++) {
+			crc = (crc & 0x80u) ? (((crc << 1) ^ 7u) & 0xffu) :
+			    ((crc << 1) & 0xffu);
+		}
+	}
+	mondrian_tlmm_write(wifi_parf, 0x2000 + crc * 4, 0x01000100);
+	mondrian_tlmm_write(wifi_parf, 0x2c00,
+	    mondrian_tlmm_read(wifi_parf, 0x2c00) & ~1u);
+	wifi_log("W1 parf sid table crc=0x%x entry=0x%x ctrl=0x%x", crc,
+	    mondrian_tlmm_read(wifi_parf, 0x2000 + crc * 4),
+	    mondrian_tlmm_read(wifi_parf, 0x2c00));
+}
+
 static void
 wifi_dbi_setup(void)
 {
 	uint32_t maximum;
 	unsigned speed;
 
+	wifi_parf_sid_table();
 	mondrian_tlmm_write(wifi_dbi, 0x8bc,
 	    mondrian_tlmm_read(wifi_dbi, 0x8bc) | 1u);
 	/* x1, DLL_LINK_EN, no FAST_LINK. */
