xnu 0086: waits that do not need the clock, and both UFS wake attempts

0082 froze the boot on its first SCSI command: the wait loop used
mach_absolute_time() and delay(), the first place in the boot that does,
and this board's timebase is exactly what has never been shown to work
(the timer interrupt has never been seen). Every wait in the driver now
counts CPU spins, and a one-off calibration prints how many counter ticks
two million spins take, so the boot says whether the counter moves.

The wake sequence is also made harmless: START STOP UNIT on the device
WLUN 0xD0 is sent and its completion is waited for only briefly (a device
that does not answer must not hang the boot), then TEST UNIT READY is
retried, and if the unit stays asleep the wake is tried again on LUN 0.
It also prints what 0082 never printed: the power mode and fDeviceInit
before the wake, the sense of the first TEST UNIT READY, and the state of
every command that never completes (HCS, IS, doorbell, UTRD), so one boot
answers where the truth is.

diff --git a/bsd/dev/mondrian_ufs.c b/bsd/dev/mondrian_ufs.c
--- a/bsd/dev/mondrian_ufs.c
+++ b/bsd/dev/mondrian_ufs.c
@@ -77,6 +77,77 @@
 #define PRDT_CHUNK      (64u << 10)             /* PRDT byte count field: 16 bits */
 #define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
 #define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+
+/*
+ * Waits here count CPU spins, not nanoseconds. This board's timebase is not
+ * trusted yet: the timer interrupt has never been seen, and 0082 froze the
+ * boot at its first SCSI command printing "scsi 0x1b sent, waiting", which
+ * is exactly the first place that called mach_absolute_time() and delay().
+ * Whatever is wrong with the clock, a spin-counted wait still finishes, and
+ * the calibration below says whether the counter ticks at all.
+ */
+static uint64_t ufs_spins_per_ms = 20000;       /* fallback: ~20MHz spin */
+
+/* The register accessors are defined further down, next to the mapping. */
+static inline uint32_t ufs_rd(uint32_t off);
+static inline void ufs_wr(uint32_t off, uint32_t v);
+
+static void
+ufs_calibrate_spins(void)
+{
+	const unsigned long n = 2000000;
+	uint32_t freq = gPEClockFrequencyInfo.timebase_frequency_hz;
+	uint64_t t0 = mach_absolute_time();
+	uint64_t t1, ticks, elapsed_ms;
+
+	for (unsigned long i = 0; i < n; i++) {
+		__builtin_arm_yield();
+	}
+	t1 = mach_absolute_time();
+	ticks = t1 - t0;
+	printf("MONDRIAN UFS: clock: %llu ticks for %lu spins, timebase %u Hz\n",
+	    ticks, n, freq);
+	if (ticks != 0 && freq > 1000) {
+		elapsed_ms = ticks * 1000ull / freq;
+		if (elapsed_ms == 0) {
+			elapsed_ms = 1;
+		}
+		ufs_spins_per_ms = n / elapsed_ms;
+		if (ufs_spins_per_ms == 0) {
+			ufs_spins_per_ms = 1;
+		}
+		printf("MONDRIAN UFS: clock: %llu spins per millisecond\n",
+		    ufs_spins_per_ms);
+	} else {
+		printf("MONDRIAN UFS: clock: the counter does not tick (or has no"
+		    " frequency); waits stay spin-counted\n");
+	}
+}
+
+static void
+ufs_spin_ms(unsigned int ms)
+{
+	uint64_t n = ufs_spins_per_ms * (ms ? ms : 1);
+
+	for (uint64_t i = 0; i < n; i++) {
+		__builtin_arm_yield();
+	}
+}
+
+/* Wait for slot 0's doorbell bit to clear, i.e. for the host to finish. */
+static int
+ufs_wait_done(unsigned int ms)
+{
+	uint64_t n = ufs_spins_per_ms * (ms ? ms : 1);
+
+	while (n-- > 0) {
+		if (!(ufs_rd(REG_UTRLDBR) & 1)) {
+			return 1;
+		}
+		__builtin_arm_yield();
+	}
+	return 0;
+}
 
