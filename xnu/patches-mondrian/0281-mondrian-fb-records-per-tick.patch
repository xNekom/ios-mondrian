+		IOLog("MONDRIAN FB: tick rec0 %u rec1 %u rec2 %u rec3 %u gap %u %u %u %u %u %u %u %u\n",
+		    fb->fTickRec[0], fb->fTickRec[1], fb->fTickRec[2], fb->fTickRec[3],
+		    fb->fSwapGapUs[0], fb->fSwapGapUs[1], fb->fSwapGapUs[2],
