+/*
+ * The panel's own display on/off (DCS 0x29 / 0x28). The driver used to paint
+ * the framebuffer black instead, which destroys the only frame the panel has:
+ * iOS stops its display link when it sleeps, so the tap that should wake the
+ * screen produces no present, and the glass stayed black with no way back.
+ * Switched off, the panel keeps its RAM; switched on, it shows that frame.
+ *
+ * Returns the DMA result, so a panel that refuses the command keeps the old
+ * black-paint fallback in the blank path.
+ */
+static int
+mondrian_panel_light(AppleCLCD *fb, bool on)
+{
+	return mondrian_dsi_dcs_dma(fb, on ? 0x29 : 0x28, 0, true);
