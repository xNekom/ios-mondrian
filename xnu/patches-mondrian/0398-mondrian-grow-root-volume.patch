xnu 0398: grow the root volume to the device on the first writable boot

The iOS root is a 16 GiB HFS+ image written into a 207.6 GiB userdata
partition, and HFS administers only the blocks its volume header names. The
volume fills: measured 2026-11-20, every open of keychain-2.db answers ENOSPC
(28), statfs reports zero free blocks, and the keychain, Photos and Safari
cannot write at all while the partition has 190 GiB unused.

hfs_extendfs already grows a mounted volume, but it refuses an unjournaled one,
and this root is HFS+ without a journal (0355). The extend path itself uses the
journal only for two optional steps: invalidating the old alternate volume
header and resizing the journal. Run it without a journal instead of refusing,
and guard those two steps.

The root mount is remembered when it happens, and the grow is armed from the
read-write upgrade the userland performs seconds later (the root is mounted
read-only first). It runs from a thread call, outside the mount operation, one
second later; a poll every second covers the case where the upgrade is late.
The grow target is the device size. The last blocks of userdata are not the
file system's -- the firmware blob area and the console ring live there and are
written by absolute LBA -- so the UFS driver reports a block device that ends in
front of them; the grown volume's alternate volume header then lands just
before the ring instead of on it.

The extend tries ExtendFileC in the existing free space first and falls back to
AddFileExtent in the newly added blocks, so it works with zero free blocks. The
volume header is written once at the end; a failure before that write restores
the fork and the size, and the volume stays at its old size.
diff --git a/bsd/dev/mondrian_ufs.c b/bsd/dev/mondrian_ufs.c
index 47c788a..c34f747 100644
--- a/bsd/dev/mondrian_ufs.c
+++ b/bsd/dev/mondrian_ufs.c
@@ -853,6 +853,8 @@ mondrian_ufs_userdata_sectors(void)
 	return su.ready ? su.nblocks * (UFS_BLOCK / 512) : 0;
 }
 
+static uint64_t mondrian_ufs_usable_sectors(void);
+
 static int
 mondrian_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
     __unused struct proc *p, int is_char)
@@ -877,7 +879,7 @@ mondrian_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int fl
 		*f = UFS_BLOCK;
 		return 0;
 	case DKIOCGETBLOCKCOUNT:
-		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		*o = mondrian_ufs_usable_sectors();
 		return 0;
 	case DKIOCISWRITABLE:
 		*f = 1;
@@ -939,7 +941,7 @@ mondrian_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *
 static int
 mondrian_ufs_psize(__unused dev_t dev)
 {
-	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+	return su.ready ? (int)MIN(mondrian_ufs_usable_sectors(), INT_MAX) : -1;
 }
 
 static int
@@ -1218,6 +1220,26 @@ mondrian_ufs_rootdev(dev_t *dev)
  * the touch driver, which cannot use the file system at that point.
  */
 #define MONDRIAN_FW_BLOCKS      (256u << 10) / UFS_BLOCK
+
+/*
+ * The last blocks of the partition are not the file system's: the firmware
+ * blob sits in front of the console ring and both are written by absolute
+ * LBA. The block device reports a size that ends in front of them, so a file
+ * system mounted on it cannot allocate over the ring; the HFS root is grown
+ * to exactly this size on its first writable boot.
+ */
+static uint64_t
+mondrian_ufs_usable_sectors(void)
+{
+	uint64_t blocks = su.nblocks;
+	uint64_t tail = MONDRIAN_FW_BLOCKS + MONDRIAN_LOG_BLOCKS;
+
+	if (blocks > tail) {
+		blocks -= tail;
+	}
+	return blocks * UFS_BLOCK / su.secsize;
+}
+
 #define MONDRIAN_LOG_TICKS      5
 
 static char mondrian_log_ring[MONDRIAN_LOG_SIZE];
