+			 */
+			mondrian_grow_hfsmp = hfsmp;
+			if (!vfs_isrdonly(mp)) {
+				mondrian_grow_start();
+			}
 		}
 #if	TARGET_OS_OSX 
 		// increment kext retain count
@@ -2982,6 +3094,9 @@ hfs_init(__unused struct vfsconf *vfsp)
 	done = 1;
 	hfs_chashinit();
 
+	/* MONDRIAN: the root's grow is armed by its mounts; allocate once. */
+	mondrian_grow_call = thread_call_allocate(mondrian_grow_call_fn, NULL);
