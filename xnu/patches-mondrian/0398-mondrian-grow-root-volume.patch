diff --git a/bsd/mondrian_hfs/core/hfs_vfsops.c b/bsd/mondrian_hfs/core/hfs_vfsops.c
index e1de70f..03546e5 100644
--- a/bsd/mondrian_hfs/core/hfs_vfsops.c
+++ b/bsd/mondrian_hfs/core/hfs_vfsops.c
@@ -93,6 +93,8 @@
 
 /* for parsing boot-args */
 #include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
 
 
 #include <kern/locks.h>
@@ -155,6 +157,94 @@ void hfs_initialize_allocator (struct hfsmount *hfsmp);
 int hfs_teardown_allocator (struct hfsmount *hfsmp);
 
 int hfs_mount(struct mount *mp, vnode_t  devvp, user_addr_t data, vfs_context_t context);
+
+/*
+ * MONDRIAN: the root is a 16 GiB image inside a much larger userdata, and
+ * nothing ever grows it: HFS administers only the blocks its volume header
+ * names. The root mount is remembered here, and the grow runs from a thread
+ * call: outside the mount operation (which holds the VFS mount lock), and a
+ * second after the read-write upgrade the userland performs, because the
+ * volume has to be writable for hfs_extendfs.
+ */
+static struct hfsmount *mondrian_grow_hfsmp;
+static thread_call_t mondrian_grow_call;
+static int mondrian_grow_tries;
+
+static int mondrian_hfs_grow_root(void);
+
+static void
+mondrian_grow_call_fn(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	int error = mondrian_hfs_grow_root();
+
+	/*
+	 * EAGAIN: the mount is still read-only, the userland has not remounted
+	 * it yet. Retry for a while, and let the read-write upgrade arm it
+	 * again if it takes longer than that.
+	 */
+	if (error == EAGAIN && ++mondrian_grow_tries < 300) {
+		uint64_t deadline;
+
+		clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+		(void) thread_call_enter_delayed(mondrian_grow_call, deadline);
+	}
+}
+
+static void
+mondrian_grow_start(void)
+{
+	uint64_t deadline;
+
+	if (mondrian_grow_call == NULL) {
+		return;
+	}
+	mondrian_grow_tries = 0;
+	clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+	(void) thread_call_enter_delayed(mondrian_grow_call, deadline);
+}
+
+static int
+mondrian_hfs_grow_root(void)
+{
+	struct hfsmount *hfsmp = mondrian_grow_hfsmp;
+	u_int64_t oldsize, newsize;
+	u_int32_t sector_size;
+	u_int64_t sector_count;
+	vfs_context_t ctx = vfs_context_kernel();
+	int error;
+
+	if (hfsmp == NULL) {
+		return 0;
+	}
+	if (hfsmp->hfs_devvp == NULL ||
+	    (hfsmp->hfs_flags & HFS_READ_ONLY)) {
+		return EAGAIN;
+	}
+	if (VNOP_IOCTL(hfsmp->hfs_devvp, DKIOCGETBLOCKSIZE,
+	    (caddr_t)&sector_size, 0, ctx) != 0 ||
+	    VNOP_IOCTL(hfsmp->hfs_devvp, DKIOCGETBLOCKCOUNT,
+	    (caddr_t)&sector_count, 0, ctx) != 0) {
+		printf("MONDRIAN GROW: device size ioctl failed\n");
+		mondrian_grow_hfsmp = NULL;
+		return ENXIO;
+	}
+	oldsize = (u_int64_t)hfsmp->totalBlocks * hfsmp->blockSize;
+	newsize = (u_int64_t)sector_size * sector_count;
+	if (newsize <= oldsize) {
+		printf("MONDRIAN GROW: volume %llu of device %llu bytes\n",
+		    oldsize, newsize);
+		mondrian_grow_hfsmp = NULL;
+		return 0;
+	}
+	printf("MONDRIAN GROW: volume %llu -> device %llu bytes\n",
+	    oldsize, newsize);
+	error = hfs_extendfs(hfsmp, newsize, ctx);
+	printf("MONDRIAN GROW: %llu bytes -> %d (volume now %llu bytes)\n",
+	    newsize, error,
+	    (u_int64_t)hfsmp->totalBlocks * hfsmp->blockSize);
+	mondrian_grow_hfsmp = NULL;
+	return error;
+}
 int hfs_mountfs(struct vnode *devvp, struct mount *mp, struct hfs_mount_args *args, int journal_replay_only, vfs_context_t context);
 int hfs_reload(struct mount *mp);
 /*
@@ -829,6 +919,16 @@ hfs_mount(struct mount *mp, vnode_t devvp, user_addr_t data, vfs_context_t conte
 			printf("hfs_mount: hfs_changefs returned %d for %s\n", retval, hfsmp->vcbVN);
 		}
 
