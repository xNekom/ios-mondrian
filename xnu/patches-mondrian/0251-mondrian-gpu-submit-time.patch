+	uint32_t entries;
 	uint32_t synced = 0, held = 0;
 
 	if (request->nr_bos > kMondrianSubmits || request->nr_cmds == 0 ||
@@ -1464,12 +1490,13 @@
 	 * are logged, so a device log answers "did the writeback shrink" (and,
 	 * against the frame line's "waiting", "by how much") without a bisect.
