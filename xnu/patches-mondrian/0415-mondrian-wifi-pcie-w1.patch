+static void wifi_log(const char *fmt, ...) __printflike(1, 2);
+
+static void
+wifi_log(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("MONDRIAN WIFI: %s\n", line);
+}
+
+static int
+wifi_fail(const char *message)
+{
+
+	wifi_log("%s", message);
+	return -1;
+}
+
+static vm_offset_t
+wifi_map_once(vm_offset_t *slot, vm_offset_t pa, vm_size_t size)
+{
+
+	if (*slot == 0) {
+		*slot = ml_io_map(pa, size);
+	}
+	return *slot;
+}
+
+static int
+wifi_wait(vm_offset_t page, uint32_t off, uint32_t mask, uint32_t value,
+    unsigned us)
+{
+	unsigned attempts = (us + 9) / 10;
+	unsigned i;
+
+	for (i = 0; i < attempts; i++) {
+		if ((mondrian_tlmm_read(page, off) & mask) == value) {
+			return 0;
+		}
+		delay(10);
+	}
+	return -1;
+}
+
+static void
+wifi_reset(vm_offset_t page, uint32_t off)
+{
+
+	mondrian_tlmm_write(page, off, mondrian_tlmm_read(page, off) | 1u);
+	delay(1000);
+	mondrian_tlmm_write(page, off, mondrian_tlmm_read(page, off) & ~1u);
+	delay(1000);
+}
+
+static uint16_t
+wifi_read16(vm_offset_t page, uint32_t off)
+{
+	uint16_t value;
+
+	value = *(volatile uint16_t *)(page + off);
+	__builtin_arm_dsb(0xf);
+	return value;
+}
+
+static void
+wifi_write16(vm_offset_t page, uint32_t off, uint16_t value)
+{
+
+	*(volatile uint16_t *)(page + off) = value;
+	__builtin_arm_dsb(0xf);
+}
+
+static uint8_t
+wifi_read8(vm_offset_t page, uint32_t off)
+{
+	uint8_t value;
+
+	value = *(volatile uint8_t *)(page + off);
+	__builtin_arm_dsb(0xf);
+	return value;
+}
+
+static void
+wifi_pin_set(vm_offset_t page, uint32_t conf, int level)
+{
+	uint32_t old = mondrian_tlmm_read(page, WIFI_TLMM_CFG);
+
+	/* Match the donor's APPS ownership claim for pads that report PRESENT. */
+	conf = (old & ~0x3ffu) | (conf & 0x3ffu);
+	if ((old & WIFI_TLMM_PRESENT) != 0) {
+		conf |= WIFI_TLMM_OWNER;
+	}
+	if (level >= 0) {
+		mondrian_tlmm_write(page, WIFI_TLMM_IN_OUT, level ? 2 : 0);
+	}
+	mondrian_tlmm_write(page, WIFI_TLMM_CFG, conf);
+	if (level >= 0) {
+		mondrian_tlmm_write(page, WIFI_TLMM_IN_OUT, level ? 2 : 0);
+	}
+}
+
+static void
+wifi_xo_set(int level)
+{
+	uint32_t old = mondrian_tlmm_read(wifi_xo_page, WIFI_TLMM_CFG);
+
+	/* GPIO204 has no DT pinctrl state; reuse the BT driver's proven output. */
+	mondrian_tlmm_output(wifi_xo_page, WIFI_TLMM_FUNC_GPIO,
+	    WIFI_TLMM_DRIVE_8MA, level);
+	if ((old & WIFI_TLMM_PRESENT) != 0) {
+		mondrian_tlmm_write(wifi_xo_page, WIFI_TLMM_CFG,
+		    mondrian_tlmm_read(wifi_xo_page, WIFI_TLMM_CFG) |
+		    WIFI_TLMM_OWNER);
+	}
+}
