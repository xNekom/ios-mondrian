xnu 0183: a power source for iOS, static for now

There is no SPMI fuel gauge on this board (the charger is on the ADSP, see
docs/MONDIAN_POWER.md), so the first step is a complete IOPMPowerSource:
installed, full, external, not charging, 5160 mAh. powerd then finds a source
and never decides the pack is empty, which an absent source does. The PMK8350
VADC read that turns it into a real percentage is the next patch.

Ported from sweet's SweetBattery.cpp (0062): same subclass, same property set,
this pack's capacity.
diff --git a/iokit/Kernel/arm/MondrianBattery.cpp b/iokit/Kernel/arm/MondrianBattery.cpp
new file mode 100644
index 0000000..165eefc
--- /dev/null
+++ b/iokit/Kernel/arm/MondrianBattery.cpp
@@ -0,0 +1,173 @@
+/*
+ * MONDRIAN BATTERY: the power source iOS sees.
+ *
+ * There is no SPMI fuel gauge on this board; the charger lives on the ADSP
+ * (docs/MONDIAN_POWER.md). This first step publishes a complete, static
+ * IOPMPowerSource — installed, full, external, not charging — so powerd finds
+ * a source and never decides the pack is empty: an absent source (or a zero
+ * percentage) is what makes it order a shutdown. The PMK8350 VADC read that
+ * turns this into a real percentage is patch 0184.
+ *
+ * Ported from sweet's SweetBattery.cpp (xnu/patches/0062): the same
+ * IOPMPowerSource subclass, the same property set powerd reads, 5160 mAh
+ * instead of sweet's 5020 because that is this pack (M11A_5160mah).
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+
+#define kMondrianBatteryCapacityMah	5160
+#define kMondrianBatteryMillivolts	4200
+
+class MondrianBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(MondrianBattery);
+
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+private:
+	void putNumber(const char *key, UInt32 value);
+	void putBool(const char *key, bool value);
+	void publish(void);
+};
+
+OSDefineMetaClassAndStructors(MondrianBattery, IOPMPowerSource);
+
+bool
+MondrianBattery::init(OSDictionary *dictionary)
+{
+	/*
+	 * IOCatalogue calls init(dictionary); this XNU's IOPMPowerSource only
+	 * overrides init(void), so run that one to allocate its PS dictionary
+	 * and symbols, then copy the matching personality into the registry.
+	 */
+	if (!IOPMPowerSource::init()) {
+		return false;
+	}
+	if (dictionary != NULL) {
+		OSCollectionIterator *iterator =
+		    OSCollectionIterator::withCollection(dictionary);
+
+		if (iterator == NULL) {
+			return false;
+		}
+		OSObject *object;
+		bool ok = true;
+
+		while ((object = iterator->getNextObject()) != NULL) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+
+			if (key == NULL || !setProperty(key,
+			    dictionary->getObject(key))) {
+				ok = false;
+				break;
+			}
+		}
+		iterator->release();
+		if (!ok) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void
+MondrianBattery::putNumber(const char *key, UInt32 value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber(value, 32);
+
+	if (symbol != NULL && number != NULL) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+MondrianBattery::putBool(const char *key, bool value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+		symbol->release();
+	}
+}
+
+void
+MondrianBattery::publish(void)
+{
+	const unsigned capacity = kMondrianBatteryCapacityMah;
+	const unsigned mv = kMondrianBatteryMillivolts;
+
+	setBatteryInstalled(true);
+	setCurrentCapacity(capacity);
+	setMaxCapacity(capacity);
+	setExternalConnected(true);
+	setExternalChargeCapable(true);
+	setIsCharging(false);
+	setAtWarnLevel(false);
+	/* Static data must never assert a critical level. */
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	setAmperage(0);
+	/* Unknown: never publish zero minutes left. */
+	setTimeRemaining(-1);
+	setCycleCount(0);
+
+	putBool("FullyCharged", true);
+	putBool("AppleRawExternalConnected", true);
+	putNumber("AppleRawCurrentCapacity", capacity);
+	putNumber("AppleRawMaxCapacity", capacity);
+	putNumber("DesignCapacity", capacity);
+	putNumber("InstantAmperage", 0);
+	/* iOS battery convention: centidegrees C; a fixed 25 C, not measured. */
+	putNumber("Temperature", 2500);
+	putBool("MondrianBatteryHardwareSampleValid", false);
+	putNumber("MondrianBatteryPercent", 100);
+
+	/* IOPMCopyBatteryInfo's per-source compatibility dictionary. */
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+
+	if (legacy != NULL) {
+		const char *keys[] = { kIOBatteryCurrentChargeKey,
+		    kIOBatteryCapacityKey, kIOBatteryVoltageKey,
+		    kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey };
+		UInt32 values[] = { capacity, capacity, mv, 0, 0,
+		    (UInt32)(kIOBatteryInstalled | kIOBatteryChargerConnect) };
+
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+
+			if (number != NULL) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+
+	/* Flush the PS properties and tell powerd on change. */
+	updateStatus();
+	IOLog("MONDRIAN BATTERY: static, 100%% %umV external=1 charging=0\n",
+	    mv);
+}
+
+bool
+MondrianBattery::start(IOService *provider)
+{
+	if (!IOPMPowerSource::start(provider)) {
+		return false;
+	}
+	/* A complete source before registerService wakes powerd. */
+	publish();
+	registerService();
+	return true;
+}
