xnu 0396: trace securityd's opens of the keychain directory

securityd never creates /private/var/Keychains/keychain-2.db on this port, and
it answers SecItemAdd with errSecNotAvailable because of it. It is the only
process that sees why, launchd gives the job /dev/null, and the loader ignores
the dylib 0394 injects (measured 2026-11-20). This logs every open under that
directory that securityd attempts, with the flags and the errno, to the console
ring; the filter keeps the rest of the system quiet.

diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -4523,7 +4523,7 @@
  * XXX Need to implement uid, gid
  */
 int
-open1(vfs_context_t ctx, struct nameidata *ndp, int uflags,
+open1_impl(vfs_context_t ctx, struct nameidata *ndp, int uflags,
     struct vnode_attr *vap, fp_initfn_t fp_init, void *initarg, int32_t *retval, int authfd)
 {
 	proc_t p = vfs_context_proc(ctx);
@@ -4823,6 +4823,65 @@
 	return error;
 }
 
+/*
+ * MONDRIAN: securityd never creates its keychain database, and it is the only
+ * process that can say why: launchd gives the job /dev/null and the loader
+ * ignores an inserted dylib (see docs/MONDIAN_WIRELESS.md). The nameidata path
+ * buffer is not filled until namei() runs inside open1_impl, so the user path
+ * is copied here. The first opens of securityd and every open of a Keychains
+ * path are logged with their result, so the console ring shows whether the
+ * database is reached at all and which errno stops its creation.
+ */
+static int
+mondrian_keychain_path(const char *path)
+{
+	const char *s;
+
+	for (s = path; *s != '\0'; s++) {
+		if (strncmp(s, "Keychain", sizeof("Keychain") - 1) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+int
+open1(vfs_context_t ctx, struct nameidata *ndp, int uflags,
+    struct vnode_attr *vap, fp_initfn_t fp_init, void *initarg, int32_t *retval,
+    int authfd)
+{
+	static int keychain_lines;
+	static int securityd_lines;
+	char path[128];
+	char *name = "?";
+	size_t copied;
+	int trace = 0;
+	int error;
+
+	if (UIO_SEG_IS_USER_SPACE(ndp->ni_segflg) &&
+	    copyinstr(ndp->ni_dirp, path, sizeof(path), &copied) == 0) {
+		proc_t p = vfs_context_proc(ctx);
+
+		if (p != PROC_NULL && proc_best_name(p) != NULL) {
+			name = proc_best_name(p);
+		}
+		if (mondrian_keychain_path(path) && keychain_lines < 32) {
+			keychain_lines++;
+			trace = 1;
+		} else if (strcmp(name, "securityd") == 0 &&
+		    securityd_lines < 32) {
+			securityd_lines++;
+			trace = 1;
+		}
+	}
+	error = open1_impl(ctx, ndp, uflags, vap, fp_init, initarg, retval, authfd);
+	if (trace) {
+		printf("MONDRIAN OPEN: %s %s flags 0x%x -> %d\n",
+		    name, path, uflags, error);
+	}
+	return error;
+}
+
 /*
  * While most of the *at syscall handlers can call nameiat() which
  * is a wrapper around namei, the use of namei and initialisation
