+/*
+ * Live vtimer PPI state: bit 0 pending, bit 1 active. The sampler prints it
+ * next to CNTV_CTL: when the compare has expired and ISTATUS reads 1, this
+ * says whether the GIC ever saw the line, which separates "the timer is not
+ * signalling" from "the GIC is not delivering it".
+ */
+uint32_t
+mondrian_gicr_vtimer_status(void)
+{
+	uint32_t pend, act;
+
+	if (mondrian_gicr_pe == 0) {
+		return 0;
+	}
+	pend = _gic_read32(mondrian_gicr_pe + GICR_ISPENDR0);
+	act = _gic_read32(mondrian_gicr_pe + GICR_ISACTIVER0);
+	return ((pend >> mondrian_vtimer_intid) & 1) |
+	    (((act >> mondrian_vtimer_intid) & 1) << 1);
+}
