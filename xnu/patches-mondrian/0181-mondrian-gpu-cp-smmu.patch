+#define GMU_GENERAL_8		GMU_OFF(0x1f9cdu)
+#define GMU_GENERAL_9		GMU_OFF(0x1f9ceu)
+#define GMU_GENERAL_10		GMU_OFF(0x1f9cfu)
+#define GMU_CM3_CFG		GMU_OFF(0x1f82du)
+#define GMU_HFI_QTBL_INFO	GMU_OFF(0x1f984u)
+#define GMU_HFI_QTBL_ADDR	GMU_OFF(0x1f985u)
+#define GMU_HFI_CTRL_INIT	GMU_OFF(0x1f986u)
+#define GMU_SYS_BUS_CONFIG	GMU_OFF(0x1f40fu)
+#define GMU_ICACHE_CONFIG	GMU_OFF(0x1f400u)
+#define GMU_DCACHE_CONFIG	GMU_OFF(0x1f401u)
+#define GMU_AHB_FENCE_RANGE_0	GMU_OFF(0x23b11u)
