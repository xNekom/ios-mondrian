+/* ------------------------------------------------------------------ */
+/* GMU SMMU + external firmware (SM8475, ArmSmmu4K/Pong layout)       */
+/* ------------------------------------------------------------------ */
+#define MONDRIAN_SMMU_SIZE	0x00040000UL
+
+#define SMMU_SID0		0x20u
+#define SMMU_SID1		0x24u
+#define SMMU_SID2		0x28u
+#define SMMU_SMR(n)		(0x800u + (n) * 4u)
+#define SMMU_S2CR(n)		(0xc00u + (n) * 4u)
+#define SMMU_SCTLR		0x00u
+#define SMMU_TCR2		0x10u
+#define SMMU_TTBR0		0x20u
+#define SMMU_TTBR1		0x28u
+#define SMMU_TCR		0x30u
+#define SMMU_MAIR0		0x38u
+#define SMMU_MAIR1		0x3cu
+#define SMMU_FSR		0x58u
+#define SMMU_TLBIASID		0x610u
+#define SMMU_TLBSYNC		0x7f0u
+#define SMMU_TLBSTATUS		0x7f4u
+
+struct mondrian_gpu_mem {
+	vm_offset_t va;
+	uint64_t pa;
+	uint32_t bytes;
+	uint64_t iova;
+};
+
+/*
+ * The bootloader keeps RBBM_SECVID_TRUST_CNTL=1 and the high words of
+ * CP_SQE_INSTR_BASE/CP_RB_BASE at 0xe000, which the non-secure kernel cannot
+ * rewrite (the high-word write is ignored and a write to TRUST_CNTL aborts).
+ * The pair therefore addresses 0xE000_0000_0000 + the low word, so the CP
+ * tables map the tagged window as well as the low one.
+ */
+#define MONDRIAN_CP_TAG		0xe00000000000ull
+
+static uint64_t
+mondrian_smmu_read64(vm_offset_t smmu, uint32_t off)
+{
+	uint64_t hi = mondrian_gpu_read(smmu, off + 4);
+	uint64_t lo = mondrian_gpu_read(smmu, off);
+
+	return (hi << 32) | lo;
+}
+
+static void
+mondrian_smmu_write64(vm_offset_t smmu, uint32_t off, uint64_t val)
+{
+	mondrian_gpu_write(smmu, off + 4, (uint32_t)(val >> 32));
+	mondrian_gpu_write(smmu, off, (uint32_t)val);
+}
+
+static int
+mondrian_gpu_mem_alloc(struct mondrian_gpu_mem *m, uint32_t bytes, uint64_t iova)
+{
+	vm_offset_t va = 0, aligned;
+	ppnum_t pn;
+
+	/*
+	 * The kernel page is 16 KiB. kmem_alloc_contig() returned a VA at a
+	 * 4 KiB offset inside the pmap page even with a 16 KiB mask, so
+	 * pmap_find_phys() gave the SMMU the page base while the CPU buffer
+	 * started at an offset; a full memset then aborted at
+	 * 0xfffffe0008026b000 (esr 0x92000010) in the CP tables. Allocate the
+	 * slack and align the VA (and therefore the PA) by hand.
+	 */
+	if (kmem_alloc_contig(kernel_map, &va, bytes + 0x3fffu, 0x3fffull, 0, 3u,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	aligned = (va + 0x3fffu) & ~(vm_offset_t)0x3fffu;
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)aligned);
+	if (pn == 0) {
+		return -1;
+	}
+	m->va = aligned;
+	m->pa = ptoa_64(pn);
+	m->bytes = bytes;
+	m->iova = iova;
+	return 0;
+}
+
+/* SQE/ring/memptr do not need physically contiguous pages: the SMMU maps
+ * each page separately. kmem_alloc returns ordinary, fully-backed pages,
+ * unlike the contiguous manager's runs (whose 4th 4 KiB aborted). */
+static int
+mondrian_gpu_mem_alloc_va(struct mondrian_gpu_mem *m, uint32_t bytes, uint64_t iova)
+{
+	vm_offset_t va = 0;
+	ppnum_t pn;
+
+	if (kmem_alloc(kernel_map, &va, bytes, KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (pn == 0) {
+		return -1;
+	}
+	m->va = va;
+	m->pa = ptoa_64(pn);
+	m->bytes = bytes;
+	m->iova = iova;
+	return 0;
+}
+
+/*
+ * ARM SMMU-500 stage-1 4 KiB long-descriptor tables. Same descriptors as
+ * Pong's ArmSmmu4K build_region(): nG|AF|valid, outer shareable, no
+ * write-back attribute (device memory for the GMU), execute/privilege bits
+ * from the permissions argument (1 read, 2 write, 4 execute, 8 privileged).
+ */
+static void
+mondrian_gpu_smmu_map(uint64_t *tables, uint64_t table_pa, uint32_t input_bits,
+    uint64_t iova, uint64_t pa, uint32_t bytes, uint32_t perms, uint32_t *next)
+{
+	unsigned levels = (input_bits - 12 + 8) / 9;
+	unsigned start = 4 - levels;
+	uint64_t attributes = (1ull << 11) | (1ull << 10) | 3ull;
+	uint64_t off;
+	unsigned level;
+
+	if (!(perms & 4u)) {
+		attributes |= 3ull << 53;
+	}
+	if (!(perms & 8u)) {
+		attributes |= 1ull << 6;
+	}
+	if (!(perms & 2u)) {
+		attributes |= 1ull << 7;
+	}
+	attributes |= 2ull << 8;
+
+	for (off = 0; off < bytes; off += 4096) {
+		uint64_t va = iova + off;
+		uint32_t table = 0;
+
+		for (level = start; level < 3; level++) {
+			unsigned shift = 39 - 9 * level;
+			unsigned width = (level == start) ? (input_bits - shift) : 9;
+			uint32_t slot = table * 512 +
+			    (uint32_t)((va >> shift) & ((1u << width) - 1));
+
+			if (tables[slot] == 0) {
+				/* Page 0 is the root; the first next-level table is
+				 * page 1. Starting at 0 made the L1 entry point at the
+				 * root itself and the walk faulted (the GMU only worked
+				 * because its leaf landed in the root's L3 slot). */
+				tables[slot] = (table_pa + 4096ull * (++(*next))) | 3ull;
+			}
+			table = (uint32_t)(((tables[slot] & 0x0000fffffffff000ull) -
+			    table_pa) / 4096);
+		}
+		tables[table * 512 + ((va >> 12) & 511)] = (pa + off) | attributes;
+	}
+}
+
+static int
+mondrian_gpu_smmu_map_va(uint64_t *tables, uint64_t table_pa, uint64_t iova,
+    vm_offset_t va, uint32_t bytes, uint32_t perms, uint32_t *next)
+{
+	uint32_t off;
+
+	for (off = 0; off < bytes; off += 4096) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(va + off));
+		uint64_t pa;
+
+		if (pn == 0) {
+			return -1;
+		}
+		pa = ptoa_64(pn) + ((va + off) & 0x3fffu);
+		mondrian_gpu_smmu_map(tables, table_pa, 32, iova + off, pa,
+		    4096, perms, next);
+	}
+	return 0;
+}
+
+static void
+mondrian_gpu_mem_flush(struct mondrian_gpu_mem *m, uint32_t bytes)
+{
+	uint32_t off;
+
+	for (off = 0; off < bytes; off += 4096) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(m->va + off));
+		uint32_t len = bytes - off < 4096 ? bytes - off : 4096;
+
+		if (pn != 0) {
+			flush_dcache64((addr64_t)(ptoa_64(pn) +
+			    ((m->va + off) & 0x3fffu)), len, TRUE);
+		}
+	}
+}
+
+/*
+ * HFI transport: queue 0 (host to GMU) and queue 1 (GMU to host) in the 16 KiB
+ * HFI buffer whose table was written before the CM3 start. Header is
+ * (sequence << 20) | (count << 8) | id; count includes the header word.
+ */
+static void
+mondrian_gpu_hfi_send(vm_offset_t gmu, vm_offset_t hfi, uint32_t id,
+    const uint32_t *payload, uint32_t words, uint32_t seq)
+{
+	volatile uint32_t *sh = (volatile uint32_t *)hfi;
+	volatile uint32_t *q = sh + 6;
+	volatile uint32_t *data = sh + 212;
+	uint32_t write = q[11];
+	uint32_t count = words + 1;
+	uint32_t padded = (count + 3) & ~3u;
+	uint32_t i;
+
+	data[write] = (seq << 20) | (count << 8) | id;
+	for (i = 0; i < words; i++) {
+		data[(write + 1 + i) & 1023] = payload[i];
+	}
+	for (i = count; i < padded; i++) {
+		data[(write + i) & 1023] = 0xfafafafau;
+	}
+	q[11] = (write + padded) & 1023;
+	__builtin_arm_dsb(0xf);
+	mondrian_gpu_write(gmu, GMU_OFF(0x1f994u), 1u);
+}
+
+/* 1 = matching response, 0 = empty, -1 = other response (printed). */
+static int
+mondrian_gpu_hfi_poll(vm_offset_t hfi, uint32_t seq, uint32_t *out, uint32_t *countp)
+{
+	volatile uint32_t *sh = (volatile uint32_t *)hfi;
+	volatile uint32_t *q = sh + 6 + 12;
+	volatile uint32_t *data = sh + 212 + 1024;
+	uint32_t read = q[10];
+	uint32_t write = q[11];
+	uint32_t header, count, i;
+
+	for (i = 0; i < 256; i++) {
+		uint32_t padded;
+
+		if (read == write) {
+			return 0;
+		}
+		header = data[read];
+		count = (header >> 8) & 255u;
+		if (count == 0 || count > 19) {
+			q[10] = (read + 1) & 1023;
+			return -1;
+		}
+		/* The GMU answers with type 1 in header[19:16] and echoes the
+		 * request sequence in the first payload word's [31:20]. The
+		 * sequence is not in the header; matching it there discarded
+		 * every response and made all HFI commands look like timeouts. */
+		if (((header >> 16) & 15u) == 1u && count >= 3 &&
+		    (((data[(read + 1) & 1023] >> 20) & 0xfffu) ==
+		    (seq & 0xfffu))) {
+			for (i = 0; i < count && i < 16; i++) {
+				out[i] = data[(read + i) & 1023];
+			}
+			*countp = count;
+			padded = (count + 3) & ~3u;
+			q[10] = (read + padded) & 1023;
+			__builtin_arm_dsb(0xf);
+			return 1;
+		}
+		padded = (count + 3) & ~3u;
+		read = (read + padded) & 1023;
+		q[10] = read;
+		__builtin_arm_dsb(0xf);
+	}
+	return 0;
+}
