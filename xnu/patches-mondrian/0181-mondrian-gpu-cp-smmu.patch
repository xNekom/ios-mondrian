+ * The gen7_reg.h GMU numbers are dword offsets from the GPU regmap base
+ * (kgsl_regmap_region.offset: "Dword offset of the region from the regmap
+ * base"), not byte offsets. GEN7_GMU_CM3_SYSRESET 0x1f800 is byte address
+ * 0x3d00000 + 0x7e000 = 0x3d7e000, i.e. offset 0x16000 in the GMU window
+ * that starts at 0x3d68000. Reading gmu+0x1f800 hit a different register and
+ * returned 0xdeafbead.
+ */
+#define GMU_OFF(w)		((w) * 4u - 0x68000u)
+#define GMU_CM3_SYSRESET	GMU_OFF(0x1f800u)
+#define GMU_CM3_BOOT_CONFIG	GMU_OFF(0x1f801u)
+#define GMU_CM3_FW_INIT_RESULT	GMU_OFF(0x1f81cu)
