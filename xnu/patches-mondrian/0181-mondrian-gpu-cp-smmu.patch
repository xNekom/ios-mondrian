+/* <machine/machine_routines.h> is the generic one in a bsd file. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+
+static uint32_t
+mondrian_gpu_read(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+mondrian_gpu_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__builtin_arm_dsb(0xf);
+}
+
+/*
+ * CP_RB_BASE and CP_SQE_INSTR_BASE are 64-bit registers (a6xx.xml
+ * reg64): the high word only latches as part of one 64-bit store. Two
+ * 32-bit stores leave the bootloader's 0xe000 in place.
+ */
+static void
+mondrian_gpu_write64(vm_offset_t base, uint32_t off, uint64_t value)
+{
+	*(volatile uint64_t *)(base + off) = value;
+	__builtin_arm_dsb(0xf);
+}
+
+/*
+ * gpupower=1: power the GPUCC CX domain, the first write of the port. The
+ * sequence is the Linux gdsc one: enable the GPUCC AHB/CXO/APB branches,
+ * clear SW_COLLAPSE in the CX GDSCR, wait 1 us and poll the hardware
+ * controller status at 0x953c bit 31 for 2 ms. CX holds the GMU; GX (the 3D
+ * core) belongs to the GMU on a7xx and is not touched here.
+ */
+/*
+ * The GPUCC hub/gmu RCGs are HW_CLK_CTRL_MODE. The vendor clk_rcg2_enable()
+ * with enable_safe_config does: force the root on with the CXO parent (/1),
+ * pulse UPDATE, drop the root (the AO owns it), and only later clk_set_rate()
+ * writes the final parent/divider while the root is off. Captured from the
+ * live vendor kernel with regmap kprobes; skipping the CXO step leaves the
+ * RCG root and the AHB branch dead.
+ */
+#define RCG_CFG_MASK	0x10371fu
+#define RCG_CFG_CXO	0x100001u	/* HW_CLK_CTRL | src 0 (CXO) | /1 */
+
+static int
+mondrian_gpu_wait(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, int us)
+{
+	int i;
+
+	for (i = 0; i < us; i++) {
+		if ((mondrian_gpu_read(base, off) & mask) == want) {
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/* Pong's branch(): enable bit 0; the delayed one (gpu_cc_ahb_clk) is not
+ * halt-polled, the rest succeed when CLK_OFF is clear or the NOC FSM is ON. */
+static void
+mondrian_gpu_branch(vm_offset_t base, uint32_t off, int delayed)
+{
+	uint32_t v;
+	int i;
+
+	mondrian_gpu_write(base, off, mondrian_gpu_read(base, off) | 1u);
+	if (delayed) {
+		delay(10);
+		return;
+	}
+	for (i = 0; i < 200; i++) {
+		v = mondrian_gpu_read(base, off);
+		if ((v & 0x80000000u) == 0 || (v & 0xf0000000u) == 0x20000000u) {
+			return;
+		}
+		delay(1);
+	}
+}
+
+static void
+mondrian_gpu_branch_cfg_ahb(vm_offset_t gcc)
+{
+	int i;
+
+	mondrian_gpu_write(gcc, GCC_GPU_CFG_AHB,
+	    mondrian_gpu_read(gcc, GCC_GPU_CFG_AHB) | 1u);
+	for (i = 0; i < 200; i++) {
+		if ((mondrian_gpu_read(gcc, GCC_GPU_CFG_AHB) & 3u) == 3u) {
+			return;
+		}
+		delay(1);
+	}
+}
+
+/*
+ * Pong's source(): force the root on, wait for the root-off status to clear,
+ * program SRC/DIV/MODE/HW in one masked write, pulse UPDATE and wait it out.
+ * The force bit stays set until every active branch below has been enabled.
+ */
+static void
+mondrian_gpu_source(vm_offset_t gpucc, uint32_t cmd, uint32_t cfg)
+{
+	uint32_t v = mondrian_gpu_read(gpucc, cmd);
+
+	if (v & 1u) {
+		printf("MONDRIAN GPU: rcg 0x%x update stuck 0x%x\n", cmd, v);
+	}
+	mondrian_gpu_write(gpucc, cmd, v | 2u);
+	(void)mondrian_gpu_wait(gpucc, cmd, 0x80000000u, 0, 500);
+	mondrian_gpu_write(gpucc, cmd + 4,
+	    (mondrian_gpu_read(gpucc, cmd + 4) & ~RCG_CFG_MASK) | cfg);
+	mondrian_gpu_write(gpucc, cmd, mondrian_gpu_read(gpucc, cmd) | 1u);
+	(void)mondrian_gpu_wait(gpucc, cmd, 1u, 0, 500);
+}
+
+/* clk_lucid_ole_pll_configure for the two Cape GPUCC PLLs (SM8475 layout).
+ * The vendor leaves them disabled in standby with RESET_N asserted; the GMU
+ * firmware owns enable/rate after HFI START. */
+static void
+mondrian_gpu_pll(vm_offset_t gpucc, uint32_t base, uint32_t l, uint32_t alpha)
+{
+	static const uint32_t offs[] = {
+		0x10, 0x14, 0x20, 0x24, 0x28, 0x1c, 0x30, 0x34, 0x38
+	};
+	static const uint32_t vals[] = {
+		0x44440000u, 0x0, 0x20485699u, 0x00182261u, 0x82aa299cu,
+		5, 3, 0x9000u, 0x34u
+	};
+	uint32_t mode = mondrian_gpu_read(gpucc, base);
+	uint32_t opmode = mondrian_gpu_read(gpucc, base + 4);
+	uint32_t i;
+
+	if ((mode & 1u) && (opmode & 1u)) {
+		return;
+	}
+	for (i = 0; i < sizeof(offs) / sizeof(offs[0]); i++) {
+		uint32_t v = vals[i];
+
+		if (i == 0) {
+			v = 0x44440000u | l;
+		} else if (i == 1) {
+			v = alpha;
+		}
+		mondrian_gpu_write(gpucc, base + offs[i], v);
+	}
+	mondrian_gpu_write(gpucc, base, mondrian_gpu_read(gpucc, base) & ~1u);
+	mondrian_gpu_write(gpucc, base + 4, 0);
+	mondrian_gpu_write(gpucc, base, mondrian_gpu_read(gpucc, base) | 4u);
+}
