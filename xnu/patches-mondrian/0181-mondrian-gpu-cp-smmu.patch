+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern uint32_t mondrian_cmd_db_addr(const char *id);
+extern const void *mondrian_cmd_db_data(const char *id, uint32_t *len);
+extern int mondrian_rpmh_write_one(uint32_t addr, uint32_t data);
+extern int mondrian_rpmh_write_batch(const uint32_t *addr, const uint32_t *data, uint32_t n);
+extern int mondrian_rpmh_rail(const char *name, uint32_t mv, uint32_t on);
