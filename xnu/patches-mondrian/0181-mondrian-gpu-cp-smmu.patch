+
+uint64_t
+mondrian_gpu_uc_memptr_iova(void)
+{
+	return mondrian_cp_memptr.iova;
+}
+
+int
+mondrian_gpu_uc_param(uint32_t param, uint64_t *value)
+{
+	uint64_t lo, hi;
+
+	if (value == NULL) {
+		return -1;
+	}
+	switch (param) {
+	case 0x01:			/* MSM_PARAM_GPU_ID */
+		*value = 730;
+		return 0;
+	case 0x02:			/* MSM_PARAM_GMEM_SIZE */
+		*value = 0x200000;
+		return 0;
+	case 0x03:			/* MSM_PARAM_CHIP_ID */
+		*value = 0x07030002;
+		return 0;
+	case 0x04:			/* MSM_PARAM_MAX_FREQ */
+		*value = 862000000;
+		return 0;
+	case 0x05:			/* MSM_PARAM_TIMESTAMP */
+		if (mondrian_uc_gpu == 0) {
+			return -1;
+		}
+		lo = mondrian_gpu_read(mondrian_uc_gpu,
+		    GEN7_CP_ALWAYS_ON_COUNTER_LO * 4u);
+		hi = mondrian_gpu_read(mondrian_uc_gpu,
+		    GEN7_CP_ALWAYS_ON_COUNTER_HI * 4u);
+		*value = lo | (hi << 32);
+		return 0;
+	case 0x06:			/* MSM_PARAM_GMEM_BASE */
+		*value = 0;
+		return 0;
+	case 0x07:			/* MSM_PARAM_PRIORITIES */
+		*value = 1;
+		return 0;
+	case 0x0e:			/* MSM_PARAM_VA_START */
+		*value = MONDRIAN_UC_IOVA_BASE;
+		return 0;
+	case 0x0f:			/* MSM_PARAM_VA_SIZE */
+		*value = MONDRIAN_UC_IOVA_END - MONDRIAN_UC_IOVA_BASE;
+		return 0;
+	default:
+		return -1;
+	}
+}
+
+uint64_t
+mondrian_gpu_uc_iova_alloc(uint64_t bytes)
+{
+	uint64_t iova;
+
+	bytes = (bytes + 0xfffull) & ~0xfffull;
+	if (bytes == 0 || mondrian_uc_iova + bytes > MONDRIAN_UC_IOVA_END) {
+		return 0;
+	}
+	iova = mondrian_uc_iova;
+	mondrian_uc_iova += bytes;
+	return iova;
+}
+
+int
+mondrian_gpu_uc_map_page(uint64_t iova, uint64_t pa, uint32_t permissions)
+{
+	if (mondrian_cp_tables.va == 0 || (iova & 0xfffull) != 0 ||
+	    (pa & 0xfffull) != 0) {
+		return -1;
+	}
+	mondrian_gpu_smmu_map((uint64_t *)mondrian_cp_tables.va,
+	    mondrian_cp_tables.pa, 32, iova, pa, 4096, permissions,
+	    &mondrian_uc_table_next);
+	return 0;
+}
+
+int
+mondrian_gpu_uc_unmap_page(uint64_t iova)
+{
+	uint64_t *t = (uint64_t *)mondrian_cp_tables.va;
+	uint64_t entry;
+	uint32_t l2, l3;
+
+	if (t == NULL || (iova & 0xfffull) != 0) {
+		return -1;
+	}
+	entry = t[(iova >> 30) & 3u];
+	if ((entry & 3ull) != 3ull) {
+		return -1;
+	}
+	l2 = (uint32_t)(((entry & 0x0000fffffffff000ull) -
+	    mondrian_cp_tables.pa) / 4096);
+	entry = t[l2 * 512 + ((iova >> 21) & 0x1ffu)];
+	if ((entry & 3ull) != 3ull) {
+		return -1;
+	}
+	l3 = (uint32_t)(((entry & 0x0000fffffffff000ull) -
+	    mondrian_cp_tables.pa) / 4096);
+	t[l3 * 512 + ((iova >> 12) & 0x1ffu)] = 0;
+	return 0;
+}
+
+int
+mondrian_gpu_uc_tables_sync(void)
+{
+	if (mondrian_cp_tables.va == 0) {
+		return -1;
+	}
+	flush_dcache64((addr64_t)mondrian_cp_tables.pa,
+	    mondrian_cp_tables.bytes, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+int
+mondrian_gpu_uc_flush(uint64_t pa, uint64_t bytes)
+{
+	if (bytes == 0) {
+		return -1;
+	}
+	flush_dcache64((addr64_t)pa, (unsigned)bytes, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+/*
+ * Close the ring. The CP fetches from the read pointer towards the write
+ * pointer and wraps at the end of the buffer, so a write pointer that jumps
+ * back to zero leaves it fetching the dwords it never saw. Fill the tail with
+ * one CP_NOP that covers it, publish the wrap and wait for the read pointer
+ * to come back to zero before anything is written at the start again.
+ */
+static int
+mondrian_uc_wrap(uint32_t *ring)
+{
+	uint32_t pad = MONDRIAN_UC_RING_DWORDS - mondrian_uc_at;
+	uint32_t i, waited;
+
+	if (pad != 0) {
+		ring[mondrian_uc_at] = mondrian_pm4_type7(0x10u, pad - 1);
+		for (i = 1; i < pad; i++) {
+			ring[mondrian_uc_at + i] = 0;
+		}
+		mondrian_gpu_mem_flush(&mondrian_cp_ring, mondrian_cp_ring.bytes);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u, 0);
+	for (waited = 0; waited < 50; waited++) {
+		if (mondrian_gpu_read(mondrian_uc_gpu,
+		    GEN7_CP_RB_RPTR * 4u) == 0) {
+			mondrian_uc_at = 0;
+			return 0;
+		}
+		delay(1000);
+	}
+	return -1;
+}
+
+int
+mondrian_gpu_uc_submit(uint64_t ib, uint32_t dwords, uint32_t *fence)
+{
+	uint32_t *ring;
+	uint32_t at, seq;
+	uint64_t slot;
+
+	if (fence == NULL) {
+		return -1;
+	}
+	*fence = 0;
+	if (!mondrian_uc_up || mondrian_cp_ring.va == 0 || dwords == 0 ||
+	    (ib & 3ull) != 0) {
+		return -1;
+	}
+	ring = (uint32_t *)mondrian_cp_ring.va;
+	if (dwords > 16 && mondrian_uc_logged < 8) {
+		mondrian_uc_logged++;
+		printf("MONDRIAN GPU: uc pre %u at 0x%x rptr 0x%x wptr 0x%x int 0x%x bv 0x%x\n",
+		    dwords, mondrian_uc_at,
+		    mondrian_gpu_read(mondrian_uc_gpu, GEN7_CP_RB_RPTR * 4u),
+		    mondrian_gpu_read(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u),
+		    mondrian_gpu_read(mondrian_uc_gpu,
+		    GEN7_CP_INTERRUPT_STATUS * 4u),
+		    ((volatile uint32_t *)mondrian_cp_memptr_view)[2]);
+		mondrian_log_flush_now();
+	}
+	at = mondrian_uc_at;
+	if (at + 13 > MONDRIAN_UC_RING_DWORDS) {
+		if (mondrian_uc_wrap(ring) != 0) {
+			return -1;
+		}
+		at = 0;
+	}
+	seq = mondrian_uc_fence + 1;
+	slot = mondrian_cp_memptr.iova + MONDRIAN_UC_FENCE_BASE +
+	    4ull * (seq % MONDRIAN_UC_FENCE_SLOTS);
+	/* kgsl brackets a submission with CP_SET_PROTECTED_MODE(0) … (1) when
+	 * the caller asks for an unprotected one; without the exit the state
+	 * stream's type-4 register writes are refused. */
+	ring[at++] = mondrian_pm4_type7(0x5fu, 1);	/* SET_PROTECTED_MODE */
+	ring[at++] = 0;
+	ring[at++] = mondrian_pm4_type7(0x3fu, 3);	/* INDIRECT_BUFFER */
+	ring[at++] = (uint32_t)ib;
+	ring[at++] = (uint32_t)(ib >> 32);
+	ring[at++] = dwords;
+	ring[at++] = mondrian_pm4_type7(0x46u, 4);	/* EVENT_WRITE */
+	ring[at++] = 0x31u | (1u << 27);		/* cache clean */
+	ring[at++] = (uint32_t)slot;
+	ring[at++] = (uint32_t)(slot >> 32);
+	ring[at++] = seq;
+	ring[at++] = mondrian_pm4_type7(0x5fu, 1);	/* SET_PROTECTED_MODE */
+	ring[at++] = 1;
+	mondrian_gpu_mem_flush(&mondrian_cp_ring, mondrian_cp_ring.bytes);
+	__asm__ volatile("dsb sy" ::: "memory");
+	mondrian_uc_fence = seq;
+	mondrian_uc_at = at;
+	mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u, at);
+	*fence = seq;
+	if (dwords > 16 && mondrian_uc_logged < 8) {
+		/* A command stream from a real driver, not the bring-up probe:
+		 * wait for its own fence here and say what the CP did with it. */
+		volatile uint32_t *view =
+		    (volatile uint32_t *)mondrian_cp_memptr_view;
+		uint32_t waited, value = 0;
+
+		for (waited = 0; waited < 300; waited++) {
+			__asm__ volatile("dsb sy" ::: "memory");
+			value = view[mondrian_uc_fence_word(seq)];
+			if ((int32_t)(value - seq) >= 0) {
+				break;
+			}
+			delay(1000);
+		}
+		mondrian_uc_logged++;
+		/* An opcode error names the packet the ucode would not take:
+		 * SQE_STAT index 0 is the ucode PC, index 1 the packet. */
+		mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_SQE_STAT_ADDR * 4u, 0);
+		{
+			uint32_t pc = mondrian_gpu_read(mondrian_uc_gpu,
+			    GEN7_CP_SQE_STAT_DATA * 4u);
+			uint32_t packet = mondrian_gpu_read(mondrian_uc_gpu,
+			    GEN7_CP_SQE_STAT_DATA * 4u);
+
+			uint32_t base = mondrian_gpu_read(mondrian_uc_gpu,
+			    GEN7_CP_IB1_BASE * 4u);
+			uint32_t rem = mondrian_gpu_read(mondrian_uc_gpu,
+			    GEN7_CP_IB1_REM_SIZE * 4u);
+
+			printf("MONDRIAN GPU: uc sqe pc 0x%x packet 0x%08x ib1 0x%x rem 0x%x ib2 0x%x rem2 0x%x\n",
+			    pc, packet, base, rem,
+			    mondrian_gpu_read(mondrian_uc_gpu,
+			    GEN7_CP_IB2_BASE * 4u),
+			    mondrian_gpu_read(mondrian_uc_gpu,
+			    GEN7_CP_IB2_REM_SIZE * 4u));
+			printf("MONDRIAN GPU: uc ib1 stopped at %u dwords\n",
+			    rem >= dwords ? 0u : dwords - rem);
+		}
+		printf("MONDRIAN GPU: uc big %u dwords fence %u done %u in %u ms int 0x%x fault 0x%x protect 0x%x fsr 0x%x\n",
+		    dwords, seq, (int32_t)(value - seq) >= 0, waited,
+		    mondrian_gpu_read(mondrian_uc_gpu,
+		    GEN7_CP_INTERRUPT_STATUS * 4u),
+		    mondrian_gpu_read(mondrian_uc_gpu, GEN7_CP_HW_FAULT * 4u),
+		    mondrian_gpu_read(mondrian_uc_gpu,
+		    GEN7_CP_PROTECT_STATUS * 4u),
+		    mondrian_gpu_read(mondrian_uc_smmu, 0x20058u));
+		mondrian_log_flush_now();
+	}
+	return 0;
+}
+
+int
+mondrian_gpu_uc_wait(uint32_t fence, uint32_t timeout_ms)
+{
+	volatile uint32_t *view = (volatile uint32_t *)mondrian_cp_memptr_view;
+	uint32_t waited = 0, limit, value;
+
+	if (view == NULL || fence == 0 || fence > mondrian_uc_fence) {
+		return -1;
+	}
+	limit = timeout_ms != 0 ? timeout_ms : 5000u;
+	for (;;) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		value = view[mondrian_uc_fence_word(fence)];
+		if ((int32_t)(value - fence) >= 0) {
+			if (mondrian_uc_logged < 10) {
+				mondrian_uc_logged++;
+				printf("MONDRIAN GPU: uc fence %u int 0x%x fault 0x%x fsr 0x%x rptr 0x%x wptr 0x%x\n",
+				    fence,
+				    mondrian_gpu_read(mondrian_uc_gpu,
+				    GEN7_CP_INTERRUPT_STATUS * 4u),
+				    mondrian_gpu_read(mondrian_uc_gpu,
+				    GEN7_CP_HW_FAULT * 4u),
+				    mondrian_gpu_read(mondrian_uc_smmu,
+				    0x20058u),
+				    mondrian_gpu_read(mondrian_uc_gpu,
+				    GEN7_CP_RB_RPTR * 4u),
+				    mondrian_gpu_read(mondrian_uc_gpu,
+				    GEN7_CP_RB_WPTR * 4u));
+				mondrian_log_flush_now();
+			}
+			return 0;
+		}
+		if (waited >= limit) {
+			return -1;
+		}
+		delay(1000);
+		waited++;
+	}
+}
+#endif
+
+int
+mondrian_gpu_probe(void)
+{
+	int on = 0, power = 0, gmuread = 0, zapread = 0, gmustart = 0, cp = 0, submit = 0;
+	vm_offset_t gpucc, gpu, gmu, smmu;
+	uint32_t cx, gx, ahb, cxo;
+
+	if (!PE_parse_boot_argn("gpu", &on, sizeof(on)) || on == 0) {
+		return 0;
+	}
+	(void)PE_parse_boot_argn("gpupower", &power, sizeof(power));
+	(void)PE_parse_boot_argn("gmuread", &gmuread, sizeof(gmuread));
+	(void)PE_parse_boot_argn("zapread", &zapread, sizeof(zapread));
+	(void)PE_parse_boot_argn("gmustart", &gmustart, sizeof(gmustart));
+	(void)PE_parse_boot_argn("gpurscc", &mondrian_gpu_rscc, sizeof(mondrian_gpu_rscc));
+	(void)PE_parse_boot_argn("gpugx", &mondrian_gpu_gx, sizeof(mondrian_gpu_gx));
+	(void)PE_parse_boot_argn("gpucp", &cp, sizeof(cp));
+	(void)PE_parse_boot_argn("gpusubmit", &submit, sizeof(submit));
+	(void)PE_parse_boot_argn("gpublind", &mondrian_cp_blind,
+	    sizeof(mondrian_cp_blind));
+	(void)PE_parse_boot_argn("gpuzap", &mondrian_cp_zap,
+	    sizeof(mondrian_cp_zap));
+	(void)PE_parse_boot_argn("gpustart", &mondrian_cp_run,
+	    sizeof(mondrian_cp_run));
+	(void)PE_parse_boot_argn("gpupm4", &mondrian_uc_pm4,
+	    sizeof(mondrian_uc_pm4));
+	(void)PE_parse_boot_argn("gpunoblit", &mondrian_uc_noblit,
+	    sizeof(mondrian_uc_noblit));
+	(void)PE_parse_boot_argn("gpunop", &mondrian_uc_nop_opcode,
+	    sizeof(mondrian_uc_nop_opcode));
+	(void)PE_parse_boot_argn("gpumode", &mondrian_uc_set_mode,
+	    sizeof(mondrian_uc_set_mode));
+	(void)PE_parse_boot_argn("gpudstate", &mondrian_uc_draw_state,
+	    sizeof(mondrian_uc_draw_state));
+	(void)PE_parse_boot_argn("gpudsaddr", &mondrian_uc_ds_addr,
+	    sizeof(mondrian_uc_ds_addr));
+	gpucc = ml_io_map(MONDRIAN_GPUCC_BASE, MONDRIAN_GPUCC_SIZE);
+	gpu = ml_io_map(MONDRIAN_GPU_BASE, MONDRIAN_GPU_SIZE);
+	gmu = ml_io_map(MONDRIAN_GMU_BASE, MONDRIAN_GMU_SIZE);
+	smmu = ml_io_map(MONDRIAN_SMMU_BASE, MONDRIAN_SMMU_SIZE);
+	if (gpucc == 0 || gpu == 0 || gmu == 0 || smmu == 0) {
+		printf("MONDRIAN GPU: map failed (gpucc 0x%lx gpu 0x%lx gmu 0x%lx smmu 0x%lx)\n",
+		    (unsigned long)gpucc, (unsigned long)gpu, (unsigned long)gmu,
+		    (unsigned long)smmu);
+		return 0;
+	}
+	if (power != 0) {
+		(void)mondrian_qmp_acd();
+		mondrian_gpu_power(gpucc);
+		mondrian_gpu_load_tcm(gmu);
+		if (gmustart != 0) {
+			mondrian_gpu_gmu_bringup(gpucc, gpu, gmu, smmu);
+		}
+		if (mondrian_gpu_gx) {
+			mondrian_gpu_gx_on(gpucc);
+		}
+		if (gmustart != 0) {
+			/*
+			 * GEN7_GMU_GFX_PWR_CLK_STATUS: bit 0 GX GDSC off, bit 1 GX
+			 * clock off, so 0 means the GMU believes both are up. The
+			 * three GPUCC branches are read raw: 0x90a8 gx_gfx3d,
+			 * 0x90bc gx_gmu, 0x90c8 gx_gfx3d_rdvm.
+			 */
+			printf("MONDRIAN GPU: gfx pwr clk 0x%x\n",
+			    mondrian_gpu_read(gmu, GMU_OFF(0x1f8d0u)));
+			printf("MONDRIAN GPU: gx clk 0x%x 0x%x 0x%x\n",
+			    mondrian_gpu_read(gpucc, 0x90a8),
+			    mondrian_gpu_read(gpucc, 0x90bc),
+			    mondrian_gpu_read(gpucc, 0x90c8));
+			mondrian_log_flush_now();
+		}
+		if (cp != 0) {
+			/* The streams are taken over in cp_start, with the GPU
+			 * powered and the CP halted, not here: a stream that
+			 * points at a disabled context stalls the bus when GX
+			 * is re-powered. */
+
+			/*
+			 * Read-only CP snapshot. With GX power and clock on the
+			 * registers are live; the byte offsets are word*4 from
+			 * PongAdrenoCpProfile.h (RBBM_STATUS 0x210, CP_RB 0x800,
+			 * CP_SQE_CNTL 0x808, CP_HW_FAULT 0x821, CP_STATUS_1 0x825,
+			 * CP_PROTECT_CNTL 0x84f, RBBM_SECVID_TSB_CNTL 0xf803).
+			 */
+			printf("MONDRIAN GPU: cp rbbm 0x%x/0x%x status1 0x%x fault 0x%x\n",
+			    mondrian_gpu_read(gpu, 0x840), mondrian_gpu_read(gpu, 0x84c),
+			    mondrian_gpu_read(gpu, 0x2094), mondrian_gpu_read(gpu, 0x2084));
+			mondrian_log_flush_now();
+			printf("MONDRIAN GPU: cp rb base 0x%x/0x%x cntl 0x%x rptr 0x%x wptr 0x%x\n",
+			    mondrian_gpu_read(gpu, 0x2000), mondrian_gpu_read(gpu, 0x2004),
+			    mondrian_gpu_read(gpu, 0x2008), mondrian_gpu_read(gpu, 0x2018),
+			    mondrian_gpu_read(gpu, 0x201c));
+			mondrian_log_flush_now();
+			printf("MONDRIAN GPU: cp sqe 0x%x protect 0x%x secvid 0x%x\n",
+			    mondrian_gpu_read(gpu, 0x2020), mondrian_gpu_read(gpu, 0x213c),
+			    mondrian_gpu_read(gpu, 0x3e00c));
+			mondrian_log_flush_now();
+			for (unsigned i = 0; i < 24; i++) {
+				uint32_t smr = mondrian_gpu_read(smmu, SMMU_SMR(i));
+				uint32_t s2cr = mondrian_gpu_read(smmu, SMMU_S2CR(i));
+				if (smr != 0 || s2cr != 0) {
+					printf("MONDRIAN GPU: smmu slot %u smr 0x%x s2cr 0x%x\n",
+					    i, smr, s2cr);
+				}
+			}
+			printf("MONDRIAN GPU: cp probe snapshot done\n");
+			mondrian_log_flush_now();
+#ifdef MONDRIAN_CP_PROFILE
+			if (submit != 0) {
+				(void)mondrian_gpu_cp_start(gpu, smmu, gpucc, gmu);
+				if (mondrian_gpu_uc_ready()) {
+					MondrianGPUStart();
+				}
+			}
+#endif
+			mondrian_log_flush_now();
+		}
+		/*
+		 * Pong releases the CX GBIF halt before any GMU access: GDSC
+		 * retention can preserve the boot firmware's halt, and every
+		 * GPU register read then returns 0xdeafbead. GEN7_GBIF_HALT is
+		 * GPU core word 0x3c45 (offset 0xf114) and is accessible with
+		 * GX still off.
+		 */
+		if (gpu != 0) {
+			printf("MONDRIAN GPU: gbif halt 0x%x\n",
+			    mondrian_gpu_read(gpu, 0xf114));
+			mondrian_gpu_write(gpu, 0xf114, 0);
+			delay(1);
+			printf("MONDRIAN GPU: gbif halt now 0x%x\n",
+			    mondrian_gpu_read(gpu, 0xf114));
+			mondrian_log_flush_now();
+		}
+	}
+	cx = mondrian_gpu_read(gpucc, GPUCC_CX_GDSCR);
+	gx = mondrian_gpu_read(gpucc, GPUCC_GX_GDSCR);
+	ahb = mondrian_gpu_read(gpucc, GPUCC_AHB_CLK);
+	cxo = mondrian_gpu_read(gpucc, GPUCC_CXO_CLK);
+	printf("MONDRIAN GPU: gpucc cx 0x%x%s gx 0x%x%s ahb 0x%x cxo 0x%x\n",
+	    cx, (cx & GDSC_PWR_ON) ? " on" : " off",
+	    gx, (gx & GDSC_PWR_ON) ? " on" : " off", ahb, cxo);
+	/*
+	 * Only read what the domain above says is up. The GPU always-on
+	 * block (RBBM) lives in GX on a7xx and the SMMU in CX; a read of a
+	 * collapsed one is exactly the class of access that wedges the NoC.
+	 */
+	if ((cx & GDSC_PWR_ON) != 0) {
+		vm_offset_t zap = ml_io_map(MONDRIAN_ZAP_BASE, MONDRIAN_ZAP_SIZE);
+
+		printf("MONDRIAN GPU: smmu idr0 0x%x idr1 0x%x idr2 0x%x\n",
+		    mondrian_gpu_read(smmu, 0x0), mondrian_gpu_read(smmu, 0x4),
+		    mondrian_gpu_read(smmu, 0x8));
+		/*
+		 * The GMU register slave sits behind gpu_cc_ahb_clk. Reading it
+		 * with the hub off returns 0xdeafbead at best and wedges the
+		 * interconnect at worst, which kills the boot thread.
+		 */
+		if (gmuread != 0 && (ahb & 1u) == 0) {
+			printf("MONDRIAN GPU: hub ahb reads 0 (delayed branch)\n");
+			mondrian_log_flush_now();
+		}
+		if (gmuread != 0) {
+			/* One register per line, flushed: if the block still hangs,
+			 * the last line names the register that did it. */
+			extern void mondrian_log_flush_now(void);
+
+			/*
+			 * Do not deassert CM3_SYSRESET here: the CM3 would
+			 * fetch from an empty ITCM and wedge the bus. The vendor
+			 * loads the GMU firmware into ITCM/DTCM first and only
+			 * then writes SYSRESET=0.
+			 */
+			printf("MONDRIAN GPU: gmu reset 0x%x\n",
+			    mondrian_gpu_read(gmu, GMU_CM3_SYSRESET));
+			mondrian_log_flush_now();
+			printf("MONDRIAN GPU: gmu init 0x%x\n",
+			    mondrian_gpu_read(gmu, GMU_CM3_FW_INIT_RESULT));
+			mondrian_log_flush_now();
+			printf("MONDRIAN GPU: gmu hfi 0x%x\n",
+			    mondrian_gpu_read(gmu, GMU_HFI_CTRL_STATUS));
+			mondrian_log_flush_now();
+			/*
+			 * GMU_GENERAL_9/10 (0x1f9ce/0x1f9cf) are unaligned
+			 * 32-bit reads and hang the bus while the GMU is off.
+			 * Leave them out until the block is clocked.
+			 */
+		}
+		if (zapread != 0 && zap != 0) {
+			printf("MONDRIAN GPU: zap %08x %08x %08x %08x\n",
+			    mondrian_gpu_read(zap, 0x0), mondrian_gpu_read(zap, 0x4),
+			    mondrian_gpu_read(zap, 0x8), mondrian_gpu_read(zap, 0xc));
+		}
+	}
+	/*
+	 * Do not read RBBM_STATUS here: GX power-on only says the GDSC is up,
+	 * the GX clock may still be off, and an unclocked GPU register read
+	 * hangs the interconnect (the boot thread is running this probe).
+	 */
+	printf("MONDRIAN GPU: probe done\n");
+	return 0;
+}
diff --git a/bsd/dev/mondrian_gpu_api.h b/bsd/dev/mondrian_gpu_api.h
new file mode 100644
index 0000000..702c53e
--- /dev/null
+++ b/bsd/dev/mondrian_gpu_api.h
@@ -0,0 +1,76 @@
+/*
+ * What the IOKit driver (iokit/Kernel/arm/MondrianGPU.cpp) asks of the GPU
+ * bring-up in mondrian_gpu.c. The C side owns the SMMU page tables, the IOVA
+ * arena, the ring and the fences; the IOKit side owns the buffers, the
+ * user/client mapping and the request decoding, so the two halves never
+ * touch each other's state directly.
+ */
+#ifndef _BSD_DEV_MONDRIAN_GPU_API_H_
+#define _BSD_DEV_MONDRIAN_GPU_API_H_
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Nonzero once the CP is running and submissions are accepted. */
+int mondrian_gpu_uc_ready(void);
+
+/* MSM_PARAM_x of Linux's msm_drm.h, filled from the live device. */
+int mondrian_gpu_uc_param(uint32_t param, uint64_t *value);
+
+/* A block of GPU addresses for buffers. Zero when the arena is exhausted. */
+uint64_t mondrian_gpu_uc_iova_alloc(uint64_t bytes);
+
+/*
+ * Stage-1 map/unmap of one 4 KiB page. Buffers a submission touches must be
+ * user accessible (permissions 3 or 7): packets executed from an indirect
+ * buffer run unprivileged and a privileged-only mapping faults them.
+ */
+int mondrian_gpu_uc_map_page(uint64_t iova, uint64_t pa, uint32_t permissions);
+int mondrian_gpu_uc_unmap_page(uint64_t iova);
+
+/* Make table changes visible to the SMMU walker. */
+int mondrian_gpu_uc_tables_sync(void);
+
+/* Write back the CPU's view of a buffer before the GPU reads it. */
+int mondrian_gpu_uc_flush(uint64_t pa, uint64_t bytes);
+
+/* One indirect command stream, fenced. Returns the fence to wait on. */
+int mondrian_gpu_uc_submit(uint64_t ib, uint32_t dwords, uint32_t *fence);
+
+/* Wait for a fence; timeout 0 means the default patience. */
+int mondrian_gpu_uc_wait(uint32_t fence, uint32_t timeout_ms);
+
+/* gpupm4=N truncates a submitted stream to N dwords, to bisect a stream the
+ * CP will not finish. Zero submits it whole. */
+uint32_t mondrian_gpu_uc_pm4_limit(void);
+
+/* gpunoblit=1 turns every CP_BLIT in a submission into a CP_NOP, to tell a
+ * packet the CP will not take from the state around it. */
+int mondrian_gpu_uc_noblit(void);
+
+/* gpunop=0xNN turns every type-7 packet with that opcode into a CP_NOP, one
+ * opcode at a time, to find the one a stream's CP will not take. */
+uint32_t mondrian_gpu_uc_nop_opcode(void);
+
+/* gpumode=N rewrites every CP_SET_MODE payload to N. */
+uint32_t mondrian_gpu_uc_set_mode(void);
+
+/* gpudstate=N keeps only the first N groups of a CP_SET_DRAW_STATE, padding
+ * the rest of the packet with a CP_NOP. Zero leaves it alone. */
+uint32_t mondrian_gpu_uc_draw_state(void);
+
+/* gpudsaddr=1 points the first draw-state group at the memptr page. */
+uint32_t mondrian_gpu_uc_ds_addr(void);
+
+/* A GPU address the CP already writes to (the memptr page), for the
+ * draw-state address experiment. */
+uint64_t mondrian_gpu_uc_memptr_iova(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BSD_DEV_MONDRIAN_GPU_API_H_ */
