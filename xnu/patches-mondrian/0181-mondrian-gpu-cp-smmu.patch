+static vm_offset_t mondrian_hfi_va;
+static uint64_t mondrian_hfi_pa, mondrian_hfi_iova;
+static uint32_t mondrian_hfi_seq = 2;
+static int mondrian_gpu_gx;   /* gpugx=1: power the GX domain */
+static int mondrian_gpu_rscc; /* gpurscc=1: Pong RSCC/PDC setup */
+
+/*
+ * The GPUCC hub clock is hardware-controlled (HW_CLK_CTRL_MODE): the AO
+ * keeps it off until the GPU rails are voted in RPMh. The cmd-db carries
+ * the ARC level table of each rail; vote MX (the parent supply), CX and the
+ * GX rail (gfx.lvl) at the highest level before any GPUCC access. The vendor
+ * votes all three (`adreno_gen7_rpmh.c`); without gfx.lvl the AO leaves the
+ * GX domain and the GPUCC hub off.
+ */
+static void
+mondrian_gpu_vote_rails(void)
+{
+	static const char *rails[] = { "mx.lvl", "cx.lvl", "mxc.lvl", "gfx.lvl" };
+	uint32_t addr[4], data[4], n = 0, r;
+
+	for (r = 0; r < sizeof(rails) / sizeof(rails[0]); r++) {
+		uint32_t len = 0;
+		uint32_t a = mondrian_cmd_db_addr(rails[r]);
+		const uint16_t *tbl = mondrian_cmd_db_data(rails[r], &len);
+		uint16_t max = 0;
+		uint32_t i;
+
+		if (a == 0 || tbl == NULL || len < 2) {
+			printf("MONDRIAN GPU: rail %s missing\n", rails[r]);
+			continue;
+		}
+		for (i = 0; i < len / 2; i++) {
+			if (tbl[i] > max) {
+				max = tbl[i];
+			}
+		}
+		/*
+		 * The GPU OPP level 0 pairs gfx 0x1a0 with cx 0x1a0
+		 * (qcom,cx-level in the live DT); the CX table's maximum
+		 * (0x1c0) is a corner the GPU table never asks for.
+		 */
+		/*
+		 * The working vendor levels (/sys/class/regulator in vendor
+		 * recovery): cx/mx 0x1a0, mxc/S2C 0x180; GPU OPP level 0 uses
+		 * 0x1a0. The table maxima (0x1c0) are corners the working rails
+		 * never ask for.
+		 */
+		if (strcmp(rails[r], "cx.lvl") == 0 ||
+		    strcmp(rails[r], "mx.lvl") == 0 ||
+		    strcmp(rails[r], "mxc.lvl") == 0) {
+			max = 0x1a0;
+		}
+		printf("MONDRIAN GPU: rail %s addr 0x%x n %u vote 0x%x\n",
+		    rails[r], a, len / 2, max);
+		addr[n] = a;
+		data[n] = max;
+		n++;
+	}
+	if (n != 0) {
+		printf("MONDRIAN GPU: rpmh batch %u\n", n);
+		(void)mondrian_rpmh_write_batch(addr, data, n);
+	}
+}
+
+/*
+ * The vendor gen7_gmu_first_boot sends the GPU ACD state to the AOP over the
+ * AOSS QMP before it touches the CX GDSC. The ABL leaves the QMP link open
+ * (MCORE link 0xffff) but the channel down; open it, then send
+ * {class: gpu, res: acd, val: 1}. The doorbell is IPCC client 0, signal 0
+ * (IPCC_REG_SEND_ID, 0x0c); the QMP IRQ is not wired here, so poll the state.
+ */
+static int
+mondrian_qmp_acd(void)
+{
+	vm_offset_t qmp = ml_io_map(MONDRIAN_QMP_BASE, MONDRIAN_QMP_SIZE);
+	vm_offset_t ipcc = ml_io_map(MONDRIAN_IPCC_BASE, MONDRIAN_IPCC_SIZE);
+	uint32_t off, i, j, n;
+	char msg[] = "{class: gpu, res: acd, val: 1}";
+
+	if (qmp == 0 || ipcc == 0) {
+		printf("MONDRIAN GPU: qmp/ipcc map failed\n");
+		return -1;
+	}
+	if (mondrian_gpu_read(qmp, 0x0) != 0x4d41494c ||
+	    mondrian_gpu_read(qmp, 0x4) != 1) {
+		printf("MONDRIAN GPU: qmp no magic (0x%x/0x%x)\n",
+		    mondrian_gpu_read(qmp, 0x0), mondrian_gpu_read(qmp, 0x4));
+		return -1;
+	}
+	off = mondrian_gpu_read(qmp, 0x38);
+	printf("MONDRIAN GPU: qmp link uc 0x%x/0x%x mc 0x%x/0x%x ch 0x%x/0x%x off 0x%x\n",
+	    mondrian_gpu_read(qmp, 0xc), mondrian_gpu_read(qmp, 0x10),
+	    mondrian_gpu_read(qmp, 0x24), mondrian_gpu_read(qmp, 0x28),
+	    mondrian_gpu_read(qmp, 0x2c), mondrian_gpu_read(qmp, 0x30), off);
+	mondrian_log_flush_now();
+	mondrian_gpu_write(qmp, 0x10, mondrian_gpu_read(qmp, 0xc));
+	mondrian_gpu_write(qmp, 0x2c, 0xffff);
+	mondrian_gpu_write(ipcc, 0xc, 0);
+	for (i = 0; i < 1000; i++) {
+		if (mondrian_gpu_read(qmp, 0x14) == 0xffff) {
+			break;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN GPU: qmp ch uc 0x%x after %u ms\n",
+	    mondrian_gpu_read(qmp, 0x14), i);
+	mondrian_log_flush_now();
+	mondrian_gpu_write(qmp, 0x18, 0xffff);
+	mondrian_gpu_write(ipcc, 0xc, 0);
+	for (i = 0; i < 1000; i++) {
+		if (mondrian_gpu_read(qmp, 0x30) == 0xffff) {
+			break;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN GPU: qmp ch ack 0x%x after %u ms\n",
+	    mondrian_gpu_read(qmp, 0x30), i);
+	mondrian_log_flush_now();
+	n = (sizeof(msg) + 3u) & ~3u;
+	for (i = 0; i < n; i += 4) {
+		uint32_t w = 0;
+
+		for (j = 0; j < 4 && i + j < sizeof(msg); j++) {
+			((uint8_t *)&w)[j] = (uint8_t)msg[i + j];
+		}
+		mondrian_gpu_write(qmp, off + 4 + i, w);
+	}
+	mondrian_gpu_write(qmp, off, n);
+	mondrian_gpu_write(ipcc, 0xc, 0);
+	for (i = 0; i < 1000; i++) {
+		if (mondrian_gpu_read(qmp, off) == 0) {
+			break;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN GPU: qmp acd len 0x%x after %u ms\n",
+	    mondrian_gpu_read(qmp, off), i);
+	mondrian_log_flush_now();
+	return 0;
+}
+
+static void
+mondrian_gpu_power(vm_offset_t gpucc)
+{
+	vm_offset_t gcc;
+	uint32_t gdscr, hw, v;
+
+	printf("MONDRIAN GPU: power enter gpucc 0x%lx\n", (unsigned long)gpucc);
+	mondrian_log_flush_now();
+	gcc = ml_io_map(MONDRIAN_GCC_BASE, MONDRIAN_GCC_SIZE);
+	printf("MONDRIAN GPU: power gcc 0x%lx\n", (unsigned long)gcc);
+	mondrian_log_flush_now();
+
+	gdscr = mondrian_gpu_read(gpucc, GPUCC_CX_GDSCR);
+	hw = mondrian_gpu_read(gpucc, GPUCC_CX_HW_CTRL);
+	printf("MONDRIAN GPU: power cx gdscr 0x%x hw 0x%x\n", gdscr, hw);
+	if ((hw & GDSC_PWR_ON) != 0) {
+		/* The probe already voted this rail up; a second RPMh vote
+		 * hangs the RSC on this port. */
+		printf("MONDRIAN GPU: power cx already on\n");
+		mondrian_log_flush_now();
+		return;
+	}
+	mondrian_gpu_vote_rails();
+	printf("MONDRIAN GPU: power vote done\n");
+	mondrian_log_flush_now();
+	delay(10);
+
+	/*
+	 * Pong's working SM8475 sequence (drivers/PongAdreno/PongAdrenoClocks.c):
+	 * CLK_DIS_WAIT=8 with SW_COLLAPSE/HW_CONTROL/SW_OVERRIDE cleared, poll
+	 * the real power status in 0x953c, set RETAIN_FF, enable the GCC
+	 * branches, program both GPUCC PLLs, write the cape probe register,
+	 * program the three RCGs with the force-enable held, enable every
+	 * active branch (including hub AON and CXO AON), and only then release
+	 * the RCG force bits.
+	 */
+	v = mondrian_gpu_read(gpucc, GPUCC_CX_GDSCR);
+	mondrian_gpu_write(gpucc, GPUCC_CX_GDSCR, (v & ~0xf007u) | 0x8000u);
+	delay(1);
+	(void)mondrian_gpu_wait(gpucc, GPUCC_CX_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON, 1000);
+	mondrian_gpu_write(gpucc, GPUCC_CX_GDSCR,
+	    mondrian_gpu_read(gpucc, GPUCC_CX_GDSCR) | 0x800u);
+	delay(2);
+	printf("MONDRIAN GPU: power cx gdscr 0x%x hw 0x%x\n",
+	    mondrian_gpu_read(gpucc, GPUCC_CX_GDSCR),
+	    mondrian_gpu_read(gpucc, GPUCC_CX_HW_CTRL));
+
+	if (gcc != 0) {
+		v = mondrian_gpu_read(gcc, GCC_GPU_GPLL0_CTRL);
+		mondrian_gpu_write(gcc, GCC_GPU_GPLL0_CTRL,
+		    v | GCC_GPU_GPLL0_BIT | GCC_GPU_GPLL0_DIV_BIT);
+		delay(10);
+		mondrian_gpu_branch_cfg_ahb(gcc);
+		mondrian_gpu_branch(gcc, GCC_GPU_MEMNOC_GFX, 0);
+		mondrian_gpu_branch(gcc, GCC_GPU_SNOC_DVM_GFX, 1);
+		printf("MONDRIAN GPU: gcc gpll0 0x%x cfgahb 0x%x memnoc 0x%x snoc 0x%x\n",
+		    mondrian_gpu_read(gcc, GCC_GPU_GPLL0_CTRL),
+		    mondrian_gpu_read(gcc, GCC_GPU_CFG_AHB),
+		    mondrian_gpu_read(gcc, GCC_GPU_MEMNOC_GFX),
+		    mondrian_gpu_read(gcc, GCC_GPU_SNOC_DVM_GFX));
+	}
+
+	mondrian_gpu_pll(gpucc, 0x0, 0x1d, 0xb000);
+	mondrian_gpu_pll(gpucc, 0x1000, 0x34, 0x1555);
+	mondrian_gpu_write(gpucc, GPUCC_CAPE_PROBE, 0);
+
+	mondrian_gpu_source(gpucc, GPUCC_GMU_CLK_SRC, 0x100602u);
+	mondrian_gpu_source(gpucc, GPUCC_HUB_CLK_SRC, 0x100603u);
+	mondrian_gpu_source(gpucc, GPUCC_XO_CLK_SRC, RCG_CFG_CXO);
+
+	mondrian_gpu_branch(gpucc, GPUCC_CXO_AON_CLK, 0);
+	mondrian_gpu_branch(gpucc, GPUCC_CXO_CLK, 0);
+	mondrian_gpu_branch(gpucc, GPUCC_HUB_AON_CLK, 0);
+	mondrian_gpu_branch(gpucc, GPUCC_CX_GMU_CLK, 0);
+	mondrian_gpu_branch(gpucc, GPUCC_HUB_CX_INT, 0);
+	mondrian_gpu_branch(gpucc, GPUCC_AHB_CLK, 1);
+	mondrian_gpu_branch(gpucc, GPUCC_HLOS1_VOTE, 0);
+
+	mondrian_gpu_write(gpucc, GPUCC_GMU_CLK_SRC,
+	    mondrian_gpu_read(gpucc, GPUCC_GMU_CLK_SRC) & ~2u);
+	mondrian_gpu_write(gpucc, GPUCC_HUB_CLK_SRC,
+	    mondrian_gpu_read(gpucc, GPUCC_HUB_CLK_SRC) & ~2u);
+	mondrian_gpu_write(gpucc, GPUCC_XO_CLK_SRC,
+	    mondrian_gpu_read(gpucc, GPUCC_XO_CLK_SRC) & ~2u);
+	delay(10);
+	printf("MONDRIAN GPU: hub cmd 0x%x cfg 0x%x ahb 0x%x gmu 0x%x aon 0x%x cxo 0x%x\n",
+	    mondrian_gpu_read(gpucc, GPUCC_HUB_CLK_SRC),
+	    mondrian_gpu_read(gpucc, GPUCC_HUB_CLK_SRC + 4),
+	    mondrian_gpu_read(gpucc, GPUCC_AHB_CLK),
+	    mondrian_gpu_read(gpucc, GPUCC_CX_GMU_CLK),
+	    mondrian_gpu_read(gpucc, GPUCC_HUB_AON_CLK),
+	    mondrian_gpu_read(gpucc, GPUCC_CXO_CLK));
+	/*
+	 * The GMU's own reset: the bootloader leaves the block asserted. The
+	 * qcom BCR asserts with bit 0 set and deasserts with it clear.
+	 */
+	printf("MONDRIAN GPU: gmu bcr 0x%x\n",
+	    mondrian_gpu_read(gpucc, GPUCC_GMU_BCR));
+	mondrian_gpu_write(gpucc, GPUCC_GMU_BCR,
+	    mondrian_gpu_read(gpucc, GPUCC_GMU_BCR) & ~1u);
+	delay(10);
+	printf("MONDRIAN GPU: gmu clk cfg 0x%x gmu 0x%x bcr 0x%x\n",
+	    mondrian_gpu_read(gpucc, GPUCC_GMU_CLK_SRC + 4),
+	    mondrian_gpu_read(gpucc, GPUCC_CX_GMU_CLK),
+	    mondrian_gpu_read(gpucc, GPUCC_GMU_BCR));
+}
+
+/*
+ * The GMU firmware is a list of {addr, len, type, value} blocks. Blocks below
+ * 0x4000 are ITCM and blocks at 0x10004000 are DTCM; the 57 KiB block at
+ * 0x4000 is external GMU memory and needs the GPU SMMU, so it is skipped
+ * here. Loading and reading back the TCM blocks proves the GMU AHB write
+ * path before the SMMU work.
+ */
+static void
+mondrian_gpu_load_tcm(vm_offset_t gmu)
+{
+#ifdef MONDRIAN_GMU_FW
+	uint32_t i, j;
+
+	for (i = 0; i < mondrian_gmu_block_count; i++) {
+		const struct mondrian_gmu_block *b = &mondrian_gmu_blocks[i];
+		uint32_t base;
+
+		if (b->addr < 0x4000u) {
+			base = GMU_OFF(0x1b400u) + b->addr;
+		} else if (b->addr >= 0x10004000u && b->addr < 0x10008000u) {
+			base = GMU_OFF(0x1c400u) + (b->addr - 0x10004000u);
+		} else {
+			printf("MONDRIAN GPU: fw block 0x%x len 0x%x needs smmu\n",
+			    b->addr, b->len);
+			continue;
+		}
+		for (j = 0; j < b->len; j += 4) {
+			uint32_t w = (uint32_t)b->data[j] |
+			    ((uint32_t)b->data[j + 1] << 8) |
+			    ((uint32_t)b->data[j + 2] << 16) |
+			    ((uint32_t)b->data[j + 3] << 24);
+
+			mondrian_gpu_write(gmu, base + j, w);
+		}
+		printf("MONDRIAN GPU: fw tcm 0x%x len 0x%x -> 0x%x\n",
+		    b->addr, b->len, base);
+	}
+	printf("MONDRIAN GPU: itcm0 0x%x want 0x%x dtcm 0x%x want 0x%x\n",
+	    mondrian_gpu_read(gmu, GMU_OFF(0x1b400u)),
+	    (uint32_t)mondrian_gmu_b0[0] | ((uint32_t)mondrian_gmu_b0[1] << 8) |
+	    ((uint32_t)mondrian_gmu_b0[2] << 16) | ((uint32_t)mondrian_gmu_b0[3] << 24),
+	    mondrian_gpu_read(gmu, GMU_OFF(0x1c400u) + 0x3f98u),
+	    (uint32_t)mondrian_gmu_b2[0] | ((uint32_t)mondrian_gmu_b2[1] << 8) |
+	    ((uint32_t)mondrian_gmu_b2[2] << 16) | ((uint32_t)mondrian_gmu_b2[3] << 24));
+	mondrian_log_flush_now();
+#else
+	printf("MONDRIAN GPU: no gmu firmware built in\n");
+#endif
+}
