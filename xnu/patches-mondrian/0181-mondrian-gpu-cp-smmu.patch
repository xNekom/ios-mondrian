+/*
+ * What the IOKit driver (iokit/Kernel/arm/MondrianGPU.cpp) asks of the GPU
+ * bring-up in mondrian_gpu.c. The C side owns the SMMU page tables, the IOVA
+ * arena, the ring and the fences; the IOKit side owns the buffers, the
+ * user/client mapping and the request decoding, so the two halves never
+ * touch each other's state directly.
+ */
+#ifndef _BSD_DEV_MONDRIAN_GPU_API_H_
+#define _BSD_DEV_MONDRIAN_GPU_API_H_
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Nonzero once the CP is running and submissions are accepted. */
+int mondrian_gpu_uc_ready(void);
+
+/* MSM_PARAM_x of Linux's msm_drm.h, filled from the live device. */
+int mondrian_gpu_uc_param(uint32_t param, uint64_t *value);
+
+/* A block of GPU addresses for buffers. Zero when the arena is exhausted. */
+uint64_t mondrian_gpu_uc_iova_alloc(uint64_t bytes);
+
+/*
+ * Stage-1 map/unmap of one 4 KiB page. Buffers a submission touches must be
+ * user accessible (permissions 3 or 7): packets executed from an indirect
+ * buffer run unprivileged and a privileged-only mapping faults them.
+ */
+int mondrian_gpu_uc_map_page(uint64_t iova, uint64_t pa, uint32_t permissions);
+int mondrian_gpu_uc_unmap_page(uint64_t iova);
+
+/* Make table changes visible to the SMMU walker. */
+int mondrian_gpu_uc_tables_sync(void);
+
+/* Write back the CPU's view of a buffer before the GPU reads it. */
+int mondrian_gpu_uc_flush(uint64_t pa, uint64_t bytes);
+
+/* One indirect command stream, fenced. Returns the fence to wait on. */
+int mondrian_gpu_uc_submit(uint64_t ib, uint32_t dwords, uint32_t *fence);
+
+/* Wait for a fence; timeout 0 means the default patience. */
+int mondrian_gpu_uc_wait(uint32_t fence, uint32_t timeout_ms);
+
+/* gpupm4=N truncates a submitted stream to N dwords, to bisect a stream the
+ * CP will not finish. Zero submits it whole. */
+uint32_t mondrian_gpu_uc_pm4_limit(void);
+
+/* gpunoblit=1 turns every CP_BLIT in a submission into a CP_NOP, to tell a
+ * packet the CP will not take from the state around it. */
+int mondrian_gpu_uc_noblit(void);
+
+/* gpunop=0xNN turns every type-7 packet with that opcode into a CP_NOP, one
+ * opcode at a time, to find the one a stream's CP will not take. */
+uint32_t mondrian_gpu_uc_nop_opcode(void);
+
+/* gpumode=N rewrites every CP_SET_MODE payload to N. */
+uint32_t mondrian_gpu_uc_set_mode(void);
+
+/* gpudstate=N keeps only the first N groups of a CP_SET_DRAW_STATE, padding
+ * the rest of the packet with a CP_NOP. Zero leaves it alone. */
+uint32_t mondrian_gpu_uc_draw_state(void);
+
+/* gpudsaddr=1 points the first draw-state group at the memptr page. */
+uint32_t mondrian_gpu_uc_ds_addr(void);
+
+/* A GPU address the CP already writes to (the memptr page), for the
+ * draw-state address experiment. */
+uint64_t mondrian_gpu_uc_memptr_iova(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BSD_DEV_MONDRIAN_GPU_API_H_ */
