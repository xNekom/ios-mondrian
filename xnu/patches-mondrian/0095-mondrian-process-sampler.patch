xnu 0095: sample the userland when it stops making progress

The boot reaches the daemons and then the console goes quiet: launchd is
waiting for something and no daemon says what. The phone has no debugger and
the daemons log nowhere readable, so a kernel thread prints, every 5 s, one
line that fits anywhere:

  SMP 134 procs | SpringBoard(71) pc=0x1aafbd12c | backboardd(69) pc=0x...

A pid of -1 means the process does not exist; the pc is its first thread's
user pc, which says whether it waits in mach_msg2_trap (an XPC), in a
semaphore, or somewhere else. Every minute it also prints the process list
and, for each wanted process, every thread's pc/lr/sp plus a frame-pointer
backtrace, with pauses so the block can be read on the phone. The names come
from boot-arg mondriansample (up to three, default
"SpringBoard,backboardd,launchd"; "-" turns it off). Same tool as sweet
0054, ported with the mondrian names.

diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -990,6 +990,81 @@
 	printf("STR done: %llu KiB scanned, %d strings\n", scanned >> 10, lines);
 	kfree_data(buf, 65536);
 }
+/*
+ * MONDRIAN process sampler (bsd/dev/mondrian_sample.c): user pc/lr/sp and a
+ * frame-pointer backtrace of every thread of a task, from the saved user
+ * state. A daemon blocked in an XPC or a syscall shows the stub in pc and its
+ * caller in lr/bt, which is the only way to see where a daemon without a
+ * debugger is stuck.
+ */
+void mondrian_sample_task(const char *name, int pid, task_t task);
+
+/* First thread's user pc: the one value worth a line in a chatty log. */
+uint64_t
+mondrian_sample_task_pc(task_t task)
+{
+	thread_t thread;
+	uint64_t pc = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+
+		if (ss != NULL && is_saved_state64(ss)) {
+			pc = get_saved_state_pc(ss);
+			break;
+		}
+	}
+	task_unlock(task);
+	return pc;
+}
+
+void
+mondrian_sample_task(const char *name, int pid, task_t task)
+{
+	vm_map_t map = get_task_map(task);
+	uint64_t slide = 0;
+	int tn = 0;
+	thread_t thread;
+	vm_shared_region_t sr = vm_shared_region_get(task);
+
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide,
+	    task->mach_header_vm_address);
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+		char line[400];
+		int n;
+		uint64_t fp;
+
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		fp = get_saved_state_fp(ss);
+		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt",
+		    name, tn++, get_saved_state_pc(ss), get_saved_state_lr(ss),
+		    get_saved_state_sp(ss));
+		for (int i = 0; i < 12 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
+
 #endif /* ARM64_BOARD_CONFIG_MONDRIAN */
 
 kern_return_t
