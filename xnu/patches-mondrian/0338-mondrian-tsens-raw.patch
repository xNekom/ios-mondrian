+/*
+ * "tsens" logs the SoC's thermal sensors raw: mainline's tsens-v2 map, one
+ * flushed line per sensor so the last one names a register that hangs.
+ */
+static void
+ud_cmd_tsens(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern void mondrian_tsens_show(void);
+
+	(void)line;
+	mondrian_tsens_show();
+	ud_cmd_send(so, to, "tsens\n", 6);
+}
