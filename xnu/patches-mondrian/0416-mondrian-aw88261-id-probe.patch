@@ -0,0 +1,498 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * MONDRIAN AUDIO PROBE: AW88261 identity over the SE15 I2C pads.
+ *
+ * This is an original, opt-in identity probe. The register number, expected
+ * value and 8-bit-register/16-bit-big-endian wire format are protocol facts
+ * from mainline Linux sound/soc/codecs/aw88261.{c,h} (GPL-2.0-only). No Linux
+ * or vendor driver code is copied here.
+ *
+ * The worker only maps TLMM pages, pulses the two active-low shutdown lines,
+ * bit-bangs the two open-drain I2C pads and reads register 0x00 at 0x34/0x35.
+ * It does not map or clock the QUP, vote a rail, touch GPIO52, start the ADSP,
+ * write an amplifier data register or open a PCM path.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stdarg.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+
+void mondrian_audio_probe_start(void);
+
+#if defined(MONDRIAN)
+
+/* osfmk/arm/machine_routines.h is not exported to the BSD layer. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t ml_get_timebase(void);
+extern void mondrian_log_flush_now(void);
+/* Present in XNU, but not declared by the BSD-visible thread header. */
+extern kern_return_t thread_terminate(thread_t thread);
+
+/* Exported by bsd/dev/mondrian_touch.c (patch 0415). */
+extern uint32_t mondrian_tlmm_read(vm_offset_t page, uint32_t off);
+extern void mondrian_tlmm_write(vm_offset_t page, uint32_t off, uint32_t value);
+extern uint32_t mondrian_tlmm_cfg(uint32_t function, uint32_t pull,
+    uint32_t drive, int output);
+
+/* dtb/mondrian-live.dtb: /soc/i2c@880000 and its two amp children. */
+#define AUDIO_I2C_SE15_PA		0x0880000UL
+#define AUDIO_I2C_SDA_GPIO		56
+#define AUDIO_I2C_SCL_GPIO		57
+#define AUDIO_AMP0_ADDR			0x34
+#define AUDIO_AMP1_ADDR			0x35
+#define AUDIO_AMP0_RESET_GPIO		1
+#define AUDIO_AMP1_RESET_GPIO		3
+#define AUDIO_SPKSW_GPIO		52
+
+/* Mainline aw88261.h: AW88261_ID_REG and enum aw88261_id. */
+#define AUDIO_AW88261_ID_REG		0x00
+#define AUDIO_AW88261_ID			0x2113U
+
+/* TLMM pin block and encoding already measured by the touch driver. */
+#define AUDIO_TLMM_BASE			0x0f100000UL
+#define AUDIO_TLMM_PAGE_SIZE		0x1000
+#define AUDIO_TLMM_CFG			0x0
+#define AUDIO_TLMM_IN_OUT		0x4
+#define AUDIO_TLMM_PULL_UP		3
+#define AUDIO_TLMM_DRIVE_2MA		0
+#define AUDIO_TLMM_DRIVE_16MA		7
+#define AUDIO_TLMM_FUNC_GPIO		0
+
+#define AUDIO_BIT_NS			5000
+#define AUDIO_SCL_STRETCH_POLLS		1000
+#define AUDIO_RESET_LOW_MS		10
+#define AUDIO_RESET_HIGH_MS		10
+
+struct audio_pins {
+	vm_offset_t sda;
+	vm_offset_t scl;
+	vm_offset_t reset0;
+	vm_offset_t reset1;
+};
+
+static uint64_t audio_timebase_hz;
+
+static void
+audio_log(const char *fmt, ...)
+{
+	va_list ap;
+
+	printf("MONDRIAN AUDIO: ");
+	va_start(ap, fmt);
+	vprintf(fmt, ap);
+	va_end(ap);
+	printf("\n");
+}
+
+static void
+audio_delay_ns(uint32_t ns)
+{
+	uint64_t ticks = ((uint64_t)ns * audio_timebase_hz + 999999999ULL) /
+	    1000000000ULL;
+	uint64_t start = mach_absolute_time();
+
+	if (ticks == 0) {
+		ticks = 1;
+	}
+	while (mach_absolute_time() - start < ticks) {
+		;
+	}
+}
+
+static int
+audio_pin_level(vm_offset_t page)
+{
+	return (int)(mondrian_tlmm_read(page, AUDIO_TLMM_IN_OUT) & 1U);
+}
+
+/* I2C is open drain: low is driven, high is released to the pad pull-up. */
+static void
+audio_pin_low(vm_offset_t page)
+{
+	mondrian_tlmm_write(page, AUDIO_TLMM_IN_OUT, 0);
+	mondrian_tlmm_write(page, AUDIO_TLMM_CFG,
+	    mondrian_tlmm_cfg(AUDIO_TLMM_FUNC_GPIO, AUDIO_TLMM_PULL_UP,
+	    AUDIO_TLMM_DRIVE_2MA, 1));
+}
+
+static void
+audio_pin_release(vm_offset_t page)
+{
+	/* Disable the output first: never actively drive an I2C high. */
+	mondrian_tlmm_write(page, AUDIO_TLMM_CFG,
+	    mondrian_tlmm_cfg(AUDIO_TLMM_FUNC_GPIO, AUDIO_TLMM_PULL_UP,
+	    AUDIO_TLMM_DRIVE_2MA, 0));
+	mondrian_tlmm_write(page, AUDIO_TLMM_IN_OUT, 2);
+}
+
+static void
+audio_reset_level(vm_offset_t page, int high)
+{
+	mondrian_tlmm_write(page, AUDIO_TLMM_IN_OUT, high ? 2 : 0);
+	mondrian_tlmm_write(page, AUDIO_TLMM_CFG,
+	    mondrian_tlmm_cfg(AUDIO_TLMM_FUNC_GPIO, 0,
+	    AUDIO_TLMM_DRIVE_16MA, 1));
+}
+
+static int
+audio_map_pins(struct audio_pins *pins)
+{
+	audio_log("SE15 0x%lx is documentary only; GPIO SDA=%u SCL=%u, "
+	    "amps 0x34/0x35, reset GPIO1/3, spksw GPIO%u untouched",
+	    (unsigned long)AUDIO_I2C_SE15_PA, AUDIO_I2C_SDA_GPIO,
+	    AUDIO_I2C_SCL_GPIO, AUDIO_SPKSW_GPIO);
+
+	audio_log("mapping TLMM 0x%lx pages for GPIO%u/%u/%u/%u",
+	    (unsigned long)AUDIO_TLMM_BASE, AUDIO_I2C_SDA_GPIO,
+	    AUDIO_I2C_SCL_GPIO, AUDIO_AMP0_RESET_GPIO,
+	    AUDIO_AMP1_RESET_GPIO);
+	pins->sda = ml_io_map(AUDIO_TLMM_BASE +
+	    0x1000UL * AUDIO_I2C_SDA_GPIO, AUDIO_TLMM_PAGE_SIZE);
+	pins->scl = ml_io_map(AUDIO_TLMM_BASE +
+	    0x1000UL * AUDIO_I2C_SCL_GPIO, AUDIO_TLMM_PAGE_SIZE);
+	pins->reset0 = ml_io_map(AUDIO_TLMM_BASE +
+	    0x1000UL * AUDIO_AMP0_RESET_GPIO, AUDIO_TLMM_PAGE_SIZE);
+	pins->reset1 = ml_io_map(AUDIO_TLMM_BASE +
+	    0x1000UL * AUDIO_AMP1_RESET_GPIO, AUDIO_TLMM_PAGE_SIZE);
+	if (pins->sda == 0 || pins->scl == 0 || pins->reset0 == 0 ||
+	    pins->reset1 == 0) {
+		audio_log("cannot map all four TLMM pages; no pad was driven");
+		return ENOMEM;
+	}
+	return 0;
+}
+
+static int
+audio_scl_high(struct audio_pins *pins)
+{
+	uint32_t i;
+
+	audio_pin_release(pins->scl);
+	for (i = 0; i < AUDIO_SCL_STRETCH_POLLS; i++) {
+		if (audio_pin_level(pins->scl)) {
+			return 0;
+		}
+		audio_delay_ns(AUDIO_BIT_NS);
+	}
+	return ETIMEDOUT;
+}
+
+static void
+audio_scl_low(struct audio_pins *pins)
+{
+	audio_pin_low(pins->scl);
+}
+
+static int
+audio_bus_idle(struct audio_pins *pins)
+{
+	audio_pin_release(pins->sda);
+	if (audio_scl_high(pins) != 0) {
+		return ETIMEDOUT;
+	}
+	audio_delay_ns(AUDIO_BIT_NS);
+	if (!audio_pin_level(pins->sda) || !audio_pin_level(pins->scl)) {
+		return EBUSY;
+	}
+	return 0;
+}
+
+static int
+audio_i2c_start(struct audio_pins *pins)
+{
+	int error = audio_bus_idle(pins);
+
+	if (error != 0) {
+		return error;
+	}
+	audio_pin_low(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	audio_scl_low(pins);
+	audio_delay_ns(AUDIO_BIT_NS);
+	return 0;
+}
+
+static int
+audio_i2c_repeated_start(struct audio_pins *pins)
+{
+	audio_pin_release(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	if (audio_scl_high(pins) != 0) {
+		return ETIMEDOUT;
+	}
+	audio_delay_ns(AUDIO_BIT_NS);
+	audio_pin_low(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	audio_scl_low(pins);
+	audio_delay_ns(AUDIO_BIT_NS);
+	return 0;
+}
+
+static int
+audio_i2c_stop(struct audio_pins *pins)
+{
+	audio_pin_low(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	if (audio_scl_high(pins) != 0) {
+		audio_pin_release(pins->sda);
+		return ETIMEDOUT;
+	}
+	audio_delay_ns(AUDIO_BIT_NS);
+	audio_pin_release(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	return audio_pin_level(pins->sda) ? 0 : EBUSY;
+}
+
+/* Returns 0 for ACK, 1 for NACK, or a negative errno for clock stretch. */
+static int
+audio_i2c_write_byte(struct audio_pins *pins, uint8_t byte)
+{
+	uint32_t bit;
+	int ack;
+
+	for (bit = 0; bit < 8; bit++) {
+		if (byte & (0x80U >> bit)) {
+			audio_pin_release(pins->sda);
+		} else {
+			audio_pin_low(pins->sda);
+		}
+		audio_delay_ns(AUDIO_BIT_NS);
+		if (audio_scl_high(pins) != 0) {
+			return -ETIMEDOUT;
+		}
+		audio_delay_ns(AUDIO_BIT_NS);
+		audio_scl_low(pins);
+		audio_delay_ns(AUDIO_BIT_NS);
+	}
+
+	audio_pin_release(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	if (audio_scl_high(pins) != 0) {
+		return -ETIMEDOUT;
+	}
+	audio_delay_ns(AUDIO_BIT_NS);
+	ack = audio_pin_level(pins->sda);
+	audio_scl_low(pins);
+	audio_delay_ns(AUDIO_BIT_NS);
+	return ack;
+}
+
+static int
+audio_i2c_read_byte(struct audio_pins *pins, uint8_t *byte, int ack)
+{
+	uint32_t bit;
+	uint8_t value = 0;
+
+	for (bit = 0; bit < 8; bit++) {
+		audio_pin_release(pins->sda);
+		audio_delay_ns(AUDIO_BIT_NS);
+		if (audio_scl_high(pins) != 0) {
+			return ETIMEDOUT;
+		}
+		audio_delay_ns(AUDIO_BIT_NS);
+		value = (uint8_t)((value << 1) | audio_pin_level(pins->sda));
+		audio_scl_low(pins);
+		audio_delay_ns(AUDIO_BIT_NS);
+	}
+
+	if (ack) {
+		audio_pin_low(pins->sda);
+	} else {
+		audio_pin_release(pins->sda);
+	}
+	audio_delay_ns(AUDIO_BIT_NS);
+	if (audio_scl_high(pins) != 0) {
+		return ETIMEDOUT;
+	}
+	audio_delay_ns(AUDIO_BIT_NS);
+	audio_scl_low(pins);
+	audio_pin_release(pins->sda);
+	audio_delay_ns(AUDIO_BIT_NS);
+	*byte = value;
+	return 0;
+}
+
+static int
+audio_read_id(struct audio_pins *pins, uint8_t addr, uint16_t *id,
+    const char **why)
+{
+	uint8_t high, low;
+	int rc, error;
+
+	*why = "bus not idle";
+	error = audio_i2c_start(pins);
+	if (error == ETIMEDOUT) {
+		*why = "clock stretch timeout";
+	} else if (error != 0) {
+		*why = "bus not idle";
+	}
+	if (error != 0) {
+		(void)audio_i2c_stop(pins);
+		return error;
+	}
+	*why = "write-address NACK";
+	rc = audio_i2c_write_byte(pins, (uint8_t)(addr << 1));
+	if (rc < 0) {
+		*why = "clock stretch timeout";
+		goto failed;
+	}
+	if (rc != 0) {
+		goto failed;
+	}
+
+	/* This is the one-byte register pointer, not a control-register write. */
+	*why = "register-pointer NACK";
+	rc = audio_i2c_write_byte(pins, AUDIO_AW88261_ID_REG);
+	if (rc < 0) {
+		*why = "clock stretch timeout";
+		goto failed;
+	}
+	if (rc != 0) {
+		goto failed;
+	}
+
+	*why = "repeated start failed";
+	if (audio_i2c_repeated_start(pins) != 0) {
+		goto failed;
+	}
+	*why = "read-address NACK";
+	rc = audio_i2c_write_byte(pins, (uint8_t)((addr << 1) | 1U));
+	if (rc < 0) {
+		*why = "clock stretch timeout";
+		goto failed;
+	}
+	if (rc != 0) {
+		goto failed;
+	}
+
+	*why = "first data byte failed";
+	if (audio_i2c_read_byte(pins, &high, 1) != 0) {
+		goto failed;
+	}
+	*why = "second data byte failed";
+	if (audio_i2c_read_byte(pins, &low, 0) != 0) {
+		goto failed;
+	}
+	*why = "STOP/bus release failed";
+	if (audio_i2c_stop(pins) != 0) {
+		goto failed;
+	}
+	*id = (uint16_t)(((uint16_t)high << 8) | low);
+	return 0;
+
+failed:
+	(void)audio_i2c_stop(pins);
+	return EIO;
+}
+
+static void __dead2
+mondrian_audio_probe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	struct audio_pins pins;
+	uint16_t id;
+	const char *why;
+	uint32_t answered = 0, matched = 0;
+	int error;
+
+	audio_timebase_hz = ml_get_timebase();
+	if (audio_timebase_hz == 0) {
+		audio_timebase_hz = 19200000;
+	}
+	if (audio_map_pins(&pins) != 0) {
+		goto done;
+	}
+
+	/* Park the bus before changing either shutdown line. */
+	audio_pin_release(pins.sda);
+	audio_pin_release(pins.scl);
+
+	/* DT active states are output-high: low is shutdown, high is run. */
+	audio_reset_level(pins.reset0, 0);
+	audio_reset_level(pins.reset1, 0);
+	delay(AUDIO_RESET_LOW_MS * 1000);
+	audio_reset_level(pins.reset0, 1);
+	audio_reset_level(pins.reset1, 1);
+	delay(AUDIO_RESET_HIGH_MS * 1000);
+	audio_log("reset GPIO1/3 low %u ms, high %u ms; reading ID register 0x%02x",
+	    AUDIO_RESET_LOW_MS, AUDIO_RESET_HIGH_MS, AUDIO_AW88261_ID_REG);
+
+	why = "bus not idle";
+	error = audio_read_id(&pins, AUDIO_AMP0_ADDR, &id, &why);
+	if (error == 0) {
+		answered++;
+		if (id == AUDIO_AW88261_ID) {
+			matched++;
+		}
+		audio_log("0x34 id 0x%04x%s", id,
+		    id == AUDIO_AW88261_ID ? " (AW88261)" : " (unexpected ID)");
+	} else {
+		audio_log("0x34 read failed: %s", why);
+	}
+
+	why = "bus not idle";
+	error = audio_read_id(&pins, AUDIO_AMP1_ADDR, &id, &why);
+	if (error == 0) {
+		answered++;
+		if (id == AUDIO_AW88261_ID) {
+			matched++;
+		}
+		audio_log("0x35 id 0x%04x%s", id,
+		    id == AUDIO_AW88261_ID ? " (AW88261)" : " (unexpected ID)");
+	} else {
+		audio_log("0x35 read failed: %s", why);
+	}
+
+	/* Leave both parts in shutdown; GPIO52 and the IRQ pads stay untouched. */
+	audio_reset_level(pins.reset0, 0);
+	audio_reset_level(pins.reset1, 0);
+	audio_pin_release(pins.sda);
+	audio_pin_release(pins.scl);
+	audio_log("done: answered %u/2, AW88261 %u/2; reset GPIO1/3 parked low, "
+	    "bus SDA=%d SCL=%d; no amp data register written",
+	    answered, matched, audio_pin_level(pins.sda), audio_pin_level(pins.scl));
+
+done:
+	mondrian_log_flush_now();
+	(void)thread_terminate(current_thread());
+	(void)thread_block(THREAD_CONTINUE_NULL);
+	__builtin_unreachable();
+}
+
+void
+mondrian_audio_probe_start(void)
+{
+	static uint32_t started;
+	thread_t thread;
+	kern_return_t kr;
+	uint32_t enabled = 0;
+
+	/* Absent, 0, or any value other than exactly 1 touches no audio hardware. */
+	if (!PE_parse_boot_argn("mondrianaudioprobe", &enabled, sizeof(enabled)) ||
+	    enabled != 1) {
+		return;
+	}
+	if (__atomic_exchange_n(&started, 1, __ATOMIC_ACQ_REL) != 0) {
+		return;
+	}
+	kr = kernel_thread_start(mondrian_audio_probe_thread, NULL, &thread);
+	if (kr != KERN_SUCCESS) {
+		__atomic_store_n(&started, 0, __ATOMIC_RELEASE);
+		audio_log("worker allocation failed kr=0x%x", kr);
+		return;
+	}
+	thread_deallocate(thread);
+	audio_log("worker started");
+}
+
+#else /* !MONDRIAN */
+
+void
+mondrian_audio_probe_start(void)
+{
+}
+
+#endif /* MONDRIAN */
