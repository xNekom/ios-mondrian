-			return EPERM;
+			return 0;
 		}
 	}
 	if (mondrian_priv_logged_count < MONDRIAN_PRIV_LOG_MAX) {
 		mondrian_priv_logged[mondrian_priv_logged_count].priv = priv;
 		strlcpy(mondrian_priv_logged[mondrian_priv_logged_count].name, name, sizeof(name));
 		mondrian_priv_logged_count++;
-		printf("MONDRIAN Sandbox: %s privilege %d denied\n", name, priv);
+		printf("MONDRIAN Sandbox: %s privilege %d granted\n", name, priv);
 	}
-	return EPERM;
+	return 0;
 }
 
