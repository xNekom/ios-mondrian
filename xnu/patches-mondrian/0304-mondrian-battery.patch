+/*
+ * The battery sample, 2 s apart and off the frame path. The old kernel ran
+ * the same two reads every 120 vsyncs from AppleCLCD::vsyncFired, where the
+ * worst case (about 100 ms of polling) is six dropped frames; here that time
+ * is spent on this thread and nowhere else. A failed sample publishes
+ * nothing and is retried on the next tick.
+ */
+static void
+mondrian_battery_thread(__unused void *arg, __unused wait_result_t wait)
+{
+	static int chan;
+	static bool last_external;
+	int ticks = MAX(hz * MONDRIAN_SPMI_BATTERY_SECS, 1);
+
+	for (;;) {
+		int mv, vbus;
+		bool external;
+
+		(void)tsleep(&chan, PZERO, "mbatt", ticks);
+		mv = mondrian_spmi_battery_mv();
+		if (mv < 1) {
+			continue;
+		}
+		vbus = mondrian_spmi_vbus_mv();
+		external = vbus > MONDRIAN_SPMI_VBUS_MV;
+		mondrian_battery_publish((uint32_t)mv, external ? 1 : 0, 0);
+		if (external != last_external) {
+			last_external = external;
+			printf("MONDRIAN BATT: vbus %d mV, external %d\n",
+			    vbus, external);
+		}
+	}
+}
