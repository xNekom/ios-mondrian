+
+/*
+ * The base class only offers setters for the keys it knows; the AppleRaw*
+ * ones that the status bar reads are arbitrary properties, so they go in
+ * through setPSProperty().
+ */
+void
+MondrianPowerSource::putNumber(const char *key, uint32_t value)
+{
+	const OSSymbol *sym = OSSymbol::withCString(key);
+	OSNumber *num = OSNumber::withNumber(value, 32);
+
+	if (sym != NULL && num != NULL) {
+		setPSProperty(sym, num);
+	}
+	if (num != NULL) {
