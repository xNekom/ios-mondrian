+/*
+ * The VADC's channel window, cached per APID like sp_write caches it: the
+ * window is 4 KiB at 0x0c500000 + apid * 0x1000 and holds the command at
+ * +0x00, the status at +0x08 and the data byte at +0x10.
+ */
+static volatile uint32_t *
+sp_chan_window(uint16_t apid)
+{
+	if (sp_chan == NULL || sp_chan_apid != apid) {
+		sp_chan = (volatile uint32_t *)ml_io_map(
+		    MONDRIAN_SPMI_CHNLS + ((uint32_t)apid << 12),
+		    MONDRIAN_SPMI_CHNLS_SIZE);
+		if (sp_chan == NULL) {
+			printf("MONDRIAN SPMI: no window for apid %u\n", apid);
+			return NULL;
+		}
+		sp_chan_apid = apid;
+	}
+	return sp_chan;
