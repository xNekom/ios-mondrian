+ * (3 for vbat, 16 for the USB divider). The divider is applied here, not
+ * written to the PMIC. Returns millivolts, or -1.
+ */
+int
+mondrian_spmi_adc_mv(uint32_t sid, uint32_t chan, uint32_t div)
+{
+	uint8_t msb = 0, lsb = 0;
+	volatile uint32_t *q;
+	uint16_t apid;
+	uint32_t st = 0, v, code;
+	unsigned retries, i;
+
+	if (sp_core == NULL || sp_cnfg == NULL || sp_obs == NULL) {
+		return -1;			/* sp_map printed its own error */
+	}
+	if (sp_count == 0) {
+		printf("MONDRIAN SPMI: no APID for the adc\n");
+		return -1;
+	}
+	apid = sp_find_apid(MONDRIAN_SPMI_VADC_PPID);
+	if (apid == 0xffffu) {
+		printf("MONDRIAN SPMI: no APID for the adc\n");
+		return -1;
+	}
+	if (sp_adc_wr(apid, 0x40, sid & 0xffu) == 0 ||	/* ADC_APP_SID */
+	    sp_adc_wr(apid, 0x42, 0) == 0 ||
+	    sp_adc_wr(apid, 0x43, 0) == 0 ||
+	    sp_adc_wr(apid, 0x44, chan & 0xffu) == 0 ||	/* the channel */
+	    sp_adc_wr(apid, 0x45, 1) == 0 ||
+	    sp_adc_wr(apid, 0x46, 0x80u) == 0 ||
+	    sp_adc_wr(apid, 0x47, 0x80u) == 0) {
+		return -1;
+	}
+	/*
+	 * One STATUS1 read is the fast path; a conversion that is not done
+	 * yet re-reads it up to 40 times, a microsecond apart, until
+	 * REQ_STS is clear with EOC set. Nothing else starts a conversion:
+	 * writes 6 and 7 do.
+	 */
+	for (retries = 0; ; ) {
+		q = (volatile uint32_t *)((char *)sp_obs +
+		    ((uint32_t)apid << (sp_obs_stride == 0x80 ? 7 : 5)));
+		q[0] = (1u << 27) | (0x08u << 4);	/* read STATUS1 */
+		__asm__ volatile("dsb osh" ::: "memory");
+		for (i = 0; i < MONDRIAN_SPMI_RETRIES; i++) {
+			st = sp_rd(q, 0x08u);
+			if (st & 1u) {
+				break;
+			}
+			delay(1);
+		}
+		if (i == MONDRIAN_SPMI_RETRIES || (st & 0x0eu) != 0) {
+			return -1;
+		}
+		v = sp_rd(q, 0x18u);
+		if (v & 0x80u) {
+			printf("MONDRIAN SPMI: adc conversion fault\n");
+			return -1;
+		}
+		if ((v & 0x3u) == 1u) {
+			break;
+		}
+		delay(1);
+		if (++retries == 40) {
+			return -1;
+		}
+	}
