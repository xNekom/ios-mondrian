+/*
+ * MONDRIAN: the battery, published as an IOPMPowerSource.
+ *
+ * The pack is 5160 mAh and the only thing the port can read is the PMK8350
+ * VADC's vbat_sns channel over SPMI (bsd/dev/mondrian_spmi.c); capacity is
+ * therefore derived from one voltage sample, and current, temperature and
+ * cycle count are constants. The curve below is the 20-point table the old
+ * kernel used, linear in between and clamped to 100 and 1.
+ *
+ * The old kernel ran the ADC read and this update inside AppleCLCD's 60 Hz
+ * vsyncFired -- on every 120th tick, i.e. every 2 s, on the thread that
+ * presents frames -- and a worst-case ADC read is about 100 ms of polling,
+ * which is six dropped frames. The sample belongs on a thread of its own:
+ * mondrian_spmi.c sleeps 2 s in mondrian_battery_thread and calls
+ * mondrian_battery_publish() here. Nothing in this file is on the frame
+ * path.
+ *
+ * The power source is created lazily on the first usable sample and attached
+ * to the display, the parent the old kernel's registry had. Attaching needs
+ * AppleCLCD registered, so a sample that arrives before the display is up
+ * publishes nothing and the next one retries.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(MONDRIAN)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+
+extern "C" IOService *mondrian_fb_service(void);
+
+#define MONDRIAN_BATT_MAH	5160u	/* the pack's design capacity */
+#define MONDRIAN_BATT_TEMP	2500u	/* no thermometer; a constant */
+
+/*
+ * Voltage to capacity, the old kernel's table: 4150 mV is full, 3450 mV the
+ * lowest point that is not empty, and anything below 3450 reads 1%. Integer
+ * division truncates, so the steps at the ends (4149 -> 99, 3449 -> 1) are
+ * the original behaviour, not rounding artefacts.
+ */
+static uint32_t
+mondrian_battery_percent(int mv)
+{
+	static const struct {
+		uint32_t mv, pct;
+	} curve[] = {
+		{ 4150, 100 }, { 4080, 95 }, { 4020, 90 }, { 3970, 85 },
+		{ 3930, 80 },  { 3900, 75 }, { 3870, 70 }, { 3840, 65 },
+		{ 3810, 60 },  { 3790, 55 }, { 3770, 50 }, { 3750, 45 },
+		{ 3730, 40 },  { 3710, 35 }, { 3690, 30 }, { 3670, 25 },
+		{ 3640, 20 },  { 3600, 15 }, { 3550, 10 }, { 3450, 5 },
+	};
+	const uint32_t n = sizeof(curve) / sizeof(curve[0]);
+	uint32_t i;
+
+	if (mv > (int)curve[0].mv - 1) {                /* 4150 and above */
+		return 100;
+	}
+	for (i = 1; i < n; i++) {
+		if (mv >= (int)curve[i].mv) {
+			break;
+		}
+	}
+	if (i == n) {                                   /* 3450 and below */
+		return 1;
+	}
+	return (uint32_t)((int)curve[i].pct +
+	    (int)((curve[i - 1].pct - curve[i].pct) * (uint32_t)(mv - curve[i].mv)) /
+	    (int)(curve[i - 1].mv - curve[i].mv));
+}
+
+class MondrianPowerSource : public IOPMPowerSource {
+	OSDeclareDefaultStructors(MondrianPowerSource);
+
+public:
+	bool init(void) APPLE_KEXT_OVERRIDE;
+	void putNumber(const char *key, uint32_t value);
+	void putBool(const char *key, bool value);
+	void updateState(uint32_t mv, bool external, bool charging);
+};
