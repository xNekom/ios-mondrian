+		return -1;
+	}
+	code = ((uint32_t)msb << 8) | lsb;
+	if (code == 0 || code == 0xffffu) {
+		return -1;
+	}
+	return (int)(((div * code * 1875u) + 14450u) / 28900u);
+}
