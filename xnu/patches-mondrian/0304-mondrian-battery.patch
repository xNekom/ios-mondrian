+	}
+	if (sym != NULL) {
+		sym->release();
+	}
+}
+
+void
+MondrianPowerSource::putBool(const char *key, bool value)
+{
+	const OSSymbol *sym = OSSymbol::withCString(key);
+
+	if (sym == NULL) {
+		return;
+	}
+	setPSProperty(sym, value ? kOSBooleanTrue : kOSBooleanFalse);
+	sym->release();
+}
+
+static void
+mondrian_legacy_number(OSDictionary *dict, const char *key, uint32_t value)
+{
+	OSNumber *num = OSNumber::withNumber(value, 32);
+
+	if (num != NULL) {
+		dict->setObject(key, num);
+		num->release();
+	}
+}
+
+/*
+ * One sample in, one published state out. Every value is derived from that
+ * sample: there is no integration, no charger and no current measurement, so
+ * IsCharging stays false and FullyCharged mirrors external power. A repeated
+ * identical sample publishes and logs nothing.
+ */
+void
+MondrianPowerSource::updateState(uint32_t mv, bool external, bool charging)
+{
+	uint32_t pct = mondrian_battery_percent((int)mv);
+	uint32_t cap = (pct * MONDRIAN_BATT_MAH + 50u) / 100u;
+	OSDictionary *info;
+
+	if (cap == currentCapacity() && mv == voltage() &&
+	    external == externalConnected() && charging == isCharging()) {
+		return;
+	}
+
+	setBatteryInstalled(true);
+	setCurrentCapacity(cap);
+	setMaxCapacity(MONDRIAN_BATT_MAH);
+	setExternalConnected(external);
+	setExternalChargeCapable(external);
+	setIsCharging(charging);
+	setAtWarnLevel(false);
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	setAmperage(0);
+	setTimeRemaining(-1);
+	setCycleCount(0);
+
+	putNumber("AppleRawCurrentCapacity", cap);
+	putNumber("AppleRawMaxCapacity", MONDRIAN_BATT_MAH);
+	putNumber("DesignCapacity", MONDRIAN_BATT_MAH);
+	putNumber("InstantAmperage", 0);
+	putNumber("Temperature", MONDRIAN_BATT_TEMP);
+	putBool("AppleRawExternalConnected", external);
+	putBool("FullyCharged", external);
+
+	/* The legacy dictionary is what iOS 16's status bar actually reads. */
+	info = OSDictionary::withCapacity(6);
+	if (info != NULL) {
+		mondrian_legacy_number(info, "Current", cap);
+		mondrian_legacy_number(info, "Capacity", MONDRIAN_BATT_MAH);
+		mondrian_legacy_number(info, "Voltage", mv);
+		mondrian_legacy_number(info, "Amperage", 0);
+		mondrian_legacy_number(info, "Cycle Count", 0);
+		mondrian_legacy_number(info, "Flags",
+		    (charging ? 2u : 0u) | (external ? 1u : 0u) | 4u);
+		setLegacyIOBatteryInfo(info);
+		info->release();
+	}
+
+	updateStatus();
+	IOLog("MONDRIAN BATT: %u mV %u%% (%u/%u mAh), external %d charging %d\n",
+	    mv, pct, cap, MONDRIAN_BATT_MAH, external, charging);
+}
+
+/*
+ * Called once per sample from the SPMI battery thread: build the power source
+ * on the first call that finds the display, then just hand the numbers over.
+ */
+extern "C" void
+mondrian_battery_publish(unsigned int mv, int external, int charging)
+{
+	static MondrianPowerSource *ps;
+	IOService *provider;
+	const char *name;
+
+	if (ps == NULL) {
+		provider = mondrian_fb_service();
+		if (provider == NULL) {
+			return;
+		}
+		ps = OSTypeAlloc(MondrianPowerSource);
+		if (ps == NULL) {
+			return;
+		}
+		if (!ps->init() || !ps->attach(provider)) {
+			ps->release();
+			ps = NULL;
+			return;
+		}
+		ps->registerService();
+		name = provider->getName();
+		IOLog("MONDRIAN BATT: power source attached to %s\n",
+		    name != NULL ? name : "?");
+	}
+	ps->updateState(mv, external != 0, charging != 0);
+}
+
