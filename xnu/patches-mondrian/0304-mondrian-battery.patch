+/* One configuration write; 1 = done, 0 = failed (the message is printed). */
+static int
+sp_adc_wr(uint16_t apid, uint32_t off, uint32_t val)
+{
+	volatile uint32_t *q = sp_chan_window(apid);
+
+	if (q == NULL) {
+		printf("MONDRIAN SPMI: adc conversion fault\n");
+		return 0;
+	}
+	q[0x10 / 4] = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+	q[0] = (off & 0xffu) << 4;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (uint32_t i = 0; i < MONDRIAN_SPMI_RETRIES; i++) {
+		uint32_t st = q[0x08 / 4];
+
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				printf("MONDRIAN SPMI: adc conversion fault\n");
+				return 0;
+			}
+			return 1;
+		}
+		delay(1);
+	}
+	printf("MONDRIAN SPMI: adc config write failed\n");
+	return 0;
