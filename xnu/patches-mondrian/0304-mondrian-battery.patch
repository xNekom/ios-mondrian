+/*
+ * One unsigned field of an "sa" line: decimal unless it is written 0x, and a
+ * leading zero is not octal. Returns the position after the field, or NULL
+ * when there is no field to read.
+ */
+static const char *
+ud_cmd_num(const char *p, uint32_t *out)
+{
+	uint32_t base = 10, v = 0;
+	bool any = false;
+
+	while (*p == ' ' || *p == '\t') {
+		p++;
+	}
+	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+		base = 16;
+		p += 2;
+	}
+	for (;; p++) {
+		uint32_t d;
+
+		if (*p >= '0' && *p <= '9') {
+			d = (uint32_t)(*p - '0');
+		} else if (base == 16 && *p >= 'a' && *p <= 'f') {
+			d = (uint32_t)(*p - 'a' + 10);
+		} else if (base == 16 && *p >= 'A' && *p <= 'F') {
+			d = (uint32_t)(*p - 'A' + 10);
+		} else {
+			break;
+		}
+		v = v * base + d;
+		any = true;
+	}
+	if (!any) {
+		return NULL;
+	}
+	*out = v;
+	return p;
+}
+
+/*
+ * "sa [SID [CHAN [DIV]]]" runs one VADC conversion: sid 3 (PM8350B), chan
+ * 0x8f (vbat_sns) and div 3 when a field is left out, so plain "sa" reads
+ * the pack. The reply is the line the old ring printed, unchanged, so a
+ * script keeps working:
+ *   sa sid 3 chan 0x38f div 3 = 4108 mV
+ * A chan over 0xff reads the same channel as its low byte (the ADC masks
+ * it), but the reply echoes what was typed.
+ */
+static void
+ud_cmd_adc(socket_t so, struct sockaddr_in *to, const char *cmd)
+{
+	uint32_t sid = 3, chan = 0x8fu, div = 3;
+	const char *p = cmd + 2;
+	char out[96];
+	int mv, n;
+
+	if ((p = ud_cmd_num(p, &sid)) != NULL &&
+	    (p = ud_cmd_num(p, &chan)) != NULL) {
+		(void)ud_cmd_num(p, &div);
+	}
+	mv = mondrian_spmi_adc_mv(sid, chan, div);
+	n = snprintf(out, sizeof(out), "sa sid %u chan 0x%03x div %u = %d mV\n",
+	    sid, chan, div, mv);
+	ud_cmd_send(so, to, out, (size_t)n);
+}
