 #define VM_SWAP_SHOULD_CREATE(cur_ts)   ((vm_num_swap_files < vm_num_swap_files_config) && ((vm_swapfile_total_segs_alloced - vm_swapfile_total_segs_used) < (unsigned int)vm_swapfile_hiwater_segs) && \

diff --git a/osfmk/vm/vm_pageout.c b/osfmk/vm/vm_pageout.c
--- a/osfmk/vm/vm_pageout.c
+++ b/osfmk/vm/vm_pageout.c
@@ -5032,6 +5032,20 @@
 	    (unsigned long long)vm_pageout_vminfo.vm_pageout_compressions,
 	    (unsigned long long)vm_pageout_vminfo.vm_compressor_pages_grabbed,
 	    (unsigned long long)vm_swap_get_failures);
+	/*
+	 * The page queues below the compressor add up to less than the window:
+	 * pages held by VM objects (the compressor's own buffers) are resident
+	 * but on no queue. These numbers close the accounting and say what the
+	 * pressure thresholds are built from.
+	 */
+	printf("MONDRIAN VMSTAT2: max %uMiB comp %uMiB avail %uMiB"
+	    " pressure %uMiB critical %uMiB wireinit %uMiB\n",
+	    (unsigned)(max_mem >> 20),
+	    (unsigned)(((uint64_t)VM_PAGE_COMPRESSOR_COUNT * 16) >> 10),
+	    (unsigned)((memorystatus_available_pages * 16) >> 10),
+	    (unsigned)((memorystatus_available_pages_pressure * 16) >> 10),
+	    (unsigned)((memorystatus_available_pages_critical * 16) >> 10),
+	    (unsigned)(((uint64_t)vm_page_wire_count_initial * 16) >> 10));
 }
 
