+/*
+ * The eUSB2 PHY is what gives the DWC3 its clock, and nothing but the
+ * bootloader's fastboot path initializes it here: on a cold boot the core's
+ * DCTL.CSftRst never self-clears, so the phone comes up with no USB. The
+ * device tree says the PHY's ref clock and reset both come from the cape GCC
+ * (clock 31, reset 21), and its registers only answer once APB access is
+ * open -- before that every read returns 0x09090909.
+ *
+ * The sequence and every tuning value are mainline's qcom init
+ * (drivers/phy/phy-snps-eusb2.c, qcom_snps_eusb2_hsphy_init).
+ */
+#define EUSB2_APB_ACCESS	0x0130		/* APB_LOGIC_RESET, bit 2 */
+#define EUSB2_CFG_CTRL_1	0x0058		/* PLL CPBIAS */
+#define EUSB2_CFG_CTRL_4	0x0068		/* PLL INT / GMP */
+#define EUSB2_CFG_CTRL_5	0x006c		/* PLL PROP / VREF */
+#define EUSB2_CFG_CTRL_6	0x0070		/* PLL VCO */
+#define EUSB2_CFG_CTRL_8	0x0078		/* tx HS vref / crossover */
+#define EUSB2_CFG_CTRL_9	0x007c		/* tx pre-emphasis / rise / impedance */
+
+static void
+eusb2_mask(vm_offset_t phy, uint32_t off, uint32_t mask, uint32_t set)
+{
+	uint32_t v = usb_rd(phy, off);
+
+	*(volatile uint32_t *)(phy + off) = (v & ~mask) | (set & mask);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	(void)usb_rd(phy, off);
+}
+
+static void
+eusb2_init(vm_offset_t phy, int div38)
+{
+	eusb2_mask(phy, EUSB2_APB_ACCESS, 0x4u, 0x4u);		/* APB access */
+	eusb2_mask(phy, EUSB2_CFG0, 0x2u, 0x2u);		/* CMN_CTRL_OVERRIDE_EN */
+	eusb2_mask(phy, EUSB2_UTMI_CTRL5, 0x2u, 0x2u);		/* POR */
+	eusb2_mask(phy, EUSB2_HS_PHY_COMMON0, 0x9u, 0x9u);	/* PHY_ENABLE|RETENABLEN */
+	eusb2_mask(phy, EUSB2_CMN_CTRL0, 0x40u, 0);		/* TESTBURNIN off */
+	eusb2_mask(phy, EUSB2_FSEL_SEL, 0x1u, 0x1u);
+	eusb2_mask(phy, EUSB2_HS_PHY_COMMON0, 0x7fu << 4, (div38 ? 4u : 0u) << 4);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_1, 0xfeu, 0);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_4, 0xfcu, 8u << 2);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_4, 0x3u, 1u);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_5, 0x1fu, 0x10u);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_6, 0x7u, 0);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_5, 0xc0u, 0x40u);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_2, 0xffu, div38 ? 0xc8u : 0x90u);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_3, 0x0fu, div38 ? 0x0u : 0x1u);
+	eusb2_mask(phy, EUSB2_HS_PHY_CTRL2, 0x10u, 0x10u);	/* VBUS_DET_EXT_SEL */
+	eusb2_mask(phy, EUSB2_CFG_CTRL_9, 0x7u, 0);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_9, 0x60u, 2u << 5);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_9, 0x18u, 1u << 3);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_8, 0x38u, 3u << 3);
+	eusb2_mask(phy, EUSB2_CFG_CTRL_8, 0xc0u, 0);
+	eusb2_mask(phy, EUSB2_HS_PHY_CTRL2, 0xcu, 0xcu);	/* SUSPEND_N_SEL|N */
+	eusb2_mask(phy, EUSB2_UTMI_CTRL0, 0x1u, 0x1u);		/* SLEEPM */
+	eusb2_mask(phy, EUSB2_HS_PHY_COMMON0, 0x2u, 0x2u);	/* SIDDQ_SEL */
+	eusb2_mask(phy, EUSB2_HS_PHY_COMMON0, 0x4u, 0);		/* SIDDQ = 0 */
+	eusb2_mask(phy, EUSB2_UTMI_CTRL5, 0x2u, 0);		/* POR = 0 */
+	eusb2_mask(phy, EUSB2_HS_PHY_CTRL2, 0x8u, 0);
+	eusb2_mask(phy, EUSB2_CFG0, 0x2u, 0);
+}
+
+/*
+ * Wait out the deadline and go to the bootloader. The reset itself is the same
+ * one the USB `reboot` order uses: the PMIC restart reason over SPMI, then
+ * PSCI, so ABL comes up in fastboot with its own USB initialized.
+ */
+static void
+mondrian_usb_fallback(__unused void *arg, __unused wait_result_t wr)
+{
+	extern void mondrian_reboot_to_fastboot(void);
+	int seconds = 0;
+
+	if (!PE_parse_boot_argn("mondrianusbfallback", &seconds, sizeof(seconds)) ||
+	    seconds <= 0) {
+		return;
+	}
+	for (int i = 0; i < seconds; i++) {
+		tsleep(&seconds, PUSER, "mondrianfb", hz);
+		if (ud_host_seen) {
+			printf("MONDR USBFALLBACK: host seen, watchdog stands down\n");
+			return;
+		}
+	}
+	printf("MONDR USBFALLBACK: no USB after %d s, resetting to fastboot\n", seconds);
+	mondrian_reboot_to_fastboot();
+}
