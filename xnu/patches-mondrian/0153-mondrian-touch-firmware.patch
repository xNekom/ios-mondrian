+/* brl_reset: 2 ms low, then brl_reset(delay=100)'s wait. The update entry
+ * resets with this, not with the 15 ms power-on pulse. */
 static void
+mondrian_touch_update_reset(void)
+{
+	mondrian_tlmm_output(mondrian_touch_reset_page, 0, MONDRIAN_TLMM_DRIVE_8MA, 0);
+	delay(2000);
+	mondrian_tlmm_output(mondrian_touch_reset_page, 0, MONDRIAN_TLMM_DRIVE_8MA, 1);
+	delay(100000);
+}
+
+static void
 mondrian_touch_reset_pulse(void)
 {
 	/* A reset pulse restarts the part's ROM: with IOVDD and AVDD up there is
@@ -1061,12 +1355,16 @@
