+/*
+ * Read the blob area in front of the log ring. Returns the bytes copied;
+ * callers tell a missing blob from a short read by the length they asked for.
+ */
+uint32_t
+mondrian_reserved_read(void *dst, uint32_t bytes)
+{
+	uint64_t lba = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS - MONDRIAN_FW_BLOCKS;
+	uint8_t *out = dst;
+	uint32_t done = 0;
+
+	if (bytes > MONDRIAN_FW_BLOCKS * UFS_BLOCK) {
+		bytes = MONDRIAN_FW_BLOCKS * UFS_BLOCK;
 	}
+	while (done < bytes) {
+		uint32_t chunk = MIN(bytes - done, BOUNCE_SIZE);
+
+		if (ufs_read_blocks(lba + done / UFS_BLOCK, chunk / UFS_BLOCK) != 0) {
+			break;
+		}
+		memcpy(out + done, (const void *)(su.dma + DMA_BOUNCE), chunk);
+		done += chunk;
+	}
+	return done;
 }
 
