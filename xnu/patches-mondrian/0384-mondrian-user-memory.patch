 /*
+ * Pages of this process as a GPU buffer (0x7d): what Turnip's host-pointer
+ * import needs when the address is an IOSurface's and the kernel's surface
+ * table is not what named it. withAddressRange() with the calling task refuses
+ * a range the process does not own, prepare() wires it, and the buffer's own
+ * free completes it, so the pages stay wired exactly while the GPU may read
+ * them. The rest is the surface path: one IOVA, page by page.
+ */
+IOReturn
+MondrianGPUUserClient::userMemory(struct mondrian_user_memory *request)
+{
+	IOMemoryDescriptor *memory;
+	mondrian_buffer *buffer;
+
+	if (request->address == 0 || request->size == 0 ||
+	    request->size > kMondrianBufferMax) {
+		return kIOReturnBadArgument;
+	}
+	/* OSPtr here is the pointer itself: withAddressRange() hands back one
+	 * reference, and bufferAdopt() takes its own. */
+	memory = IOMemoryDescriptor::withAddressRange(request->address,
+	    request->size, kIODirectionInOut, current_task());
+	if (memory == nullptr) {
+		return kIOReturnBadArgument;
+	}
+	if (memory->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(fLock);
+	buffer = bufferAdopt(memory, request->size);
+	IOLockUnlock(fLock);
+	if (buffer == nullptr) {
+		memory->complete(kIODirectionInOut);
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	memory->release();
+	buffer->prepared = true;
+	request->handle = buffer->handle;
+	return kIOReturnSuccess;
+}
