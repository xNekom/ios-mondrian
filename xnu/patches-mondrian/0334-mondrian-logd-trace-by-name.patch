+	/*
+	 * The reply to the bootstrap-shaped request: bytes are what say whether it
+	 * carries a port right (a service that exists) or an error code.
+	 */
+	if (id == 1100) {
+		mach_msg_user_header_t hdr;
+		mach_msg_size_t len;
+
+		if (copyin((user_addr_t)msg_addr, &hdr, sizeof(hdr)) == 0) {
+			len = hdr.msgh_size;
+			if (len > sizeof(mondrian_lookup_hex)) {
+				len = sizeof(mondrian_lookup_hex);
+			}
+			if (len != 0 &&
+			    copyin((user_addr_t)msg_addr, mondrian_lookup_hex,
+			    len) == 0) {
+				mondrian_lookup_hex_len = (int)len;
+				mondrian_lookup_kind = 1;
+				mondrian_lookup_seq++;
+			}
+		}
+	}
 }
 
