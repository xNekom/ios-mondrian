+/*
+ * mondrian: the service name a bootstrap request carries.
+ *
+ * backboardd's container query never returns and all the ring shows is a
+ * request with msgh id 1000 and its reply, so the request itself is copied
+ * here: the body is the service name (or, for a complex message, whatever
+ * precedes the descriptors), and the sampler prints it outside the trap. That
+ * is what separates an unregistered service from one that is registered and
+ * never answers.
+ */
+char mondrian_lookup_name[80];
+unsigned char mondrian_lookup_hex[48];
+int mondrian_lookup_hex_len;
+int mondrian_lookup_kind;
+volatile int mondrian_lookup_seq;
+int mondrian_lookup_pid;
+int mondrian_lookup_bits;
+int mondrian_lookup_size;
+
+static void
+mondrian_msgtrace_lookup(mach_vm_address_t msg_addr, mach_msg_size_t size,
+    mach_msg_user_header_t *header)
+{
+	mach_msg_size_t body;
+	char name[80];
+	int pid = proc_pid(current_proc());
+	int i;
+
+	if (header->msgh_id != 1000 || !mondrian_msgtrace_wanted(pid)) {
+		return;
+	}
+	memset(name, 0, sizeof(name));
+	body = size > sizeof(*header) ? size - sizeof(*header) : 0;
+	if (body >= sizeof(name)) {
+		body = sizeof(name) - 1;
+	}
+	if (body != 0 &&
+	    copyin((user_addr_t)(msg_addr + sizeof(*header)), name, body) != 0) {
+		strlcpy(name, "copyin failed", sizeof(name));
+	}
+	for (i = 0; i < (int)sizeof(name); i++) {
+		if (name[i] == 0) {
+			break;
+		}
+		if ((unsigned char)name[i] < 0x20 ||
+		    (unsigned char)name[i] > 0x7e) {
+			name[i] = '.';
+		}
+	}
+	memcpy(mondrian_lookup_name, name, sizeof(mondrian_lookup_name));
+	{
+		mach_msg_size_t len = size > sizeof(mondrian_lookup_hex) ?
+		    sizeof(mondrian_lookup_hex) : size;
+
+		if (copyin((user_addr_t)msg_addr, mondrian_lookup_hex, len) == 0) {
+			mondrian_lookup_hex_len = (int)len;
+			mondrian_lookup_kind = 0;
+		}
+	}
+	mondrian_lookup_pid = pid;
+	mondrian_lookup_bits = (int)header->msgh_bits;
+	mondrian_lookup_size = (int)size;
+	mondrian_lookup_seq++;
+}
+
 static void
 mondrian_msgtrace_send(mach_msg_user_header_t *header)
 {
@@ -1244,6 +1312,28 @@
