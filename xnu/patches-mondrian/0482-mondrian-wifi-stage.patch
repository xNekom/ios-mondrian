+/*
+ * The stage counter is the one Wi-Fi state that can be read without touching
+ * MMIO: the ring loses lines and a BAR read on a collapsed device hangs the
+ * command thread (measured 2026-11-26). `wifistage` reports it over USB.
+ */
+static volatile uint32_t wifi_stage;
+static volatile uint32_t wifi_seen_status;
+static volatile uint32_t wifi_seen_errcode;
+static volatile uint32_t wifi_seen_execenv;
+
+#define WIFI_STAGE(n)	do { wifi_stage = (n); } while (0)
+
 static vm_offset_t
 wifi_map_once(vm_offset_t *slot, vm_offset_t pa, vm_size_t size)
 {
@@ -1695,6 +1707,7 @@ mondrian_wifi_load_amss(void)
