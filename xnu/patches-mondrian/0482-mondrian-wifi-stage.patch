         iova, image_size, got, intvec, rc);
     mondrian_log_flush_now();
@@ -1969,6 +1985,9 @@ mondrian_wifi_load_amss(void)
     }
     wifi_log("W6 BHI status=0x%x errcode=0x%x polls=%u", status, errcode,
         i);
+    wifi_seen_status = status;
+    wifi_seen_errcode = errcode;
+    WIFI_STAGE(18);
     {
         uint32_t cookie = 0, warm = 0, cause = 0;
 
@@ -2116,23 +2135,50 @@ mondrian_wifi_set_sbl(uint32_t size)
 int
 mondrian_wifi_stat(void)
 {
-    uint32_t bhioff = 0, status = 0, execenv = 0, mhistatus = 0;
-    uint32_t mhictrl = 0;
+    uint32_t bhioff = 0, status = wifi_seen_status;
+    uint32_t execenv = wifi_seen_execenv, mhistatus = 0, mhictrl = 0;
 
-    if (wifi_bar == 0) {
-        wifi_log("W7 stat BAR not mapped");
+    /*
+     * Reading BAR0+0x28 with the link down or the rails off wedges the AHB
+     * and, with it, the command thread (measured 2026-11-26: `wifistat` got no
+     * answer and the following reset could not reach fastboot). Only touch
+     * MMIO once the worker has mapped the host windows (stage 9).
+     */
+    if (wifi_bar != 0 && wifi_stage >= 9) {
+        (void)mondrian_mmio_try_rd32(wifi_bar + 0x28, &bhioff);
+        (void)mondrian_mmio_try_rd32(wifi_bar + 0x38, &mhictrl);
+        (void)mondrian_mmio_try_rd32(wifi_bar + 0x48, &mhistatus);
+        if (bhioff != 0 && bhioff <= WIFI_BAR_MAP - 0x50) {
+            (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x2c, &status);
+            (void)mondrian_mmio_try_rd32(wifi_bar + bhioff + 0x28, &execenv);
+            wifi_seen_status = status;
+            wifi_seen_execenv = execenv;
+        }
+    }
+    wifi_log("W7 stat stage=%u sbl=0x%x mhictrl=0x%x mhistatus=0x%x "
+        "bhi_status=0x%x execenv=0x%x", wifi_stage, wifi_sbl_size, mhictrl,
+        mhistatus, status, execenv);
+    return 0;
+}
