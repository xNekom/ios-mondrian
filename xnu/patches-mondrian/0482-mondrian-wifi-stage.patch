         bhioff == 0) {
@@ -1758,6 +1771,8 @@ mondrian_wifi_load_amss(void)
         msi_page = *(volatile uint32_t *)(buf + W6_MSI_OFF);
         wifi_log("W6 post-reset execenv=0x%x intvec=0x%x status=0x%x"
