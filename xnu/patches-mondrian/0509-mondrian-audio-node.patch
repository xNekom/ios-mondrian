+
+/*
+ * Kill every process with this name. `kill PID` is useless for a daemon whose
+ * PID is not in the ring (`kill mediaserverd` is `kill 0`, which answers 3 and
+ * kills nothing), and launchd restarts it at once, which is what makes a
+ * newly installed HAL plug-in load. proc_iterate avoids holding proc_list_lock
+ * across psignal(), which wedged the command thread.
+ */
+struct ud_killname_arg {
+	const char *name;
+	unsigned killed;
+};
+
+static int
+ud_killname_one(proc_t p, void *arg)
+{
+	struct ud_killname_arg *ka = (struct ud_killname_arg *)arg;
+	char *pn = proc_best_name(p);
+
+	if (pn != NULL && strcmp(pn, ka->name) == 0) {
+		psignal(p, SIGKILL);
+		ka->killed++;
+	}
+	return 0;
+}
+
+static void
+ud_cmd_killname(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	struct ud_killname_arg ka;
+	char out[128];
+	int n;
+
+	ka.name = line + 9;
+	ka.killed = 0;
+	while (*ka.name == ' ')
+		ka.name++;
+	if (*ka.name == '\0') {
+		ud_cmd_send(so, to, "killname: no name\n", 19);
+		return;
+	}
+	proc_iterate(PROC_ALLPROCLIST, ud_killname_one, &ka, NULL, NULL);
+	n = snprintf(out, sizeof(out), "killname %s -> %u\n", ka.name, ka.killed);
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("MONDR USB: %s", out);
+}
+
