+/*
+ * /dev/mondrian-audio: the HAL plug-in's end of the same ring.
+ *
+ * MondrianAudio.driver (in mediaserverd) writes what iOS mixed for its
+ * "Speaker" device here: S16LE, two channels, 48000 frames a second, whole
+ * frames only. The writer is the audio server's real-time thread, so the call
+ * never blocks: what does not fit in the ring is dropped and counted, exactly
+ * as the other working ports do it (/dev/redwood-audio, /dev/negroni-audio).
+ *
+ * This is preferred over `kern.mondrian_audio` because the server is
+ * sandboxed and a character device is what those ports open from inside it.
+ * The sysctl stays as the diagnostic and test channel.
+ */
+
+#define MONDRIAN_AUDIO_DEVICE	"mondrian-audio"
+#define MONDRIAN_AUDIO_FRAME	4	/* bytes: S16LE left, right */
+
+struct mondrian_audio_volume {
+	uint32_t below;			/* 1/8 dB below the maximum */
+	uint32_t muted;
+};
+
+struct mondrian_audio_stats {
+	uint64_t frames_in;
+	uint64_t frames_dropped;
+	uint64_t frames_played;
+	uint32_t state;
+	uint32_t peak_in;
+	uint32_t peak_out;
+	uint32_t limiter_gain_q15;
+};
+
+#define MONDRIAN_AUDIO_SET_VOLUME _IOW('m', 1, struct mondrian_audio_volume)
+#define MONDRIAN_AUDIO_GET_STATS _IOR('m', 2, struct mondrian_audio_stats)
+#define MONDRIAN_AUDIO_SET_ROUTE _IOW('m', 3, uint32_t)
+/* A line from the plug-in: mediaserverd's stderr never reaches the ring. */
+#define MONDRIAN_AUDIO_LOG _IOW('m', 4, char[128])
+
+static uint64_t mas_frames_in, mas_frames_dropped;
+static uint32_t mas_write_calls;
+static uint32_t mas_peak_in;
+static int mas_major = -1;
+
+static int
+mas_dev_open(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *p)
+{
+	mondrian_audio_pcm_init();
+	lck_mtx_lock(mas_lock);
+	mas_open = 1;
+	mas_head = mas_tail = 0;
+	mas_underruns = 0;
+	mas_frames_in = mas_frames_dropped = 0;
+	mas_peak_in = 0;
+	lck_mtx_unlock(mas_lock);
+	wakeup(&mas_state);
+	adsp_log("audio node opened");
+	return 0;
+}
+
+static int
+mas_dev_close(__unused dev_t dev, __unused int flags,
+    __unused int devtype, __unused struct proc *p)
+{
+	mondrian_audio_pcm_client_done();
+	wakeup(&mas_state);
+	adsp_log("audio node closed");
+	return 0;
+}
+
+/*
+ * S16LE stereo in, S32LE stereo in the ring: the graph's converter expects
+ * 32-bit slots, and this is the one conversion the HAL does not do.
+ */
+static int
+mas_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t in[256 * 2];
+	int32_t out[256 * 2];
+	int error = 0;
+
+	while (uio_resid(uio) >= MONDRIAN_AUDIO_FRAME) {
+		user_ssize_t want = uio_resid(uio);
+		uint32_t frames, i, taken, bytes;
+
+		if (want > (user_ssize_t)sizeof(in)) {
+			want = (user_ssize_t)sizeof(in);
+		}
+		want &= ~(user_ssize_t)(MONDRIAN_AUDIO_FRAME - 1);
+		if ((error = uiomove((caddr_t)in, (int)want, uio)) != 0) {
+			break;
+		}
+		frames = (uint32_t)want / MONDRIAN_AUDIO_FRAME;
+		for (i = 0; i < frames * 2; i++) {
+			uint32_t a = in[i] < 0 ? (uint32_t)-(int32_t)in[i] :
+			    (uint32_t)in[i];
+
+			out[i] = (int32_t)in[i] << 16;
+			if (a > mas_peak_in) {
+				mas_peak_in = a;
+			}
+		}
+		bytes = mondrian_audio_pcm_write((const uint8_t *)out,
+		    frames * 8);
+		/*
+		 * The plug-in's own log does not reach the console ring, so the
+		 * kernel says whether iOS is actually playing into the node: the
+		 * first few writes and then every 500th (about every 5 s).
+		 */
+		if (mas_write_calls < 4 || (mas_write_calls % 500) == 0) {
+			adsp_log("audio node: PCM %u bytes %u frames (call %u)",
+			    (unsigned)bytes, (unsigned)(bytes / 8),
+			    (unsigned)mas_write_calls);
+		}
+		mas_write_calls++;
+		taken = (bytes / 8) * MONDRIAN_AUDIO_FRAME;
+		mas_frames_in += bytes / 8;
+		if (taken < (uint32_t)want) {
+			mas_frames_dropped += ((uint32_t)want - taken) /
+			    MONDRIAN_AUDIO_FRAME;
+		}
+		if (bytes == 0) {
+			/* The ring is full: drop the rest of this call. */
+			break;
+		}
+	}
+	return error;
+}
+
+static int
+mas_dev_ioctl(__unused dev_t dev, u_long cmd, caddr_t data,
+    __unused int fflag, __unused struct proc *p)
+{
+	switch (cmd) {
+	case MONDRIAN_AUDIO_SET_VOLUME: {
+		struct mondrian_audio_volume *v =
+		    (struct mondrian_audio_volume *)data;
+
+		/*
+		 * iOS keeps its own speaker in software volume and sets this
+		 * once to the top, so the kernel stays at unity and only the
+		 * mute is honoured. `below` is accepted and ignored.
+		 */
+		lck_mtx_lock(mas_lock);
+		mas_gain = v->muted ? 0 : 256;
+		lck_mtx_unlock(mas_lock);
+		return 0;
+	}
+	case MONDRIAN_AUDIO_GET_STATS: {
+		struct mondrian_audio_stats *st =
+		    (struct mondrian_audio_stats *)data;
+
+		bzero(st, sizeof(*st));
+		lck_mtx_lock(mas_lock);
+		st->frames_in = mas_frames_in;
+		st->frames_dropped = mas_frames_dropped;
+		st->frames_played = mas_bytes / 8;
+		st->state = mas_open ? 2 : 1;
+		st->peak_in = mas_peak_in;
+		st->limiter_gain_q15 = (uint32_t)mas_gain << 7;
+		lck_mtx_unlock(mas_lock);
+		return 0;
+	}
+	case MONDRIAN_AUDIO_SET_ROUTE:
+		/* One route: the speaker. */
+		return 0;
+	case MONDRIAN_AUDIO_LOG:
+		adsp_log("client: %s", (const char *)data);
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static const struct cdevsw mas_cdevsw = {
+	.d_open = mas_dev_open, .d_close = mas_dev_close,
+	.d_read = eno_rdwrt, .d_write = mas_dev_write,
+	.d_ioctl = mas_dev_ioctl, .d_stop = eno_stop, .d_reset = eno_reset,
+	.d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+static void
+mondrian_audio_dev_init(void)
+{
+	void *node;
+
+	if (mas_major >= 0) {
+		return;
+	}
+	mondrian_audio_pcm_init();
+	mas_major = cdevsw_add(-1, &mas_cdevsw);
+	if (mas_major < 0) {
+		adsp_log("audio node: cdevsw_add failed 0x%x", mas_major);
+		mas_major = -1;
+		return;
+	}
+	node = devfs_make_node(makedev(mas_major, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_WHEEL, 0666, MONDRIAN_AUDIO_DEVICE);
+	if (node == NULL) {
+		adsp_log("audio node: devfs_make_node failed");
+		return;
+	}
+	adsp_log("audio node /dev/%s major %d", MONDRIAN_AUDIO_DEVICE,
+	    mas_major);
+}
