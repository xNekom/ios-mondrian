index 00cd9d7..d184dd9 100644
--- a/bsd/dev/mondrian_adsp.c
+++ b/bsd/dev/mondrian_adsp.c
@@ -17,6 +17,10 @@
  * rail vote: PAS alone brought the ADSP up on this unit.
  */
 #include <sys/param.h>
+#include <sys/conf.h>
+#include <sys/ioccom.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
 #include <sys/systm.h>
 #include <stdarg.h>
 #include <kern/clock.h>
@@ -695,6 +699,185 @@ adsp_apm_write(uint8_t *packet, uint32_t length, uint32_t token,
 #define ADSP_BEEP_PERIOD_FRAMES	24000u	/* 150 ms on, then 350 ms off */
 #define ADSP_RING_FRAMES	(ADSP_PCM_BYTES / 8u)
 
+
+/*
+ * /dev/mondrian-audio: the HAL plug-in's end of the PCM ring.
+ *
+ * MondrianAudio.driver writes S16LE stereo 48 kHz whole frames here. The
+ * writer is CoreAudio's real-time thread, so it never blocks: what does not
+ * fit in the ring is dropped and counted. The samples land in the same
+ * adsp_pcm_va ring the boot worker queues to the TDM sink, and the mute is
+ * honoured while iOS keeps the volume in software.
+ */
+#define MONDRIAN_AUDIO_DEVICE	"mondrian-audio"
+#define MONDRIAN_AUDIO_FRAME	4	/* bytes: S16LE left, right */
+
+struct mondrian_audio_volume {
+	uint32_t below;			/* 1/8 dB below the maximum */
+	uint32_t muted;
+};
+
+struct mondrian_audio_stats {
+	uint64_t frames_in;
+	uint64_t frames_dropped;
+	uint64_t frames_played;
+	uint32_t state;
+	uint32_t peak_in;
+	uint32_t limiter_gain_q15;
+};
+
+#define MONDRIAN_AUDIO_SET_VOLUME _IOW('m', 1, struct mondrian_audio_volume)
+#define MONDRIAN_AUDIO_GET_STATS _IOR('m', 2, struct mondrian_audio_stats)
+#define MONDRIAN_AUDIO_SET_ROUTE _IOW('m', 3, uint32_t)
+#define MONDRIAN_AUDIO_LOG _IOW('m', 4, char[128])
+
+static uint64_t mas_frames_in, mas_frames_dropped, mas_frames_played;
+static uint32_t mas_write_calls, mas_peak_in, mas_state, mas_gain = 256;
+static int mas_major = -1;
+static lck_grp_t *mas_grp;
+static lck_mtx_t *mas_lock;
+
+static int
+mas_dev_open(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *p)
+{
+	lck_mtx_lock(mas_lock);
+	mas_frames_in = mas_frames_dropped = mas_frames_played = 0;
+	mas_write_calls = mas_peak_in = 0;
+	mas_state = 2;
+	lck_mtx_unlock(mas_lock);
+	adsp_log("audio node opened");
+	return 0;
+}
+
+static int
+mas_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *p)
+{
+	lck_mtx_lock(mas_lock);
+	mas_state = 1;
+	lck_mtx_unlock(mas_lock);
+	adsp_log("audio node closed");
+	return 0;
+}
+
+/* S16LE stereo in, S32LE stereo in the ring: the PCM converter wants 32-bit
+ * slots. Copy straight into the period ring the worker already maps. */
+static int
+mas_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t in[256 * 2];
+	int error = 0;
+
+	while (uio_resid(uio) >= MONDRIAN_AUDIO_FRAME) {
+		user_ssize_t want = uio_resid(uio);
+		uint32_t frames, i, taken;
+
+		if (want > (user_ssize_t)sizeof(in))
+			want = (user_ssize_t)sizeof(in);
+		want &= ~(user_ssize_t)(MONDRIAN_AUDIO_FRAME - 1);
+		if ((error = uiomove((caddr_t)in, (int)want, uio)) != 0)
+			break;
+		frames = (uint32_t)want / MONDRIAN_AUDIO_FRAME;
+		lck_mtx_lock(mas_lock);
+		for (i = 0; i < frames * 2; i++) {
+			int32_t *ring = (int32_t *)adsp_pcm_va;
+			uint32_t at = (uint32_t)((mas_frames_played + i) %
+			    (ADSP_PCM_BYTES / 4));
+			uint32_t a = in[i] < 0 ? (uint32_t)-(int32_t)in[i] :
+			    (uint32_t)in[i];
+
+			ring[at] = mas_gain == 0 ? 0 : ((int32_t)in[i] << 16);
+			if (a > mas_peak_in)
+				mas_peak_in = a;
+		}
+		taken = frames;
+		mas_frames_in += taken;
+		mas_frames_played += taken;
+		if (taken < (uint32_t)want / MONDRIAN_AUDIO_FRAME)
+			mas_frames_dropped +=
+			    (uint32_t)want / MONDRIAN_AUDIO_FRAME - taken;
+		lck_mtx_unlock(mas_lock);
+		if (mas_write_calls < 4 || (mas_write_calls % 500) == 0)
+			adsp_log("audio node: PCM %u frames (call %u)",
+			    (unsigned)taken, (unsigned)mas_write_calls);
+		mas_write_calls++;
+	}
+	return error;
+}
+
+static int
+mas_dev_ioctl(__unused dev_t dev, u_long cmd, caddr_t data,
+    __unused int fflag, __unused struct proc *p)
+{
+	switch (cmd) {
+	case MONDRIAN_AUDIO_SET_VOLUME: {
+		struct mondrian_audio_volume *v =
+		    (struct mondrian_audio_volume *)data;
+
+		lck_mtx_lock(mas_lock);
+		mas_gain = v->muted ? 0 : 256;
+		lck_mtx_unlock(mas_lock);
+		return 0;
+	}
+	case MONDRIAN_AUDIO_GET_STATS: {
+		struct mondrian_audio_stats *st =
+		    (struct mondrian_audio_stats *)data;
+
+		bzero(st, sizeof(*st));
+		lck_mtx_lock(mas_lock);
+		st->frames_in = mas_frames_in;
+		st->frames_dropped = mas_frames_dropped;
+		st->frames_played = mas_frames_played;
+		st->state = mas_state;
+		st->peak_in = mas_peak_in;
+		st->limiter_gain_q15 = mas_gain << 7;
+		lck_mtx_unlock(mas_lock);
+		return 0;
+	}
+	case MONDRIAN_AUDIO_SET_ROUTE:
+		return 0;
+	case MONDRIAN_AUDIO_LOG:
+		adsp_log("client: %s", (const char *)data);
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static const struct cdevsw mas_cdevsw = {
+	.d_open = mas_dev_open, .d_close = mas_dev_close,
+	.d_read = eno_rdwrt, .d_write = mas_dev_write,
+	.d_ioctl = mas_dev_ioctl, .d_stop = eno_stop, .d_reset = eno_reset,
+	.d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_type = 0,
+};
+
+static void
+mondrian_audio_dev_init(void)
+{
+	void *node;
+
+	if (mas_major >= 0)
+		return;
+	mas_grp = lck_grp_alloc_init("mondrian_audio", LCK_GRP_ATTR_NULL);
+	mas_lock = lck_mtx_alloc_init(mas_grp, LCK_ATTR_NULL);
+	mas_major = cdevsw_add(-1, &mas_cdevsw);
+	if (mas_major < 0) {
+		adsp_log("audio node: cdevsw_add failed %d", mas_major);
+		mas_major = -1;
+		return;
+	}
+	node = devfs_make_node(makedev(mas_major, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_WHEEL, 0666, MONDRIAN_AUDIO_DEVICE);
+	if (node == NULL) {
+		adsp_log("audio node: devfs_make_node failed");
+		return;
+	}
+	adsp_log("audio node /dev/%s major %d", MONDRIAN_AUDIO_DEVICE,
+	    mas_major);
+}
+
 static void
 adsp_pcm_fill(uint32_t first_frame, int audio)
 {
@@ -1362,6 +1543,7 @@ mondrian_adsp_start(void)
 		return;
 	}
 	thread_deallocate(thread);
+	mondrian_audio_dev_init();
 	adsp_log("worker started");
 }
 
