+	    "Spotlight"))) {
+		wanted = MONDRIAN_HOOK_KBD;
 	} else if (wanted == 0 &&
 	    mondrian_name_is(name, (size_t)imgp->ip_ndp->ni_cnd.cn_namelen,
 	    "MobileSlideShow")) {
