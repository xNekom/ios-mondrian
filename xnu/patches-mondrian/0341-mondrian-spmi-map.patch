+/*
+ * The APID map as the bootloader left it: one ring line per entry with the
+ * PPID it carries and the owner bits. Both matter, because a peripheral this
+ * AP cannot see at all (no entry) and one another processor owns look the
+ * same from a read that returns nothing.
+ */
+void
+mondrian_spmi_dump_map(unsigned int first, unsigned int count)
+{
+	unsigned int i;
+
+	if (!sp_ensure()) {
+		printf("MONDRIAN SPMI: no arbiter\n");
+		return;
+	}
+	if (first >= sp_count) {
+		printf("MONDRIAN SPMI: APIDs %u, %u out of range\n", sp_count,
+		    first);
+		return;
+	}
+	for (i = first; i < sp_count && i < first + count; i++) {
+		uint32_t map = sp_rd(sp_core, sp_map_off + 4u * i);
+		uint32_t owner = sp_rd(sp_cnfg, sp_owner_off + 4u * i) & 7u;
+
+		printf("MONDRIAN SPMI: apid %u ppid 0x%03x owner %u\n", i,
+		    (map >> 8) & 0xfffu, owner);
+	}
+	printf("MONDRIAN SPMI: map %u entries from %u\n", sp_count, first);
+}
