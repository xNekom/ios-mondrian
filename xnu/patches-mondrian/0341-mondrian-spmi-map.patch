+/* "spmimap [first [count]]" logs the arbiter's APID map to the ring. */
+static void
+ud_cmd_spmimap(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern void mondrian_spmi_dump_map(unsigned int first, unsigned int count);
+	const char *p;
+	uint32_t first = 0, count = 600;
+
+	p = ud_cmd_num(line + 7, &first);
+	if (p != NULL) {
+		(void)ud_cmd_num(p, &count);
+	}
+	mondrian_spmi_dump_map(first, count);
+	ud_cmd_send(so, to, "spmimap\n", 8);
+}
