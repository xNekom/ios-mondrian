 /*
+ * mondrian: the owner pid of a port name in another task's space.
+ *
+ * A send that never completes never reports where it was going, and the trap
+ * cannot take the locks to find out. The sampler calls this instead: it
+ * translates the name the trap recorded and reads the receiving task off the
+ * port, which names the process that owes the answer.
+ */
+/* kern/bsd_kern.c; vm_protos.h carries the declaration */
+extern ipc_space_t get_task_ipcspace(task_t);
+
+int
+mondrian_task_port_owner_pid(task_t task, mach_port_name_t name)
+{
+	ipc_space_t space;
+	ipc_port_t port = IP_NULL;
+	ipc_space_t rcv;
+	int owner = -1;
+
+	if (task == TASK_NULL || !MACH_PORT_VALID(name)) {
+		return -1;
+	}
+	space = get_task_ipcspace(task);
+	if (space == IS_NULL) {
+		return -1;
+	}
+	if (ipc_port_translate_send(space, name, &port) != KERN_SUCCESS ||
+	    port == IP_NULL) {
+		return -1;
+	}
+	/*
+	 * translate_send returns the port active and LOCKED, without a ref:
+	 * unlock it here and never release a send right that was not taken.
+	 * ipc_port_release_send on a locked port spins on its own lock and
+	 * takes the whole kernel with it, which is what the first version of
+	 * this helper did (one boot, no ring, no panic). ip_mq_unlock is the
+	 * port unlock in this XNU; there is no ip_unlock.
+	 */
+	rcv = port->ip_receiver;
+	if (rcv != IPS_NULL && rcv->is_task != TASK_NULL) {
+		owner = task_pid(rcv->is_task);
+	}
+	ip_mq_unlock(port);
+	return owner;
+}
+
+/*
  *	Routine:	ipc_port_release_send
  *	Purpose:
  *		Release a naked send right.
