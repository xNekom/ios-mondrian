+
+/* Called from the UFS write path, which runs throughout the boot. */
+void
+mondrian_log_kick(void)
+{
+	uint64_t total = os_atomic_load(&mondrian_log_total, relaxed);
+
+	static uint32_t calls;
+
+	if (total - os_atomic_load(&mondrian_log_flushed, relaxed) >= MONDRIAN_LOG_KICK_BYTES) {
+		mondrian_log_store(total);
+	}
+	/*
+	 * The sampler has the same dead timeout, so give it this clock too:
+	 * one line every 256 write-path calls.
+	 */
+	if ((++calls & 0xff) == 0) {
+		extern void mondrian_sample_tick(void);
+		mondrian_sample_tick();
+	}
+}
+
+static void
+mondrian_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	printf("MONDRIAN LOG: console ring in the last %u KiB of the partition (block 0x%llx)\n",
+	    MONDRIAN_LOG_BLOCKS * UFS_BLOCK >> 10, mondrian_log_base);
+	for (;;) {
+		mondrian_log_store(os_atomic_load(&mondrian_log_total, relaxed));
+		(void)tsleep(&mondrian_log_chan, PZERO, "mondrianlog", MONDRIAN_LOG_TICKS * hz);
 	}
 }
 
