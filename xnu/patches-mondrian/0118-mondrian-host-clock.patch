 }
 
+#if defined(ARM64_BOARD_CONFIG_MONDRIAN)
+/* bsd/dev/mondrian_clock.c: host-supplied time, for a board with no RTC. */
+extern "C" {
+int mondrian_pe_get_utc(clock_sec_t *, clock_usec_t *);
+int mondrian_pe_set_utc(clock_sec_t, clock_usec_t);
+}
+#endif
+
