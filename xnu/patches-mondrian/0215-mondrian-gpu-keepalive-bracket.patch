+/*
+ * A GPU register access into a core the GMU has collapsed never returns: it
+ * hangs the CPU that issued it. kgsl brackets its accesses the same way
+ * (gen7_irq_handler raises the keepalive before the first register read and
+ * drops it after the last). With the default (gpukeep=1) the keepalive is
+ * already up, so this is a no-op; it exists for gpukeep=0, kgsl's
+ * submit-time toggle and the default until the measured death above.
+ */
+static uint32_t mondrian_uc_keep_depth;
+
+static void
+mondrian_uc_keepalive(int on)
+{
+	if (mondrian_uc_gmu == 0 || mondrian_uc_keep != 0) {
+		return;
+	}
+	if (on != 0) {
+		if (mondrian_uc_keep_depth++ == 0) {
+			mondrian_gpu_write(mondrian_uc_gmu, GMU_OFF(0x1f8c3u), 1u);
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+		return;
+	}
+	if (mondrian_uc_keep_depth == 0 || --mondrian_uc_keep_depth != 0) {
+		return;
+	}
+	mondrian_gpu_write(mondrian_uc_gmu, GMU_OFF(0x1f8c3u), 0u);
+}
