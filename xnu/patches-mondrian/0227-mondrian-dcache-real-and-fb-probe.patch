+/*
+ * XNU is built with __ARM_COHERENT_IO__ here (pexpert/arm64/
+ * apple_arm64_common.h), and in that build flush_dcache() and clean_dcache()
+ * are a bare dsb: they order, they do not clean. Nothing on this board is
+ * IO-coherent -- the panel reads DRAM and the Adreno reads DRAM behind the CPU
+ * caches -- so the maintenance the driver asks for has to be done by hand.
+ *
+ * Clean and invalidate each line to the point of coherency through the
+ * physmap alias of the pages (a cacheable view of them, so the operation is
+ * unambiguous), keyed on the line size CTR_EL0 reports instead of a guess.
+ */
+static void
+mondrian_dcache_flush_va(uintptr_t va, uint64_t bytes)
+{
+	uint64_t ctr = 0, dmin, line, end;
+
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	dmin = 4ull << ((ctr >> 16) & 0xfull);
+	if (dmin < 16 || dmin > 256) {
+		dmin = 64;
+	}
+	line = va & ~(dmin - 1);
+	end = va + bytes;
+	for (; line < end; line += dmin) {
+		__asm__ volatile("dc civac, %0" :: "r"(line) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+mondrian_dcache_flush_pa(uint64_t pa, uint64_t bytes)
+{
+	while (bytes != 0) {
+		vm_size_t count = (vm_size_t)bytes;
+		vm_offset_t va = phystokv_range((addr64_t)pa, &count);
+
+		if (va == 0 || count == 0) {
+			uint64_t step = bytes < 4096 ? bytes : 4096;
+
+			pa += step;
+			bytes -= step;
+			continue;
+		}
+		if ((uint64_t)count > bytes) {
+			count = (vm_size_t)bytes;
+		}
+		mondrian_dcache_flush_va((uintptr_t)va, count);
+		pa += count;
+		bytes -= count;
+	}
+}
+
 int
 mondrian_gpu_uc_flush(uint64_t pa, uint64_t bytes)
 {
 	if (bytes == 0) {
 		return -1;
 	}
-	flush_dcache64((addr64_t)pa, (unsigned)bytes, TRUE);
-	__asm__ volatile("dsb sy" ::: "memory");
+	mondrian_dcache_flush_pa(pa, bytes);
 	return 0;
 }
 
