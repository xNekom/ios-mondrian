+/*
+ * MONDRIAN: the trees a boot regrows, read and emptied from the kernel.
+ *
+ * The user-level hook cannot do this: it runs as the mobile account, and
+ * `/private/var/db` answers EACCES to it. It also cannot *list* them -- measured
+ * 2026-11-19, `/private/var/log` answers a readdir with only "." and ".." while
+ * `unlink` of a file below it succeeds, because the directory's catalog valence
+ * is zero and `cat_getdirentries` takes that as its entry limit. So the walk
+ * bumps the valence in memory: what it needs is the listing, not a repair, and
+ * nothing here is written back except the unlinks themselves.
+ *
+ * `mondrian_hfs_rmtree` removes every file and leaves the directory skeleton: an
+ * empty directory holds no data blocks, so the space is the files. It only ever
+ * touches the two trees named below, and the path arrives from the control
+ * channel -- the allow-list is what keeps a wrong path from being a destructive
+ * one.
+ *
+ * The pending list is static because one command runs at a time on the control
+ * thread: a directory three levels deep would otherwise put a kilobyte per level
+ * on a 16 KB kernel stack.
+ */
+static const char * const mondrian_tree_roots[] = {
+	"/private/var/log",
+	"/private/var/db/diagnostics",
+};
+
+#define MONDRIAN_TREE_MAX   64
+#define MONDRIAN_TREE_BATCH 8
+#define MONDRIAN_TREE_PATH  448
+#define MONDRIAN_TREE_BUFSZ 4096
+#define MONDRIAN_TREE_VALENCE 100000
+
+static char mondrian_tree_pend[MONDRIAN_TREE_MAX][MONDRIAN_TREE_PATH];
+static char mondrian_tree_batch[MONDRIAN_TREE_BATCH][NAME_MAX + 1];
+static char mondrian_tree_buf[MONDRIAN_TREE_BUFSZ];
+
+/* bsd/vfs/vfs_syscalls.c, where the path-based unlink lives */
+extern int unlink1(vfs_context_t, vnode_t, user_addr_t, enum uio_seg, int);
+/* sys/vnode_if.h declares this only under XNU_KERNEL_PRIVATE, which the HFS core
+ * is not built with; the symbol is the same one the vnode layer calls. */
+extern errno_t VNOP_READDIR(vnode_t, struct uio *, int, int *, int *,
+    vfs_context_t);
+
+static int
+mondrian_tree_allowed(const char *path)
+{
+	size_t i;
+
+	for (i = 0; i < sizeof(mondrian_tree_roots) /
+	    sizeof(mondrian_tree_roots[0]); i++) {
+		size_t len = strlen(mondrian_tree_roots[i]);
+
+		if (strncmp(path, mondrian_tree_roots[i], len) == 0 &&
+		    (path[len] == '\0' || path[len] == '/')) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Up to `max` names of one directory, read as `struct direntry` records so that
+ * the dot entries and the real ones share one layout. Returns the count and the
+ * offset that follows them; `*errp` is set when the directory could not be read.
+ */
+static int
+mondrian_tree_names(vnode_t dvp, off_t off, off_t *next, int *errp)
+{
+	struct cnode *cp = VTOC(dvp);
+	u_int32_t saved;
+	uio_t auio;
+	int error, eofflag = 0, numdirent = 0, count = 0;
+	size_t total, pos;
+
+	*errp = 0;
+	*next = off;
+
+	hfs_lock(cp, HFS_EXCLUSIVE_LOCK, HFS_LOCK_DEFAULT);
+	saved = cp->c_entries;
+	if (cp->c_entries < MONDRIAN_TREE_VALENCE) {
+		cp->c_entries = MONDRIAN_TREE_VALENCE;
+	}
+	hfs_unlock(cp);
+
+	auio = uio_create(1, off, UIO_SYSSPACE, UIO_READ);
+	uio_addiov(auio, CAST_USER_ADDR_T(mondrian_tree_buf),
+	    MONDRIAN_TREE_BUFSZ);
+	error = VNOP_READDIR(dvp, auio, VNODE_READDIR_EXTENDED, &eofflag,
+	    &numdirent, vfs_context_kernel());
+	total = MONDRIAN_TREE_BUFSZ - (size_t)uio_resid(auio);
+	*next = uio_offset(auio);
+	uio_free(auio);
+
+	hfs_lock(cp, HFS_EXCLUSIVE_LOCK, HFS_LOCK_DEFAULT);
+	cp->c_entries = saved;
+	hfs_unlock(cp);
+
+	if (error != 0) {
+		*errp = error;
+		return 0;
+	}
+	for (pos = 0; pos + sizeof(struct direntry) <= total &&
+	    count < MONDRIAN_TREE_BATCH; ) {
+		struct direntry *de = (struct direntry *)(void *)
+		    (mondrian_tree_buf + pos);
+
+		if (de->d_reclen == 0 || pos + de->d_reclen > total) {
+			break;
+		}
+		if (de->d_namlen > 0 && de->d_namlen <= NAME_MAX &&
+		    !(de->d_namlen == 1 && de->d_name[0] == '.') &&
+		    !(de->d_namlen == 2 && de->d_name[0] == '.' &&
+		    de->d_name[1] == '.')) {
+			memcpy(mondrian_tree_batch[count], de->d_name,
+			    de->d_namlen);
+			mondrian_tree_batch[count][de->d_namlen] = '\0';
+			count++;
+		}
+		pos += de->d_reclen;
+	}
+	return count;
+}
+
+/*
+ * What the mount says about itself. `statfs` reports the free-block counter
+ * minus the reserve, so this is the number PhotoKit reads.
+ */
+void
+mondrian_hfs_free(const char *label)
+{
+	vnode_t rv = vfs_rootvnode();
+
+	if (rv != NULLVP) {
+		struct vfsstatfs *sf = vfs_statfs(vnode_mount(rv));
+
+		if (sf != NULL) {
+			printf("MONDRIAN FREE: %s free %lld avail %lld bsize %d\n",
+			    label, (long long)sf->f_bfree,
+			    (long long)sf->f_bavail, (int)sf->f_bsize);
+		}
+		vnode_put(rv);
+	}
+}
+
+/*
+ * Print a directory from the kernel context, with each entry's size. It is also
+ * the proof that the listing works at all before anything is removed.
+ */
+int
+mondrian_hfs_list(const char *path, int max)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t dvp = NULLVP;
+	off_t off = 0;
+	int shown = 0, err = 0, saved = 0, error;
+
+	error = vnode_lookup(path, 0, &dvp, ctx);
+	if (error != 0) {
+		printf("MONDRIAN LS: %s -> %d\n", path, error);
+		return error;
+	}
+	if (vnode_vtype(dvp) != VDIR) {
+		vnode_put(dvp);
+		printf("MONDRIAN LS: %s is not a directory\n", path);
+		return ENOTDIR;
+	}
+	hfs_lock(VTOC(dvp), HFS_SHARED_LOCK, HFS_LOCK_DEFAULT);
+	saved = (int)VTOC(dvp)->c_entries;
+	hfs_unlock(VTOC(dvp));
+	printf("MONDRIAN LS: %s valence %d\n", path, saved);
+
+	while (shown < max) {
+		int i, count;
+		off_t next = 0;
+
+		count = mondrian_tree_names(dvp, off, &next, &err);
+		if (err != 0) {
+			printf("MONDRIAN LS: %s readdir %d\n", path, err);
+			break;
+		}
+		if (count == 0) {
+			break;
+		}
+		for (i = 0; i < count && shown < max; i++) {
+			char child[MONDRIAN_TREE_PATH];
+			struct vnode_attr va;
+			vnode_t vp = NULLVP;
+
+			if (snprintf(child, sizeof(child), "%s/%s", path,
+			    mondrian_tree_batch[i]) >= (int)sizeof(child)) {
+				continue;
+			}
+			if (vnode_lookup(child, 0, &vp, ctx) != 0) {
+				printf("MONDRIAN LS: %s gone\n", child);
+				shown++;
+				continue;
+			}
+			if (vnode_vtype(vp) == VDIR) {
+				printf("MONDRIAN LS: %s/ dir\n", child);
+			} else {
+				VATTR_INIT(&va);
+				VATTR_WANTED(&va, va_data_size);
+				(void)vnode_getattr(vp, &va, ctx);
+				printf("MONDRIAN LS: %s %lld\n", child,
+				    (long long)va.va_data_size);
+			}
+			vnode_put(vp);
+			shown++;
+		}
+		if (next <= off) {
+			off++;
+		} else {
+			off = next;
+		}
+	}
+	vnode_put(dvp);
+	return 0;
+}
+
+int
+mondrian_hfs_rmtree(const char *start, unsigned *files, unsigned *dirs,
+    unsigned *failed)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	unsigned guard = 0;
+	int top = 0, first = 0;
+
+	if (mondrian_tree_allowed(start) == 0) {
+		printf("MONDRIAN RM: %s is not one of the allowed trees\n", start);
+		return EPERM;
+	}
+	if (strlen(start) >= MONDRIAN_TREE_PATH) {
+		return ENAMETOOLONG;
+	}
+	strlcpy(mondrian_tree_pend[top++], start, MONDRIAN_TREE_PATH);
+
+	while (top > 0 && guard++ < 200000) {
+		char *path = mondrian_tree_pend[top - 1];
+		vnode_t dvp = NULLVP;
+		int err = 0, count, i, progress = 0, error;
+		off_t next = 0;
+
+		error = vnode_lookup(path, 0, &dvp, ctx);
+		if (error != 0) {
+			top--;
+			continue;
+		}
+		if (vnode_vtype(dvp) != VDIR) {
+			vnode_put(dvp);
+			top--;
+			continue;
+		}
+		count = mondrian_tree_names(dvp, 0, &next, &err);
+		vnode_put(dvp);
+		if (err != 0) {
+			if (first == 0) {
+				first = err;
+			}
+			printf("MONDRIAN RM: %s readdir %d\n", path, err);
+			top--;
+			continue;
+		}
+		if (count == 0) {
+			top--;
+			continue;
+		}
+		for (i = 0; i < count; i++) {
+			char child[MONDRIAN_TREE_PATH];
+			vnode_t vp = NULLVP;
+
+			if (snprintf(child, sizeof(child), "%s/%s", path,
+			    mondrian_tree_batch[i]) >= (int)sizeof(child)) {
+				continue;
+			}
+			error = vnode_lookup(child, 0, &vp, ctx);
+			if (error != 0) {
+				continue;
+			}
+			if (vnode_vtype(vp) == VDIR) {
+				vnode_put(vp);
+				(*dirs)++;
+				if (top < MONDRIAN_TREE_MAX) {
+					strlcpy(mondrian_tree_pend[top++], child,
+					    MONDRIAN_TREE_PATH);
+					progress++;
+				}
+				continue;
+			}
+			vnode_put(vp);
+			error = unlink1(ctx, NULLVP,
+			    (user_addr_t)(uintptr_t)child, UIO_SYSSPACE, 0);
+			if (error == 0) {
+				(*files)++;
+				progress++;
+				if ((*files % 500) == 0) {
+					printf("MONDRIAN RM: %u files\n", *files);
+				}
+			} else {
+				(*failed)++;
+				if (*failed < 6) {
+					printf("MONDRIAN RM: unlink %s -> %d\n",
+					    child, error);
+				}
+			}
+		}
+		if (progress == 0) {
+			top--;
+		}
+	}
+	return first;
+}
