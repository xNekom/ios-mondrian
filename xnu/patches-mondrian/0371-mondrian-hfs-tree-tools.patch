+/*
+ * MONDRIAN: an app does not exec through namei. Measured 2026-11-19: two hundred
+ * execs a boot reach the name check and none of them is `/Applications/
+ * MobileSlideShow.app/MobileSlideShow`, because a launch through runningboardd
+ * is a `posix_spawn` and that path carries `ip_vp` but no nameidata. The vnode's
+ * own name is the executable's file name, which is what the probe list holds.
+ * Only the probe switch arms this: no ordinary boot changes.
+ */
+static bool
+mondrian_probe_app_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char probe[] = "DYLD_INSERT_LIBRARIES=/private/var/vm/mondrian-ui-hook.dylib";
+	const char *vname;
+	bool hit;
+	int army = 0;
+
+	if (imgp->ip_vp == NULL || sizeof(probe) > size) {
+		return false;
+	}
+	if (!mondrian_probe_switch() &&
+	    !(PE_parse_boot_argn("mondrian_ui_probe", &army, sizeof(army)) &&
+	    army > 0)) {
+		return false;
+	}
+	vname = vnode_getname(imgp->ip_vp);
+	if (vname == NULL) {
+		return false;
+	}
+	hit = mondrian_probe_target(vname, strlen(vname));
+	vnode_putname(vname);
+	if (!hit) {
+		return false;
+	}
+	strlcpy(env, probe, size);
+	return true;
+}
