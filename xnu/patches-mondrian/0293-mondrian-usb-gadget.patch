+static void
+ud_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
+static void
+ud_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	static lck_grp_t *grp;
+
+	grp = lck_grp_alloc_init("mondrian_usb", LCK_GRP_ATTR_NULL);
+	ud.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "mondrian-usb-ecm";
+	init.uniqueid_len = sizeof("mondrian-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ud_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ud_if_ioctl;
+	init.detach = ud_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ud.ifp) != 0) {
+		printf("MONDR USB: ifnet_allocate failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ud.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ud.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ud.ifp, ETHERMTU);
+	ifnet_set_baudrate(ud.ifp, 480000000);
+	ifnet_set_flags(ud.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ud.ifp, NULL) != 0) {
+		printf("MONDR USB: ifnet_attach failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ud.ifp, ud_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ud.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("MONDR USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			printf("MONDR USB: bus reset\n");
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("MONDR USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			printf("MONDR USB: disconnect\n");
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (ep == EP_RX && type == 1) {
+		ud_rx_done();
+		return;
+	}
+	if (ep == EP_TX && type == 1) {
+		lck_mtx_lock(ud.lock);
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ticks = 0;
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 200) {
+					printf("MONDR USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		if ((++ticks % 30000) == 0) {
+			printf("MONDR USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+		}
+		ud_sleep_ms(1);
+	}
+}
+
+/*
+ * Live console log over USB Ethernet: every 100 ms the new bytes of the
+ * console ring (bsd/dev/mondrian_ufs.c) go as UDP datagrams to
+ * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
+ * so the boot is included. Nothing here may print (it would feed itself).
+ * Boot-arg usblog=0 disables it.
+ */
+extern uint32_t mondrian_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t mondrian_log_position(void);
+
+static void
+ud_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t so = NULL;
+	struct sockaddr_in to;
+	uint64_t pos = mondrian_log_position();
+
+	pos = pos > 65536 ? pos - 65536 : 0;
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(5140);
+	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	for (;;) {
+		ud_sleep_ms(100);
+		if (!ud.configured) {
+			continue;
+		}
+		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+			so = NULL;
+			continue;
+		}
+		uint32_t n;
+		while ((n = mondrian_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			struct iovec iov = { .iov_base = chunk, .iov_len = n };
+			struct msghdr msg = {
+				.msg_name = &to, .msg_namelen = sizeof(to),
+				.msg_iov = &iov, .msg_iovlen = 1,
+			};
+			size_t sent = 0;
+			if (sock_send(so, &msg, 0, &sent) != 0) {
+				break;          /* no route/ARP yet: retry later */
+			}
+		}
+	}
+}
+
+
+/*
+ * Step 3: control channel on udp/5141, served from the gadget's own stack.
+ * The live log thread only sends what is written after it starts, so a
+ * frozen UI used to force a power cycle and a recovery dump to read the
+ * ring. This thread answers three commands from the host:
+ *
+ *   dump    the whole 4 MiB ring, as datagrams "RLG1" + u32 offset + bytes,
+ *           ended by "RLG1" + 0xffffffff with no payload
+ *   pos     the ring's absolute position, as ASCII
+ *   reboot  flush the ring, point the BCB at fastboot, reset the SoC
+ *
+ * Nothing listens on the phone otherwise: ping answers because the kernel
+ * answers ICMP, not because there is a service.
+ */
+#define UD_CMD_PORT     5141
+#define UD_CMD_CHUNK    1200
+
+static void
+ud_cmd_send(socket_t so, struct sockaddr_in *to, const void *buf, size_t len)
+{
+	struct iovec iov = { .iov_base = (void *)buf, .iov_len = len };
+	struct msghdr msg = {
+		.msg_name = to, .msg_namelen = sizeof(*to),
+		.msg_iov = &iov, .msg_iovlen = 1,
+	};
+	size_t sent = 0;
+
+	(void)sock_send(so, &msg, 0, &sent);
+}
+
+/*
+ * Synthetic key: "RLK1" + key + down (key: 0 power, 1 volume up, 2 volume
+ * down, 3 home). The power key is how the host wakes a screen that the idle
+ * timer turned off before it asks for a frame.
+ */
+static void
+ud_cmd_key(const uint8_t *req)
+{
+	extern void mondrian_hid_key(int key, int down);
+
+	mondrian_hid_key(req[4], req[5] != 0);
+	printf("MONDR USB: key %u %s\n", req[4], req[5] ? "down" : "up");
+}
+
+/*
+ * Screen capture: "RLS1" + little-endian u16 row. The reply is "RLP1", the
+ * same row and 1440 bytes of half-scale RGB565. One row per datagram keeps
+ * the reply under the interface MTU; the host windows the requests.
+ */
+static void
+ud_cmd_screen(socket_t so, struct sockaddr_in *to, uint32_t row)
+{
+	extern uint32_t mondrian_fb_capture_row(uint32_t y, uint8_t *dst,
+	    uint32_t dstLen);
+	static uint8_t packet[1500];
+	uint32_t n;
+
+	packet[0] = 'R'; packet[1] = 'L'; packet[2] = 'P'; packet[3] = '1';
+	packet[4] = (uint8_t)(row & 0xff);
+	packet[5] = (uint8_t)((row >> 8) & 0xff);
+	n = mondrian_fb_capture_row(row, packet + 6, sizeof(packet) - 6);
+	if (n == 0) {
+		return;
+	}
+	ud_cmd_send(so, to, packet, (size_t)n + 6);
+}
+
+/*
+ * Synthetic touch: "RLT1" + five little-endian u16 (x1, y1, x2, y2, ms).
+ * The coordinates are panel pixels (1440x3200); the HID service works in
+ * tenths. A zero ms is a tap, anything else is a straight swipe sampled
+ * every 8 ms. This is how a hang gets reproduced from the host instead of
+ * asking somebody to swipe at the right moment.
+ */
+static void
+ud_cmd_touch(const uint8_t *req)
+{
+	extern void mondrian_hid_touch(int finger, int down, int x, int y);
+	uint16_t v[5];
+	int steps, i;
+
+	for (i = 0; i < 5; i++) {
+		v[i] = (uint16_t)(req[4 + 2 * i] | (req[5 + 2 * i] << 8));
+	}
+	steps = v[4] / 8;
+	if (steps < 1) {
+		steps = 1;
+	}
+	if (steps > 240) {
+		steps = 240;
+	}
+	mondrian_hid_touch(0, 1, v[0] * 10, v[1] * 10);
+	for (i = 1; i <= steps; i++) {
+		int x = v[0] + ((int)v[2] - (int)v[0]) * i / steps;
+		int y = v[1] + ((int)v[3] - (int)v[1]) * i / steps;
+
+		mondrian_hid_touch(0, 1, x * 10, y * 10);
+		if (v[4]) {
+			ud_sleep_ms(8);
+		}
+	}
+	mondrian_hid_touch(0, 0, v[2] * 10, v[3] * 10);
+	printf("MONDR USB: touch %u,%u -> %u,%u in %u ms\n",
+	    v[0], v[1], v[2], v[3], v[4]);
+}
+
+static void
+ud_cmd_chunk(socket_t so, struct sockaddr_in *to, uint32_t offset)
+{
+	static char packet[UD_CMD_CHUNK + 8];
+	uint64_t at = offset;
+	uint32_t n = mondrian_log_copy(&at, packet + 8, UD_CMD_CHUNK);
+	uint64_t got = at - n;
+
+	if (n == 0) {
+		return;
+	}
+	packet[0] = 'R'; packet[1] = 'L'; packet[2] = 'G'; packet[3] = '1';
+	packet[4] = (char)(got & 0xff);
+	packet[5] = (char)((got >> 8) & 0xff);
+	packet[6] = (char)((got >> 16) & 0xff);
+	packet[7] = (char)((got >> 24) & 0xff);
+	ud_cmd_send(so, to, packet, (size_t)n + 8);
+}
+
+static void
+ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t so = NULL;
+	char cmd[64];
+
+	for (;;) {
+		if (so == NULL) {
+			struct sockaddr_in bind_to;
+
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+				ud_sleep_ms(500);
+				continue;
+			}
+			bzero(&bind_to, sizeof(bind_to));
+			bind_to.sin_len = sizeof(bind_to);
+			bind_to.sin_family = AF_INET;
+			bind_to.sin_port = htons(UD_CMD_PORT);
+			bind_to.sin_addr.s_addr = htonl(INADDR_ANY);
+			if (sock_bind(so, (const struct sockaddr *)&bind_to) != 0) {
+				sock_close(so);
+				so = NULL;
+				ud_sleep_ms(500);
+				continue;
+			}
+			printf("MONDR USB: control channel on udp/%u\n", UD_CMD_PORT);
+		}
+		struct sockaddr_storage from;
+		struct iovec iov = { .iov_base = cmd, .iov_len = sizeof(cmd) - 1 };
+		struct msghdr msg = {
+			.msg_name = &from, .msg_namelen = sizeof(from),
+			.msg_iov = &iov, .msg_iovlen = 1,
+		};
+		size_t n = 0;
+
+		bzero(&from, sizeof(from));
+		if (sock_receive(so, &msg, 0, &n) != 0) {
+			sock_close(so);
+			so = NULL;
+			continue;
+		}
+		if (n == 0 || n >= sizeof(cmd) || from.ss_family != AF_INET) {
+			continue;
+		}
+		cmd[n] = 0;
+		{
+			struct sockaddr_in *peer = (struct sockaddr_in *)&from;
+
+			if (n == 6 && memcmp(cmd, "RLS1", 4) == 0) {
+				uint16_t row = (uint16_t)((uint8_t)cmd[4] |
+				    ((uint16_t)(uint8_t)cmd[5] << 8));
+
+				ud_cmd_screen(so, peer, row);
+			} else if (n == 6 && memcmp(cmd, "RLK1", 4) == 0) {
+				ud_cmd_key((const uint8_t *)cmd);
+			} else if (n == 14 && memcmp(cmd, "RLT1", 4) == 0) {
+				ud_cmd_touch((const uint8_t *)cmd);
+			} else if (n == 8 && memcmp(cmd, "RLQ1", 4) == 0) {
+				uint32_t offset;
+
+				memcpy(&offset, cmd + 4, sizeof(offset));
+				ud_cmd_chunk(so, peer, offset);
+			} else if (strcmp(cmd, "mem") == 0) {
+				extern void mondrian_gpu_dump_hist(void);
+				extern uint64_t vm_compressor_pages_compressed(void);
+
+				extern void mondrian_vm_stats(void);
+
+				printf("MONDRIAN MEM: compressor %llu bytes\n",
+				    (unsigned long long)vm_compressor_pages_compressed());
+				mondrian_vm_stats();
+				mondrian_gpu_dump_hist();
+			} else if (strcmp(cmd, "pos") == 0) {
+				char out[32];
+				int len = snprintf(out, sizeof(out), "%llu\n",
+				    (unsigned long long)mondrian_log_position());
+				ud_cmd_send(so, peer, out, (size_t)len);
+			} else if (strcmp(cmd, "reboot") == 0) {
+				extern void mondrian_reboot_to_fastboot(void);
+
+				printf("MONDR USB: reboot requested by the host\n");
+				mondrian_reboot_to_fastboot();
+			}
+		}
+	}
+}
+
+static void
+mondrian_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("MONDR USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	if (!pn) {
+		return;
+	}
+	ud.dma_pa = ptoa_64(pn);
+	ud_if_create();
+
+	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("MONDR USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done */
+	dwc_wr(DEVTEN, 0x7);
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("MONDR USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+		printf("MONDR USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
+		    hs, ss, usb_rd(qs, 0x08));
+		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("MONDR USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+		    usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("MONDR USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	int livelog = 1;
+	PE_parse_boot_argn("usblog", &livelog, sizeof(livelog));
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+
+	if (kernel_thread_start(ud_cmd_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_MONDRIAN */

