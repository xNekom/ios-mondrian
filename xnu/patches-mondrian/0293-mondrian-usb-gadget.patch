+
+/*
+ * Read side of the ring, for the live USB console (bsd/dev/mondrian_usb.c):
+ * never prints (the log would feed itself). A reader that fell more than one
+ * ring behind is moved forward instead of replaying what was overwritten.
+ */
+uint64_t
+mondrian_log_position(void)
+{
+	return os_atomic_load(&mondrian_log_total, relaxed);
+}
+
+uint32_t
+mondrian_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&mondrian_log_total, relaxed);
+	uint64_t at = *pos;
+	uint32_t n = 0;
+
+	if (at > total) {
+		at = total;
+	}
+	if (total - at > MONDRIAN_LOG_SIZE) {
+		at = total - MONDRIAN_LOG_SIZE;
+	}
+	while (at < total && n < max) {
+		out[n++] = mondrian_log_ring[at % MONDRIAN_LOG_SIZE];
+		at++;
+	}
+	*pos = at;
+	return n;
+}
+
 struct mondrian_log_header {
 	char magic[8];
 	uint32_t version, size;
@@ -1460,6 +1493,23 @@
 }
 
 /*
+ * Public entry for the USB control channel: what the timed reset thread does
+ * once its deadline expires, without waiting for it. The ring is on the disk
+ * before the BCB changes, so the next boot (recovery or fastboot) still has
+ * the lines describing why the reboot was asked for.
+ */
+void
+mondrian_reboot_to_fastboot(void)
+{
+	mondrian_log_flush_now();
+	/* "bootloader", not "boot-fastboot": the latter is fastbootd, which
+	 * does not accept "fastboot boot". */
+	(void)mondrian_ufs_bcb_set("bootloader");
+	mondrian_log_flush_now();
+	mondrian_reset_to_bootloader();
+}
+
+/*
  * mondrianreset=<seconds>: after that long, put the ring on the disk, point
  * the BCB at the bootloader and reset the SoC, so the next boot lands in
  * fastboot with the ring readable: no key presses to collect a log.
@@ -1851,9 +1901,11 @@
