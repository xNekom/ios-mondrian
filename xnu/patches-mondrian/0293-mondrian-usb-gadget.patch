xnu 0293: the USB gadget and the control channel

`usb=1` reads the DWC3 the bootloader leaves powered; `usb=2` starts the
gadget: the phone enumerates as an ECM Ethernet device at 192.168.7.2 and
answers a control channel on udp/5141. `tools/usb-ring.py` drives it: dump the
console ring from a position, photograph the panel, inject a tap, swipe or
key, print the memory breakdown, reboot to the bootloader.

The ring gets a reader that never prints (the log would feed itself) and the
UFS driver exports the flush, the BCB write and the reset as one call, so a
reboot lands in the bootloader with the lines on the disk. The touch driver
publishes the last coordinates the HID stack was given, which is how a
synthetic gesture is confirmed to have arrived.

diff --git a/bsd/dev/mondrian_usb.c b/bsd/dev/mondrian_usb.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/mondrian_usb.c
@@ -0,0 +1,1264 @@
+/*
+ * MONDRIAN: USB bring-up, step 1 - read-only state probe.
+ *
+ * The phone's USB is a Synopsys DWC3 (USB 2.0 only: the device tree sets
+ * maximum-speed high-speed and disables the USB3/DP combo PHY) at
+ * 0x0a600000 behind Qualcomm's dwc-usb3-msm wrapper, with an SNPS eUSB2
+ * high-speed PHY at 0x088e3000 (qcom,usb-snps-eusb2-phy). Its power domain
+ * is the USB30_PRIM GDSC and its clocks come from GCC; the offsets here are
+ * SM8450's (Linux gcc-sm8450.c), not SM7150's. ABL uses the same controller
+ * for fastboot, so this probe only reports the state it is left in after
+ * `fastboot boot`: it never writes a register, and it touches a block only
+ * when the GCC status registers say that block is powered and clocked (an
+ * access to a gated Qualcomm block hangs the bus).
+ *
+ * Every map here is one 4 KiB page on purpose. ml_io_map() allocates kernel
+ * VA from io_submap, which is 8 MiB for the *whole* kernel (osfmk/arm/
+ * io_map.c, IO_MAP_SIZE) and already holds the GPU, the panel and the touch
+ * controller's windows; asking it for the 2 MiB GCC block panics with
+ * kmem_alloc(KMA_NOFAIL). Map the page that holds each register instead.
+ *
+ * What the answer decides: if ABL leaves the GDSC, the clocks and the PHY up,
+ * the gadget (the second half of this file, from the step 2 comment) can be
+ * started without touching the PHY at all. If not, this driver has to do the
+ * GCC and eUSB2 bring-up itself: the sequence is the Linux phy-snps-eusb2.c
+ * one (qcom register set, 19.2 MHz reference) and the GCC register map below.
+ */
+#if defined(ARM64_BOARD_CONFIG_MONDRIAN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <kern/locks.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <net/if_media.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+void mondrian_usb_probe(void);
+static void mondrian_usb_gadget_start(vm_offset_t dwc);
+
+#define GCC_PA			0x00100000UL
+/* Pages of the GCC block that this probe reads (the block is 2 MiB). */
+#define GCC_USB_PA		0x00149000UL	/* GDSCR, CBCRs, block reset */
+#define GCC_AHB2PHY_PA		0x0017a000UL	/* USB_PHY_CFG_AHB2PHY_BCR */
+#define GCC_CLKREF_PA		0x0019c000UL	/* eusb3/usb3 clkref enables */
+#define PAGE_SIZE_4K		0x00001000UL
+
+#define DWC3_PA			0x0a600000UL
+/* The DWC3 registers live at 0xc100..0xc82c of the block; map that page and
+ * keep the conventional base by subtracting its offset, so every register
+ * access in the gadget (all of them 0xc000 and above) lands inside it. */
+#define DWC3_REGS_PA		(DWC3_PA + 0x0000c000UL)
+#define DWC3_REGS_OFF		0x0000c000UL
+#define QSCRATCH_PA		0x0a6f8800UL
+#define QSCRATCH_PAGE_PA	(DWC3_PA + 0x000f8000UL)	/* QSCRATCH_PA rounded down */
+#define QSCRATCH_OFF		(QSCRATCH_PA - QSCRATCH_PAGE_PA)
+#define EUSB2_PA		0x088e3000UL
+
+/* GCC, SM8450 layout (Linux gcc-sm8450.c), offsets from the pages above. */
+#define GCC_USB30_PRIM_BCR	0x000
+#define GCC_USB30_PRIM_GDSCR	0x004		/* bit 31: power on */
+#define GCC_USB30_MASTER_CBCR	0x018
+#define GCC_USB30_SLEEP_CBCR	0x020
+#define GCC_USB30_UTMI_CBCR	0x024
+#define GCC_USB30_CFG_NOC_CBCR	0x084
+#define GCC_USB30_AGGRE_CBCR	0x088
+#define GCC_EUSB3_0_CLKREF	0x00c
+#define GCC_USB3_0_CLKREF	0x010
+#define GCC_USB_PHY_AHB2PHY_BCR	0x000
+
+/* DWC3 global and device registers. */
+#define DWC3_GSBUSCFG0		0x0000c100
+#define DWC3_GSBUSCFG1		0x0000c104
+#define DWC3_GCTL		0x0000c110
+#define DWC3_GSTS		0x0000c118
+#define DWC3_GUCTL1		0x0000c11c
+#define DWC3_GSNPSID		0x0000c120
+#define DWC3_GUCTL		0x0000c12c
+#define DWC3_GHWPARAMS0		0x0000c140
+#define DWC3_GUSB2PHYCFG	0x0000c200	/* bit 6 SUSPHY, bit 8 ENBLSLPM */
+#define DWC3_GUSB3PIPECTL	0x0000c2c0
+#define DWC3_GEVNTADRLO		0x0000c400
+#define DWC3_GEVNTADRHI		0x0000c404
+#define DWC3_GEVNTSIZ		0x0000c408
+#define DWC3_GEVNTCOUNT		0x0000c40c
+#define DWC3_DCFG		0x0000c700
+#define DWC3_DCTL		0x0000c704
+#define DWC3_DEVTEN		0x0000c708
+#define DWC3_DSTS		0x0000c70c
+#define DWC3_DALEPENA		0x0000c720
+
+/* eUSB2 PHY registers (Linux phy-snps-eusb2.c, qcom register set). */
+#define EUSB2_UTMI_CTRL0	0x003c
+#define EUSB2_UTMI_CTRL5	0x0050
+#define EUSB2_HS_PHY_COMMON0	0x0054		/* bit 0 PHY_ENABLE, bits 6:4 FSEL */
+#define EUSB2_CFG_CTRL_2	0x005c
+#define EUSB2_CFG_CTRL_3	0x0060
+#define EUSB2_HS_PHY_CTRL2	0x0064
+#define EUSB2_CFG0		0x0094
+#define EUSB2_CMN_CTRL0		0x0098
+#define EUSB2_FSEL_SEL		0x00b8
+
+/* QSCRATCH: Qualcomm wrapper registers. */
+#define QSCRATCH_GENERAL_CFG	0x08
+#define QSCRATCH_HS_PHY_CTRL	0x10		/* bit 20 VBUS_VALID, bit 28 SW_SESSVLD */
+#define   UTMI_OTG_VBUS_VALID	(1u << 20)
+#define   SW_SESSVLD_SEL	(1u << 28)
+#define QSCRATCH_SS_PHY_CTRL	0x30
+#define   LANE0_PWR_PRESENT	(1u << 24)
+
+#define CBCR_CLK_OFF		(1u << 31)
+#define GDSC_POWER_ON		(1u << 31)
+
+static uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+mondrian_usb_probe(void)
+{
+	int usb = 1;
+	uint32_t gdscr, master, utmi, cfgnoc;
+	boolean_t clocked;
+	vm_offset_t gw, ga, gc, dwc = 0;
+
+	PE_parse_boot_argn("usb", &usb, sizeof(usb));
+	if (usb <= 0) {
+		return;
+	}
+	gw = ml_io_map(GCC_USB_PA, PAGE_SIZE_4K);
+	ga = ml_io_map(GCC_AHB2PHY_PA, PAGE_SIZE_4K);
+	gc = ml_io_map(GCC_CLKREF_PA, PAGE_SIZE_4K);
+	if (gw == 0 || ga == 0 || gc == 0) {
+		printf("MONDR USB: GCC map failed\n");
+		return;
+	}
+	gdscr = usb_rd(gw, GCC_USB30_PRIM_GDSCR);
+	master = usb_rd(gw, GCC_USB30_MASTER_CBCR);
+	utmi = usb_rd(gw, GCC_USB30_UTMI_CBCR);
+	cfgnoc = usb_rd(gw, GCC_USB30_CFG_NOC_CBCR);
+	printf("MONDR USB: GCC usb30 gdscr 0x%08x (%s) bcr 0x%08x\n", gdscr,
+	    (gdscr & GDSC_POWER_ON) ? "on" : "off", usb_rd(gw, GCC_USB30_PRIM_BCR));
+	printf("MONDR USB: GCC clocks master 0x%08x (%s) utmi 0x%08x (%s) cfg-noc 0x%08x (%s)\n",
+	    master, (master & CBCR_CLK_OFF) ? "off" : "on",
+	    utmi, (utmi & CBCR_CLK_OFF) ? "off" : "on",
+	    cfgnoc, (cfgnoc & CBCR_CLK_OFF) ? "off" : "on");
+	printf("MONDR USB: GCC clocks sleep 0x%08x aggre 0x%08x clkref-eusb3 0x%08x clkref-usb3 0x%08x ahb2phy-bcr 0x%08x\n",
+	    usb_rd(gw, GCC_USB30_SLEEP_CBCR), usb_rd(gw, GCC_USB30_AGGRE_CBCR),
+	    usb_rd(gc, GCC_EUSB3_0_CLKREF), usb_rd(gc, GCC_USB3_0_CLKREF),
+	    usb_rd(ga, GCC_USB_PHY_AHB2PHY_BCR));
+
+	clocked = (gdscr & GDSC_POWER_ON) && !(master & CBCR_CLK_OFF) && !(utmi & CBCR_CLK_OFF);
+	if (!clocked) {
+		printf("MONDR USB: controller unpowered or unclocked; DWC3 not read\n");
+		return;
+	}
+
+	{
+		vm_offset_t page = ml_io_map(DWC3_REGS_PA, PAGE_SIZE_4K);
+
+		if (page == 0) {
+			printf("MONDR USB: DWC3 map failed\n");
+			return;
+		}
+		dwc = page - DWC3_REGS_OFF;
+		printf("MONDR USB: DWC3 GSNPSID 0x%08x GHWPARAMS0 0x%08x GCTL 0x%08x GSTS 0x%08x\n",
+		    usb_rd(dwc, DWC3_GSNPSID), usb_rd(dwc, DWC3_GHWPARAMS0),
+		    usb_rd(dwc, DWC3_GCTL), usb_rd(dwc, DWC3_GSTS));
+		printf("MONDR USB: DWC3 GUSB2PHYCFG 0x%08x (susphy %u) GUSB3PIPECTL 0x%08x\n",
+		    usb_rd(dwc, DWC3_GUSB2PHYCFG),
+		    (usb_rd(dwc, DWC3_GUSB2PHYCFG) >> 6) & 1,
+		    usb_rd(dwc, DWC3_GUSB3PIPECTL));
+		printf("MONDR USB: DWC3 DCFG 0x%08x DCTL 0x%08x (%s) DSTS 0x%08x DEVTEN 0x%08x\n",
+		    usb_rd(dwc, DWC3_DCFG), usb_rd(dwc, DWC3_DCTL),
+		    (usb_rd(dwc, DWC3_DCTL) & (1u << 31)) ? "run" : "stop",
+		    usb_rd(dwc, DWC3_DSTS), usb_rd(dwc, DWC3_DEVTEN));
+		printf("MONDR USB: DWC3 DALEPENA 0x%08x GEVNTADR 0x%08x%08x SIZ 0x%08x COUNT 0x%08x\n",
+		    usb_rd(dwc, DWC3_DALEPENA), usb_rd(dwc, DWC3_GEVNTADRHI),
+		    usb_rd(dwc, DWC3_GEVNTADRLO), usb_rd(dwc, DWC3_GEVNTSIZ),
+		    usb_rd(dwc, DWC3_GEVNTCOUNT));
+		printf("MONDR USB: DWC3 GSBUSCFG0 0x%08x GSBUSCFG1 0x%08x GUCTL 0x%08x GUCTL1 0x%08x\n",
+		    usb_rd(dwc, DWC3_GSBUSCFG0), usb_rd(dwc, DWC3_GSBUSCFG1),
+		    usb_rd(dwc, DWC3_GUCTL), usb_rd(dwc, DWC3_GUCTL1));
+		if (usb >= 2) {
+			mondrian_usb_gadget_start(dwc);
+		}
+	}
+
+	{
+		vm_offset_t qs = ml_io_map(QSCRATCH_PAGE_PA, PAGE_SIZE_4K);
+
+		if (qs != 0) {
+			printf("MONDR USB: QSCRATCH general 0x%08x hs_phy_ctrl 0x%08x ss_phy_ctrl 0x%08x\n",
+			    usb_rd(qs, QSCRATCH_OFF + QSCRATCH_GENERAL_CFG),
+			    usb_rd(qs, QSCRATCH_OFF + QSCRATCH_HS_PHY_CTRL),
+			    usb_rd(qs, QSCRATCH_OFF + QSCRATCH_SS_PHY_CTRL));
+		}
+	}
+
+	{
+		vm_offset_t phy = ml_io_map(EUSB2_PA, PAGE_SIZE_4K);
+
+		if (phy == 0) {
+			printf("MONDR USB: eUSB2 PHY map failed\n");
+			return;
+		}
+		printf("MONDR USB: eUSB2 common0 0x%08x (enable %u, fsel 0x%x) ctrl2 0x%08x ctrl3 0x%08x\n",
+		    usb_rd(phy, EUSB2_HS_PHY_COMMON0), usb_rd(phy, EUSB2_HS_PHY_COMMON0) & 1,
+		    (usb_rd(phy, EUSB2_HS_PHY_COMMON0) >> 4) & 7,
+		    usb_rd(phy, EUSB2_CFG_CTRL_2), usb_rd(phy, EUSB2_CFG_CTRL_3));
+		printf("MONDR USB: eUSB2 utmi_ctrl0 0x%08x utmi_ctrl5 0x%08x hs_phy_ctrl2 0x%08x\n",
+		    usb_rd(phy, EUSB2_UTMI_CTRL0), usb_rd(phy, EUSB2_UTMI_CTRL5),
+		    usb_rd(phy, EUSB2_HS_PHY_CTRL2));
+		printf("MONDR USB: eUSB2 cfg0 0x%08x cmn_ctrl0 0x%08x fsel_sel 0x%08x\n",
+		    usb_rd(phy, EUSB2_CFG0), usb_rd(phy, EUSB2_CMN_CTRL0),
+		    usb_rd(phy, EUSB2_FSEL_SEL));
+	}
+
+	/*
+	 * apps_smmu (0x15000000) is intentionally not probed: reading it here
+	 * raises a synchronous external abort (esr 0x96000010), so the block is
+	 * powered down / not clocked in this state - which also means the USB
+	 * stream cannot be translating through it. If the gadget's first DMA
+	 * resets the phone, the SMR/S2CR work is the one in anonbeat1's
+	 * 0091-sweet-spacewar-usb-net-smmu.patch (reuse ABL's SMR for the SID).
+	 */
+	printf("MONDR USB: probe done\n");
+}
+
+/*
+ * Step 2: USB device mode with only the default control endpoint, enough
+ * for the host to enumerate the phone (boot-arg usb=2). ABL leaves
+ * the DWC3 powered, clocked, in device mode and halted, with the PHY set
+ * up, so only the device controller is restarted: soft reset, an event
+ * buffer in our memory, endpoint 0, run. Events are polled from a kernel
+ * thread (no interrupt), like the UFS driver. DMA is not cache coherent
+ * (DT qcom,gsi-disable-io-coherency): buffers are cleaned/invalidated.
+ * Register layout and the control-transfer state machine follow the
+ * Synopsys DWC3 databook as used by Linux drivers/usb/dwc3 (gadget.c,
+ * ep0.c).
+ */
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+/*
+ * Qualcomm wrapper registers ("QSCRATCH", core base + 0xf8800). The
+ * controller only connects (pull-up on D+) while it sees a valid VBUS
+ * session; Linux dwc3-qcom forces that in software when the charger
+ * reports a cable (dwc3_qcom_vbus_override_enable).
+ */
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_TRB_RX       0x1020          /* ep1 OUT (bulk, host -> phone) */
+#define UD_TRB_TX       0x1030          /* ep1 IN (bulk, phone -> host) */
+#define UD_TRB_INT      0x1050          /* ep2 IN (interrupt, notifications) */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1300          /* 16-byte notification */
+#define UD_RX           0x2000          /* one received frame */
+#define UD_TX           0x2800          /* one frame to send */
+#define UD_FRAME_MAX    0x800
+#define UD_SIZE         0x4000
+
+/* Physical endpoints: 2n = OUT, 2n+1 = IN */
+#define EP_RX           2               /* 0x01 bulk OUT */
+#define EP_TX           3               /* 0x81 bulk IN */
+#define EP_INT          5               /* 0x82 interrupt IN */
+#define TRBCTL_NORMAL   (1u << 4)
+
+#define UD_TXQ          32
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+	bool        configured;
+	uint8_t     data_alt;       /* data interface alternate setting */
+	/* network */
+	ifnet_t     ifp;
+	lck_mtx_t  *lock;           /* TX ring and TX endpoint */
+	mbuf_t      txq[UD_TXQ];
+	unsigned    txq_head, txq_count;
+	bool        tx_busy;
+	uint64_t    rx_frames, tx_frames;
+} ud;
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("MONDR USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("MONDR USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	return -1;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep. */
+static void
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/*
+ * USB descriptors: a CDC-ECM (Ethernet) function, which Linux (cdc_ether)
+ * and macOS drive without extra drivers. VID 0x1209 / PID 0x0001 =
+ * pid.codes test ID, not a product.
+ */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[80] = {
+	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* The host side's MAC (ECM iMACAddress); the phone's own is ..:02 */
+static const char *const ud_strings[] = {
+	NULL, "ios-mondrian", "Poco F5 Pro (USB Ethernet)", "0001", "02005E77EE01",
+};
+static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	/*
+	 * DEPCFG is only valid on a disabled endpoint: reconfiguring after a
+	 * bus reset with the old DALEPENA bits still set left the controller
+	 * with a stale configuration and no transfer ever completed there.
+	 */
+	dwc_wr(DALEPENA, (1u << 0) | (1u << 1));	/* EP0/EP1 stay enabled */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("MONDR USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud_rx_arm();
+	printf("MONDR USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	printf("MONDR USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("MONDR USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		}
+		printf("MONDR USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured) {
+				ud_notify_connected();
+				ud_link_event(true);
+			}
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 || req == 3) { /* CLEAR/SET_FEATURE (halt, remote wakeup) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+static void
+ud_rx_arm(void)
+{
+	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = len;
+			ud.rx_frames++;
+			ifnet_input(ud.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	ud_rx_arm();
+}
+
+/* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_tx_kick_locked(void)
+{
+	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		mbuf_freem(m);
+		/* A frame of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one pad byte does the same (IP ignores it). */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+	}
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return 0;
+}
+
+/*
+ * Link state for configd (KernelEventMonitor reads SIOCGIFMEDIA and the
+ * KEV_DL_LINK_ON/OFF events; IPMonitor does not route through a service
+ * whose interface has no active link).
+ */
+static void
+ud_link_event(bool up)
+{
+	if (ud.ifp != NULL) {
+		dlil_post_msg(ud.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = ud.configured ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (ud.configured ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
