xnu 0463: let the restart reason finish before the reset

Measured 2026-11-26: three boots in a row ended on `boot_b` instead of
fastboot, and the live capture of the last one stops right after
`MONDRIAN RESET: BCB "bootloader" at misc block 0x400: 0` -- neither the
reason thread nor the PSCI line reaches the console.

Two fixes. The reason thread now prints at entry and after the SPMI write, so
the next capture separates "never started" from "blocked in the PMIC". The
wait goes from 500 ms to 5 s and reports the elapsed time, because the PMIC
write is not instant even when the arbiter answers and a reset that leaves
without the reason boots the active slot. The last flush is followed by 50 ms
before PSCI, so the line that names the step is not lost in the USB path.

diff --git a/bsd/dev/mondrian_ufs.c b/bsd/dev/mondrian_ufs.c
index 977063b..2cf4945 100644
--- a/bsd/dev/mondrian_ufs.c
+++ b/bsd/dev/mondrian_ufs.c
@@ -1667,8 +1667,17 @@ static int mondrian_reason_done;
 static void
 mondrian_reason_thread(__unused void *arg, __unused wait_result_t wr)
 {
+	/*
+	 * Print each edge: the capture after the BCB line used to be empty, and
+	 * "the thread never started" and "it blocked in the SPMI write" look
+	 * identical from the caller (measured 2026-11-26).
+	 */
+	printf("MONDRIAN RESET: reason thread start\n");
+	mondrian_log_flush_now();
 	mondrian_reset_reason_set = 0;      /* force it, even after a failed try */
 	mondrian_set_reset_reason(0);
+	printf("MONDRIAN RESET: reason thread done\n");
+	mondrian_log_flush_now();
 	mondrian_reason_done = 1;
 }
 
@@ -1685,7 +1694,7 @@ static void
 mondrian_reset_to_bootloader(int recovery)
 {
 	thread_t t;
-	int i, wrote = 0;
+	int i, wrote = 0, waited = 0;
 
 	printf("MONDRIAN RESET: bcb %s\n", recovery ? "boot-recovery" : "bootloader");
 	mondrian_log_flush_now();
@@ -1694,19 +1703,34 @@ mondrian_reset_to_bootloader(int recovery)
 	if (kernel_thread_start((thread_continue_t)mondrian_reason_thread, NULL,
 	    &t) == KERN_SUCCESS) {
 		thread_deallocate(t);
-		for (i = 0; i < 500 && !mondrian_reason_done; i++) {
+		/*
+		 * The PMIC write is not instant even when the arbiter answers,
+		 * and a reset that leaves without the reason lands on the
+		 * active slot instead of fastboot (measured 2026-11-26, three
+		 * boots in a row). Five seconds still cannot strand the port,
+		 * and the elapsed time names the real cost.
+		 */
+		for (i = 0; i < 5000 && !mondrian_reason_done; i++) {
 			delay(1000);
+			waited = i;
 		}
 		wrote = mondrian_reason_done;
 	}
-	printf("MONDRIAN RESET: PSCI system reset to %s, reason %s\n",
-	    recovery ? "recovery" : "fastboot", wrote ? "written" : "gave up");
+	printf("MONDRIAN RESET: PSCI system reset to %s, reason %s after %d ms\n",
+	    recovery ? "recovery" : "fastboot", wrote ? "written" : "gave up",
+	    (waited + 1) * 1000);
 	/*
 	 * Flush here: this is the last line before the monitor. Everything the
 	 * reset path prints after it stays in memory, and a reset the monitor
 	 * refuses then reads as a boot that stopped at the previous step.
 	 */
 	mondrian_log_flush_now();
+	/*
+	 * Give the datagram time to leave: a flush followed by the SMC on the
+	 * next instruction loses the line in the USB path (measured 2026-11-26,
+	 * the last capture ended at the BCB write).
+	 */
+	delay(50000);
 	(void)mondrian_smc(0x84000009ull);      /* PSCI_SYSTEM_RESET */
 	/*
 	 * PSCI returned, so no reset happened. Dropping PS_HOLD collapses the
