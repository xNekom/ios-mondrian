+
+/* The cmd-db and RPMh helpers live in the touch driver (same TCS/RSC path). */
+extern uint32_t mondrian_cmd_db_addr(const char *id);
+extern const void *mondrian_cmd_db_data(const char *id, uint32_t *len);
+extern int mondrian_rpmh_write_one(uint32_t addr, uint32_t data);
+
+/*
+ * The GPUCC hub clock is hardware-controlled (HW_CLK_CTRL_MODE): the AO
+ * keeps it off until the GPU rails are voted in RPMh. The cmd-db carries
+ * the ARC level table of each rail; vote MX (the parent supply) then CX at
+ * the highest level before any GPUCC access.
+ */
+static void
+mondrian_gpu_vote_rails(void)
+{
+	static const char *rails[] = { "mx.lvl", "cx.lvl" };
+	uint32_t r;
+
+	for (r = 0; r < sizeof(rails) / sizeof(rails[0]); r++) {
+		uint32_t len = 0;
+		uint32_t addr = mondrian_cmd_db_addr(rails[r]);
+		const uint16_t *tbl = mondrian_cmd_db_data(rails[r], &len);
+		uint16_t max = 0;
+		uint32_t i;
+
+		if (addr == 0 || tbl == NULL || len < 2) {
+			printf("MONDRIAN GPU: rail %s missing\n", rails[r]);
+			continue;
+		}
+		for (i = 0; i < len / 2; i++) {
+			if (tbl[i] > max) {
+				max = tbl[i];
+			}
+		}
+		printf("MONDRIAN GPU: rail %s addr 0x%x n %u max 0x%x\n",
+		    rails[r], addr, len / 2, max);
+		(void)mondrian_rpmh_write_one(addr, max);
 	}
 }
 
