xnu 0170: vote the GPU rails in RPMh (gpupower=1)

The GPUCC hub clock is HW_CLK_CTRL_MODE: the AO keeps it off until the
GPU rails are voted in RPMh, which is why the AHB never enabled and the
GMU read back 0xdeafbead. Export the touch driver's cmd-db lookup (with
the auxiliary ARC table) and a single-command TCS write, then vote MX and
CX at the highest ARC level of each rail before the GPUCC sequence.
--- a/bsd/dev/mondrian_touch.c
+++ b/bsd/dev/mondrian_touch.c
@@ -467,7 +467,7 @@
  * The LDO resource address lives in the command DB, keyed by the vendor's
  * qcom,resource-name ("ldoc2" for pm8350c_l2).
  */
-static uint32_t
+uint32_t
 mondrian_cmd_db_addr(const char *id)
 {
 	vm_offset_t db = ml_io_map(MONDRIAN_CMD_DB_PA, MONDRIAN_CMD_DB_SIZE);
@@ -504,6 +504,92 @@
 		}
 	}
 	printf("MONDRIAN TOUCH: cmd-db has no \"%s\"\n", id);
+	return 0;
+}
+
+/*
+ * The auxiliary table of a cmd-db resource (the ARC levels of a rail, or the
+ * BCM list). Layout: header 0x90 bytes, resource entries 24 bytes (id[8],
+ * priority[2], addr at +16, len at +20, offset at +22), data at
+ * 0x90 + the resource's data offset + the entry's offset.
+ */
+const void *
+mondrian_cmd_db_data(const char *id, uint32_t *len)
+{
+	vm_offset_t db = ml_io_map(MONDRIAN_CMD_DB_PA, MONDRIAN_CMD_DB_SIZE);
+	const uint8_t *b = (const uint8_t *)db;
+	uint32_t i, j;
+
+	if (db == 0) {
+		return NULL;
+	}
+	if (b[4] != 0xdb || b[5] != 0x30 || b[6] != 0x03 || b[7] != 0x0c) {
+		return NULL;
+	}
+	for (i = 0; i < 8; i++) {
+		const uint8_t *h = b + 8 + 16 * i;
+		uint32_t count, eoff;
+		uint16_t doff;
+		const uint8_t *e;
+
+		if ((h[0] | (h[1] << 8)) == 0) {
+			break;
+		}
+		eoff = h[2] | (h[3] << 8);
+		count = h[6] | (h[7] << 8);
+		doff = (uint16_t)(h[4] | (h[5] << 8));
+		e = b + 0x90 + eoff;
+		for (j = 0; j < count; j++, e += 24) {
+			if (memcmp(e, id, strlen(id)) == 0) {
+				uint16_t l, off;
+
+				memcpy(&l, e + 20, 2);
+				memcpy(&off, e + 22, 2);
+				*len = l;
+				return b + 0x90 + doff + off;
+			}
+		}
+	}
+	return NULL;
+}
+
+/*
+ * One command through the first ACTIVE TCS, for resources whose vote is a
+ * single word (the ARC level of a rail). Same trigger sequence as the LDO
+ * vote: AMC mode, clear, enable, trigger.
+ */
+int
+mondrian_rpmh_write_one(uint32_t addr, uint32_t data)
+{
+	vm_offset_t rsc = ml_io_map(MONDRIAN_RSC_PA, MONDRIAN_RSC_SIZE);
+	uint32_t base = MONDRIAN_RSC_ACTIVE_BASE;
+	uint32_t msgid = MONDRIAN_CMD_MSGID_LEN | MONDRIAN_CMD_MSGID_WRITE |
+	    MONDRIAN_CMD_MSGID_RESP;
+	uint32_t i, ctrl;
+
+	if (rsc == 0 || addr == 0) {
+		return -1;
+	}
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ENABLE, 0);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_MSGID, msgid);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ADDR, addr);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_DATA, data);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ENABLE, 0x1);
+	__builtin_arm_dsb(0xf);
+	ctrl = mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CONTROL);
+	ctrl &= ~MONDRIAN_TCS_AMC_TRIGGER;
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, ctrl);
+	ctrl &= ~MONDRIAN_TCS_AMC_ENABLE;
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, ctrl);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, MONDRIAN_TCS_AMC_ENABLE);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL,
+	    MONDRIAN_TCS_AMC_ENABLE | MONDRIAN_TCS_AMC_TRIGGER);
+	__builtin_arm_dsb(0xf);
+	for (i = 0; i < 1000000; i++) {
+		if ((mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_ENABLE) & 0x1) == 0) {
+			break;
+		}
+	}
 	return 0;
 }
 
--- a/bsd/dev/mondrian_gpu.c
+++ b/bsd/dev/mondrian_gpu.c
@@ -122,6 +122,45 @@
 			break;
 		}
 		delay(10);
