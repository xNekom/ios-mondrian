xnu 0488: read the QCA6490 boot-ROM stage around the BHI doorbell

Measured 2026-11-27: 0487's real cache clean leaves BHI_STATUS at 0, and with
only 8 KiB mapped at 0xa1000000 the SMMU sees no read past 0xa1002000. The
image is the 0x50d000 amss20.bin and the doorbell/address registers read back,
so the next question is where the boot ROM stops.

Read the QCA6490 telemetry after the SOC reset and after the status poll:
TCSR_PBL_LOGGING (0x01b000f8), PBL_WLAN_BOOT_CFG (0x01e22b34),
PBL_BOOTSTRAP_STATUS (0x01910008), BHI_ERRDBG2/3 (0x01e0e238/0x01e0e23c),
WLAN_SECURE_BOOTN (0x01e22b24), TLMM_OD_EN (0x01910020), the WLAON power
registers and the PBL log SRAM. The addresses are the vendor cnss2 reg.h
values; the two not in that header are the 7a stock-port reads in the same
windows. All are read-only. The first 512 KiB checksum is logged so a wrong
image cannot be mistaken for a ROM stall.

diff --git a/bsd/dev/mondrian_wifi.c b/bsd/dev/mondrian_wifi.c
--- a/bsd/dev/mondrian_wifi.c
+++ b/bsd/dev/mondrian_wifi.c
@@ -1175,7 +1175,7 @@
 #define WIFI_AHB_WINDOW_BASE	0x80000
 #define WIFI_AHB_WINDOW_ENABLE	0x40000000u
 #define WIFI_AHB_RANGE		0x7ffffu
-#define WIFI_AHB_PAGES		4
+#define WIFI_AHB_PAGES	12
 
 static vm_offset_t wifi_ahb_maps[WIFI_AHB_PAGES];
 static uint32_t wifi_ahb_offs[WIFI_AHB_PAGES];
@@ -1257,6 +1257,48 @@
 }
 
 /*
+ * QCA6490 boot-ROM telemetry. The register addresses are the vendor cnss2
+ * reg.h values: TCSR_PBL_LOGGING 0x01b000f8, PBL_WLAN_BOOT_CFG 0x01e22b34,
+ * PBL_BOOTSTRAP_STATUS 0x01910008 and BHI_ERRDBG2/3 0x01e0e238/0x01e0e23c.
+ * WLAN_SECURE_BOOTN (0x01e22b24) and TLMM_OD_EN (0x01910020) are the
+ * addresses the 7a stock port read in the same windows. All are read-only.
+ *
+ * The PBL log SRAM is read only after the doorbell: reading it while the ROM
+ * is still running is the read that can hang the window.
+ */
+static void
+wifi_pbl_dump(const char *tag, int sram)
+{
+	uint32_t v[8] = { 0 };
+	uint32_t wl_pwr = 0;
+	int rc = 0;
+	unsigned i;
+
+	rc |= wifi_ahb_read32(0x1b000f8, &v[0]);
+	rc |= wifi_ahb_read32(0x1e22b34, &v[1]);
+	rc |= wifi_ahb_read32(0x1910008, &v[2]);
+	rc |= wifi_ahb_read32(0x1e0e238, &v[3]);
+	rc |= wifi_ahb_read32(0x1e0e23c, &v[4]);
+	rc |= wifi_ahb_read32(0x1e22b24, &v[5]);
+	rc |= wifi_ahb_read32(0x1910020, &v[6]);
+	rc |= wifi_ahb_read32(0x1f80000, &v[7]);
+	(void)wifi_ahb_read32(0x1f8002c, &wl_pwr);
+	wifi_log("W16 %s pbl=0x%x boot_cfg=0x%x bootstrap=0x%x"
+	    " errdbg2=0x%x errdbg3=0x%x secure=0x%x od_en=0x%x"
+	    " soc_pwr=0x%x wl_pwr=0x%x rc=0x%x", tag, v[0], v[1], v[2], v[3],
+	    v[4], v[5], v[6], v[7], wl_pwr, rc);
+	if (sram != 0) {
+		for (i = 0; i < 10; i++) {
+			if (wifi_ahb_read32(0x1403d58 + i * 4, &v[0]) != 0) {
+				break;
+			}
+			wifi_log("W16 %s sram[%u]=0x%x", tag, i, v[0]);
+		}
+	}
+	mondrian_log_flush_now();
+}
