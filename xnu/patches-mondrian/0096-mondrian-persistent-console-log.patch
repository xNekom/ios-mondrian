+
+/*
+ * Persistent console log ("mondrianlog"). A photo of the panel is the only
+ * other way to read a boot, and it shows one screenful of a log that is chatty
+ * enough to push the lines that matter off it. So every character that reaches
+ * the console -- kernel printf and the daemons' /dev/console writes, both
+ * through _cnputs -- is also kept in a 4 MiB ring in RAM, and once the
+ * partition is known a thread copies the new blocks to the LAST 4 MiB + 4 KiB
+ * of userdata, far behind the HFS image at its start. Device block 0 of that
+ * area is a header:
+ *
+ *   "MONDLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ *
+ * and byte n of the console stream is at ring offset n % ring size. Read a
+ * previous boot with a dump kernel (`mondriandump=1`), which prints selected
+ * first/last matches before stopping. The shim log viewer is unreliable on
+ * this UFS host. Boot-arg mondrianlog=0 turns persistence off.
+ */
+#define MONDRIAN_LOG_SIZE       (4u << 20)
+#define MONDRIAN_LOG_BLOCKS     (1 + MONDRIAN_LOG_SIZE / UFS_BLOCK)
+#define MONDRIAN_LOG_TICKS      5
+
+static char mondrian_log_ring[MONDRIAN_LOG_SIZE];
+static uint64_t _Atomic mondrian_log_total;
+static int mondrian_log_chan;
+
+/* Called for every console character, in any context: never blocks. */
+void
+mondrian_log_append(const char *c, int size)
+{
+	uint64_t at;
+
+	if (size <= 0) {
+		return;
+	}
+	at = os_atomic_add_orig(&mondrian_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		mondrian_log_ring[(at + (uint64_t)i) % MONDRIAN_LOG_SIZE] = c[i];
+	}
+}
+
+struct mondrian_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+mondrian_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("MONDRIAN LOG: console ring in the last %u KiB of the partition (block 0x%llx)\n",
+	    MONDRIAN_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		uint64_t total, pos;
+		int error = 0;
+
+		(void)tsleep(&mondrian_log_chan, PZERO, "mondrianlog", MONDRIAN_LOG_TICKS * hz);
+		total = os_atomic_load(&mondrian_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		/*
+		 * Write whole device blocks, from the first block that holds
+		 * unflushed data: a partial block would lose the bytes that
+		 * follow it, and the ring is not block aligned.
+		 */
+		pos = (total - flushed >= MONDRIAN_LOG_SIZE) ? total - MONDRIAN_LOG_SIZE : flushed;
+		lck_mtx_lock(&mondrian_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % MONDRIAN_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)(off % UFS_BLOCK) + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(MONDRIAN_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+
+			memcpy(bounce, mondrian_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct mondrian_log_header h = {
+				.magic = { 'M', 'O', 'N', 'D', 'L', 'O', 'G' },
+				.version = 1, .size = MONDRIAN_LOG_SIZE, .total = total, .seq = ++seq
+			};
+
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_flush();
+		}
+		lck_mtx_unlock(&mondrian_ufs_lock);
+		if (error) {
+			printf("MONDRIAN LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+/* Does the line contain `want`? strstr(a,b) drawn at home. */
+static bool
+mondrian_log_contains(const char *line, const char *want)
+{
+	size_t n = strlen(want);
+
+	if (n == 0) {
+		return true;
+	}
+	for (; *line != 0; line++) {
+		if (strncmp(line, want, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * Boot-arg mondriandump=N (N>0 turns it on) with mondriandumpmatch=a,b,c (up
+ * to four terms, default "SMP"): count the lines of the PREVIOUS boot's
+ * console log that contain each term and print the first and the last of each,
+ * then stop the boot there.
+ *
+ * The log runs at hundreds of lines a second, so "the last forty lines" is a
+ * tenth of a second of it, and the question is never "what was the last line"
+ * but "did this ever happen, and where was it". A count and the newest match
+ * answer that in a few lines that survive being read off a screen.
+ */
+static void
+mondrian_log_dump(uint32_t lines)
+{
+	static char text[MONDRIAN_LOG_SIZE + 1];
+	static char first[4][80], last[4][80];
+	static uint32_t hits[4];
+	char terms[128] = "SMP";
+	char *term[4];
+	uint32_t nterms = 0, nlines = 0, got = 0, have, ring;
+	uint64_t base = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS;
+	uint64_t total, pos;
+	char *h = (char *)(su.dma + DMA_BOUNCE);
+
+	if (lines == 0) {
+		return;
+	}
+	if (ufs_read_blocks(base, 1)) {
+		printf("MONDRIANDUMP: header read failed\n");
+		return;
+	}
+	if (memcmp(h, "MONDLOG", 7) != 0) {
+		printf("MONDRIANDUMP: no MONDLOG header (the log never flushed)\n");
+		return;
+	}
+	ring = *(uint32_t *)(h + 12);
+	total = *(uint64_t *)(h + 16);
+	if (ring == 0 || ring > MONDRIAN_LOG_SIZE || total == 0) {
+		printf("MONDRIANDUMP: empty or bad ring\n");
+		return;
+	}
+
+	/* The terms. */
+	(void)PE_parse_boot_argn("mondriandumpmatch", terms, sizeof(terms));
+	for (char *t = terms; *t != 0 && nterms < 4; ) {
+		char *end = strchr(t, ',');
+		size_t len = end ? (size_t)(end - t) : strlen(t);
+
+		if (len > 0) {
+			char save = t[len];
+
+			t[len] = 0;
+			term[nterms++] = t;
+			t[len] = save;
+		}
+		t = end ? end + 1 : t + len;
+	}
+
+	/* The whole ring: a filtered window has to be minutes wide. */
+	have = total < ring ? (uint32_t)total : ring;
+	if (have > MONDRIAN_LOG_SIZE) {
+		have = MONDRIAN_LOG_SIZE;
+	}
+	pos = (total % ring + ring - have) % ring;
+	uint32_t const per_read = BOUNCE_SIZE / UFS_BLOCK;
+	while (got < have) {
+		uint32_t off = (uint32_t)(pos % ring);
+		uint32_t n = MIN(have - got, ring - off);
+		uint32_t blocks = (off % UFS_BLOCK + n + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t skip = off % UFS_BLOCK;
+
+		if (blocks > per_read) {
+			blocks = per_read;
+		}
+		if (ufs_read_blocks(base + 1 + off / UFS_BLOCK, blocks)) {
+			printf("MONDRIANDUMP: read failed at ring offset %u\n", off);
+			break;
+		}
+		n = MIN(n, blocks * UFS_BLOCK - skip);
+		memcpy(text + got, (char *)(su.dma + DMA_BOUNCE) + skip, n);
+		got += n;
+		pos = (pos + n) % ring;
+	}
+	text[got] = 0;
+
+	for (char *c = text, *start = text; ; c++) {
+		if (*c != '\n' && *c != 0) {
+			continue;
+		}
+		char stop = *c;
+
+		*c = 0;
+		if (c > start) {
+			nlines++;
+			for (uint32_t t = 0; t < nterms; t++) {
+				if (!mondrian_log_contains(start, term[t])) {
+					continue;
+				}
+				hits[t]++;
+				if (first[t][0] == 0) {
+					snprintf(first[t], sizeof(first[t]), "%s", start);
+				}
+				snprintf(last[t], sizeof(last[t]), "%s", start);
+			}
+		}
+		if (stop == 0) {
+			break;
+		}
+		start = c + 1;
+	}
+
+	printf("MONDRIANDUMP: %u lines, %llu bytes written, ring %u\n", nlines, total, ring);
+	for (uint32_t t = 0; t < nterms; t++) {
+		printf("MONDRIANDUMP: \"%s\" %u hits\n", term[t], hits[t]);
+		if (hits[t] != 0) {
+			printf("  first | %s\n", first[t]);
+			printf("  last  | %s\n", last[t]);
+		}
+	}
+	printf("MONDRIANDUMP: end\n");
+	for (;;) {
+		delay(1000);
+	}
 }
+
+static void
+mondrian_log_start(void)
+{
+	static int started;
+	uint32_t on = 1;
+	thread_t thread;
+
+	if (started || !su.ready) {
+		return;
+	}
+	PE_parse_boot_argn("mondrianlog", &on, sizeof(on));
+	if (!on || su.nblocks < 2 * MONDRIAN_LOG_BLOCKS) {
+		return;
+	}
+	if (kernel_thread_start(mondrian_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		started = 1;
+		thread_deallocate(thread);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_MONDRIAN */
