+
+/*
+ * Persistent console log ("mondrianlog"). A photo of the panel is the only
+ * other way to read a boot, and it shows one screenful of a log that is chatty
+ * enough to push the lines that matter off it. So every character that reaches
+ * the console -- kernel printf and the daemons' /dev/console writes, both
+ * through _cnputs -- is also kept in a 4 MiB ring in RAM, and once the
+ * partition is known a thread copies the new blocks to the LAST 4 MiB + 4 KiB
+ * of userdata, far behind the HFS image at its start. Device block 0 of that
+ * area is a header:
+ *
+ *   "MONDLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ *
+ * and byte n of the console stream is at ring offset n % ring size. Read it
+ * back by booting the log viewer shim (`shim/build.sh` with LOGVIEW=1, started
+ * with `fastboot boot`), or from a recovery with adb using
+ * tools/ios-log-pull.sh. Boot-arg mondrianlog=0 turns it off.
+ */
+#define MONDRIAN_LOG_SIZE       (4u << 20)
+#define MONDRIAN_LOG_BLOCKS     (1 + MONDRIAN_LOG_SIZE / UFS_BLOCK)
+#define MONDRIAN_LOG_TICKS      5
+
+static char mondrian_log_ring[MONDRIAN_LOG_SIZE];
+static uint64_t _Atomic mondrian_log_total;
+static int mondrian_log_chan;
+
+/* Called for every console character, in any context: never blocks. */
+void
+mondrian_log_append(const char *c, int size)
+{
+	uint64_t at;
+
+	if (size <= 0) {
+		return;
+	}
+	at = os_atomic_add_orig(&mondrian_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		mondrian_log_ring[(at + (uint64_t)i) % MONDRIAN_LOG_SIZE] = c[i];
+	}
+}
+
+struct mondrian_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+mondrian_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - MONDRIAN_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("MONDRIAN LOG: console ring in the last %u KiB of the partition (block 0x%llx)\n",
+	    MONDRIAN_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		uint64_t total, pos;
+		int error = 0;
+
+		(void)tsleep(&mondrian_log_chan, PZERO, "mondrianlog", MONDRIAN_LOG_TICKS * hz);
+		total = os_atomic_load(&mondrian_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		/*
+		 * Write whole device blocks, from the first block that holds
+		 * unflushed data: a partial block would lose the bytes that
+		 * follow it, and the ring is not block aligned.
+		 */
+		pos = (total - flushed >= MONDRIAN_LOG_SIZE) ? total - MONDRIAN_LOG_SIZE : flushed;
+		lck_mtx_lock(&mondrian_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % MONDRIAN_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)(off % UFS_BLOCK) + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(MONDRIAN_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+
+			memcpy(bounce, mondrian_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct mondrian_log_header h = {
+				.magic = { 'M', 'O', 'N', 'D', 'L', 'O', 'G' },
+				.version = 1, .size = MONDRIAN_LOG_SIZE, .total = total, .seq = ++seq
+			};
+
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_flush();
+		}
+		lck_mtx_unlock(&mondrian_ufs_lock);
+		if (error) {
+			printf("MONDRIAN LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
 }
+
+static void
+mondrian_log_start(void)
+{
+	static int started;
+	uint32_t on = 1;
+	thread_t thread;
+
+	if (started || !su.ready) {
+		return;
+	}
+	PE_parse_boot_argn("mondrianlog", &on, sizeof(on));
+	if (!on || su.nblocks < 2 * MONDRIAN_LOG_BLOCKS) {
+		return;
+	}
+	if (kernel_thread_start(mondrian_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		started = 1;
+		thread_deallocate(thread);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_MONDRIAN */
