diff --git a/bsd/dev/mondrian_btctl.c b/bsd/dev/mondrian_btctl.c
new file mode 100644
index 0000000..1585ae1
--- /dev/null
+++ b/bsd/dev/mondrian_btctl.c
@@ -0,0 +1,1353 @@
+/*
+ * com.mondrian.btuart: the HCI control bluetoothd's POSIX driver opens.
+ *
+ * The driver takes the third token of BT_HCI_TRANSPORT as the control name
+ * (0x100156264). The name decides the data path: the literal
+ * "com.apple.uart.sk.bluetooth" makes the driver ask for a Skywalk channel
+ * UUID and abort when os_channel_create() returns NULL, while any other name
+ * takes the termios path at 0x100066e50 and then writes and reads this socket
+ * directly. Skywalk is not built into this kernel, so the control uses a name
+ * of its own and the shim tells the daemon to use it.
+ *
+ * The node /dev/cu.bluetooth still exists: FindLocalMacAddress in the same
+ * binary access()es it to decide that a serial port is present, before it
+ * tries the IORegistry.
+ *
+ * The options are Darwin's _IO* encoding, so they arrive with their size and
+ * direction bits intact. The 12-byte UART option is
+ * { maxReadSize=1024, rxWatermark=63, txWatermark=63 } as measured at
+ * 0x100675260 in the daemon; it only matters to the channel path, which is
+ * not used.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kern_control.h>
+#include <sys/mbuf.h>
+#include <sys/errno.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/termios.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+
+extern int mondrian_btuart_tty_open(void);
+extern int mondrian_btuart_tty_write(const void *buf, size_t len);
+extern int mondrian_btuart_tty_read(void *buf, size_t cap);
+
+#define MONDRIAN_BTCTL_NAME     "com.mondrian.btuart"
+
+#define MONDRIAN_BTCTL_GET_TERMIOS      0x40487413      /* _IOR('t', 0x13, struct termios) */
+#define MONDRIAN_BTCTL_GET_UUID         0x40105412      /* _IOR('t', 0x12, uuid_t) */
+#define MONDRIAN_BTCTL_SET_UART         0x800c5414      /* _IOW('T', 0x14, 12) */
+#define MONDRIAN_BTCTL_SET_TERMIOS      0x80487414      /* _IOW('t', 0x14, struct termios) */
+
+#define MONDRIAN_BTCTL_POLL_MS          10
+#define MONDRIAN_BTCTL_RX_MAX           128
+#define MONDRIAN_BTCTL_PENDING          4096
+#define MONDRIAN_BTCTL_OUT_MAX          4096
+#define MONDRIAN_BTCTL_LOG_PACKETS      64
+
+static LCK_GRP_DECLARE(mondrian_btctl_grp, "mondrian_btctl");
+static LCK_MTX_DECLARE(mondrian_btctl_lock, &mondrian_btctl_grp);
+static LCK_MTX_DECLARE(mondrian_btctl_tx_lock, &mondrian_btctl_grp);
+
+static kern_ctl_ref mondrian_btctl_kref;
+static thread_call_t mondrian_btctl_call;
+
+static struct {
+	kern_ctl_ref kref;
+	uint32_t unit;
+	int active;
+	int tx_logged;
+	int rx_logged;
+	unsigned tx_packets;
+	unsigned tx_fails;
+	unsigned rx_packets;
+	unsigned le_meta;
+	unsigned le_adv;
+	unsigned le_scan_rsp;
+	unsigned inquiry_results;
+	unsigned inquiry_cmds;
+	unsigned name_reqs;
+	unsigned legacy_enable;
+	unsigned legacy_disable;
+	unsigned ext_enable;
+	unsigned ext_disable;
+	unsigned scan_refused;
+	unsigned scan_translated;
+	unsigned ext_reports;
+	unsigned ext_report_logged;
+	unsigned rx_dropped;
+	unsigned rx_filler;
+	unsigned rx_acks;
+	unsigned names_added;
+	unsigned names_noted;
+	unsigned ext_params_pending;
+	unsigned ext_enable_pending;
+	uint8_t pending[MONDRIAN_BTCTL_PENDING];
+	size_t pending_len;
+	uint64_t opened;
+	uint64_t last_tx;
+	uint64_t last_rx;
+} mondrian_btctl;
+
+static void mondrian_btctl_poll(thread_call_param_t, thread_call_param_t);
+
+static void
+mondrian_btctl_dump(const char *what, const uint8_t *buf, int n)
+{
+	char line[128];
+	int m;
+
+	m = snprintf(line, sizeof(line), "MONDRIAN BTCTL: %s %d", what, n);
+	for (int i = 0; i < n && i < 32 && m < (int)sizeof(line) - 4; i++) {
+		m += snprintf(line + m, sizeof(line) - (size_t)m, " %02x",
+		    buf[i]);
+	}
+	printf("%s\n", line);
+}
+
+/*
+ * The connection summary is the only place that can say what happened after
+ * the first 64 packets, which the ring cannot show: whether LE reports ever
+ * arrive, whether an advertisement carries a name, and whether the daemon asks
+ * for one with Remote Name Request (0x0419). A device list of bare addresses
+ * cannot be told from an unparsed one without these numbers.
+ */
+static void
+mondrian_btctl_count_command(const uint8_t *buf, size_t len)
+{
+	uint16_t opcode;
+
+	if (len < 3 || buf[0] != 0x01) {
+		return;
+	}
+	opcode = (uint16_t)(buf[1] | (buf[2] << 8));
+	switch (opcode) {
+	case 0x0401:
+		mondrian_btctl.inquiry_cmds++;
+		break;
+	case 0x0419:
+		mondrian_btctl.name_reqs++;
+		if (mondrian_btctl.name_reqs <= 4) {
+			mondrian_btctl_dump("name request", buf,
+			    (int)MIN(len, (size_t)16));
+		}
+		break;
+	case 0x200c:
+		if (len >= 5 && buf[4] != 0) {
+			mondrian_btctl.legacy_enable++;
+		} else {
+			mondrian_btctl.legacy_disable++;
+		}
+		break;
+	case 0x2031:
+		if (len >= 5 && buf[4] != 0) {
+			mondrian_btctl.ext_enable++;
+		} else {
+			mondrian_btctl.ext_disable++;
+		}
+		break;
+	}
+}
+
+/*
+ * The daemon ignores the name in the classic inquiry EIR: for a dual-mode
+ * device whose LE advertisement carries no name it answers
+ * kCBMsgIdDeviceGetNameMsg with an empty string (measured 2026-11-21:
+ * kCBMsgArgResult 212, name length 0), while the EIR for the same address
+ * says `55...`. The control sees both streams, so it keeps the EIR name and
+ * appends it to the LE report for that address when the advertisement has no
+ * name of its own.
+ */
+#define MONDRIAN_BTCTL_NAMES 8
+#define MONDRIAN_BTCTL_NAME_LEN 30
+
+struct mondrian_btctl_name {
+	uint8_t addr[6];
+	char name[MONDRIAN_BTCTL_NAME_LEN];
+};
+
+static struct mondrian_btctl_name
+    mondrian_btctl_names[MONDRIAN_BTCTL_NAMES];
+static unsigned mondrian_btctl_names_next;
+
+static void
+mondrian_btctl_note_name(const uint8_t *addr, const uint8_t *data, size_t len)
+{
+	struct mondrian_btctl_name *slot = NULL;
+	unsigned i;
+	int fresh = 0;
+
+	if (len == 0) {
+		return;
+	}
+	if (len >= MONDRIAN_BTCTL_NAME_LEN) {
+		len = MONDRIAN_BTCTL_NAME_LEN - 1;
+	}
+	for (i = 0; i < MONDRIAN_BTCTL_NAMES; i++) {
+		if (bcmp(mondrian_btctl_names[i].addr, addr, 6) == 0) {
+			slot = &mondrian_btctl_names[i];
+			break;
+		}
+	}
+	if (slot == NULL) {
+		slot = &mondrian_btctl_names[
+		    mondrian_btctl_names_next++ % MONDRIAN_BTCTL_NAMES];
+		bcopy(addr, slot->addr, 6);
+		fresh = 1;
+	}
+	bcopy(data, slot->name, len);
+	slot->name[len] = '\0';
+	if (fresh && mondrian_btctl.names_noted < 8) {
+		mondrian_btctl.names_noted++;
+		printf("MONDRIAN BTCTL: name note"
+		    " %02x:%02x:%02x:%02x:%02x:%02x \"%s\"\n",
+		    addr[5], addr[4], addr[3], addr[2], addr[1], addr[0],
+		    slot->name);
+	}
+}
+
+static const char *
+mondrian_btctl_find_name(const uint8_t *addr)
+{
+	unsigned i;
+
+	for (i = 0; i < MONDRIAN_BTCTL_NAMES; i++) {
+		if (mondrian_btctl_names[i].name[0] != '\0' &&
+		    bcmp(mondrian_btctl_names[i].addr, addr, 6) == 0) {
+			return mondrian_btctl_names[i].name;
+		}
+	}
+	return NULL;
+}
+
+static int
+mondrian_btctl_ad_has_name(const uint8_t *data, size_t len)
+{
+	size_t pos = 0;
+
+	while (pos + 1 < len) {
+		size_t elen = data[pos];
+
+		if (elen == 0 || pos + 1 + elen > len) {
+			break;
+		}
+		if (data[pos + 1] == 0x08 || data[pos + 1] == 0x09) {
+			return 1;
+		}
+		pos += 1 + elen;
+	}
+	return 0;
+}
+
+/*
+ * One Inquiry Result response, fixed fields only: number at 3, then 13
+ * bytes (BD_ADDR, page-scan repetition, reserved, class of device, clock
+ * offset) and the EIR. The controller's plen is always 0xff and the bytes
+ * between offset 17 and the real EIR are not cleared, so the name structure
+ * is found by walking the possible starts rather than read at a fixed one.
+ */
+static int
+mondrian_btctl_inquiry_name(const uint8_t *pkt, size_t total, size_t *at)
+{
+	size_t pos;
+
+	if (total < 18 || pkt[3] != 0x01) {
+		return 0;
+	}
+	for (pos = 17; pos + 2 <= total && pos <= 72; pos++) {
+		uint8_t elen = pkt[pos];
+
+		if (elen >= 2 && elen <= 30 &&
+		    (pkt[pos + 1] == 0x08 || pkt[pos + 1] == 0x09) &&
+		    pos + 1 + elen <= total) {
+			*at = pos;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static void
+mondrian_btctl_count_event(const uint8_t *buf, size_t len)
+{
+	unsigned sub;
+
+	if (len < 3 || buf[0] != 0x04) {
+		return;
+	}
+	if (buf[1] == 0x2f) {
+		mondrian_btctl.inquiry_results++;
+		if (mondrian_btctl.inquiry_results <= 4) {
+			mondrian_btctl_dump("inquiry eir", buf,
+			    (int)MIN(len, (size_t)32));
+		}
+		/*
+		 * The fixed response is 13 bytes after the number (address,
+		 * page-scan mode, reserved, class and clock), so a standard EIR
+		 * starts at 17. The WCN7850 firmware instead sends plen 0xff and
+		 * leaves uninitialised bytes before the EIR (measured 2026-11-21:
+		 * e4 c0 repeated for the PC, one junk byte before DIGI R2A), so
+		 * the name structure is searched for instead of assumed.
+		 */
+		{
+			size_t at;
+
+			if (mondrian_btctl_inquiry_name(buf, len, &at)) {
+				mondrian_btctl_note_name(buf + 4, buf + at + 2,
+				    buf[at] - 1);
+			}
+		}
+		return;
+	}
+	if (buf[1] != 0x3e || len < 4) {
+		return;
+	}
+	sub = buf[3];
+	mondrian_btctl.le_meta++;
+	if (sub == 0x02) {
+		mondrian_btctl.le_adv++;
+		if (mondrian_btctl.le_adv <= 4) {
+			mondrian_btctl_dump("le adv", buf,
+			    (int)MIN(len, (size_t)48));
+		}
+	} else if (sub == 0x04) {
+		mondrian_btctl.le_scan_rsp++;
+		if (mondrian_btctl.le_scan_rsp <= 4) {
+			mondrian_btctl_dump("le scan rsp", buf,
+			    (int)MIN(len, (size_t)48));
+		}
+	} else if (sub == 0x0d) {
+		mondrian_btctl.ext_reports++;
+		if (mondrian_btctl.ext_report_logged < 4 && len >= 5 + 24) {
+			const uint8_t *p = buf + 5;
+
+			mondrian_btctl.ext_report_logged++;
+			printf("MONDRIAN BTCTL: ext report %02x:%02x:%02x:"
+			    "%02x:%02x:%02x type 0x%02x%02x data %u\n",
+			    p[8], p[7], p[6], p[5], p[4], p[3],
+			    p[1], p[0], p[23]);
+		}
+	}
+}
+
+/*
+ * The controller scans with the extended pair and refuses the legacy pair.
+ * bluetoothd asks for the legacy pair because its init-time report says
+ * enableExtendedScanHCI=0, and the WCN7850 answers both 0x200b and 0x200c with
+ * 0x0c "command disallowed" in every state measured 2026-11-21, so no LE
+ * report ever reached the daemon and the device list stayed on addresses.
+ * 0x2041 and 0x2042 complete with status 0 and produce LE meta events (the
+ * shim probe under /private/var/vm/bt-ext-probe measures it), so the control
+ * translates the host side: the daemon's parameters and enable go out as the
+ * extended pair, the controller's completion is swallowed on the way back,
+ * and the daemon receives the completion for the opcode it sent. Answering
+ * locally is what the vendor commands in mondrian_btctl_send already do: a
+ * reply written by the userspace shim waits in its buffer until the daemon
+ * reads again, and the daemon is waiting for the socket to become readable.
+ */
+static size_t
+mondrian_btctl_translate_scan(const uint8_t *data, size_t len, uint8_t *out,
+    size_t cap)
+{
+	uint16_t opcode;
+
+	if (len < 4 || data[0] != 0x01) {
+		return 0;
+	}
+	opcode = (uint16_t)(data[1] | (data[2] << 8));
+	if (opcode == 0x200b) {
+		/*
+		 * LE Set Scan Parameters: type, interval, window, own address
+		 * type, filter policy. The extended form takes the two policy
+		 * bytes first and then one block per PHY; only LE 1M is asked
+		 * for, which is what the legacy command configures. The own
+		 * address is forced to public: bluetoothd asks for the random
+		 * type, and the controller answers the extended enable with
+		 * 0x12 "invalid parameters" when no random address is set
+		 * (measured 2026-11-21: own=1 -> 18, own=0 -> 0, same
+		 * interval, window and filter).
+		 */
+		if (len < 11 || data[3] != 7 || cap < 12) {
+			return 0;
+		}
+		out[0] = 0x01;
+		out[1] = 0x41;
+		out[2] = 0x20;
+		out[3] = 0x08;
+		out[4] = 0x00;
+		out[5] = data[10];
+		out[6] = 0x01;
+		/*
+		 * The daemon uses both kinds: the background scan asks for passive,
+		 * the Settings pane for active. The type is kept as asked; the log
+		 * is what tells the two apart in a ring (measured 2026-11-21: the
+		 * pane's scan is type 1 and its scan responses carry the names).
+		 */
+		printf("MONDRIAN BTCTL: scan params type %u own %u filter %u\n",
+		    data[4], data[9], data[10]);
+		out[7] = data[4];
+		out[8] = data[5];
+		out[9] = data[6];
+		out[10] = data[7];
+		out[11] = data[8];
+		return 12;
+	}
+	if (opcode == 0x200c) {
+		/* Enable, filter duplicates, then no duration or period. */
+		if (len < 6 || data[3] != 2 || cap < 10) {
+			return 0;
+		}
+		out[0] = 0x01;
+		out[1] = 0x42;
+		out[2] = 0x20;
+		out[3] = 0x06;
+		out[4] = data[4];
+		out[5] = data[5];
+		out[6] = 0;
+		out[7] = 0;
+		out[8] = 0;
+		out[9] = 0;
+		return 10;
+	}
+	return 0;
+}
+
+static void
+mondrian_btctl_complete_scan(kern_ctl_ref kref, uint32_t unit,
+    uint16_t opcode)
+{
+	uint8_t event[7];
+
+	event[0] = 0x04;
+	event[1] = 0x0e;
+	event[2] = 0x04;
+	event[3] = 0x01;
+	event[4] = (uint8_t)(opcode & 0xff);
+	event[5] = (uint8_t)(opcode >> 8);
+	event[6] = 0x00;
+	(void) ctl_enqueuedata(kref, unit, event, sizeof(event), 0);
+}
+
+/*
+ * HCI-IBS: 0xfd is the controller's WAKE_IND and 0xfc the host's ACK. With
+ * in-band sleep on, an unanswered indication repeats every 100 ms and the part
+ * takes no command (hci_qca.c), which is what left the daemon's reset
+ * unanswered after a boot re-downloaded the NVM (measured 2026-11-21: the
+ * daemon's session saw 2 KB of 0xfd/0xfe and no packet). The shim answers
+ * during qca_boot; this answers for the rest of the session. The write lock
+ * keeps the ACK byte from interleaving with a command the daemon is sending:
+ * each write is one GENI TX command, so the engine serializes them.
+ */
+static void
+mondrian_btctl_ack_controller(void)
+{
+	static const uint8_t ack = 0xfc;
+
+	lck_mtx_lock(&mondrian_btctl_tx_lock);
+	(void) mondrian_btuart_tty_write(&ack, 1);
+	lck_mtx_unlock(&mondrian_btctl_tx_lock);
+	mondrian_btctl.rx_acks++;
+	if (mondrian_btctl.rx_acks <= 4) {
+		printf("MONDRIAN BTCTL: ibs ack %u\n",
+		    mondrian_btctl.rx_acks);
+	}
+}
+
+static errno_t
+mondrian_btctl_connect(kern_ctl_ref kref, struct sockaddr_ctl *sac,
+    void **unitinfo)
+{
+	int error;
+	char name[64];
+
+	proc_name(proc_pid(current_proc()), name, sizeof(name));
+	lck_mtx_lock(&mondrian_btctl_lock);
+	if (mondrian_btctl.active) {
+		lck_mtx_unlock(&mondrian_btctl_lock);
+		printf("MONDRIAN BTCTL: connect refused, already open\n");
+		return EBUSY;
+	}
+	mondrian_btctl.kref = kref;
+	mondrian_btctl.unit = sac->sc_unit;
+	mondrian_btctl.tx_logged = 0;
+	mondrian_btctl.rx_logged = 0;
+	mondrian_btctl.tx_packets = 0;
+	mondrian_btctl.tx_fails = 0;
+	mondrian_btctl.rx_packets = 0;
+	mondrian_btctl.le_meta = 0;
+	mondrian_btctl.le_adv = 0;
+	mondrian_btctl.le_scan_rsp = 0;
+	mondrian_btctl.inquiry_results = 0;
+	mondrian_btctl.inquiry_cmds = 0;
+	mondrian_btctl.name_reqs = 0;
+	mondrian_btctl.legacy_enable = 0;
+	mondrian_btctl.legacy_disable = 0;
+	mondrian_btctl.ext_enable = 0;
+	mondrian_btctl.ext_disable = 0;
+	mondrian_btctl.scan_refused = 0;
+	mondrian_btctl.scan_translated = 0;
+	mondrian_btctl.ext_reports = 0;
+	mondrian_btctl.ext_report_logged = 0;
+	mondrian_btctl.rx_dropped = 0;
+	mondrian_btctl.rx_filler = 0;
+	mondrian_btctl.rx_acks = 0;
+	mondrian_btctl.names_added = 0;
+	mondrian_btctl.names_noted = 0;
+	mondrian_btctl.ext_params_pending = 0;
+	mondrian_btctl.ext_enable_pending = 0;
+	mondrian_btctl.pending_len = 0;
+	mondrian_btctl.last_tx = 0;
+	mondrian_btctl.last_rx = 0;
+	clock_get_uptime(&mondrian_btctl.opened);
+	mondrian_btctl.active = 1;
+	lck_mtx_unlock(&mondrian_btctl_lock);
+
+	error = mondrian_btuart_tty_open();
+	if (error != 0) {
+		lck_mtx_lock(&mondrian_btctl_lock);
+		mondrian_btctl.active = 0;
+		lck_mtx_unlock(&mondrian_btctl_lock);
+		printf("MONDRIAN BTCTL: engine open failed %d\n", error);
+		return error;
+	}
+	/*
+	 * A reset completion the previous process never read stays in the
+	 * controller's FIFO and reaches this daemon as the answer to its own
+	 * reset. The stack treats an unexpected completion as fatal and exits,
+	 * leaving its own behind, so the chain never ends by itself (measured
+	 * 2026-11-21: every run died processing OI_DHCI_RESET_OPCODE, and the
+	 * read carried two identical completions). Drain before the daemon
+	 * sends anything; the wake filler after this point is skipped in the
+	 * poll path.
+	 */
+	{
+		uint8_t stale[MONDRIAN_BTCTL_RX_MAX];
+		int drained = 0, got;
+
+		while ((got = mondrian_btuart_tty_read(stale,
+		    sizeof(stale))) > 0) {
+			drained += got;
+			if (drained >= 4096) {
+				break;
+			}
+		}
+		if (drained > 0) {
+			printf("MONDRIAN BTCTL: drained %d stale bytes\n",
+			    drained);
+		}
+	}
+	printf("MONDRIAN BTCTL: connected unit %u from %s pid %d\n",
+	    mondrian_btctl.unit, name, proc_pid(current_proc()));
+	*unitinfo = &mondrian_btctl;
+	mondrian_btctl_poll(NULL, NULL);
+	return 0;
+}
+
+static errno_t
+mondrian_btctl_disconnect(__unused kern_ctl_ref kref, __unused uint32_t unit,
+    __unused void *unitinfo)
+{
+	uint64_t now = 0, opened = 0, last = 0, age_ns = 0, idle_ns = 0;
+	unsigned tx, fails, rx;
+	unsigned le_meta, le_adv, le_scan_rsp, inquiry_results, name_reqs;
+	unsigned legacy_enable, legacy_disable, ext_enable, ext_disable;
+	unsigned scan_refused, scan_translated, ext_reports, rx_dropped;
+	unsigned rx_filler, rx_acks;
+	unsigned names_added;
+
+	clock_get_uptime(&now);
+	lck_mtx_lock(&mondrian_btctl_lock);
+	mondrian_btctl.active = 0;
+	opened = mondrian_btctl.opened;
+	tx = mondrian_btctl.tx_packets;
+	fails = mondrian_btctl.tx_fails;
+	rx = mondrian_btctl.rx_packets;
+	le_meta = mondrian_btctl.le_meta;
+	le_adv = mondrian_btctl.le_adv;
+	le_scan_rsp = mondrian_btctl.le_scan_rsp;
+	inquiry_results = mondrian_btctl.inquiry_results;
+	name_reqs = mondrian_btctl.name_reqs;
+	legacy_enable = mondrian_btctl.legacy_enable;
+	legacy_disable = mondrian_btctl.legacy_disable;
+	ext_enable = mondrian_btctl.ext_enable;
+	ext_disable = mondrian_btctl.ext_disable;
+	scan_refused = mondrian_btctl.scan_refused;
+	scan_translated = mondrian_btctl.scan_translated;
+	ext_reports = mondrian_btctl.ext_reports;
+	rx_dropped = mondrian_btctl.rx_dropped;
+	rx_filler = mondrian_btctl.rx_filler;
+	rx_acks = mondrian_btctl.rx_acks;
+	names_added = mondrian_btctl.names_added;
+	last = mondrian_btctl.last_tx > mondrian_btctl.last_rx ?
+	    mondrian_btctl.last_tx : mondrian_btctl.last_rx;
+	lck_mtx_unlock(&mondrian_btctl_lock);
+	if (now > opened) {
+		absolutetime_to_nanoseconds(now - opened, &age_ns);
+	}
+	if (last != 0 && now > last) {
+		absolutetime_to_nanoseconds(now - last, &idle_ns);
+	}
+	/*
+	 * One line per connection: the daemon leaves and reopens the control
+	 * about every 16 s (docs/MONDIAN_WIRELESS.md), and whether the close
+	 * follows a failed write or an idle socket decides the fix.
+	 */
+	printf("MONDRIAN BTCTL: disconnected tx %u fail %u rx %u "
+	    "age %llu ms idle %llu ms\n", tx, fails, rx,
+	    (unsigned long long)(age_ns / 1000000ull),
+	    (unsigned long long)(idle_ns / 1000000ull));
+	printf("MONDRIAN BTCTL: scan le meta %u adv %u rsp %u "
+	    "inquiry eir %u name req %u legacy %u/%u ext %u/%u "
+	    "xlate %u ext rsp %u refused %u drop %u filler %u ack %u "
+	    "names %u\n",
+	    le_meta, le_adv, le_scan_rsp, inquiry_results, name_reqs,
+	    legacy_enable, legacy_disable, ext_enable, ext_disable,
+	    scan_translated, ext_reports, scan_refused, rx_dropped,
+	    rx_filler, rx_acks, names_added);
+	return 0;
+}
+
+static errno_t
+mondrian_btctl_send_packet(kern_ctl_ref kref, uint32_t unit,
+    const uint8_t *data, size_t len, int *total)
+{
+	mondrian_btctl_count_command(data, len);
+	/*
+	 * BD_VSC_OLYMPIC_*: the WCN7850 has no Olympian vendor
+	 * commands and answers "unknown command" (status 1), and the
+	 * stack treats the failed
+	 * BT_VSC_OLYMPIC_SET_RETAIN_LE_SCAN_DUPLICATES_ON_START as
+	 * fatal: bluetoothd calls _exit(1) about 16 s into every run
+	 * and launchd restarts it, which re-initialises the controller
+	 * and drops the discovered-device list (measured 2026-11-21,
+	 * the exit report names the command).
+	 *
+	 * The user-space shim cannot answer these: its injected reply
+	 * sits in its own buffer until the daemon calls read() again,
+	 * and the daemon is waiting on a dispatch source that only
+	 * fires when the socket is readable -- so the command times out
+	 * anyway. ctl_enqueuedata makes the socket readable, which is
+	 * why the completion is made here. The Olympics only tune
+	 * Broadcom firmware behaviour, so a successful completion
+	 * leaves the controller's own defaults in place; the 0xfce2
+	 * family carries two zero bytes, the smallest payload the
+	 * Broadcom parser accepts (the 0x15 case in
+	 * tools/mondrian-bt.c measured it).
+	 */
+	if (len >= 3 && data[0] == 0x01 && data[2] == 0xfc &&
+	    (data[1] == 0xe9 || data[1] == 0xe2)) {
+		static const uint8_t olympic[] = {
+			0x04, 0x0e, 0x04, 0x01, 0xe9, 0xfc, 0x00
+		};
+		static const uint8_t apple[] = {
+			0x04, 0x0e, 0x06, 0x01, 0xe2, 0xfc, 0x00, 0x00,
+			0x00
+		};
+
+		if (mondrian_btctl.tx_logged <
+		    MONDRIAN_BTCTL_LOG_PACKETS) {
+			mondrian_btctl.tx_logged++;
+			mondrian_btctl_dump("tx", data,
+			    (int)MIN(len, (size_t)24));
+		}
+		printf("MONDRIAN BTCTL: vsc %02x/%02x answered\n",
+		    data[1], len > 4 ? data[4] : 0);
+		(void) ctl_enqueuedata(kref, unit,
+		    data[1] == 0xe9 ? olympic : apple,
+		    data[1] == 0xe9 ? sizeof(olympic) : sizeof(apple),
+		    0);
+		mondrian_btctl.tx_packets++;
+		clock_get_uptime(&mondrian_btctl.last_tx);
+		*total += (int)len;
+		return 0;
+	}
+	{
+		uint8_t translated[16];
+		size_t outlen;
+
+		outlen = mondrian_btctl_translate_scan(data, len,
+		    translated, sizeof(translated));
+		if (outlen > 0) {
+			uint16_t opcode = (uint16_t)(data[1] |
+			    (data[2] << 8));
+			int written;
+
+			if (mondrian_btctl.tx_logged <
+			    MONDRIAN_BTCTL_LOG_PACKETS) {
+				mondrian_btctl.tx_logged++;
+				mondrian_btctl_dump("tx", data,
+				    (int)MIN(len, (size_t)24));
+			}
+			lck_mtx_lock(&mondrian_btctl_tx_lock);
+			written = mondrian_btuart_tty_write(translated,
+			    outlen);
+			lck_mtx_unlock(&mondrian_btctl_tx_lock);
+			if (written < 0) {
+				mondrian_btctl.tx_fails++;
+				printf("MONDRIAN BTCTL: scan write"
+				    " failed %d\n", written);
+				return EIO;
+			}
+			if (opcode == 0x200b) {
+				mondrian_btctl.ext_params_pending++;
+			} else {
+				mondrian_btctl.ext_enable_pending++;
+			}
+			mondrian_btctl.scan_translated++;
+			mondrian_btctl_complete_scan(kref, unit, opcode);
+			mondrian_btctl.tx_packets++;
+			clock_get_uptime(&mondrian_btctl.last_tx);
+			*total += (int)len;
+			return 0;
+		}
+		/*
+		 * Remote Name Request (0x0419) takes 10 parameter bytes: BD_ADDR,
+		 * page-scan repetition mode, reserved and clock offset. The daemon
+		 * sends exactly that (`01 19 04 0a <addr> 01 00 0b fd`), so the
+		 * command is forwarded unchanged. An earlier revision appended an
+		 * eleventh byte, which the WCN7850 answered with Command Status
+		 * 0x12 (Invalid HCI Command Parameters): the name request never
+		 * left the controller while a 15-byte packet was written.
+		 */
+	}
+	/*
+	 * Everything else goes to the controller whole: the daemon's H4
+	 * framing is already in the bytes and the engine writes them out
+	 * unchanged.
+	 */
+	if (mondrian_btctl.tx_logged < MONDRIAN_BTCTL_LOG_PACKETS) {
+		mondrian_btctl.tx_logged++;
+		mondrian_btctl_dump("tx", data,
+		    (int)MIN(len, (size_t)24));
+	}
+	{
+		int written;
+
+		lck_mtx_lock(&mondrian_btctl_tx_lock);
+		written = mondrian_btuart_tty_write(data, len);
+		lck_mtx_unlock(&mondrian_btctl_tx_lock);
+		if (written < 0) {
+			mondrian_btctl.tx_fails++;
+			if (mondrian_btctl.tx_fails <= 4) {
+				printf("MONDRIAN BTCTL: write failed %d"
+				    " after %lu bytes\n", written,
+				    (unsigned long)len);
+			}
+			return EIO;
+		}
+	}
+	mondrian_btctl.tx_packets++;
+	clock_get_uptime(&mondrian_btctl.last_tx);
+	*total += (int)len;
+	return 0;
+}
+
+/*
+ * A write(2) can carry more than one H4 command, so the mbuf is walked packet
+ * by packet: the translation needs one packet's parameters, and a concatenated
+ * buffer would otherwise lose everything after the first command.
+ */
+static errno_t
+mondrian_btctl_send(__unused kern_ctl_ref kref, __unused uint32_t unit,
+    __unused void *unitinfo, mbuf_t m, __unused int flags)
+{
+	mbuf_t head = m;
+	int total = 0;
+
+	for (; m != NULL; m = mbuf_next(m)) {
+		const uint8_t *data = (const uint8_t *)mbuf_data(m);
+		size_t len = mbuf_len(m);
+		size_t at = 0;
+
+		while (at < len) {
+			size_t pktlen = len - at;
+
+			if (pktlen >= 4 && data[at] == 0x01) {
+				size_t want = 4 + (size_t)data[at + 3];
+
+				if (want <= pktlen) {
+					pktlen = want;
+				}
+			}
+			if (mondrian_btctl_send_packet(kref, unit, data + at,
+			    pktlen, &total) != 0) {
+				m_freem(head);
+				return EIO;
+			}
+			at += pktlen;
+		}
+	}
+	m_freem(head);
+	return total > 0 ? 0 : EINVAL;
+}
+
+static errno_t
+mondrian_btctl_getopt(__unused kern_ctl_ref kref, __unused uint32_t unit,
+    __unused void *unitinfo, int opt, void *data, size_t *len)
+{
+	struct termios t;
+
+	switch (opt) {
+	case MONDRIAN_BTCTL_GET_TERMIOS:
+		if (*len < sizeof(t)) {
+			*len = sizeof(t);
+			return ENOMEM;
+		}
+		bzero(&t, sizeof(t));
+		/* cfmakeraw() and cfsetspeed() in the daemon fix the rest. */
+		t.c_ispeed = 115200;
+		t.c_ospeed = 115200;
+		bcopy(&t, data, sizeof(t));
+		*len = sizeof(t);
+		return 0;
+
+	case MONDRIAN_BTCTL_GET_UUID:
+		/*
+		 * A UUID that names no nexus: os_channel_create() returns NULL
+		 * and bluetoothd uses read/write on this socket.
+		 */
+		if (*len < 16) {
+			*len = 16;
+			return ENOMEM;
+		}
+		{
+			static const uint8_t no_nexus[16] = {
+				0x4d, 0x4f, 0x4e, 0x44, 0x52, 0x49, 0x41,
+				0x4e, 0x42, 0x54, 0x43, 0x54, 0x4c, 0x30,
+				0x30, 0x31
+			};
+
+			bcopy(no_nexus, data, sizeof(no_nexus));
+		}
+		*len = 16;
+		return 0;
+
+	default:
+		return ENOTSUP;
+	}
+}
+
+static errno_t
+mondrian_btctl_setopt(__unused kern_ctl_ref kref, __unused uint32_t unit,
+    __unused void *unitinfo, int opt, void *data, size_t len)
+{
+	switch (opt) {
+	case MONDRIAN_BTCTL_SET_UART:
+		if (len >= 12) {
+			const uint32_t *v = (const uint32_t *)data;
+
+			printf("MONDRIAN BTCTL: uart cfg %u %u %u\n",
+			    v[0], v[1], v[2]);
+		}
+		return 0;
+
+	case MONDRIAN_BTCTL_SET_TERMIOS:
+		if (len >= sizeof(struct termios)) {
+			const struct termios *t = (const struct termios *)data;
+
+			printf("MONDRIAN BTCTL: termios iflag 0x%lx "
+			    "oflag 0x%lx cflag 0x%lx lflag 0x%lx "
+			    "ispeed %lu ospeed %lu\n",
+			    (unsigned long)t->c_iflag,
+			    (unsigned long)t->c_oflag,
+			    (unsigned long)t->c_cflag,
+			    (unsigned long)t->c_lflag,
+			    (unsigned long)t->c_ispeed,
+			    (unsigned long)t->c_ospeed);
+		}
+		return 0;
+
+	default:
+		return ENOTSUP;
+	}
+}
+
+/*
+ * The extended advertising report (LE meta subevent 0x0d) is what the
+ * controller sends once the extended scan is on, and the daemon's parser
+ * knows the legacy report (subevent 0x02) only. Each report becomes the legacy
+ * event with the same address, data and RSSI; a legacy event carries at most
+ * 31 data bytes, so a longer payload is truncated exactly as a legacy report
+ * would have arrived. The event type maps from the extended flags, and an
+ * identity address type (2 or 3) folds onto public or random (0 or 1).
+ */
+static size_t
+mondrian_btctl_legacy_report(const uint8_t *pkt, size_t len, uint8_t *out,
+    size_t cap)
+{
+	const uint8_t *p = pkt + 5;
+	size_t num, i, used = 0;
+
+	if (len < 7) {
+		return 0;
+	}
+	num = pkt[4];
+	for (i = 0; i < num; i++) {
+		size_t adlen = 0, dlen, room;
+		uint8_t ad[31];
+		uint8_t type, legacy;
+		const char *name;
+
+		if ((size_t)(p - pkt) + 24 > len) {
+			break;
+		}
+		dlen = p[23];
+		if ((size_t)(p - pkt) + 24 + dlen > len) {
+			break;
+		}
+		/*
+		 * A legacy report carries at most 31 data bytes, and an
+		 * extended advertisement can be longer. Cut at whole AD
+		 * structures only: a length byte that promises bytes the event
+		 * does not carry makes the daemon reject the report
+		 * (`Invalid advertising response data size (1 + 66)`,
+		 * measured 2026-11-21 on a 67-byte advertisement).
+		 */
+		while (adlen < dlen) {
+			size_t elen = p[24 + adlen];
+
+			if (elen == 0) {
+				if (adlen + 1 <= sizeof(ad)) {
+					ad[adlen++] = 0;
+				}
+				break;
+			}
+			if (adlen + 1 + elen > sizeof(ad)) {
+				break;
+			}
+			bcopy(p + 24 + adlen, ad + adlen, 1 + elen);
+			/*
+			 * The daemon keeps the device name from a Complete
+			 * Local Name (0x09) and not from the shortened one
+			 * (0x08) this controller's scan responses carry
+			 * (measured 2026-11-21: the scan response for
+			 * C8:A6:EF says 0x08 "55...", the pane still draws
+			 * the address). Promote it.
+			 */
+			if (ad[adlen + 1] == 0x08) {
+				ad[adlen + 1] = 0x09;
+			}
+			adlen += 1 + elen;
+		}
+		/*
+		 * The daemon ignores the classic EIR name for a dual-mode
+		 * device (see mondrian_btctl_note_name). When this
+		 * advertisement has no name of its own, add the one the
+		 * inquiry carried, dropping trailing AD structures if the
+		 * 31-byte legacy payload needs the room.
+		 */
+		name = mondrian_btctl_find_name(p + 3);
+		if (name != NULL && !mondrian_btctl_ad_has_name(ad, adlen)) {
+			size_t nlen = strlen(name);
+
+			if (nlen > sizeof(ad) - 2) {
+				nlen = sizeof(ad) - 2;
+			}
+			while (adlen + 2 + nlen > sizeof(ad) && adlen > 0) {
+				size_t start = 0, pos = 0;
+
+				while (pos < adlen) {
+					size_t elen = ad[pos];
+
+					if (elen == 0 ||
+					    pos + 1 + elen > adlen) {
+						break;
+					}
+					start = pos;
+					pos += 1 + elen;
+				}
+				adlen = start;
+			}
+			if (adlen + 2 + nlen <= sizeof(ad)) {
+				ad[adlen++] = (uint8_t)(nlen + 1);
+				ad[adlen++] = 0x09;
+				bcopy(name, ad + adlen, nlen);
+				adlen += nlen;
+				if (mondrian_btctl.names_added < 8) {
+					mondrian_btctl.names_added++;
+					printf("MONDRIAN BTCTL: ext name"
+					    " %02x:%02x:%02x:%02x:%02x:%02x"
+					    " \"%s\"\n", p[8], p[7], p[6],
+					    p[5], p[4], p[3], name);
+				}
+			}
+		}
+		dlen = adlen;
+		legacy = 0x00;
+		if (p[0] & 0x08) {
+			legacy = 0x04;
+		} else if (p[0] & 0x04) {
+			legacy = 0x01;
+		} else if ((p[0] & 0x03) == 0) {
+			legacy = 0x03;
+		} else if ((p[0] & 0x01) == 0) {
+			legacy = 0x02;
+		}
+		room = 12 + dlen;
+		if (used + 3 + room > cap) {
+			break;
+		}
+		out[used + 0] = 0x04;
+		out[used + 1] = 0x3e;
+		out[used + 2] = (uint8_t)room;
+		out[used + 3] = 0x02;
+		out[used + 4] = 0x01;
+		out[used + 5] = legacy;
+		type = p[2];
+		if (type > 1) {
+			type &= 0x01;
+		}
+		out[used + 6] = type;
+		bcopy(p + 3, out + used + 7, 6);
+		out[used + 13] = (uint8_t)dlen;
+		bcopy(ad, out + used + 14, dlen);
+		out[used + 14 + dlen] = p[13];
+		used += 3 + room;
+		p += 24 + p[23];
+	}
+	return used;
+}
+
+/*
+ * Legacy advertising reports (subevent 0x02) come straight from the
+ * controller when the daemon asks for the legacy scan, and they carry the
+ * same AD structures. Apply the name bridge and rebuild the packet: adding
+ * the name changes the event length, which the poll path cannot do in place.
+ */
+static size_t
+mondrian_btctl_legacy_rewrite(const uint8_t *pkt, size_t total, uint8_t *out,
+    size_t cap)
+{
+	const uint8_t *p = pkt + 5;
+	size_t num, i, used = 5;
+
+	if (total < 6) {
+		return 0;
+	}
+	num = pkt[4];
+	out[0] = 0x04;
+	out[1] = 0x3e;
+	out[3] = 0x02;
+	out[4] = pkt[4];
+	for (i = 0; i < num; i++) {
+		size_t dlen, adlen = 0;
+		uint8_t ad[31];
+		const char *name;
+
+		if ((size_t)(p - pkt) + 9 > total) {
+			return 0;
+		}
+		dlen = p[8];
+		if ((size_t)(p - pkt) + 9 + dlen + 1 > total) {
+			return 0;
+		}
+		while (adlen < dlen) {
+			size_t elen = p[9 + adlen];
+
+			if (elen == 0) {
+				if (adlen + 1 <= sizeof(ad)) {
+					ad[adlen++] = 0;
+				}
+				break;
+			}
+			if (adlen + 1 + elen > sizeof(ad)) {
+				break;
+			}
+			bcopy(p + 9 + adlen, ad + adlen, 1 + elen);
+			if (ad[adlen + 1] == 0x08) {
+				ad[adlen + 1] = 0x09;
+			}
+			adlen += 1 + elen;
+		}
+		name = mondrian_btctl_find_name(p + 2);
+		if (name != NULL && !mondrian_btctl_ad_has_name(ad, adlen)) {
+			size_t nlen = strlen(name);
+
+			if (nlen > sizeof(ad) - 2) {
+				nlen = sizeof(ad) - 2;
+			}
+			while (adlen + 2 + nlen > sizeof(ad) && adlen > 0) {
+				size_t start = 0, pos = 0;
+
+				while (pos < adlen) {
+					size_t elen = ad[pos];
+
+					if (elen == 0 ||
+					    pos + 1 + elen > adlen) {
+						break;
+					}
+					start = pos;
+					pos += 1 + elen;
+				}
+				adlen = start;
+			}
+			if (adlen + 2 + nlen <= sizeof(ad)) {
+				ad[adlen++] = (uint8_t)(nlen + 1);
+				ad[adlen++] = 0x09;
+				bcopy(name, ad + adlen, nlen);
+				adlen += nlen;
+				if (mondrian_btctl.names_added < 8) {
+					mondrian_btctl.names_added++;
+					printf("MONDRIAN BTCTL: ext name"
+					    " %02x:%02x:%02x:%02x:%02x:%02x"
+					    " \"%s\"\n", p[7], p[6], p[5],
+					    p[4], p[3], p[2], name);
+				}
+			}
+		}
+		if (used + 9 + adlen + 1 > cap) {
+			return 0;
+		}
+		out[used++] = p[0];
+		out[used++] = p[1];
+		bcopy(p + 2, out + used, 6);
+		used += 6;
+		out[used++] = (uint8_t)adlen;
+		bcopy(ad, out + used, adlen);
+		used += adlen;
+		out[used++] = p[9 + dlen];
+		p += 9 + dlen + 1;
+	}
+	out[2] = (uint8_t)(used - 3);
+	return used;
+}
+
+static void
+mondrian_btctl_mask_scan_status(uint8_t *buf, size_t len)
+{
+	uint8_t status;
+
+	if (len < 7 || buf[0] != 0x04 || buf[1] != 0x0e || buf[3] != 0x01) {
+		return;
+	}
+	if (!((buf[4] == 0x0b || buf[4] == 0x0c) && buf[5] == 0x20)) {
+		return;
+	}
+	status = buf[6];
+	if (status == 0) {
+		return;
+	}
+	if (mondrian_btctl.scan_refused < 4) {
+		printf("MONDRIAN BTCTL: 0x20%02x refused %#x, reported success\n",
+		    buf[4], status);
+	}
+	mondrian_btctl.scan_refused++;
+	buf[6] = 0;
+}
+
+static void
+mondrian_btctl_poll(thread_call_param_t p0, thread_call_param_t p1)
+{
+	uint8_t in[MONDRIAN_BTCTL_RX_MAX];
+	uint8_t out[MONDRIAN_BTCTL_OUT_MAX];
+	kern_ctl_ref kref;
+	uint32_t unit;
+	size_t space = 0, out_len = 0;
+	int active, n;
+
+	(void)p0;
+	(void)p1;
+
+	lck_mtx_lock(&mondrian_btctl_lock);
+	active = mondrian_btctl.active;
+	kref = mondrian_btctl.kref;
+	unit = mondrian_btctl.unit;
+	lck_mtx_unlock(&mondrian_btctl_lock);
+
+	if (!active) {
+		return;
+	}
+	if (ctl_getenqueuespace(kref, unit, &space) == 0 && space > 0) {
+		size_t cap = MIN(space, sizeof(in));
+
+		n = mondrian_btuart_tty_read(in, cap);
+		if (n > 0) {
+			if (mondrian_btctl.pending_len + (size_t)n >
+			    sizeof(mondrian_btctl.pending)) {
+				mondrian_btctl.pending_len = 0;
+				mondrian_btctl.rx_dropped++;
+				printf("MONDRIAN BTCTL: rx pending"
+				    " overflow\n");
+			}
+			bcopy(in, mondrian_btctl.pending +
+			    mondrian_btctl.pending_len, (size_t)n);
+			mondrian_btctl.pending_len += (size_t)n;
+		}
+	}
+	/*
+	 * The FIFO hands out at most 128 bytes per read, so an event longer
+	 * than that arrives in pieces; pending reassembles the H4 stream and
+	 * only complete packets are translated and enqueued.
+	 */
+	while (mondrian_btctl.pending_len > 0) {
+		uint8_t *pkt = mondrian_btctl.pending;
+		size_t total;
+		size_t used;
+
+		/*
+		 * The controller emits 0xFD/0xFE wake filler between packets,
+		 * and answers the shim's 0xFD wake with a bare 0xFC. Filler is
+		 * dropped; any other byte goes through as a one-byte chunk so
+		 * the handshake survives (measured 2026-11-21: dropping 0xFC
+		 * made qca_wake time out, the firmware never loaded and the
+		 * daemon's HCI reset went unanswered).
+		 */
+		if (pkt[0] != 0x04 && pkt[0] != 0x02 && pkt[0] != 0x03 &&
+		    pkt[0] != 0x05) {
+			if (pkt[0] == 0xfd) {
+				mondrian_btctl_ack_controller();
+				mondrian_btctl.rx_filler++;
+			} else if (pkt[0] == 0xfe) {
+				mondrian_btctl.rx_filler++;
+			} else {
+				if (out_len + 1 > sizeof(out)) {
+					break;
+				}
+				out[out_len++] = pkt[0];
+			}
+			memmove(pkt, pkt + 1, mondrian_btctl.pending_len - 1);
+			mondrian_btctl.pending_len--;
+			continue;
+		}
+		if (pkt[0] == 0x02) {
+			if (mondrian_btctl.pending_len < 5) {
+				break;
+			}
+			total = 5 + ((size_t)pkt[3] |
+			    ((size_t)pkt[4] << 8));
+		} else {
+			if (mondrian_btctl.pending_len < 3) {
+				break;
+			}
+			total = 3 + (size_t)pkt[2];
+		}
+		if (total > sizeof(mondrian_btctl.pending)) {
+			mondrian_btctl.rx_dropped++;
+			memmove(pkt, pkt + 1, mondrian_btctl.pending_len - 1);
+			mondrian_btctl.pending_len--;
+			continue;
+		}
+		if (mondrian_btctl.pending_len < total) {
+			break;
+		}
+		mondrian_btctl_count_event(pkt, total);
+		/*
+		 * The completions of the commands translated in
+		 * mondrian_btctl_send belong to opcodes the daemon never sent:
+		 * it already received the completion for its own opcode, so
+		 * these are dropped here.
+		 */
+		if (pkt[0] == 0x04 && pkt[1] == 0x0e && total >= 7 &&
+		    pkt[3] == 0x01 && pkt[5] == 0x20 &&
+		    ((pkt[4] == 0x41 &&
+		    mondrian_btctl.ext_params_pending > 0) ||
+		    (pkt[4] == 0x42 &&
+		    mondrian_btctl.ext_enable_pending > 0))) {
+			if (pkt[6] != 0) {
+				printf("MONDRIAN BTCTL: ext scan 0x20%02x"
+				    " status %#x\n", pkt[4], pkt[6]);
+			}
+			if (pkt[4] == 0x41) {
+				mondrian_btctl.ext_params_pending--;
+			} else {
+				mondrian_btctl.ext_enable_pending--;
+			}
+			memmove(pkt, pkt + total,
+			    mondrian_btctl.pending_len - total);
+			mondrian_btctl.pending_len -= total;
+			continue;
+		}
+		if (pkt[0] == 0x04 && pkt[1] == 0x3e && total >= 7 &&
+		    pkt[3] == 0x0d) {
+			if (sizeof(out) - out_len < 64) {
+				break;
+			}
+			used = mondrian_btctl_legacy_report(pkt, total,
+			    out + out_len, sizeof(out) - out_len);
+			if (used == 0) {
+				mondrian_btctl.rx_dropped++;
+			}
+		} else if (pkt[0] == 0x04 && pkt[1] == 0x3e && total >= 7 &&
+		    pkt[3] == 0x02) {
+			used = mondrian_btctl_legacy_rewrite(pkt, total,
+			    out + out_len, sizeof(out) - out_len);
+			if (used == 0) {
+				if (out_len + total > sizeof(out)) {
+					break;
+				}
+				bcopy(pkt, out + out_len, total);
+				used = total;
+			}
+		} else {
+			if (out_len + total > sizeof(out)) {
+				break;
+			}
+			mondrian_btctl_mask_scan_status(pkt, total);
+			bcopy(pkt, out + out_len, total);
+			used = total;
+		}
+		out_len += used;
+		memmove(pkt, pkt + total, mondrian_btctl.pending_len - total);
+		mondrian_btctl.pending_len -= total;
+	}
+	if (out_len > 0) {
+		mondrian_btctl.rx_packets++;
+		clock_get_uptime(&mondrian_btctl.last_rx);
+		if (mondrian_btctl.rx_logged < MONDRIAN_BTCTL_LOG_PACKETS) {
+			mondrian_btctl.rx_logged++;
+			mondrian_btctl_dump("rx", out,
+			    (int)MIN(out_len, (size_t)24));
+		}
+		(void) ctl_enqueuedata(kref, unit, out, out_len, 0);
+	}
+
+	lck_mtx_lock(&mondrian_btctl_lock);
+	if (mondrian_btctl.active) {
+		uint64_t deadline;
+
+		clock_interval_to_deadline(MONDRIAN_BTCTL_POLL_MS,
+		    NSEC_PER_MSEC, &deadline);
+		(void) thread_call_enter_delayed(mondrian_btctl_call, deadline);
+	}
+	lck_mtx_unlock(&mondrian_btctl_lock);
+}
+
+void
+mondrian_bt_ctl_init(void)
+{
+	struct kern_ctl_reg reg;
+	errno_t error;
+
+	bzero(&reg, sizeof(reg));
+	strlcpy(reg.ctl_name, MONDRIAN_BTCTL_NAME, sizeof(reg.ctl_name));
+	/*
+	 * The daemon builds its socket as PF_SYSTEM/SOCK_STREAM/SYSPROTO_CONTROL
+	 * and kern_control refuses that with EPROTOTYPE unless the control
+	 * registered itself as a sock-stream control (measured 2026-11-20:
+	 * connect returned errno 41 and the H4 driver gave up).
+	 */
+	reg.ctl_flags = CTL_FLAG_REG_SOCK_STREAM;
+	reg.ctl_sendsize = 64 * 1024;
+	reg.ctl_recvsize = 64 * 1024;
+	reg.ctl_connect = mondrian_btctl_connect;
+	reg.ctl_disconnect = mondrian_btctl_disconnect;
+	reg.ctl_send = mondrian_btctl_send;
+	reg.ctl_getopt = mondrian_btctl_getopt;
+	reg.ctl_setopt = mondrian_btctl_setopt;
+
+	mondrian_btctl_call = thread_call_allocate(mondrian_btctl_poll, NULL);
+	if (mondrian_btctl_call == NULL) {
+		printf("MONDRIAN BTCTL: no thread call\n");
+		return;
+	}
+	error = ctl_register(&reg, &mondrian_btctl_kref);
+	if (error != 0) {
+		printf("MONDRIAN BTCTL: ctl_register failed %d\n", error);
+		return;
+	}
+	printf("MONDRIAN BTCTL: control \"%s\" registered\n",
+	    MONDRIAN_BTCTL_NAME);
+}
