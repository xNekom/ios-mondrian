+/*
+ * gpuevent=1 (the default): give every CP_EVENT_WRITE in a submission the
+ * BIT(27) this CP needs.
+ *
+ * An event write without it is refused -- CP_INTERRUPT_STATUS bit 7,
+ * CP_ILLEGAL_INSTR_ERROR, the same refusal that made this port's ring fence a
+ * CP_MEM_WRITE instead (`cpfence=mem`, 0181). freedreno drives the RB blit
+ * engine with those packets: `FD_BLIT` (event 30) is what makes a *clear*
+ * happen and what resolves a tile out of GMEM into the render target
+ * (a6xx/fd6_emit.h, `fd6_emit_blit()`), and `FD_CACHE_CLEAN` (0x31) is what
+ * pushes the GPU's own writes out of its cache. Refused, every frame is drawn
+ * into GMEM and never reaches memory: the framebuffer is complete, there is no
+ * GL error, and the surface reads as zeros (measured with the GL self test).
+ *
+ * The form that works is 0181's: `CP_EVENT_WRITE` with `CACHE_CLEAN|BIT(27)`
+ * in the event dword, which writes its value. This walks the stream, and the
+ * indirect buffers it chains, and sets the bit on every event write.
+ */
+static uint64_t mondrian_uc_events = ~0ull;
+static int mondrian_uc_events_parsed;
+
+/*
+ * gpuevent=<event>[,<event>...] limits the rewrite to those event numbers, in
+ * hex as the packet carries them (1e is FD_BLIT, 31 CACHE_CLEAN); gpuevent=0
+ * turns it off; absent, every event write gets the bit. The CP halts on some
+ * event with WRITE_ENABLED set, so the list is how the one that does it is
+ * found without giving up the others.
+ */
+static bool
+mondrian_uc_event_wanted(uint32_t event)
+{
+	if (!mondrian_uc_events_parsed) {
+		char text[64];
+
+		mondrian_uc_events_parsed = 1;
+		if (PE_parse_boot_argn("gpuevent", text, sizeof(text))) {
+			const char *p = text;
+
+			mondrian_uc_events = 0;
+			while (*p != 0) {
+				uint32_t value = 0, digits = 0;
+
+				while (*p != 0 && *p != ',') {
+					int c = *p++;
+
+					value *= 16;
+					if (c >= '0' && c <= '9') {
+						value += (uint32_t)(c - '0');
+					} else if (c >= 'a' && c <= 'f') {
+						value += (uint32_t)(c - 'a' + 10);
+					} else if (c >= 'A' && c <= 'F') {
+						value += (uint32_t)(c - 'A' + 10);
+					}
+					digits++;
+				}
+				if (*p == ',') {
+					p++;
+				}
+				if (digits != 0 && value < 64) {
+					mondrian_uc_events |= 1ull << value;
+				}
+			}
+		}
+	}
+	return (mondrian_uc_events &
+	    (1ull << (event & 0x3f))) != 0;
+}
+
+static bool
+mondrian_uc_events_on(void)
+{
+	(void)mondrian_uc_event_wanted(0);
+	return mondrian_uc_events != 0;
+}
+
+IOReturn
+MondrianGPUUserClient::rewriteEvents(mondrian_buffer *buffer, uint32_t offset,
+    uint32_t size, unsigned depth, unsigned *rewritten)
+{
+	uint32_t at = 0;
+
+	if (buffer == NULL || depth > 3) {
+		return kIOReturnUnsupported;
+	}
+	while (at + 4 <= size) {
+		uint32_t header = 0, words[3], op, count;
+
+		if (buffer->memory->readBytes(offset + at, &header, 4) != 4) {
+			break;
+		}
+		if ((header >> 28) != 7) {
+			at += 4;
+			continue;
+		}
+		op = (header >> 16) & 0x7f;
+		count = header & 0x3fff;
+		if (at + 4 * (1 + count) > size) {
+			break;
+		}
+		if (op == 0x46 && count >= 1) {
+			uint32_t event = 0;
+
+			if (buffer->memory->readBytes(offset + at + 4, &event,
+			    4) == 4 && (event & (1u << 27)) == 0 &&
+			    mondrian_uc_event_wanted(event & 0xffu)) {
+				event |= 1u << 27;
+				if (buffer->memory->writeBytes(offset + at + 4,
+				    &event, 4) == 4) {
+					(*rewritten)++;
+				}
+			}
+		} else if (op == 0x3f && count == 3 &&
+		    buffer->memory->readBytes(offset + at + 4, words, 12) == 12) {
+			uint64_t addr = words[0] | ((uint64_t)words[1] << 32);
+			uint32_t n = words[2], b;
+
+			for (b = 0; b < fBufferCount; b++) {
+				mondrian_buffer *target = fBuffers[b];
+
+				if (n == 0 || addr < target->iova ||
+				    addr + 4ull * n > target->iova +
+				    target->size) {
+					continue;
+				}
+				(void)rewriteEvents(target,
+				    (uint32_t)(addr - target->iova), 4 * n,
+				    depth + 1, rewritten);
+				/* The dwords this changed are in the CPU's
+				 * cache; the CP fetches from memory. */
+				if (*rewritten != 0) {
+					bufferSync(target);
+				}
+				break;
+			}
+		}
+		at += 4 * (1 + count);
+	}
+	return kIOReturnSuccess;
+}
