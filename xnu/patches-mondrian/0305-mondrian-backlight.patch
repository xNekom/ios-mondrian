+/*
+ * The control channel's `bl`: store the level and let the next tick send it,
+ * the way the old kernel's USB path did. Sending it on the calling thread
+ * would put a DSI DMA in the middle of a frame the compositor may be copying
+ * into, and a slider produces a run of levels of which only the last one
+ * matters.
+ */
+extern "C" void
+mondrian_fb_set_brightness(uint32_t level, uint32_t fmt, uint32_t cmd)
+{
+	AppleCLCD *fb = gMondrianFB;
+
+	if (fb == NULL || fb->fDsi == NULL) {
+		return;
+	}
+	if (level > 4095) {
+		level = 4095;
+	}
+	fb->fBrightLevel = level;
+	fb->fBrightFmt = fmt & 0x1b;
+	fb->fBrightCmd = (cmd != 0 && cmd < 0x100) ? cmd : 0x51;
+	fb->fBrightPending = true;
+}
+
+/*
+ * The control channel's `dcs`: one DCS packet from the calling thread, through
+ * the inline path rather than the frame's DMA, so a register can be poked
+ * without waiting for a tick. `params` are the bytes after the command: a
+ * short write (0x05) has none, a long write (0x39) up to three.
+ */
+extern "C" int
+mondrian_fb_dcs(uint32_t cmd, const uint8_t *params, uint32_t n)
+{
+	AppleCLCD *fb = gMondrianFB;
+	uint8_t buf[4];
+	uint32_t ack = 0;
+	int rc;
+
+	if (fb == NULL || fb->fDsi == NULL) {
+		return -1;
+	}
+	/* The old kernel refused a packet with no command byte, as does DSI. */
+	if (cmd == 0 || cmd > 0xff) {
+		return -1;
+	}
+	if (n > 3) {
+		n = 3;
+	}
+	if (params == NULL) {
+		n = 0;
+	}
+	buf[0] = (uint8_t)cmd;
+	buf[1] = n > 0 ? params[0] : 0;
+	buf[2] = n > 1 ? params[1] : 0;
+	buf[3] = n > 2 ? params[2] : 0;
+	rc = mondrian_dsi_packet(fb, n == 0 ? 0x05 : 0x39, buf, n + 1, false,
+	    &ack);
+	IOLog("MONDRIAN DCS: cmd 0x%02x n %u lpm %u rc %d ack 0x%08x\n",
+	    cmd & 0xff, n, 0, rc, ack);
+	return rc;
+}
