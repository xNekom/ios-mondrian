 static AppleCLCD *gMondrianFB;
 
+/*
+ * A command page that is not RAM takes one log line, not one per frame.
+ */
+static bool mondrian_bl_nobuf_logged;
+
+/*
+ * One DSI packet through the inline ("embedded") path, the one the control
+ * channel's `dcs` uses: the header and the payload go into
+ * DSI_TEST_PATTERN_GEN_CMD_INIT_VAL and the trigger register starts the
+ * engine, with no memory behind it. `type` is the DSI data type (0x05 short
+ * write, 0x39 long write, 0x06 read), `data` holds the DCS command byte
+ * first, and `len` is how many of its bytes go out: 1 or 2 make a 4-byte
+ * packet, 3 an 8-byte one. Both waits are bounded at 20 ms and a timeout is
+ * not an error, as in the old kernel.
+ */
+static int
+mondrian_dsi_packet(AppleCLCD *fb, uint32_t type, const uint8_t *data,
+    uint32_t len, bool lpm, uint32_t *ack)
+{
+	volatile uint32_t *dsi = fb->fDsi;
+	uint32_t hdr, payload, plen, a;
+
+	if (len > 3) {
+		return -1;
+	}
+	if (dsi == NULL) {
+		return -1;
+	}
+	if (len < 2) {
+		payload = 0;
+		plen = 4;
+		hdr = type | ((uint32_t)data[0] << 8);
+		if (type == 6) {
+			hdr |= 0x20000000;
+		}
+	} else {
+		plen = 8;
+		payload = (uint32_t)data[0] | ((uint32_t)data[1] << 8);
+		if (len == 3) {
+			payload |= (uint32_t)data[2] << 16;
+		}
+		hdr = type | (len << 8) | 0x40000000;
+	}
+
+	/* DSI_STATUS bit 2: the engine is still busy with the last packet. */
+	for (uint32_t i = 200; i != 0; i--) {
+		if ((mondrian_mdp_rd(dsi, MONDRIAN_DSI_STATUS) & 4) == 0) {
+			break;
+		}
+		delay(100);
+	}
+
+	a = mondrian_mdp_rd(dsi, MONDRIAN_DSI_ACK_ERR_STATUS);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_ACK_ERR_STATUS, a);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_CTRL, 0x00030006);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_CMD_INIT_VAL, hdr);
+	if (len >= 2) {
+		mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_CMD_INIT_VAL, payload);
+	}
+	if (plen == 4) {
+		mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_CMD_INIT_VAL, 0);
+	}
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_MODE_DMA_CTRL,
+	    (mondrian_mdp_rd(dsi, MONDRIAN_DSI_CMD_MODE_DMA_CTRL) & 0xCAFFFFFFu) |
+	    (lpm ? 0x14000000u : 0x10000000u));
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_DMA_CMD_LENGTH, plen);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TRIG_CTRL,
+	    (mondrian_mdp_rd(dsi, MONDRIAN_DSI_TRIG_CTRL) & 0xFFFFFFF0u) | 1);
+
+	__asm__ volatile("dsb sy" ::: "memory");
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_MODE_DMA_SW_TRIGGER, 1);
+
+	/* DSI_STATUS bit 1: the engine is still busy, the packet not done. */
+	for (uint32_t i = 200; i != 0; i--) {
+		if ((mondrian_mdp_rd(dsi, MONDRIAN_DSI_STATUS) & 2) == 0) {
+			break;
+		}
+		delay(100);
+	}
+
+	delay(5);
+	if (ack != NULL) {
+		*ack = mondrian_mdp_rd(dsi, MONDRIAN_DSI_ACK_ERR_STATUS);
+	}
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_CTRL, 0);
+	return 0;
+}
+
+/*
+ * The brightness write, as a DSI DMA out of fBrightBuf: the DCS long write
+ * sits in memory (4-byte packet header 03 00 39 c0, then the command byte and
+ * the 12-bit level, 0xff pad) and DSI_DMA_CMD_OFFSET points the engine at it.
+ * The two lengths are the constants the old kernel used: three payload bytes,
+ * eight on the wire. `cmd` is the DCS command byte, `value` its 16-bit payload
+ * low byte first.
+ *
+ * Returns -1 without a DSI window or a command page, -2 when the DMA-done bit
+ * never arrives (100 ms), 0 once it did.
+ */
+static int
+mondrian_dsi_dcs_dma(AppleCLCD *fb, uint32_t cmd, uint32_t value)
+{
+	volatile uint32_t *dsi = fb->fDsi;
+	volatile uint32_t *buf = (volatile uint32_t *)fb->fBrightBuf;
+	uint32_t save3c, save50, status, back, iv = 0, n;
+	bool done = false;
+	int rc;
+
+	if (dsi == NULL) {
+		return -1;
+	}
+	if (buf == NULL) {
+		if (!mondrian_bl_nobuf_logged) {
+			mondrian_bl_nobuf_logged = true;
+			IOLog("MONDRIAN BL: no command buffer\n");
+		}
+		return -1;
+	}
+
+	/*
+	 * The page has to be RAM the engine can read, not a hole that swallows
+	 * writes: write a word, read it back, clear it.
+	 */
+	buf[0x3c / 4] = 0xa5c3f00du;
+	__asm__ volatile("dsb sy" ::: "memory");
+	back = buf[0x3c / 4];
+	buf[0x3c / 4] = 0;
+	if (back != 0xa5c3f00du) {
+		IOLog("MONDRIAN BL: command page 0x%llx read back 0x%x, refused\n",
+		    (unsigned long long)fb->fBrightPhys, back);
+		return -1;
+	}
+
+	/* 64-byte block; the DMA reads the first 8 bytes. */
+	buf[0] = 0xc0390003u;
+	buf[1] = 0xff000000u | (cmd & 0xff) | ((value & 0xffff) << 8);
+	for (uint32_t i = 2; i < 16; i++) {
+		buf[i] = 0xffffffff;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_CTRL, 0);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_DMA_FIFO_RESET, 1);
+	delay(10);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_TPG_DMA_FIFO_RESET, 0);
+
+	save3c = mondrian_mdp_rd(dsi, MONDRIAN_DSI_CMD_MODE_DMA_CTRL);
+	save50 = mondrian_mdp_rd(dsi, MONDRIAN_DSI_DMA_FIFO_CTRL);
+
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_MODE_DMA_CTRL,
+	    ((fb->fBrightFmt & 0x10) ? 0x54000000u : 0x50000000u) |
+	    (save3c & 0x0AFFFFFFu));
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_DMA_FIFO_CTRL, save50 | 0x00110000u);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_DMA_CMD_OFFSET,
+	    (uint32_t)fb->fBrightPhys);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_DMA_CMD_LENGTH, 8);
+
+	__asm__ volatile("dsb sy" ::: "memory");
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_DMA_DONE, 1);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_MODE_DMA_SW_TRIGGER, 1);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	status = mondrian_mdp_rd(dsi, MONDRIAN_DSI_STATUS);
+	for (n = 0; ; n++) {
+		iv = mondrian_mdp_rd(dsi, MONDRIAN_DSI_CMD_DMA_DONE);
+		if ((iv & 1) != 0) {
+			done = true;
+			break;
+		}
+		delay(500);
+		if (n > 0xc6) {          /* 200 x 500 us, 100 ms */
+			break;
+		}
+	}
+
+	IOLog("MONDRIAN BL: dma len %u size %u phys 0x%llx int 0x%08x done %d\n",
+	    3, 8, (unsigned long long)fb->fBrightPhys, iv, done ? 1 : 0);
+	IOLog("MONDRIAN BL: status 0x%x -> 0x%x fifo 0x%x ack 0x%x to 0x%x "
+	    "vmode 0x%x off 0x%x len 0x%x\n",
+	    status, mondrian_mdp_rd(dsi, MONDRIAN_DSI_STATUS),
+	    mondrian_mdp_rd(dsi, MONDRIAN_DSI_FIFO_STATUS),
+	    mondrian_mdp_rd(dsi, MONDRIAN_DSI_ACK_ERR_STATUS),
+	    mondrian_mdp_rd(dsi, 0x0c0),
+	    mondrian_mdp_rd(dsi, MONDRIAN_DSI_VIDEO_MODE_CTRL),
+	    mondrian_mdp_rd(dsi, MONDRIAN_DSI_DMA_CMD_OFFSET),
+	    mondrian_mdp_rd(dsi, MONDRIAN_DSI_DMA_CMD_LENGTH));
+
+	if (done) {
+		mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_DMA_DONE, 1);
+		rc = 0;
+	} else {
+		rc = -2;
+	}
+
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_DMA_FIFO_CTRL, save50);
+	mondrian_mdp_wr(dsi, MONDRIAN_DSI_CMD_MODE_DMA_CTRL, save3c);
+	return rc;
+}
+
+/*
+ * Send the stored level: three DCS bytes, command first, the 12-bit DBV split
+ * by the format (bit0 swaps the byte order, bit1 inverts it), then the DMA.
+ * A failed transfer gets one retry after the TPG FIFO reset the old kernel
+ * used; the second failure is reported and dropped.
+ */
+static void
+mondrian_fb_brightness_apply(AppleCLCD *fb)
+{
+	uint32_t level = fb->fBrightLevel;
+	uint32_t fmt = fb->fBrightFmt;
+	uint32_t v, lsb, cmd, p0, p1, p2;
+	int rc;
+
+	v = level & 0xfff;
+	if ((fmt & 2) != 0) {
+		v ^= 0xfff;              /* inverted polarity panel */
+	}
+	lsb = (fmt & 1) << 3;        /* 0: high byte first, 8: low byte first */
+	cmd = fb->fBrightCmd != 0 ? fb->fBrightCmd : 0x51;
+	p0 = cmd & 0xff;
+	p1 = (v >> (lsb ^ 8)) & 0xff;
+	p2 = (v >> lsb) & 0xff;
+
+	IOLog("MONDRIAN BL: level %u fmt %d cmd 0x%02x dbv 0x%03x path dma\n",
+	    level, (int)fmt, cmd, v);
+	rc = mondrian_dsi_dcs_dma(fb, p0, p1 | (p2 << 8));
+	if (rc != 0 && fb->fDsi != NULL) {
+		mondrian_mdp_wr(fb->fDsi, MONDRIAN_DSI_TPG_CTRL, 0);
+		mondrian_mdp_wr(fb->fDsi, MONDRIAN_DSI_TPG_DMA_FIFO_RESET, 1);
+		delay(10);
+		mondrian_mdp_wr(fb->fDsi, MONDRIAN_DSI_TPG_DMA_FIFO_RESET, 0);
+		rc = mondrian_dsi_dcs_dma(fb, p0, p1 | (p2 << 8));
+	}
+	IOLog("MONDRIAN BL: sent rc %d ack 0x%08x\n", rc, 0);
+	fb->fBrightApplies++;
+}
