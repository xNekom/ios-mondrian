+/*
+ * "bl [LEVEL [FMT [CMD]]]" sets the panel's brightness: the level and the
+ * two format bytes are stored and the next vsync sends them as one DCS long
+ * write, so a run of commands costs one packet per frame. The ring keeps the
+ * line the old kernel printed and the peer gets the same text, so a host that
+ * only reads the log and a script that waits for the answer both see it:
+ *   MONDR USB: brightness 2048 of 4095 fmt 8 dcs 0x51
+ * A level is required; the format defaults to 0 and the command to 0x51.
+ */
+static void
+ud_cmd_bl(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	uint32_t level, fmt = 0, dcs = 0x51;
+	const char *p = line + 2;
+	char out[96];
+	int n;
+
+	if ((p = ud_cmd_num(p, &level)) == NULL) {
+		n = snprintf(out, sizeof(out), "bl needs a level\n");
+		ud_cmd_send(so, to, out, (size_t)n);
+		printf("%s", out);
+		return;
+	}
+	if ((p = ud_cmd_num(p, &fmt)) != NULL) {
+		(void)ud_cmd_num(p, &dcs);
+	}
+	if (level > 4095) {
+		level = 4095;
+	}
+	mondrian_fb_set_brightness(level, fmt, dcs);
+	n = snprintf(out, sizeof(out),
+	    "MONDR USB: brightness %u of 4095 fmt %u dcs 0x%02x\n",
+	    level, fmt, dcs);
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
+
+/*
+ * "dcs CMD [P0 [P1 [P2]]]" sends one DCS packet from this thread, through the
+ * inline path rather than the frame's DMA: no parameter is a short write
+ * (0x05), one to three a long write (0x39). The reply counts the parameters,
+ * not the bytes on the wire, and goes to the ring and the peer alike:
+ *   MONDR USB: dcs 0x51 3 bytes
+ */
+static void
+ud_cmd_dcs(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	uint8_t params[3];
+	uint32_t c = 0, v = 0, n = 0, i;
+	const char *p = line + 3;
+	char out[96];
+	int len;
+
+	if ((p = ud_cmd_num(p, &c)) == NULL) {
+		len = snprintf(out, sizeof(out), "dcs needs a command byte\n");
+		ud_cmd_send(so, to, out, (size_t)len);
+		printf("%s", out);
+		return;
+	}
+	for (i = 0; i < 3; i++) {
+		if ((p = ud_cmd_num(p, &v)) == NULL) {
+			break;
+		}
+		params[i] = (uint8_t)v;
+		n++;
+	}
+	(void)mondrian_fb_dcs(c & 0xff, params, n);
+	len = snprintf(out, sizeof(out), "MONDR USB: dcs 0x%02x %u bytes\n",
+	    c & 0xff, n);
+	ud_cmd_send(so, to, out, (size_t)len);
+	printf("%s", out);
+}
