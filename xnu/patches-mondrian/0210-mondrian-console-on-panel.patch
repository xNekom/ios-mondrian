xnu 0210: the kernel log reaches the panel, and the panel is not the splash

This board has no UART and no video console. The early console painted its own
marks and nothing else: kprintf and the BSD printf path (which is where most of
the boot log comes from) reach the log ring but never the screen, so the panel
froze at the last early mark and stayed that way until CoreAnimation swapped its
first frame. That is the "console shows one screenful and stops" symptom.

Paint the funnel too: console_write() is the one point every kernel log line and
every /dev/console write passes through, and it is already where the port tees
into the persistent ring. The same switch that stops the console when the UI
takes the panel (mondrian_fbcon_quiet) stops the painting.

Two things had to change in the painter with it. The console painted a row when
it needed it and wrapped to the top, so the rows it never wrote kept the
bootloader's splash (the strip above the beacon, the white corner). Clear the
whole panel once, before the first character. And scroll by half a screen when
the cursor leaves the last text row instead of wrapping: a pass over the panel
is 4.6M stores, one per line would cost the boot, one every ~49 lines is free.
--- a/osfmk/arm64/mondrian_early.c
+++ b/osfmk/arm64/mondrian_early.c
@@ -53,6 +53,61 @@
 	}
 }
 
+/*
+ * The whole panel, once, before the first character. The bootloader's splash
+ * stays in the rows nothing ever writes: the console paints a row when it
+ * needs it, so the strip above the beacon and the corners kept somebody
+ * else's pixels. One 18 MB pass at the start of the console is cheaper than a
+ * photo that shows them.
+ */
+static void
+mondrian_early_clear_screen(void)
+{
+	uint64_t const bg = 0xff000000ff000000ull;
+
+	for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
+		volatile uint64_t *line =
+		    (volatile uint64_t *)(EARLY_FB + y * EARLY_STRIDE);
+
+		for (unsigned int x = 0; x < EARLY_WIDTH / 2; x++) {
+			line[x] = bg;
+		}
+	}
+}
+
+/*
+ * A page, not a line. Moving the pixels up for every line is a 4.6M-store pass
+ * per line and the boot would be spent scrolling; half a screen at a time
+ * costs the same pass every ~49 lines, and the console still reads like a
+ * terminal: what is pushed off the top is gone and the newest line is the one
+ * at the bottom.
+ */
+static void
+mondrian_early_scroll(void)
+{
+	unsigned int const rows = EARLY_HUD_ROW0;
+	unsigned int const step = rows / 2;
+	unsigned int const keep = rows - step;
+
+	for (unsigned int y = 0; y < keep * EARLY_CELL_H; y++) {
+		volatile uint64_t *dst = (volatile uint64_t *)(EARLY_FB + y * EARLY_STRIDE);
+		volatile uint64_t *src = (volatile uint64_t *)(EARLY_FB +
+		    (y + step * EARLY_CELL_H) * EARLY_STRIDE);
+
+		for (unsigned int x = 0; x < EARLY_WIDTH / 2; x++) {
+			dst[x] = src[x];
+		}
+	}
+	for (unsigned int row = keep; row < rows; row++) {
+		unsigned int save = early_row;
+
+		early_row = row;
+		mondrian_early_clear_row();
+		early_row = save;
+	}
+	early_row = keep;
+}
+
 void
 mondrian_early_putc(char c)
 {
@@ -61,7 +116,7 @@
 	}
 	if (!early_started) {
 		early_started = 1;
-		mondrian_early_clear_row();
+		mondrian_early_clear_screen();
 	}
 	if (c == '\r') {
 		early_col = 0;
@@ -69,8 +124,12 @@
 	}
 	if (c == '\n' || early_col == EARLY_COLS) {
 		early_col = 0;
-		early_row = (early_row + 1) % EARLY_ROWS;
-		mondrian_early_clear_row();
+		if (early_row + 1 < EARLY_HUD_ROW0) {
+			early_row++;
+			mondrian_early_clear_row();
+		} else {
+			mondrian_early_scroll();
+		}
 		if (c == '\n') {
 			return;
 		}
@@ -168,6 +227,26 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+/*
+ * Everything the kernel log writes, on the panel. This board has no UART and
+ * no video console: kprintf and the BSD printf path reach the log ring but
+ * never the screen, so the boot looked frozen after the last early mark. The
+ * console funnel calls this for every line, and the same switch that stops the
+ * console when the UI takes the panel (mondrian_fbcon_quiet) stops this.
+ */
+void
+mondrian_early_paint(const char *c, int size)
+{
+	extern int mondrian_fbcon_quiet;
+
+	if (mondrian_fbcon_quiet) {
+		return;
+	}
+	while (size-- > 0) {
+		mondrian_early_putc(*c++);
+	}
+}
+
 void
 mondrian_early_relocate(uint64_t base)
 {
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -520,7 +520,9 @@
 	 * ~40 KiB once userland started.
 	 */
 	extern void mondrian_log_append(const char *c, int size);
+	extern void mondrian_early_paint(const char *c, int size);
 	mondrian_log_append(str, size);
+	mondrian_early_paint(str, size);
 #endif
 	assert(str != NULL);
 
