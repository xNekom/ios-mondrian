+/* WRITE(10) of count device blocks at lba from the bounce buffer. */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+
+	printf("MONDRIAN UFS: write lba 0x%llx, %u blocks\n",
+	    lba, count);
+	return ufs_scsi(su.lun, cdb, sizeof(cdb), count * UFS_BLOCK, TRUE);
 }
 
+/* SYNCHRONIZE CACHE(10): the device may hold the writes in its own cache. */
+static int
+ufs_flush(void)
+{
+	uint8_t cdb[10] = { 0x35, 0, 0, 0, 0, 0, 0, 0, 0, 0 };
+
+	return ufs_scsi(su.lun, cdb, sizeof(cdb), 0, FALSE);
+}
