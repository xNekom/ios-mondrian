diff --git a/bsd/dev/mondrian_scm.c b/bsd/dev/mondrian_scm.c
new file mode 100644
index 0000000..1d41523
--- /dev/null
+++ b/bsd/dev/mondrian_scm.c
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include "mondrian_scm.h"
+
+#if defined(MONDRIAN)
+
+int
+mondrian_scm_call(uint32_t fn, uint32_t info, const uint64_t args[3],
+    int32_t *transport, int64_t *result)
+{
+	uint64_t first = fn, a6 = 0;
+	uint32_t busy = 0;
+	unsigned resumes;
+
+	for (resumes = 0; resumes < 10000; resumes++) {
+		register uint64_t x0 asm("x0") = first;
+		register uint64_t x1 asm("x1") = info;
+		register uint64_t x2 asm("x2") = args[0];
+		register uint64_t x3 asm("x3") = args[1];
+		register uint64_t x4 asm("x4") = args[2];
+		register uint64_t x5 asm("x5") = 0;
+		register uint64_t x6 asm("x6") = a6;
+		register uint64_t x7 asm("x7") = 0;
+
+		asm volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+		    "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) ::
+		    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		    "x16", "x17", "memory");
+		if (x0 == 1) {
+			first = 1;
+			a6 = x6;
+			continue;
+		}
+		if ((int64_t)x0 == -12 && busy++ < 20) {
+			first = fn;
+			a6 = 0;
+			delay(30000);
+			continue;
+		}
+		*transport = (int32_t)x0;
+		*result = (int64_t)x1;
+		return 0;
+	}
+	return 1;
+}
+
+
+#endif /* MONDRIAN */
diff --git a/bsd/dev/mondrian_scm.h b/bsd/dev/mondrian_scm.h
new file mode 100644
index 0000000..3428605
--- /dev/null
+++ b/bsd/dev/mondrian_scm.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+#ifndef _MONDRIAN_SCM_H_
+#define _MONDRIAN_SCM_H_
+
+#include <stdint.h>
+
+/* 0 = completed, 1 = resume/retry budget exhausted. */
+int mondrian_scm_call(uint32_t fn, uint32_t info, const uint64_t args[3],
+    int32_t *transport, int64_t *result);
+
+#endif /* _MONDRIAN_SCM_H_ */
