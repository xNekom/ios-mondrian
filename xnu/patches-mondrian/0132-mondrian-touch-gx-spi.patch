+
+/*
+ * The Goodix SPI framing from drivers/hid/hid-goodix-spi.c: a 0xF1 read (or
+ * 0xF0 write) byte, the register address as 32-bit big endian, and for a read
+ * three dummy bytes before the data, all with CS asserted.
+ */
+static void
+mondrian_goodix_prefix(uint8_t *tx, uint8_t flag, uint32_t addr)
+{
+	tx[0] = flag;
+	tx[1] = (uint8_t)(addr >> 24);
+	tx[2] = (uint8_t)(addr >> 16);
+	tx[3] = (uint8_t)(addr >> 8);
+	tx[4] = (uint8_t)addr;
+	tx[5] = 0;
+	tx[6] = 0;
+	tx[7] = 0;
 }
 
 static int
+mondrian_goodix_read(uint32_t addr, uint8_t *buf, uint32_t len)
+{
+	uint8_t tx[8];
+
+	mondrian_goodix_prefix(tx, 0xf1, addr);
+	return mondrian_spi_frame(tx, sizeof(tx), buf, len);
+}
+
+static int
+mondrian_goodix_write(uint32_t addr, const uint8_t *buf, uint32_t len)
+{
+	uint8_t tx[16];
+
+	if (len > sizeof(tx) - 8) {
+		len = sizeof(tx) - 8;
+	}
+	mondrian_goodix_prefix(tx, 0xf0, addr);
+	memcpy(tx + 8, buf, len);
+	return mondrian_spi_frame(tx, 8 + len, NULL, 0);
+}
