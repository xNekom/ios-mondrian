+/* The PMIC's own PBS raises hBoost; this AP only writes the two SDAM bytes. */
+static int
+hap_boost(unsigned int on)
+{
+	uint8_t arg = on ? 1 : 2, got_arg = 0, got_trig = 0;
+	int ok;
+
+	ok = mondrian_spmi_reg_write(MONDRIAN_HAP_SDAM,
+	    HAP_SDAM_PBS_ARG, arg);
+	ok &= mondrian_spmi_reg_write(MONDRIAN_HAP_SDAM,
+	    HAP_SDAM_PBS_TRIG, 1);
+	(void)mondrian_spmi_reg_read(MONDRIAN_HAP_SDAM,
+	    HAP_SDAM_PBS_ARG, &got_arg);
+	(void)mondrian_spmi_reg_read(MONDRIAN_HAP_SDAM,
+	    HAP_SDAM_PBS_TRIG, &got_trig);
+	printf("MONDRIAN HAP: hboost %s: sdam 0x42=0x%02x 0xe5=0x%02x"
+	    " ppid 0x09d %s\n", on ? "on" : "off", got_arg, got_trig,
+	    ok ? "sent" : "failed");
+	return ok;
+}
+
+static int
+hap_boost_ready(void)
+{
+	uint8_t vreg = 0, status4 = 0;
+	unsigned int i;
+
+	for (i = 0; i < 100; i++) {
+		if (mondrian_spmi_reg_read_raw(MONDRIAN_HAP_HBST,
+		    HAP_HBST_VREG, &vreg) &&
+		    mondrian_spmi_reg_read_raw(MONDRIAN_HAP_HBST,
+		    HAP_HBST_STATUS4, &status4) &&
+		    ((vreg & HAP_EN_BIT) != 0 || (status4 & 1) != 0)) {
+			printf("MONDRIAN HAP: hboost ready: vreg 0x%02x"
+			    " status4 0x%02x\n", vreg, status4);
+			return 1;
+		}
+		delay(200);
+	}
+	printf("MONDRIAN HAP: hboost did not come up after 20 ms"
+	    " (vreg 0x%02x status4 0x%02x)\n", vreg, status4);
+	return 0;
+}
+
+int
+mondrian_haptics_boost(unsigned int on)
+{
+	if (on > 1) {
+		return -1;
+	}
+	return hap_boost(on) ? 0 : -1;
+}
