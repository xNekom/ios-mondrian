diff --git a/osfmk/arm64/corecrypto/arm64_isa_compatibility.h b/osfmk/arm64/corecrypto/arm64_isa_compatibility.h
--- a/osfmk/arm64/corecrypto/arm64_isa_compatibility.h
+++ b/osfmk/arm64/corecrypto/arm64_isa_compatibility.h
@@ -28,7 +28,12 @@
 // #include <Availability.h>
 #include <sys/cdefs.h>
 
-#if defined(__clang__) && ((defined(__apple_build_version__) && __apple_build_version__ > 5010000))
+/* The vN.4s crypto syntax needs a clang new enough to parse it: every clang
+ * since Apple's 5010000, including upstream LLVM clang, which does not
+ * define __apple_build_version__ at all. The qN form in the other branch is
+ * Apple's assembler syntax and upstream LLVM rejects it. */
+#if defined(__clang__) && (!defined(__apple_build_version__) || \
+    (__apple_build_version__ > 5010000))
 #define __USES_V_CRYPTO_INTRINSICS 1
 #else
 #define __USES_V_CRYPTO_INTRINSICS 0

diff --git a/osfmk/kern/kalloc.c b/osfmk/kern/kalloc.c
--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -1784,6 +1784,17 @@
 	 */
 	kt_count = kalloc_type_view_parse(KTV_FIXED);
 	assert(kt_count < KALLOC_TYPE_SIZE_MASK);
+	/*
+	 * Without __builtin_xnu_type_signature every view is a data view, and
+	 * kalloc_type_view_copy() keeps none of them: all of them go to
+	 * KHEAP_DATA_BUFFERS. There is then nothing to sort and no typed zone to
+	 * create, and the iterator below assumes at least one view (its
+	 * assert(c_idx == p_idx) fails when the loop never runs; measured as a
+	 * panic in kernel_bootstrap, before the console ring is armed).
+	 */
+	if (kt_count == 0) {
+		return;
+	}
 
 #if DEBUG || DEVELOPMENT
 	vm_size_t sig_slist_size = (size_t) kt_count * sizeof(uint16_t);
@@ -1904,6 +1915,10 @@
 	 */
 	kt_count = kalloc_type_view_parse(KTV_VAR);
 	assert(kt_count < UINT32_MAX);
+	/* The same for the variable-size views: none was kept. */
+	if (kt_count == 0) {
+		return;
+	}
 
 #if DEBUG || DEVELOPMENT
 	vm_size_t sig_slist_size = (size_t) kt_count * sizeof(uint32_t);

diff --git a/osfmk/kern/kalloc.h b/osfmk/kern/kalloc.h
--- a/osfmk/kern/kalloc.h
+++ b/osfmk/kern/kalloc.h
@@ -743,6 +743,25 @@
 	    KT_SUMMARY_GRANULE_TO_IDX(KT_GRANULE_DUAL) |     \
 	    KT_SUMMARY_GRANULE_TO_IDX(KT_GRANULE_PAC))
 
+/*
+ * The XNU signature type system is an Apple clang extension: upstream clang
+ * has no __builtin_xnu_type_* functions. Fall back to a summary of data
+ * granules only, which keeps the in-tree static asserts that require a
+ * data-only type satisfied; signatures come out empty and pointer
+ * compatibility always passes, so the type-metadata fast paths (and their
+ * runtime checks) are gone, but the kernel builds and kalloc_type() still
+ * allocates.
+ */
+#if !__has_builtin(__builtin_xnu_type_summary)
+#define __builtin_xnu_type_summary(type) KT_SUMMARY_MASK_DATA
+#endif
+#if !__has_builtin(__builtin_xnu_type_signature)
+#define __builtin_xnu_type_signature(type) ""
+#endif
+#if !__has_builtin(__builtin_xnu_types_compatible)
+#define __builtin_xnu_types_compatible(t1, t2) (1)
+#endif
+
 /*!
  * @macro KT_SUMMARY_GRANULES
  *

diff --git a/osfmk/vm/vm_link_compat.c b/osfmk/vm/vm_link_compat.c
new file mode 100644
--- /dev/null
+++ b/osfmk/vm/vm_link_compat.c
@@ -0,0 +1,41 @@
+/*
+ * Link shims for a non-Apple toolchain.
+ *
+ * bsd/pgo/profile_runtime.c calls the InstrProfiling helpers that Apple's
+ * compiler-rt supplies at link time; there is no such runtime here, so report
+ * an empty profile. __cxa_atexit is only referenced by the C++ static
+ * destructor registration in libkern's bootstrap object; the kernel builds
+ * with -fno-c++-static-destructors and never runs it.
+ */
+#include <stdint.h>
+
+uint64_t
+__llvm_profile_get_size_for_buffer_internal(
+	const char *DataBegin, const char *DataEnd,
+	const char *CountersBegin, const char *CountersEnd,
+	const char *NamesBegin, const char *NamesEnd)
+{
+	(void)DataBegin; (void)DataEnd;
+	(void)CountersBegin; (void)CountersEnd;
+	(void)NamesBegin; (void)NamesEnd;
+	return 0;
+}
+
+int
+__llvm_profile_write_buffer_internal(
+	char *Buffer, const char *DataBegin, const char *DataEnd,
+	const char *CountersBegin, const char *CountersEnd,
+	const char *NamesBegin, const char *NamesEnd)
+{
+	(void)Buffer; (void)DataBegin; (void)DataEnd;
+	(void)CountersBegin; (void)CountersEnd;
+	(void)NamesBegin; (void)NamesEnd;
+	return 0;
+}
+
+int
+__cxa_atexit(void (*func)(void *), void *arg, void *dso)
+{
+	(void)func; (void)arg; (void)dso;
+	return 0;
+}

