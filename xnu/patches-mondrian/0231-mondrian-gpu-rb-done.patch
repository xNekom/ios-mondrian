+			/*
+			 * gprbdone=1: the render backend's own write. Every
+			 * write the CP has made so far is a write of the CP's;
+			 * RB_DONE_TS (event 22) is emitted by the RB pipeline
+			 * and lands only with WRITE_ENABLED set, so its 64-bit
+			 * timestamp at a known address answers "can the engine
+			 * that draws write memory at all". The polling is the
+			 * kernel's, not the GPU's: the timestamp is the RB's
+			 * and the CP does not order it behind its own fence,
+			 * which is why Mesa puts a CP_WAIT_REG_MEM after it.
+			 */
+			if (rptr >= at && mondrian_cp_test_rbdone) {
+				uint32_t *ib = (uint32_t *)mondrian_cp_ib.va;
+				uint32_t n = 0;
+				const uint64_t ts =
+				    mondrian_cp_memptr.iova + 0x900u;
+				const uint64_t fen3 =
+				    mondrian_cp_memptr.iova + 0x910u;
+				int polls;
+
+				if (mv != NULL) {
+					mv[0x900 / 4] = 0;
+					mv[0x904 / 4] = 0;
+					mv[0x910 / 4] = 0;
+					mv[0x914 / 4] = 0;
+				}
+				__asm__ volatile("dsb sy" ::: "memory");
+
+				ib[n++] = mondrian_pm4_type7(0x46u, 4);
+				/* RB_DONE_TS | WRITE_SRC(ALWAYSON) |
+				 * WRITE_DST(RAM) | WRITE_ENABLED */
+				ib[n++] = 22u | (3u << 20) | (1u << 27);
+				ib[n++] = (uint32_t)ts;
+				ib[n++] = (uint32_t)(ts >> 32);
+				ib[n++] = 0;
+				n = mondrian_cp_fence(ib, n, fen3, 0x600dc0e1u);
+				mondrian_gpu_mem_flush(&mondrian_cp_ib,
+				    mondrian_cp_ib.bytes);
+				at = mondrian_cp_prot_enter(ring, at);
+				ring[at++] = mondrian_pm4_type7(0x3fu, 3);
+				ring[at++] = (uint32_t)mondrian_cp_ib.iova;
+				ring[at++] = (uint32_t)(mondrian_cp_ib.iova >> 32);
+				ring[at++] = n;
+				at = mondrian_cp_prot_exit(ring, at);
+				mondrian_gpu_mem_flush(&mondrian_cp_ring,
+				    mondrian_cp_ring.bytes);
+				__asm__ volatile("dsb sy" ::: "memory");
+				CPW(GEN7_CP_RB_WPTR, at);
+				for (i = 0; i < 2000; i++) {
+					rptr = CPR(GEN7_CP_RB_RPTR);
+					if (rptr >= at) {
+						break;
+					}
+					delay(1000);
+				}
+				for (polls = 0; polls < 200; polls++) {
+					__asm__ volatile("dsb sy" ::: "memory");
+					if (mv == NULL) {
+						break;
+					}
+					if (mv[0x900 / 4] != 0 ||
+					    mv[0x904 / 4] != 0) {
+						break;
+					}
+					delay(1000);
+				}
+				__asm__ volatile("dsb sy" ::: "memory");
+				printf("MONDRIAN GPU: rb done ts 0x%08x%08x fence 0x%x polls %d int 0x%x fault 0x%x\n",
+				    mv ? mv[0x904 / 4] : 0, mv ? mv[0x900 / 4] : 0,
+				    mv ? mv[0x910 / 4] : 0, polls,
+				    CPR(GEN7_CP_INTERRUPT_STATUS),
+				    CPR(GEN7_CP_HW_FAULT));
+				mondrian_log_flush_now();
+			}
 		}
