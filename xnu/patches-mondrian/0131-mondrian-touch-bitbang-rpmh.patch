+	    mondrian_tlmm_cfg(0, MONDRIAN_TLMM_PULL_UP, MONDRIAN_TLMM_DRIVE_2MA, 0));
+	mondrian_spi_delay(2000);
+	printf("MONDRIAN TOUCH: spi: miso pull-up %u\n",
+	    mondrian_tlmm_read(mondrian_spi_miso, MONDRIAN_TLMM_IN_OUT) & 1);
+	mondrian_tlmm_write(mondrian_spi_miso, MONDRIAN_TLMM_CFG,
+	    mondrian_tlmm_cfg(0, MONDRIAN_TLMM_PULL_DOWN, MONDRIAN_TLMM_DRIVE_2MA, 0));
+	mondrian_spi_delay(2000);
+	printf("MONDRIAN TOUCH: spi: miso pull-down %u\n",
+	    mondrian_tlmm_read(mondrian_spi_miso, MONDRIAN_TLMM_IN_OUT) & 1);
