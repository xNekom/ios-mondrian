+/*
+ * The LDO resource address lives in the command DB, keyed by the vendor's
+ * qcom,resource-name ("ldoc2" for pm8350c_l2).
+ */
+static uint32_t
+mondrian_cmd_db_addr(const char *id)
+{
+	vm_offset_t db = ml_io_map(MONDRIAN_CMD_DB_PA, MONDRIAN_CMD_DB_SIZE);
+	const uint8_t *b = (const uint8_t *)db;
+	uint32_t i, j;
+
+	if (db == 0) {
+		return 0;
+	}
+	if (b[4] != 0xdb || b[5] != 0x30 || b[6] != 0x03 || b[7] != 0x0c) {
+		printf("MONDRIAN TOUCH: cmd-db magic %02x %02x %02x %02x\n",
+		    b[4], b[5], b[6], b[7]);
+		return 0;
+	}
+	for (i = 0; i < 8; i++) {
+		const uint8_t *h = b + 8 + 16 * i;
+		uint32_t count, eoff;
+		const uint8_t *e;
+
+		if ((h[0] | (h[1] << 8)) == 0) {
+			break;
+		}
+		eoff = h[2] | (h[3] << 8);
+		count = h[6] | (h[7] << 8);
+		e = b + 0x90 + eoff;
+		for (j = 0; j < count; j++, e += 24) {
+			if (memcmp(e, id, strlen(id)) == 0) {
+				uint32_t addr;
+
+				memcpy(&addr, e + 16, 4);
+				printf("MONDRIAN TOUCH: cmd-db \"%s\" 0x%x\n", id, addr);
+				return addr;
+			}
+		}
+	}
+	printf("MONDRIAN TOUCH: cmd-db has no \"%s\"\n", id);
+	return 0;
+}
+
+/*
+ * Vote for pm8350c_l2 on (1.8 V, enabled) through the first ACTIVE TCS. The
+ * VRM registers behind the resource address are +0x0 voltage in millivolts,
+ * +0x4 enable (bit 0) and +0x8 mode.
+ */
+static int
+mondrian_rpmh_ldo2(void)
+{
+	vm_offset_t rsc;
+	uint32_t addr = mondrian_cmd_db_addr("ldoc2");
+	uint32_t base = MONDRIAN_RSC_TCS_OFF;
+	uint32_t msgid = MONDRIAN_CMD_MSGID_LEN | MONDRIAN_CMD_MSGID_WRITE |
+	    MONDRIAN_CMD_MSGID_RESP;
+	uint32_t i, idle;
+
+	if (addr == 0) {
+		return -1;
+	}
+	rsc = ml_io_map(MONDRIAN_RSC_PA, MONDRIAN_RSC_SIZE);
+	if (rsc == 0) {
+		return -1;
+	}
+	idle = mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_ENABLE);
+	printf("MONDRIAN TOUCH: rpmh tcs0 enable 0x%x status 0x%x\n", idle,
+	    mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_STATUS));
+	mondrian_log_flush_now();
+	if (idle != 0) {
+		printf("MONDRIAN TOUCH: rpmh tcs0 busy, not voting\n");
+		return -1;
+	}
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_MSGID, msgid);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ADDR, addr);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_DATA, 1800);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_STEP + MONDRIAN_RSC_CMD_MSGID, msgid);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_STEP + MONDRIAN_RSC_CMD_ADDR, addr + 4);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_STEP + MONDRIAN_RSC_CMD_DATA, 1);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ENABLE, 0x3);
+	__builtin_arm_dsb(0xf);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, 1);
+	__builtin_arm_dsb(0xf);
+	for (i = 0; i < 1000000; i++) {
+		if (!(mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_ENABLE) & 0x3)) {
+			break;
+		}
+	}
+	printf("MONDRIAN TOUCH: rpmh vote done, status 0x%x cmd 0x%x/0x%x\n",
+	    mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_STATUS),
+	    mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_STATUS),
+	    mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_STEP + MONDRIAN_RSC_CMD_STATUS));
+	mondrian_log_flush_now();
+	return 0;
 }
 
