+	wifi_wlan_en_page = wifi_pin(WIFI_GPIO_WLAN_EN);
+	wifi_bt_en_page = wifi_pin(WIFI_GPIO_BT_EN);
+	wifi_perst_page = wifi_pin(WIFI_GPIO_PERST);
+	wifi_clkreq_page = wifi_pin(WIFI_GPIO_CLKREQ);
