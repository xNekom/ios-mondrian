-	    WIFI_TLMM_PAGE_SIZE);
-	wifi_bt_en_page = wifi_map_once(&wifi_bt_en_page,
-	    WIFI_TLMM_BASE + WIFI_TLMM_PAGE_SIZE * WIFI_GPIO_BT_EN,
