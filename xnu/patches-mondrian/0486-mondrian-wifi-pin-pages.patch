 	if (wifi_wlan_en_page == 0 || wifi_bt_en_page == 0 ||
 	    wifi_perst_page == 0 || wifi_clkreq_page == 0 ||
 	    wifi_wake_page == 0 || wifi_xo_page == 0) {
