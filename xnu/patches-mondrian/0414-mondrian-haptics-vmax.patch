xnu 0414: expose haptics VMAX for live drive tests

The PBS boost now comes up, but amplitudes 0x40 and 0xff do not move the LRA
at the conservative 1250 mV default. Add hapv MV so the next boot can change
VMAX from the live ring without another kernel build; vib uses the selected
value and logs it. The command is explicit, defaults are unchanged, and the
range is capped at 2000 mV after 2700 mV corrupted live PMIC reads.

diff --git a/bsd/dev/mondrian_haptics.c b/bsd/dev/mondrian_haptics.c
index 73124f0..dc572a4 100644
--- a/bsd/dev/mondrian_haptics.c
+++ b/bsd/dev/mondrian_haptics.c
@@ -73,9 +73,11 @@ extern void delay(int us);
 #define HAP_SINE			0x01
 #define HAP_FORCE_VREG_RDY	0x01
 #define HAP_FORCE_VSET_ACK	0x02	/* HAP525_HV only */
-#define HAP_VMAX_MV		1250	/* the DT's qcom,vmax-mv */
+#define HAP_VMAX_MV		1250	/* conservative first-drive default */
 #define HAP_VMAX_STEP_MV	50
 
+static unsigned int hap_vmax_mv = HAP_VMAX_MV;
+
 /*
  * HBST is read-only on this board. A write there (the vendor's SW_CTRL_HBST
  * path, taken because the block reports HAP_BOOST_V0P1) never completes: the
@@ -159,6 +161,17 @@ mondrian_haptics_boost(unsigned int on)
 	return hap_boost(on) ? 0 : -1;
 }
 
+int
+mondrian_haptics_set_vmax(unsigned int mv)
+{
+	if (mv < 500 || mv > 2000) {
+		return -1;
+	}
+	hap_vmax_mv = (mv / HAP_VMAX_STEP_MV) * HAP_VMAX_STEP_MV;
+	printf("MONDRIAN HAP: vmax %u mV\n", hap_vmax_mv);
+	return 0;
+}
+
 /* One register, one transaction: the unit the USB side walks. */
 int
 mondrian_haptics_peek(unsigned int block, unsigned int reg, uint8_t *out)
@@ -191,7 +204,7 @@ mondrian_haptics_poke(unsigned int block, unsigned int reg, unsigned int val)
 int
 mondrian_haptics_buzz(unsigned int ms, unsigned int amp, unsigned int force)
 {
-	uint8_t vmax = HAP_VMAX_MV / HAP_VMAX_STEP_MV;
+	uint8_t vmax = hap_vmax_mv / HAP_VMAX_STEP_MV;
 	uint8_t z = 0, st = 0, hpwr = 0, vset = 0, autores = 0, sine = 0;
 	int ok = 1;
 
@@ -249,7 +262,7 @@ mondrian_haptics_buzz(unsigned int ms, unsigned int amp, unsigned int force)
 	delay(2000 * 1000);
 	ok &= hap_boost(0);
 	printf("MONDRIAN HAP: buzz %u ms amp 0x%02x vmax %d force %u %s\n", ms,
-	    amp, HAP_VMAX_MV, force, ok ? "sent" : "with a failed write");
+	    amp, hap_vmax_mv, force, ok ? "sent" : "with a failed write");
 	return ok ? 0 : -1;
 }
 
