+/*
+ * gpu2dfault=1: the same blit, aimed at a page the SMMU does not map.
+ *
+ * 0239 measured everything except whether the engine writes at all: the 2D
+ * state registers read back exactly as written (`dst 0x14ae4000`, `pitch
+ * 0x40`), `CP_PROTECT` refused nothing, the fence completed, the CP wrote a
+ * canary into that same client buffer -- and the blit left 0 of 64 sampled
+ * dwords. A write into an unmapped page is the one way to see the write
+ * itself: if the engine issues it, the SMMU latches a translation fault and
+ * `CB_FAR` names the address it tried; if nothing faults, the blit never
+ * reaches the memory system and the loss is inside the RB/CCU.
+ *
+ * One row, so only the unmapped first page is touched, and the canary goes to
+ * the second page, which stays mapped: if the canary lands, the CP ran this
+ * IB and the fault, or its absence, belongs to the blit. Run last: a fault
+ * with no handler can leave the block stalled.
+ */
+void
+MondrianGPUUserClient::run2dFault(void)
+{
+	mondrian_buffer *dst, *ib;
+	uint32_t words[64], zeros[16];
+	uint32_t n, fence = 0, got = 0, fsr = 0, gfsr = 0;
+	uint64_t far = 0;
+	int submitted, polled;
+
+	{
+		static int parsed, on;
+
+		if (!parsed) {
+			parsed = 1;
+			if (!PE_parse_boot_argn("gpu2dfault", &on, sizeof(on))) {
+				on = 0;
+			}
+		}
+		if (!on) {
+			return;
+		}
+	}
+	IOLockLock(fLock);
+	dst = bufferNew(0x2000);
+	ib = bufferNew(0x1000);
+	IOLockUnlock(fLock);
+	if (dst == NULL || ib == NULL) {
+		IOLog("MondrianGPU: 2d fault: no buffer\n");
+		return;
+	}
+	memset(zeros, 0, sizeof(zeros));
+	(void)dst->memory->writeBytes(0, zeros, sizeof(zeros));
+	(void)dst->memory->writeBytes(0x1000, zeros, sizeof(zeros));
+	if (mondrian_gpu_uc_unmap_page(dst->iova) != 0 ||
+	    mondrian_gpu_uc_tables_sync() != 0) {
+		IOLog("MondrianGPU: 2d fault: unmap failed\n");
+		bufferFree(ib);
+		bufferFree(dst);
+		return;
+	}
+	n = mondrian_uc_2dfill_words(words, dst->iova, dst->iova + 0x1000,
+	    1, 0xff, 0x00, 0xff, 0xff);
+	if (ib->memory->writeBytes(0, words, n * 4) != n * 4) {
+		IOLog("MondrianGPU: 2d fault: ib write failed\n");
+		return;
+	}
+	bufferSync(ib);
+	bufferSync(dst);
+	mondrian_gpu_uc_fault_clear();
+	submitted = mondrian_gpu_uc_submit(ib->iova, n, &fence) == 0;
+	polled = submitted && mondrian_gpu_uc_wait(fence, 1000) == 0;
+	if (polled) {
+		fsr = mondrian_gpu_uc_fault_state(&gfsr);
+		far = mondrian_gpu_uc_fault_addr();
+	}
+	bufferSync(dst);
+	(void)dst->memory->readBytes(0x1000, &got, sizeof(got));
+	IOLog("MondrianGPU: 2d fault iova 0x%llx submit %d poll %d fence %u"
+	    " canary got 0x%08x fsr 0x%x gfsr 0x%x far 0x%llx\n",
+	    (unsigned long long)dst->iova, submitted, polled, fence, got, fsr,
+	    gfsr, (unsigned long long)far);
+	bufferFree(ib);
+	bufferFree(dst);
+}
