+/*
+ * The input address of the last fault, for a caller that cleared the latch
+ * first. Zero when nothing faulted.
+ */
+uint64_t
+mondrian_gpu_uc_fault_addr(void)
+{
+	if (mondrian_uc_smmu == 0 || mondrian_uc_tlb_ctx == 0) {
+		return 0;
+	}
+	return mondrian_smmu_read64(mondrian_uc_smmu, mondrian_uc_tlb_ctx + 0x60u);
+}
