@@ -68,6 +73,19 @@
 static vm_offset_t mondrian_uc_gmu;
 static uint32_t mondrian_uc_at;
 static uint32_t mondrian_uc_fence;
+/*
+ * The CP doorbell. CP_RB_WPTR is the one GPU register a submission has to
+ * touch, and touching it when the block has stopped answering never returns:
+ * measured on the phone, a boot where the ring ends at "uc pre 71" with a
+ * healthy keepalive and the UI frozen at 0 fps. Doing it here keeps that
+ * stall off the submission path and off the user client's lock.
+ */
+static volatile uint32_t mondrian_uc_door_at;
+static volatile uint32_t mondrian_uc_door_seq;
+static volatile uint32_t mondrian_uc_door_posted;
+static int mondrian_uc_door_started;
+
+static void mondrian_uc_door_thread(void *arg, wait_result_t wr);
 static uint32_t mondrian_uc_table_next = 1;
 static uint64_t mondrian_uc_iova = MONDRIAN_UC_IOVA_BASE;
 
@@ -2441,6 +2459,19 @@
 		printf("MONDRIAN GPU: cp keepalive held up\n");
 		mondrian_log_flush_now();
 	}
+	if (mondrian_uc_async != 0) {
+		thread_t thread = NULL;
+
+		if (kernel_thread_start(mondrian_uc_door_thread, NULL,
+		    &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			mondrian_uc_door_started = 1;
+			printf("MONDRIAN GPU: door thread started\n");
+		} else {
+			printf("MONDRIAN GPU: door thread failed, writing inline\n");
+		}
+		mondrian_log_flush_now();
+	}
 
 	for (i = 0; i < 2000; i++) {
 		rptr = CPR(GEN7_CP_RB_RPTR);
@@ -3000,6 +3031,29 @@
 	return -1;
 }
 
+static void
+mondrian_uc_door_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		uint32_t at = mondrian_uc_door_at;
+		uint32_t seq = mondrian_uc_door_seq;
+
+		if (at == 0) {
+			tsleep(&mondrian_uc_door_at, PUSER, "mondriandoor",
+			    hz);
+			continue;
+		}
+		mondrian_uc_door_at = 0;
+		printf("MONDRIAN GPU: uc door %u at 0x%x\n", seq, at);
+		mondrian_log_flush_now();
+		mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u, at);
+		__asm__ volatile("dsb sy" ::: "memory");
+		mondrian_uc_door_posted = seq;
+		printf("MONDRIAN GPU: uc door posted %u\n", seq);
+		mondrian_log_flush_now();
+	}
+}
+
 int
 mondrian_gpu_uc_submit(uint64_t ib, uint32_t dwords, uint32_t *fence)
 {
@@ -3073,7 +3127,29 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 	mondrian_uc_fence = seq;
 	mondrian_uc_at = at;
-	mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u, at);
+	if (mondrian_uc_async != 0 && mondrian_uc_door_started != 0) {
+		uint32_t waited;
+
+		mondrian_uc_door_seq = seq;
+		mondrian_uc_door_at = at;
+		wakeup(&mondrian_uc_door_at);
+		/* Memory only: the fence word, not a GPU register. */
+		for (waited = 0; waited < 100; waited++) {
+			if (mondrian_uc_door_posted == seq) {
+				break;
+			}
+			delay(1000);
+		}
+		if (mondrian_uc_door_posted != seq) {
+			printf("MONDRIAN GPU: door thread stopped answering at seq %u, submissions refused\n",
+			    seq);
+			mondrian_log_flush_now();
+			mondrian_uc_up = 0;
+			return 0;
+		}
+	} else {
+		mondrian_gpu_write(mondrian_uc_gpu, GEN7_CP_RB_WPTR * 4u, at);
+	}
 	/*
 	 * The read-back that used to be here (CP_RB_WPTR) made sure the posted
 	 * write had crossed the interconnect. It is the first GPU register
@@ -3369,6 +3445,8 @@
 	    sizeof(mondrian_uc_rback));
 	(void)PE_parse_boot_argn("gpukeep", &mondrian_uc_keep,
 	    sizeof(mondrian_uc_keep));
+	(void)PE_parse_boot_argn("gpuasync", &mondrian_uc_async,
