 /*
+ * Several single-word commands in one TCS trigger. The GPU's gfx/cx/mx ARC
+ * votes are sent as a batch by the vendor (rpmh_write_batch), and the RSC
+ * checks the corners of a batch; one command per trigger is not the same
+ * transaction. Returns 0 if every command reported success.
+ */
+int
+mondrian_rpmh_write_batch(const uint32_t *addr, const uint32_t *data, uint32_t n)
+{
+	vm_offset_t rsc = ml_io_map(MONDRIAN_RSC_PA, MONDRIAN_RSC_SIZE);
+	uint32_t base = MONDRIAN_RSC_ACTIVE_BASE;
+	uint32_t msgid = MONDRIAN_CMD_MSGID_LEN | MONDRIAN_CMD_MSGID_WRITE |
+	    MONDRIAN_CMD_MSGID_RESP;
+	uint32_t i, ctrl, mask = 0;
+	int error = 0;
+
+	if (rsc == 0 || n == 0 || n > 8) {
+		return -1;
+	}
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ENABLE, 0);
+	for (i = 0; i < n; i++) {
+		uint32_t off = i * MONDRIAN_RSC_CMD_STEP;
+
+		mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_MSGID + off, msgid);
+		mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ADDR + off, addr[i]);
+		mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_DATA + off, data[i]);
+		mask |= 1u << i;
+	}
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CMD_ENABLE, mask);
+	__builtin_arm_dsb(0xf);
+	ctrl = mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CONTROL);
+	ctrl &= ~MONDRIAN_TCS_AMC_TRIGGER;
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, ctrl);
+	ctrl &= ~MONDRIAN_TCS_AMC_ENABLE;
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, ctrl);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL, MONDRIAN_TCS_AMC_ENABLE);
+	mondrian_tlmm_write(rsc, base + MONDRIAN_RSC_CONTROL,
+	    MONDRIAN_TCS_AMC_ENABLE | MONDRIAN_TCS_AMC_TRIGGER);
+	__builtin_arm_dsb(0xf);
+	for (i = 0; i < 1000000; i++) {
+		if ((mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_ENABLE) & mask) == 0) {
+			break;
+		}
+	}
+	for (i = 0; i < n; i++) {
+		uint32_t off = i * MONDRIAN_RSC_CMD_STEP;
+		uint32_t status = mondrian_tlmm_read(rsc, base + MONDRIAN_RSC_CMD_STATUS + off);
+
+		if ((status & 0xff) != 0) {
+			printf("MONDRIAN RPMH: cmd %u addr 0x%x status 0x%x\n",
+			    i, addr[i], status);
+			error = -1;
+		}
+	}
+	return error;
+}
+
+/*
  * Vote for pm8350c_l2 on through the first ACTIVE TCS. The VRM registers
  * behind the resource address are +0x0 voltage in millivolts (the vendor
  * driver sends DIV_ROUND_UP(uV, 1000)), +0x4 enable and +0x8 mode. The mode
