+
+int
+mondrian_gpu_perf_set(int perf)
+{
+	uint32_t was = mondrian_gpu_perf;
+	int r;
+
+	if (mondrian_uc_up == 0 || mondrian_uc_gmu == 0) {
+		printf("MONDRIAN GPU: perf no gpu in this boot\n");
+		mondrian_log_flush_now();
+		return -1;
+	}
+	if (perf >= 0) {
+		mondrian_gpu_perf = (uint32_t)(perf > 13 ? 13 : perf);
+	}
+	/* Print before the vote: a GMU that does not come back leaves the line. */
+	printf("MONDRIAN GPU: perf %u -> %u (%u MHz) voting\n", was,
