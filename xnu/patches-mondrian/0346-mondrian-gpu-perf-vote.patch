+/*
+ * "gpuperf" prints the perf-table index the GPU is voted at and "gpuperf N"
+ * moves it: the boot vote stands for the whole session otherwise, where kgsl
+ * sends a fresh one per submission. 2 is the idle OPP (285 MHz), 13 the top
+ * (900); the answer is the index that is now in effect.
+ */
+static void
+ud_cmd_gpuperf(socket_t so, struct sockaddr_in *to, const char *line)
+{
+	extern int mondrian_gpu_perf_set(int perf);
+	extern int mondrian_gpu_perf_get(void);
+	uint32_t perf = 0;
+	char out[64];
+	int n;
+
+	if (line[7] == ' ' && ud_cmd_num(line + 8, &perf) != NULL) {
+		(void)mondrian_gpu_perf_set((int)perf);
+	}
+	n = snprintf(out, sizeof(out), "gpuperf %d\n",
+	    mondrian_gpu_perf_get());
+	ud_cmd_send(so, to, out, (size_t)n);
+	printf("%s", out);
+}
